+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse already uses exit code 2 for errors; ensure empty stdout (it uses stderr)
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            text = stream.read()
+        try:
+            request = json.loads(text)
+        except Exception:
+            raise ValueError("malformed request")
+        if type(request) is not dict:
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if type(op) is not str or op not in _OPS:
+            raise ValueError("unknown op")
+        keys = set(request.keys())
+        keys.discard("op")
+        allowed = _ALLOWED_PARAMS[op]
+        required = _REQUIRED_PARAMS[op]
+        # No unknown fields
+        for k in keys:
+            if k not in allowed:
+                raise ValueError("unknown field")
+        # All required present
+        for k in required:
+            if k not in request:
+                raise ValueError("missing field")
+        kwargs = {k: request[k] for k in keys}
+        queue = Queue(args.db)
+        method = getattr(queue, op)
+        value = method(**kwargs)
+        sys.stdout.write(json.dumps(value, sort_keys=True) + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except (ValueError, TypeError, KeyError, OSError, IOError, UnicodeError):
+        return 2
+    except Exception:
+        return 2
 
 
