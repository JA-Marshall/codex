+"""Focused regression tests for durable_queue contract."""
+import copy
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def make_queue(tmp):
+    return Queue(Path(tmp) / "queue.db")
+
+
+class SubmitAtomicityTests(unittest.TestCase):
+    def test_invalid_batch_rollback_leaves_db_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c"}, {"id": ""}])
+            self.assertEqual(q.list(), before)
+            self.assertIsNone(q.get("c"))
+
+    def test_duplicate_ids_within_batch_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x"}, {"id": "x"}])
+            self.assertEqual(q.list(), [])
+
+    def test_unknown_self_cycle_deps_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_bool_is_not_int_and_finite_payload(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": False}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"v": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"v": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": [1, 2]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "unknown_field": 1}])
+            self.assertEqual(q.list(), [])
+
+    def test_sorted_unique_deps_and_no_mutation_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "m"}, {"id": "z"}])
+            orig = {"id": "a", "dependencies": ["z", "m", "z", "m"]}
+            snapshot = copy.deepcopy(orig)
+            views = q.submit([orig])
+            self.assertEqual(orig, snapshot)
+            self.assertEqual(views[0]["dependencies"], ["m", "z"])
+            v = q.get("a")
+            self.assertEqual(v["dependencies"], ["m", "z"])
+            v["payload"]["x"] = 1
+            v["dependencies"].append("evil")
+            v2 = q.get("a")
+            self.assertNotIn("evil", v2["dependencies"])
+            self.assertNotIn("x", v2["payload"])
+            self.assertEqual(set(v2.keys()), {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"})
+            self.assertEqual(v2["state"], "pending")
+            self.assertEqual(v2["attempts"], 0)
+            self.assertIsNone(v2["worker"])
+            self.assertIsNone(v2["lease_until"])
+
+    def test_idempotent_only_if_normalized_original_matches(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "priority": 5, "dependencies": []}])
+            # same spec with different dep order still idempotent (normalized)
+            views = q.submit([{"id": "a", "priority": 5, "dependencies": []}])
+            self.assertEqual(views[0]["priority"], 5)
+            # conflict rejects whole batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}, {"id": "newbie"}])
+            self.assertIsNone(q.get("newbie"))
+            self.assertEqual(q.get("a")["priority"], 5)
+            # after state change, idempotent resubmit still succeeds
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            views2 = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(views2[0]["state"], "running")
+
+    def test_list_sorted_by_id(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "z"}, {"id": "a"}, {"id": "m"}])
+            self.assertEqual([v["id"] for v in q.list()], ["a", "m", "z"])
+
+    def test_get_validates_id(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get(None)
+
+
+class LeaseRetryStaleTests(unittest.TestCase):
+    def test_recover_expired_sets_ready_at_to_expired_lease(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 10)
+            self.assertEqual(c["lease_until"], 10)
+            ids = q.recover(10)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 10)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # repeated recovery no-op
+            self.assertEqual(q.recover(10), [])
+            self.assertEqual(q.recover(99), [])
+
+    def test_recover_exhausted_goes_failed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}])
+            q.claim("w", 0, 5)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "failed")
+            self.assertEqual(v["ready_at"], 0)
+            self.assertIsNone(q.claim("w", 5, 5))
+
+    def test_stale_attempt_rejected_even_same_worker_reclaimed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            self.assertEqual(c1["attempts"], 1)
+            q.recover(5)
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 6)
+            # correct attempt succeeds
+            q.complete("a", "w", 2, 6)
+            self.assertEqual(q.get("a")["state"], "succeeded")
+
+    def test_complete_fail_require_running_owner_lease(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c["attempts"], 10)
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w1", 1, 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c["attempts"], 1, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c["attempts"], 1, retry_delay=True)
+            # ValueError writes nothing including no recover: expired other job stays running
+            q.submit([{"id": "b"}])
+            cb = q.claim("w2", 0, 5)
+            # cb is for b? a is running so only b eligible? Actually a running, b pending -> claim b
+            self.assertEqual(cb["id"], "b")
+            # try invalid complete on a (wrong owner) at time beyond b expiry; b must stay running
+            with self.assertRaises(ValueError):
+                q.complete("a", "wrong", 99, 99)
+            vb = q.get("b")
+            self.assertEqual(vb["state"], "running")
+
+    def test_fail_retry_delay_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 3}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            self.assertIsNone(v["worker"])
+            # not eligible before ready_at
+            self.assertIsNone(q.claim("w", 2, 10))
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["id"], "a")
+            # terminal cannot be completed/failed/claimed again
+            q.complete("a", "w", c2["attempts"], 7)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c2["attempts"], 7)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c2["attempts"], 7)
+            self.assertIsNone(q.claim("w", 7, 10))
+
+    def test_claim_priority_lex_and_dep_gating(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 5}])
+            self.assertEqual(q.claim("w", 0, 10)["id"], "c")
+            q.complete("c", "w", 1, 1)
+            self.assertEqual(q.claim("w", 1, 10)["id"], "a")
+            q.complete("a", "w", 1, 2)
+            self.assertEqual(q.claim("w", 2, 10)["id"], "b")
+
+    def test_failed_dep_stays_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "dep")
+            q.fail("dep", "w", c["attempts"], 1)
+            # dep now failed after recover? attempts==max so failed
+            q.recover(5)
+            # need to fail the running? Actually dep was failed via fail? max_attempts=1 so fail sets failed directly
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertIsNone(q.claim("w", 1, 10))
+            self.assertEqual(q.get("child")["state"], "pending")
+
+
+class SubprocessDurabilityTests(unittest.TestCase):
+    def test_reopen_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = str(Path(tmp) / "queue.db")
+            Queue(path).submit([{"id": "a", "payload": {"n": 1}}])
+            self.assertEqual(Queue(path).get("a")["payload"], {"n": 1})
+
+    def test_subprocess_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "queue.db")
+            Queue(db).submit([{"id": "a"}, {"id": "b"}])
+            def cli_claim(worker):
+                req = Path(tmp) / ("req_%s.json" % worker)
+                req.write_text(json.dumps({"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30}), encoding="utf-8")
+                p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True, timeout=10)
+                return p
+            p1 = cli_claim("w1")
+            p2 = cli_claim("w2")
+            self.assertEqual(p1.returncode, 0, p1.stderr)
+            self.assertEqual(p2.returncode, 0, p2.stderr)
+            v1 = json.loads(p1.stdout)
+            v2 = json.loads(p2.stdout)
+            self.assertIsNotNone(v1)
+            self.assertIsNotNone(v2)
+            self.assertNotEqual(v1["id"], v2["id"])
+            self.assertNotEqual(v1["worker"], v2["worker"])
+
+
+class CLITests(unittest.TestCase):
+    def run_cli(self, db, obj):
+        import uuid
+        d = str(Path(db).parent)
+        req = Path(d) / ("req_%s.json" % uuid.uuid4().hex)
+        if isinstance(obj, bytes):
+            req.write_bytes(obj)
+        elif isinstance(obj, str):
+            req.write_text(obj, encoding="utf-8")
+        else:
+            req.write_text(json.dumps(obj), encoding="utf-8")
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True, timeout=10)
+        return p
+
+    def test_cli_success_sorted_keys_single_line(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            req = Path(tmp) / "req.json"
+            req.write_text(json.dumps({"op": "get", "id": "a"}), encoding="utf-8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True, timeout=10)
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            val = json.loads(p.stdout)
+            self.assertEqual(val["id"], "a")
+            # sorted keys: raw stdout should have keys in sorted order
+            raw = p.stdout.strip()
+            self.assertEqual(raw, json.dumps(val, sort_keys=True))
+
+    def test_cli_errors_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            # unknown op
+            p = self.run_cli(db, {"op": "nope"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unknown field
+            p = self.run_cli(db, {"op": "get", "id": "a", "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # malformed json
+            p = self.run_cli(db, "{not json")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp) / "missing.json")], capture_output=True, text=True, timeout=10)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
