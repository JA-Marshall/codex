+_ALLOWED_PARAMS = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now", "retry_delay"},
+}
+_REQUIRED_PARAMS = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
