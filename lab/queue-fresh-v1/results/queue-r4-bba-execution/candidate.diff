+            if color.get(w, WHITE) == GRAY:
+                return True
+            if color.get(w, WHITE) == WHITE:
+                if dfs(w, stack):
+                    return True
+        color[u] = BLACK
+        return False
+
+    for n in graph:
+        if color[n] == WHITE:
+            if dfs(n, []):
+                return True
+    return False
