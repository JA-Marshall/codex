+"""Focused regression tests for durable_queue contract (TDD red)."""
+import copy
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def tmpdb(tmp):
+    return str(Path(tmp) / "q.db")
+
+EXACT_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+class TestSubmitValidation(unittest.TestCase):
+    def test_bool_rejected_and_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","priority":True}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","max_attempts":True}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            self.assertEqual(q.list(), [])
