+        # argparse exits 2 on error; ensure empty stdout (it uses stderr)
+        raise
+    # Read request file strictly UTF-8
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+    except Exception:
+        sys.stdout.write("")  # ensure no stdout
+        raise SystemExit(2)
+    # Parse JSON, reject non-finite constants
+    def _reject_constant(x):
+        raise ValueError("non-finite constant")
