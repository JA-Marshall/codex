+class TestDurabilityProcesses(unittest.TestCase):
+    def test_reopen_durability_subprocess(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            code = "from durable_queue import Queue; Queue(r'''"+db+r"''').submit([{'id':'a','payload':{'x':1}}])"
+            r = subprocess.run([sys.executable,"-c",code],capture_output=True,text=True,timeout=20)
+            self.assertEqual(r.returncode,0,msg=r.stderr)
+            self.assertEqual(Queue(db).get("a")["payload"],{"x":1})
