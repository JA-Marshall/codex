+    if "op" not in request:
+        raise SystemExit(2)
+    op = request.get("op")
+    if not isinstance(op, str) or op not in _OPS:
+        raise SystemExit(2)
+    allowed = _ALLOWED_FIELDS[op]
+    required = _REQUIRED_FIELDS[op]
+    keys = set(request.keys()) - {"op"}
+    # No unknown fields
+    for k in keys:
+        if k not in allowed:
+            raise SystemExit(2)
+    for k in required:
+        if k not in request:
+            raise SystemExit(2)
+    kwargs = {k: request[k] for k in keys}
+    # Dispatch
