+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            Queue(db).submit([{"id":"only"}])
+            code = "from durable_queue import Queue; import json; q=Queue(r'''"+db+r"'''); v=q.claim('p1',0,30); print(json.dumps(v['id'] if v else None))"
+            p1 = subprocess.Popen([sys.executable,"-c",code],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+            out1, err1 = p1.communicate(timeout=20)
+            self.assertEqual(p1.returncode,0,msg=err1)
+            # second claim in this process must be None (lease still active)
+            self.assertIsNone(Queue(db).claim("p2",0,30))
