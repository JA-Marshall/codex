+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+from durable_queue import Queue
+
+EXE = sys.executable
+
+def cli(db, obj):
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+        json.dump(obj, f)
+        name = f.name
+    try:
+        r = subprocess.run([EXE, "-m", "durable_queue", "--db", str(db), "--request", name], capture_output=True)
+        return r
+    finally:
+        try:
+            Path(name).unlink()
+        except Exception:
+            pass
+
+class ProcessDurabilityTests(unittest.TestCase):
+    def test_reopen_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "q.db"
+            q1 = Queue(path)
+            q1.submit([{"id": "a", "payload": {"n": 1}}, {"id": "b", "priority": 3}])
+            c = q1.claim("w", 0, 10)
+            del q1
+            q2 = Queue(path)
+            self.assertEqual(q2.get(c["id"])["state"], "running")
+            self.assertEqual(len(q2.list()), 2)
+            q2.complete(c["id"], "w", c["attempts"], 1)
+            del q2
+            q3 = Queue(path)
+            self.assertEqual(q3.get(c["id"])["state"], "succeeded")
+
+    def test_kill_restart_reopen_after_claim(self):
+        # simulate kill by discarding handle without commit issues (commit already done per-op)
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "q.db"
+            Queue(path).submit([{"id": "job1"}, {"id": "job2"}])
+            # claim via subprocess (fresh process)
+            with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+                json.dump({"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 10}, f)
+                req = f.name
+            try:
+                r = subprocess.run([EXE, "-m", "durable_queue", "--db", str(path), "--request", req], capture_output=True)
+            finally:
+                Path(req).unlink()
+            self.assertEqual(r.returncode, 0)
+            claimed = json.loads(r.stdout.decode())
+            self.assertIn(claimed["id"], ("job1", "job2"))
+            # reopen in new process and verify
+            q = Queue(path)
+            self.assertEqual(q.get(claimed["id"])["state"], "running")
+
+    def test_concurrent_claim_exclusivity_single_job(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = str(Path(tmp) / "q.db")
+            Queue(path).submit([{"id": "only"}])
+            def do_claim(worker):
+                r = cli(path, {"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30})
+                if r.returncode != 0:
+                    return ("err", worker, r.returncode)
+                v = json.loads(r.stdout.decode())
+                return v
+            with ThreadPoolExecutor(max_workers=2) as ex:
+                f1 = ex.submit(do_claim, "w1")
+                f2 = ex.submit(do_claim, "w2")
+                r1 = f1.result()
+                r2 = f2.result()
+            # exactly one should get the job, other None
+            got = [r for r in (r1, r2) if isinstance(r, dict) and r is not None]
+            nones = [r for r in (r1, r2) if r is None]
+            self.assertEqual(len(got), 1, msg=f"{r1!r} {r2!r}")
+            self.assertEqual(len(nones), 1)
+            # DB shows single running lease
+            q = Queue(path)
+            g = q.get("only")
+            self.assertEqual(g["state"], "running")
+            self.assertIn(g["worker"], ("w1", "w2"))
+            self.assertEqual(g["attempts"], 1)
+
+    def test_concurrent_claim_distinct_jobs(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = str(Path(tmp) / "q.db")
+            Queue(path).submit([{"id": "j1"}, {"id": "j2"}, {"id": "j3"}])
+            def do_claim(worker):
+                r = cli(path, {"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30})
+                self.assertEqual(r.returncode, 0)
+                return json.loads(r.stdout.decode())
+            with ThreadPoolExecutor(max_workers=3) as ex:
+                futs = [ex.submit(do_claim, f"w{i}") for i in range(3)]
+                results = [f.result() for f in futs]
+            ids = [v["id"] for v in results if v is not None]
+            self.assertEqual(sorted(ids), ["j1", "j2", "j3"])
+            # no duplicate active lease
+            self.assertEqual(len(set(ids)), 3)
+
+    def test_cli_roundtrip_survives_failures(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = str(Path(tmp) / "q.db")
+            # submit via CLI
+            r = cli(path, {"op": "submit", "jobs": [{"id": "a"}, {"id": "b", "dependencies": ["a"]}]})
+            self.assertEqual(r.returncode, 0)
+            # invalid batch via CLI must not change DB
+            r2 = cli(path, {"op": "submit", "jobs": [{"id": "c", "dependencies": ["missing"]}]})
+            self.assertEqual(r2.returncode, 2)
+            self.assertEqual(r2.stdout, b"")
+            q = Queue(path)
+            self.assertIsNone(q.get("c"))
+            self.assertIsNotNone(q.get("a"))
+
+if __name__ == "__main__":
+    unittest.main()
