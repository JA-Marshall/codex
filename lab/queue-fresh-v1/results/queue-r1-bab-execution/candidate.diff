+                q.complete("a", "other", c1["attempts"], 1)
+            # stale attempt (0)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 999, 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 999, 1)
+            # expired (now == lease)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c1["attempts"], 5)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c1["attempts"], 5)
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w1", 1, 1)
+            # invalid args
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", True, 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c1["attempts"], 1, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c1["attempts"], True)
+            # DB unchanged including no recovery
+            after = q.get("a")
+            self.assertEqual(before, after)
+            self.assertEqual(after["state"], "running")
+            # stale after reclaim: reclaim via recover then old attempt rejected
+            q.recover(5)
+            c2 = q.claim("w1", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 6)
+
+    def test_attempts_never_exceed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["attempts"], 1)
+            # no more claims while running
+            # after fail -> failed, no claim
+            q.fail("a", "w", 1, 1)
+            self.assertEqual(q.get("a")["attempts"], 1)
+            self.assertIsNone(q.claim("w", 2, 10))
+
+
+class CliTests(unittest.TestCase):
+    def _req(self, tmp, obj, raw_bytes=None):
+        p = Path(tmp) / "req.json"
+        if raw_bytes is not None:
+            p.write_bytes(raw_bytes)
+        else:
+            p.write_text(json.dumps(obj), encoding="utf-8")
+        return str(p)
+
+    def _run(self, db, req):
+        return subprocess.run([EXE, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True)
+
+    def test_cli_success_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            req = self._req(tmp, {"op": "submit", "jobs": [{"id": "a", "priority": 2}]})
+            r = self._run(db, req)
+            self.assertEqual(r.returncode, 0)
+            self.assertTrue(r.stdout.endswith(b"\n"))
+            self.assertEqual(r.stdout.count(b"\n"), 1)
+            val = json.loads(r.stdout.decode())
+            self.assertEqual(val[0]["id"], "a")
+            # keys sorted: check raw output has sorted keys (sort_keys)
+            raw = r.stdout.decode().strip()
+            # json dumps sorted ensures "attempts" before "dependencies" etc; just verify loads and that output equals sorted dumps
+            self.assertEqual(raw, json.dumps(val, sort_keys=True, ensure_ascii=False))
+
+    def test_cli_errors_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # need a valid job first
+            Queue(db).submit([{"id": "a"}])
+            cases = [
+                ({"op": "submit", "jobs": [{"id": "a", "priority": 999}], "extra": 1}, "unknown field"),
+                ({"op": "nosuch"}, "unknown op"),
+                ({"jobs": []}, "missing op"),
+                ({"op": "get", "id": "a", "extra": 1}, "extra field"),
+                ({"op": "get"}, "missing field"),
+                ([1,2,3], "non-object"),
+                ({"op": "submit", "jobs": [{"id": ""}]}, "api ValueError"),
+            ]
+            for obj, msg in cases:
+                req = self._req(tmp, obj)
+                r = self._run(db, req)
+                self.assertEqual(r.returncode, 2, msg)
+                self.assertEqual(r.stdout, b"", msg)
+            # malformed JSON
+            req = self._req(tmp, None, raw_bytes=b"{not json")
+            r = self._run(db, req)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+            # invalid utf-8
+            req = self._req(tmp, None, raw_bytes=b"\xff\xff")
+            r = self._run(db, req)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+            # missing file
+            r = self._run(db, str(Path(tmp) / "nope.json"))
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+            # unavailable db (is a directory)
+            req2 = self._req(tmp, {"op": "list"})
+            r = subprocess.run([EXE, "-m", "durable_queue", "--db", tmp, "--request", req2], capture_output=True)
+            # tmp is a directory; sqlite connect may actually succeed? Directory as db path fails.
+            # If it unexpectedly succeeds, accept 0? But contract says unavailable DB must exit 2.
+            # Our code: Queue(tmp) will try sqlite connect to directory -> OperationalError -> exit 2.
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+
+    def test_cli_fail_retry_delay_optional(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            c = Queue(db).claim("w", 0, 10)
+            req = self._req(tmp, {"op": "fail", "id": "a", "worker": "w", "attempt": c["attempts"], "now": 1})
+            r = self._run(db, req)
+            self.assertEqual(r.returncode, 0)
+            val = json.loads(r.stdout.decode())
+            self.assertEqual(val["state"], "pending")
+
+if __name__ == "__main__":
+    unittest.main()
