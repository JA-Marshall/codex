+def _tmpdb(tmp):
+    return os.path.join(tmp, "q.db")
+
+
+def _claim_worker(args):
+    db_path, worker, now, lease_seconds, q = args
+    try:
+        from durable_queue import Queue as Q
+        v = Q(db_path).claim(worker, now, lease_seconds)
+        q.put({"worker": worker, "view": v})
+    except Exception as e:
+        q.put({"worker": worker, "error": f"{type(e).__name__}: {e}"})
+
+
+def _submit_worker(db_path, jobs, q):
+    try:
+        from durable_queue import Queue as Q
+        v = Q(db_path).submit(jobs)
+        q.put({"views": v})
+    except Exception as e:
+        q.put({"error": f"{type(e).__name__}: {e}"})
+
