+            conn.execute(
+                "INSERT OR REPLACE INTO jobs_new "
+                "(id, spec, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    jid,
+                    json.dumps(spec, sort_keys=True),
+                    json.dumps(payload, sort_keys=True),
+                    priority,
+                    json.dumps(deps),
+                    max_attempts,
+                    ready_at,
+                    state,
+                    attempts,
+                    worker,
+                    lease_until,
+                ),
+            )
+        except Exception:
+            continue
+    conn.execute("DROP TABLE jobs")
+    conn.execute("ALTER TABLE jobs_new RENAME TO jobs")
+    _ensure_indexes(conn)
+
+
+def ensure_schema(conn):
+    sql = _table_sql(conn)
+    if sql is None:
+        conn.execute(SCHEMA_SQL)
+        _ensure_indexes(conn)
+        return
+    # New schema has spec/payload columns; legacy has data column.
+    upper = sql.upper()
+    if "SPEC" in upper and "PAYLOAD" in upper:
+        # Ensure all expected columns exist (defensive ALTER for partial schemas).
+        cols = {r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()}
+        expected = {
+            "id": "TEXT",
+            "spec": "TEXT",
+            "payload": "TEXT",
+            "priority": "INTEGER",
+            "dependencies": "TEXT",
+            "max_attempts": "INTEGER",
+            "ready_at": "INTEGER",
+            "state": "TEXT",
+            "attempts": "INTEGER",
+            "worker": "TEXT",
+            "lease_until": "INTEGER",
+        }
+        for name, typ in expected.items():
+            if name not in cols:
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {name} {typ}")
+        _ensure_indexes(conn)
+        return
+    # Legacy table -> migrate.
+    _migrate_legacy(conn, sql)
+
+
+def connect(path):
+    conn = sqlite3.connect(str(path), timeout=30.0, isolation_level=None, check_same_thread=False)
+    try:
+        conn.execute("PRAGMA journal_mode=WAL;")
+    except sqlite3.Error:
+        pass
+    try:
+        conn.execute("PRAGMA busy_timeout=5000;")
+    except sqlite3.Error:
+        pass
+    try:
+        conn.execute("PRAGMA synchronous=NORMAL;")
+    except sqlite3.Error:
+        pass
+    try:
+        conn.execute("PRAGMA foreign_keys=ON;")
+    except sqlite3.Error:
+        pass
+    ensure_schema(conn)
+    return conn
+
+
+@contextlib.contextmanager
+def atomic(conn):
+    conn.execute("BEGIN IMMEDIATE")
+    try:
+        yield conn
+    except BaseException:
+        try:
+            conn.execute("ROLLBACK")
+        except sqlite3.Error:
+            pass
+        raise
+    else:
+        conn.execute("COMMIT")
