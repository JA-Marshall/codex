+class CLITests(unittest.TestCase):
+    def test_cli_success_canonical(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = os.path.join(tmp, "q.db")
+            req = _write_request(tmp, {"op": "submit", "jobs": [{"id": "a", "priority": 2}]})
+            r = _run_cli(db, req)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            self.assertTrue(r.stdout.endswith("\n"))
+            self.assertEqual(r.stdout.count("\n"), 1)
+            val = json.loads(r.stdout)
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: first object keys sorted
+            text = r.stdout.strip()
+            # ensure sorted-keys canonical by reloading with sort and comparing raw? check key order
+            raw_obj = json.loads(text)
+            canonical = json.dumps(raw_obj, sort_keys=True)
+            self.assertEqual(text, canonical)
+            # list via CLI
+            req2 = _write_request(tmp, {"op": "list"})
+            r2 = _run_cli(db, req2)
+            self.assertEqual(r2.returncode, 0)
+            self.assertEqual(json.loads(r2.stdout)[0]["id"], "a")
+
+    def test_cli_failures_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = os.path.join(tmp, "q.db")
+            Queue(db).submit([{"id": "a"}])
+            cases = [
+                {"op": "nope"},
+                {"op": "list", "extra": 1},
+                {"op": "get"},
+                {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10},
+                [1, 2],
+                None,
+                {"jobs": []},
+            ]
+            for i, c in enumerate(cases):
+                req = _write_request(tmp, c)
+                # rewrite each to unique file to avoid caching
+                r = _run_cli(db, req)
+                self.assertEqual(r.returncode, 2, f"case {i}: {c} stderr={r.stderr}")
+                self.assertEqual(r.stdout, "", f"case {i}")
+            # malformed json
+            p = os.path.join(tmp, "bad.json")
+            with open(p, "w", encoding="utf-8") as f:
+                f.write("{not json")
+            r = _run_cli(db, p)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # invalid utf-8
+            p2 = os.path.join(tmp, "bad2.json")
+            with open(p2, "wb") as f:
+                f.write(b"\xff\xfe{")
+            r = _run_cli(db, p2)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # missing file
+            r = _run_cli(db, os.path.join(tmp, "missing.json"))
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # API ValueError maps to exit 2
+            reqv = _write_request(tmp, {"op": "complete", "id": "a", "worker": "w", "attempt": 1, "now": 0})
+            r = _run_cli(db, reqv)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+
+    def test_cli_db_survives_restart(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = os.path.join(tmp, "q.db")
+            r = _run_cli(db, _write_request(tmp, {"op": "submit", "jobs": [{"id": "k"}]}))
+            self.assertEqual(r.returncode, 0)
+            r2 = _run_cli(db, _write_request(tmp, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10}))
+            self.assertEqual(r2.returncode, 0)
+            v = json.loads(r2.stdout)
+            self.assertEqual(v["id"], "k")
+            # reopen via API sees running
+            self.assertEqual(Queue(db).get("k")["state"], "running")
+
+
+if __name__ == "__main__":
+    unittest.main()
