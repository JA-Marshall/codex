+def _mp_submit(path_str, jobs):
+    from durable_queue import Queue as Q
+    Q(path_str).submit(jobs)
+
+def _mp_claim(path_str, worker, now, lease, out_q):
+    try:
+        from durable_queue import Queue as Q
+        v = Q(path_str).claim(worker, now, lease)
+        out_q.put((worker, v["id"] if v else None, v["attempts"] if v else None))
+    except Exception as e:
+        out_q.put((worker, "ERR:" + repr(e), None))
+
+def _run_cli(db, req_obj=None, raw_bytes=None, req_text=None):
+    tmp = Path(tempfile.mkdtemp())
+    # use repo-local fallback if needed: tempfile already works
+    req = tmp / "req.json"
+    if raw_bytes is not None:
+        req.write_bytes(raw_bytes)
+    elif req_text is not None:
+        req.write_bytes(req_text.encode("utf-8"))
+    else:
+        req.write_text(json.dumps(req_obj), encoding="utf-8")
+    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req)], capture_output=True, text=True)
+    return p
+
+class ValidationTests(unittest.TestCase):
+    def _q(self, tmp):
+        return Queue(Path(tmp) / "q.db")
+    def test_bool_rejected_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a"}])
+            before = q.list()
+            for bad in [[{"id": "b", "priority": True}], [{"id": "c", "max_attempts": True}], [{"id": "d", "ready_at": False}], [{"id": "e", "payload": {"x": True}, "priority": 0}]]:
+                pass
+            # payload bool is allowed; check int fields bool rejected
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "max_attempts": False}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "ready_at": True}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            self.assertEqual(q.list(), before)
+    def test_unknown_self_cycle_duplicate(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "bogus": 1}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "dependencies": ["b"]}])
+            self.assertEqual(len(q.list()), 1)
+    def test_nonfinite_and_types(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "", "payload": {}}])
+            with self.assertRaises(ValueError):
+                q.submit("notalist")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": "x"}])
+            self.assertEqual(q.list(), [])
+            # payload bool allowed
+            v = q.submit([{"id": "ok", "payload": {"b": True, "n": None, "s": "x", "l": [1, 2.5]}}])
+            self.assertEqual(v[0]["payload"]["b"], True)
+    def test_atomic_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "b", "priority": "bad"}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 1}, {"id": "a", "priority": 1}])
+            self.assertEqual(q.list(), [])
+    def test_idempotent_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a", "priority": 5, "payload": {"x": 1}}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # resubmit original spec after state change should succeed and return current view
+            v = q.submit([{"id": "a", "priority": 5, "payload": {"x": 1}}])
+            self.assertEqual(v[0]["state"], "running")
+            self.assertEqual(v[0]["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6, "payload": {"x": 1}}])
+            # failed batch with conflict leaves unchanged
+            self.assertEqual(q.get("a")["priority"], 5)
+    def test_detached_and_no_mutation(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            inp = {"id": "a", "payload": {"x": [1]}, "dependencies": ["z", "z"]}
+            orig = copy.deepcopy(inp)
+            # need dep z first
+            q.submit([{"id": "z"}])
+            v = q.submit([inp])
+            self.assertEqual(inp, orig)
+            self.assertEqual(v[0]["dependencies"], ["z"])
+            v[0]["payload"]["x"].append(99)
+            v[0]["dependencies"].append("evil")
+            self.assertEqual(q.get("a")["payload"], {"x": [1]})
+            self.assertEqual(q.get("a")["dependencies"], ["z"])
+            g = q.get("a")
+            g["payload"]["x"] = "mut"
+            self.assertEqual(q.get("a")["payload"], {"x": [1]})
+    def test_get_list_validation_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # get/list do not recover even after expiry
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.list()[0]["state"], "running")
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get(None)
