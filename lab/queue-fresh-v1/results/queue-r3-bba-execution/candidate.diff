+"""Durable SQLite storage with WAL, timeouts and spec/state split."""
+import contextlib
 import sqlite3
 
+SPEC_SCHEMA = (
+    "CREATE TABLE IF NOT EXISTS job_specs ("
+    "id TEXT PRIMARY KEY, "
+    "payload TEXT NOT NULL, "
+    "priority INTEGER NOT NULL, "
+    "dependencies TEXT NOT NULL, "
+    "max_attempts INTEGER NOT NULL, "
+    "ready_at INTEGER NOT NULL"
+    ")"
+)
 
-def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
-    connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
-    )
+JOBS_SCHEMA = (
+    "CREATE TABLE IF NOT EXISTS jobs ("
+    "id TEXT PRIMARY KEY, "
+    "payload TEXT NOT NULL, "
+    "priority INTEGER NOT NULL, "
+    "dependencies TEXT NOT NULL, "
+    "max_attempts INTEGER NOT NULL, "
+    "ready_at INTEGER NOT NULL, "
+    "state TEXT NOT NULL, "
+    "attempts INTEGER NOT NULL, "
+    "worker TEXT, "
+    "lease_until INTEGER"
+    ")"
+)
+
+
+def _apply_pragmas(connection):
+    try:
+        connection.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA busy_timeout=5000;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA foreign_keys=ON;")
+    except Exception:
+        pass
+
+
+def _ensure_schema(connection):
+    # Migrate legacy jobs(id, data) table if present.
+    try:
+        rows = connection.execute(
+            "SELECT sql FROM sqlite_master WHERE type='table' AND name='jobs'"
+        ).fetchone()
+    except Exception:
+        rows = None
+    if rows is not None and rows[0] is not None and "data TEXT" in rows[0]:
+        # Legacy schema: try to migrate, else drop.
+        try:
+            legacy = connection.execute("SELECT id, data FROM jobs").fetchall()
+        except Exception:
+            legacy = []
+        connection.execute("DROP TABLE jobs")
+        connection.execute(SPEC_SCHEMA)
+        connection.execute(JOBS_SCHEMA)
+        import json as _json
+        for _id, _data in legacy:
+            try:
+                v = _json.loads(_data)
+                import json as _j2
+                payload = _j2.dumps(v.get("payload", {}), sort_keys=True, separators=(",", ":"))
+                deps = _j2.dumps(sorted(set(v.get("dependencies", []))), separators=(",", ":"))
+                connection.execute(
+                    "INSERT OR IGNORE INTO job_specs(id,payload,priority,dependencies,max_attempts,ready_at) VALUES(?,?,?,?,?,?)",
+                    (v["id"], payload, int(v.get("priority", 0)), deps, int(v.get("max_attempts", 3)), int(v.get("ready_at", 0))),
+                )
+                connection.execute(
+                    "INSERT OR IGNORE INTO jobs(id,payload,priority,dependencies,max_attempts,ready_at,state,attempts,worker,lease_until) VALUES(?,?,?,?,?,?,?,?,?,?)",
+                    (v["id"], payload, int(v.get("priority", 0)), deps, int(v.get("max_attempts", 3)), int(v.get("ready_at", 0)), v.get("state", "pending"), int(v.get("attempts", 0)), v.get("worker"), v.get("lease_until")),
+                )
+            except Exception:
+                continue
+        return
+    connection.execute(SPEC_SCHEMA)
+    connection.execute(JOBS_SCHEMA)
+
+
+def _open(path):
+    connection = sqlite3.connect(str(path), timeout=5.0, isolation_level=None, check_same_thread=False)
+    _apply_pragmas(connection)
+    _ensure_schema(connection)
     return connection
+
+
+def connect(path):
+    return _open(path)
+
+
+@contextlib.contextmanager
+def transaction(path):
+    connection = _open(path)
+    try:
+        connection.execute("BEGIN IMMEDIATE;")
+        yield connection
+        connection.commit()
+    except Exception:
+        try:
+            connection.rollback()
+        except Exception:
+            pass
+        raise
+    finally:
+        try:
+            connection.close()
+        except Exception:
+            pass
