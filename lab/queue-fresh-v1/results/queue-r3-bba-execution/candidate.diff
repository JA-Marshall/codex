+class OrderingLeaseTests(unittest.TestCase):
+    def test_priority_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 5}, {"id": "c", "priority": 5}])
+            c1 = q.claim("w", 0, 10)
+            self.assertEqual(c1["id"], "a")
+            q.complete("a", "w", c1["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "c")
+            q.complete("c", "w", c2["attempts"], 2)
+            c3 = q.claim("w", 2, 10)
+            self.assertEqual(c3["id"], "b")
+    def test_dependency_failed_stays_pending(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "dep")
+            # fail with max 1 -> failed
+            q.fail("dep", "w", c["attempts"], 1)
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertIsNone(q.claim("w", 1, 10))
+            self.assertEqual(q.get("child")["state"], "pending")
+    def test_recover_mapping(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 3}, {"id": "b", "max_attempts": 1}])
+            ca = q.claim("w", 0, 5)
+            self.assertEqual(ca["id"], "a")
+            # claim b next (a running, so next eligible is b)
+            cb = q.claim("w", 0, 5)
+            self.assertEqual(cb["id"], "b")
+            # both leases expire at 5
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a", "b"])
+            self.assertEqual(q.get("a")["state"], "pending")
+            self.assertEqual(q.get("a")["ready_at"], 5)
+            self.assertIsNone(q.get("a")["worker"])
+            self.assertIsNone(q.get("a")["lease_until"])
+            # b had attempts 1 == max 1 -> failed, ready unchanged (0)
+            self.assertEqual(q.get("b")["state"], "failed")
+            self.assertEqual(q.get("b")["ready_at"], 0)
+            # repeated no-op
+            self.assertEqual(q.recover(5), [])
+            self.assertEqual(q.recover(6), [])
+    def test_claim_recovers_atomically(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c = q.claim("w1", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # at now 5, a expired; claim should recover a then claim highest priority smallest id among eligible (a ready_at=5, b ready 0)
+            c2 = q.claim("w2", 5, 5)
+            # eligible: a (ready 5<=5) and b (0<=5); tie priority 0 -> smallest id a
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["worker"], "w2")
+            self.assertEqual(c2["attempts"], 2)
+    def test_complete_fail_validation_zero_writes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c = q.claim("w", 0, 5)
+            before_b = q.get("b")
+            # wrong worker
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", c["attempts"], 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"] + 1, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 5)
+            # unknown
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            # invalid args
+            with self.assertRaises(ValueError):
+                q.complete("a", "", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 1, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], True)
+            # state unchanged, no recovery side effects on b (b still pending)
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.get("b"), before_b)
+            # invalid claim leaves expired unrecovered
+            with self.assertRaises(ValueError):
+                q.claim("", 10, 5)
+            self.assertEqual(q.get("a")["state"], "running")
+            # valid complete
+            v = q.complete("a", "w", c["attempts"], 1)
+            self.assertEqual(v["state"], "succeeded")
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 2)
+    def test_fail_retry_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c1["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            self.assertIsNone(v["worker"])
+            # not eligible before ready
+            self.assertIsNone(q.claim("w", 5, 10))
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a", "w", c2["attempts"], 7)
+            self.assertEqual(v2["state"], "failed")
+            self.assertIsNone(q.claim("w", 8, 10))
+            # older attempt rejected even same worker reclaimed scenario
+            q2 = Queue(Path(tmp) / "q2.db")
+            q2.submit([{"id": "x"}])
+            cx1 = q2.claim("w", 0, 5)
+            q2.recover(5)
+            cx2 = q2.claim("w", 5, 5)
+            self.assertEqual(cx2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q2.complete("x", "w", cx1["attempts"], 5 if 5 < 10 else 6)
+            # retry_delay bool rejected
+            with self.assertRaises(ValueError):
+                q2.fail("x", "w", cx2["attempts"], 6 if 6 < 10 else 6, retry_delay=True)
+
+class MultiprocessTests(unittest.TestCase):
+    def test_submit_survives_restart_separate_process(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "init"}])
+            ctx = multiprocessing.get_context("spawn")
+            p = ctx.Process(target=_mp_submit, args=(db, [{"id": "from-child", "payload": {"v": 1}}]))
+            p.start()
+            p.join(timeout=20)
+            self.assertEqual(p.exitcode, 0)
+            self.assertEqual(Queue(db).get("from-child")["payload"], {"v": 1})
+            self.assertIsNotNone(Queue(db).get("init"))
+    def test_concurrent_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            ctx = multiprocessing.get_context("spawn")
+            out = ctx.Queue()
+            p1 = ctx.Process(target=_mp_claim, args=(db, "w1", 0, 10, out))
+            p2 = ctx.Process(target=_mp_claim, args=(db, "w2", 0, 10, out))
+            p1.start()
+            p2.start()
+            p1.join(timeout=20)
+            p2.join(timeout=20)
+            self.assertEqual(p1.exitcode, 0)
+            self.assertEqual(p2.exitcode, 0)
+            results = []
+            while not out.empty():
+                results.append(out.get())
+            self.assertEqual(len(results), 2)
+            winners = [r for r in results if r[1] == "only"]
+            nones = [r for r in results if r[1] is None]
+            self.assertEqual(len(winners), 1)
+            self.assertEqual(len(nones), 1)
+            cur = Queue(db).get("only")
+            self.assertEqual(cur["state"], "running")
+            self.assertIn(cur["worker"], ("w1", "w2"))
+            self.assertEqual(cur["attempts"], 1)
+
+class CliTests(unittest.TestCase):
+    def test_cli_success_shapes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = _run_cli(db, {"op": "submit", "jobs": [{"id": "a", "priority": 2}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            val = json.loads(p.stdout)
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: check raw starts with [{"attempts"
+            self.assertIn('"attempts"', p.stdout)
+            p2 = _run_cli(db, {"op": "list"})
+            self.assertEqual(p2.returncode, 0)
+            self.assertTrue(p2.stdout.endswith("\n"))
+            p3 = _run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p3.returncode, 0)
+            p4 = _run_cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(p4.returncode, 0)
+            claimed = json.loads(p4.stdout)
+            self.assertEqual(claimed["id"], "a")
+            p5 = _run_cli(db, {"op": "complete", "id": "a", "worker": "w", "attempt": claimed["attempts"], "now": 1})
+            self.assertEqual(p5.returncode, 0)
+            p6 = _run_cli(db, {"op": "recover", "now": 20})
+            self.assertEqual(p6.returncode, 0)
+            self.assertEqual(json.loads(p6.stdout), [])
+    def test_cli_exit2_paths(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            # unknown op
+            p = _run_cli(db, {"op": "nope"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unknown field
+            p = _run_cli(db, {"op": "list", "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing field
+            p = _run_cli(db, {"op": "get"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # ValueError from API (bool)
+            p = _run_cli(db, {"op": "claim", "worker": "w", "now": True, "lease_seconds": 10})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # malformed json
+            p = _run_cli(db, req_text="{bad json")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # non-object
+            p = _run_cli(db, req_obj=[1, 2])
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid utf-8
+            p = _run_cli(db, raw_bytes=b"\xff\xfe bad")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(Path(tmp) / "missing.json")], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unavailable db (is directory)
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(Path(tmp)), "--request", str(Path(tmp) / "req.json")], capture_output=True, text=True)
+            # need a request file present; create one
+            (Path(tmp) / "req.json").write_text(json.dumps({"op": "list"}), encoding="utf-8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(Path(tmp)), "--request", str(Path(tmp) / "req.json")], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # prior committed work survives failure/restart
+            self.assertEqual(Queue(db).get("a")["id"], "a")
