+def _create_indexes(connection):
+    connection.execute(
+        "CREATE INDEX IF NOT EXISTS idx_jobs_state_ready ON jobs(state, ready_at)"
+    )
+    connection.execute(
+        "CREATE INDEX IF NOT EXISTS idx_jobs_state_prio_id ON jobs(state, priority DESC, id ASC)"
+    )
+    connection.execute(
+        "CREATE INDEX IF NOT EXISTS idx_jobs_lease ON jobs(state, lease_until)"
+    )
+
+
+def _migrate_old_schema(connection):
+    rows = list(connection.execute("SELECT id, data FROM jobs").fetchall())
+    connection.execute("DROP TABLE IF EXISTS jobs_new")
+    connection.execute(
+        """CREATE TABLE jobs_new (
+            id TEXT PRIMARY KEY,
+            spec TEXT NOT NULL,
+            payload TEXT NOT NULL,
+            priority INTEGER NOT NULL,
+            dependencies TEXT NOT NULL,
+            max_attempts INTEGER NOT NULL,
+            ready_at INTEGER NOT NULL,
+            state TEXT NOT NULL,
+            attempts INTEGER NOT NULL,
+            worker TEXT,
+            lease_until INTEGER
+        )"""
+    )
+    for (jid, data) in rows:
+        try:
+            view = json.loads(data)
+        except Exception:
+            continue
+        try:
+            jid2 = view.get("id", jid)
+            payload = view.get("payload", {})
+            priority = view.get("priority", 0)
+            dependencies = view.get("dependencies", [])
+            max_attempts = view.get("max_attempts", 3)
+            ready_at = view.get("ready_at", 0)
+            state = view.get("state", "pending")
+            attempts = view.get("attempts", 0)
+            worker = view.get("worker", None)
+            lease_until = view.get("lease_until", None)
+            if not isinstance(jid2, str) or jid2 == "":
+                jid2 = jid
+            if not isinstance(payload, dict):
+                payload = {}
+            try:
+                deps_norm = sorted(set(dependencies)) if isinstance(dependencies, list) else []
+            except Exception:
+                deps_norm = []
+            # Coerce ints defensively for legacy rows
+            if type(priority) is bool or not isinstance(priority, int):
+                try:
+                    priority = int(priority)
+                except Exception:
+                    priority = 0
+            if type(max_attempts) is bool or not isinstance(max_attempts, int):
+                max_attempts = 3
+            if type(ready_at) is bool or not isinstance(ready_at, int):
+                ready_at = 0
+            if type(attempts) is bool or not isinstance(attempts, int):
+                attempts = 0
+            if state not in ("pending", "running", "succeeded", "failed"):
+                state = "pending"
+            spec = {
+                "id": jid2,
+                "payload": payload,
+                "priority": priority,
+                "dependencies": deps_norm,
+                "max_attempts": max_attempts,
+                "ready_at": ready_at if type(ready_at) is int else 0,
+            }
+            connection.execute(
+                "INSERT INTO jobs_new (id, spec, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    jid2,
+                    json.dumps(spec, sort_keys=True, allow_nan=False),
+                    json.dumps(payload, sort_keys=True, allow_nan=False),
+                    priority,
+                    json.dumps(deps_norm, sort_keys=True, allow_nan=False),
+                    max_attempts,
+                    ready_at,
+                    state,
+                    attempts,
+                    worker,
+                    lease_until,
+                ),
+            )
+        except Exception:
+            continue
+    connection.execute("DROP TABLE jobs")
+    connection.execute("ALTER TABLE jobs_new RENAME TO jobs")
+    _create_indexes(connection)
+
+
+@contextmanager
+def immediate(connection):
+    """BEGIN IMMEDIATE transaction helper for atomic cross-process claims."""
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        yield connection
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    else:
+        connection.execute("COMMIT")
