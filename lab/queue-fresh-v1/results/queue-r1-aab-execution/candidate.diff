+    def test_two_processes_never_share_active_lease(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            Queue(db).submit([{"id": "only"}])
+            ctx = multiprocessing.get_context("spawn")
+            out_q = ctx.Queue()
+            p1 = ctx.Process(target=_claim_worker, args=(db, "w1", 0, 30, out_q))
+            p2 = ctx.Process(target=_claim_worker, args=(db, "w2", 0, 30, out_q))
+            p1.start()
+            p2.start()
+            p1.join(timeout=20)
+            p2.join(timeout=20)
+            self.assertEqual(p1.exitcode, 0)
+            self.assertEqual(p2.exitcode, 0)
+            results = [out_q.get(timeout=5), out_q.get(timeout=5)]
+            # exactly one claimant wins, other gets None
+            non_null = [r for r in results if r is not None and not (isinstance(r, tuple))]
+            nulls = [r for r in results if r is None]
+            self.assertEqual(len(non_null), 1)
+            self.assertEqual(len(nulls), 1)
+            winner = non_null[0]
+            # DB reflects winner's lease
+            cur = Queue(db).get("only")
+            self.assertEqual(cur["state"], "running")
+            self.assertEqual(cur["worker"], winner["worker"])
