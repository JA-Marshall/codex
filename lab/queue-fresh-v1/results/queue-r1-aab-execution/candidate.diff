+import copy
+import json
+import multiprocessing
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _tmpdb(tmp):
+    return str(Path(tmp) / "queue.db")
+
+
+def _claim_worker(db_path, worker, now, lease_seconds, queue_out):
+    try:
+        q = Queue(db_path)
+        v = q.claim(worker, now, lease_seconds)
+        queue_out.put(v)
+    except Exception as e:
+        queue_out.put(("ERR", repr(e)))
+
+
+class RegressionTests(unittest.TestCase):
+    def test_submit_rollback_on_invalid_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            before = q.list()
+            # batch with one valid + one invalid (unknown dep) must fully rollback
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "c", "dependencies": ["missing"]}])
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+            self.assertIsNone(q.get("b"))
+            self.assertIsNone(q.get("c"))
+            # duplicate within batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x"}, {"id": "x"}])
+            self.assertIsNone(q.get("x"))
+            # self dependency
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "s", "dependencies": ["s"]}])
+            self.assertIsNone(q.get("s"))
+            # cycle
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "p1", "dependencies": ["p2"]}, {"id": "p2", "dependencies": ["p1"]}])
+            self.assertIsNone(q.get("p1"))
+            # conflict on existing id rejects whole batch, no partial writes
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 99}, {"id": "brand-new"}])
+            self.assertIsNone(q.get("brand-new"))
+            self.assertEqual(q.get("a")["priority"], 0)
+            # invalid must not have performed recovery side-effects tested elsewhere
+            self.assertEqual(q.list(), before)
+
+    def test_submit_no_mutation_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}, {"id": "b"}])
+            orig = {"id": "m", "payload": {"x": [1, 2]}, "dependencies": ["b", "b", "a"], "priority": 1}
+            snapshot = copy.deepcopy(orig)
+            views = q.submit([orig])
+            self.assertEqual(orig, snapshot)
+            # dependencies normalized sorted unique
+            self.assertEqual(views[0]["dependencies"], ["a", "b"])
+            v = q.get("m")
+            v["payload"]["x"].append(99)
+            v["dependencies"].append("zzz")
+            v2 = q.get("m")
+            self.assertEqual(v2["payload"], {"x": [1, 2]})
+            self.assertEqual(v2["dependencies"], ["a", "b"])
+            # exact 10 keys
+            self.assertEqual(set(v2.keys()), {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"})
+
+    def test_idempotent_resubmit_after_state_change(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "j", "payload": {"k": 1}}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "j")
+            # resubmit same original spec while running -> idempotent, returns current view
+            v = q.submit([{"id": "j", "payload": {"k": 1}}])
+            self.assertEqual(v[0]["state"], "running")
+            self.assertEqual(v[0]["attempts"], 1)
+            q.complete("j", "w", 1, 5)
+            v2 = q.submit([{"id": "j", "payload": {"k": 1}}])
+            self.assertEqual(v2[0]["state"], "succeeded")
+
+    def test_stale_completion_rejected_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "s1"}])
+            c1 = q.claim("w1", 0, 5)
+            self.assertEqual(c1["attempts"], 1)
+            # wrong worker
+            with self.assertRaises(ValueError):
+                q.complete("s1", "other", 1, 1)
+            # stale attempt number
+            with self.assertRaises(ValueError):
+                q.complete("s1", "w1", 99, 1)
+            # expired lease: now == lease_until counts as expired
+            with self.assertRaises(ValueError):
+                q.complete("s1", "w1", 1, 5)
+            # job still running unchanged
+            cur = q.get("s1")
+            self.assertEqual(cur["state"], "running")
+            self.assertEqual(cur["worker"], "w1")
+            self.assertEqual(cur["attempts"], 1)
+            # recover then reclaim with same worker, old attempt must be rejected
+            rec = q.recover(5)
+            self.assertEqual(rec, ["s1"])
+            c2 = q.claim("w1", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("s1", "w1", 1, 6)
+            # correct attempt works
+            done = q.complete("s1", "w1", 2, 6)
+            self.assertEqual(done["state"], "succeeded")
+            # terminal cannot be completed/failed again
+            with self.assertRaises(ValueError):
+                q.complete("s1", "w1", 2, 6)
+            with self.assertRaises(ValueError):
+                q.fail("s1", "w1", 2, 6)
+
+    def test_bounded_retries_and_ready_at(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "r", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            self.assertEqual(c1["attempts"], 1)
+            f1 = q.fail("r", "w", 1, 5, retry_delay=7)
+            self.assertEqual(f1["state"], "pending")
+            self.assertEqual(f1["ready_at"], 12)
+            self.assertIsNone(f1["worker"])
+            self.assertIsNone(f1["lease_until"])
+            # not eligible before ready_at
+            self.assertIsNone(q.claim("w", 11, 10))
+            c2 = q.claim("w", 12, 10)
+            self.assertEqual(c2["attempts"], 2)
+            f2 = q.fail("r", "w", 2, 13, retry_delay=5)
+            self.assertEqual(f2["state"], "failed")
+            # failed leaves ready_at unchanged (was 12)
+            self.assertEqual(f2["ready_at"], 12)
+            self.assertIsNone(q.claim("w", 100, 10))
+            self.assertEqual(q.recover(1000), [])
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "max_attempts": 3}, {"id": "b", "max_attempts": 1}])
+            ca = q.claim("w", 0, 5)
+            self.assertEqual(ca["id"], "a")
+            # claim b at later now? a still active so b pending; need to complete a? Actually priority same, id order: a first. Claim b next.
+            cb = q.claim("w", 0, 5)
+            # both running with lease_until 5
+            self.assertEqual(cb["id"], "b")
+            rec = q.recover(5)
+            self.assertEqual(rec, ["a", "b"])
+            va = q.get("a")
+            vb = q.get("b")
+            self.assertEqual(va["state"], "pending")
+            self.assertEqual(va["ready_at"], 5)
+            self.assertIsNone(va["worker"])
+            self.assertEqual(vb["state"], "failed")
+            # repeated recovery no-op
+            self.assertEqual(q.recover(5), [])
+            self.assertEqual(q.recover(6), [])
+
+    def test_priority_order_and_failed_dep_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([
+                {"id": "low", "priority": 0},
