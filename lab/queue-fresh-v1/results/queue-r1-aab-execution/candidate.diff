+                qd.fail("base", "w", 1, 1)
+                self.assertEqual(qd.get("base")["state"], "failed")
+                self.assertIsNone(qd.claim("w", 10, 10))
+                self.assertEqual(qd.get("child")["state"], "pending")
+
+    def test_bool_rejected_and_validation_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
