+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad)],
+                               capture_output=True, text=True, timeout=30)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+
+    def test_cli_durability_and_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            r = self._cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(r.returncode, 0)
+            # invalid batch via CLI must not write
+            r = self._cli(db, {"op": "submit", "jobs": [{"id": "b"}, {"id": "c", "dependencies": ["missing"]}]})
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            r = self._cli(db, {"op": "list"})
+            self.assertEqual([v["id"] for v in json.loads(r.stdout)], ["a"])
+            # claim via CLI then complete via API fresh process
+            r = self._cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(r.returncode, 0)
+            claim = json.loads(r.stdout)
+            self.assertEqual(claim["id"], "a")
+            r = self._cli(db, {"op": "complete", "id": "a", "worker": "w", "attempt": claim["attempts"], "now": 1})
+            self.assertEqual(r.returncode, 0)
+            self.assertEqual(json.loads(r.stdout)["state"], "succeeded")
