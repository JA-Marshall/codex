+"""Shared SQLite storage helpers and strict validators."""
+import json
+import math
 import sqlite3
 
+VIEW_KEYS = ("id", "payload", "priority", "dependencies", "max_attempts",
+             "ready_at", "state", "attempts", "worker", "lease_until")
+
+SCHEMA_SQL = (
+    "CREATE TABLE IF NOT EXISTS jobs ("
+    "id TEXT PRIMARY KEY, "
+    "payload TEXT NOT NULL, "
+    "priority INTEGER NOT NULL, "
+    "dependencies TEXT NOT NULL, "
+    "max_attempts INTEGER NOT NULL, "
+    "ready_at INTEGER NOT NULL, "
+    "state TEXT NOT NULL, "
+    "attempts INTEGER NOT NULL, "
+    "worker TEXT, "
+    "lease_until INTEGER, "
+    "spec TEXT NOT NULL"
+    ")"
+)
+
+
+def is_strict_int(v):
+    return type(v) is int
+
+
+def check_id(v):
+    if not isinstance(v, str) or v == "":
+        raise ValueError("invalid id")
+    return v
+
+
+def check_worker(v):
+    if not isinstance(v, str) or v == "":
+        raise ValueError("invalid worker")
+    return v
+
+
+def check_now(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid now")
+    return v
+
+
+def check_lease_seconds(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("invalid lease_seconds")
+    return v
+
+
+def check_retry_delay(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid retry_delay")
+    return v
+
+
+def check_attempt(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("invalid attempt")
+    return v
+
+
+def check_priority(v):
+    if type(v) is not int:
+        raise ValueError("invalid priority")
+    return v
+
+
+def check_max_attempts(v):
+    if type(v) is not int or not (1 <= v <= 100):
+        raise ValueError("invalid max_attempts")
+    return v
+
+
+def check_ready_at(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid ready_at")
+    return v
+
+
+def _check_json_value(v):
+    if v is None:
+        return
+    if isinstance(v, bool):
+        return
+    if type(v) is int:
+        return
+    if isinstance(v, float):
+        if not math.isfinite(v):
+            raise ValueError("non-finite payload number")
+        return
+    if isinstance(v, str):
+        return
+    if isinstance(v, list):
+        for item in v:
+            _check_json_value(item)
+        return
+    if isinstance(v, dict):
+        for k, item in v.items():
+            if not isinstance(k, str):
+                raise ValueError("invalid payload key")
+            _check_json_value(item)
+        return
+    raise ValueError("invalid payload value")
+
+
+def check_payload(v):
+    if not isinstance(v, dict):
+        raise ValueError("invalid payload")
+    _check_json_value(v)
+    return v
+
+
+def normalize_dependencies(v):
+    if not isinstance(v, list):
+        raise ValueError("invalid dependencies")
+    for item in v:
+        if not isinstance(item, str) or item == "":
+            raise ValueError("invalid dependency")
+    return sorted(set(v))
+
+
+def row_to_view(row):
+    # row: (id, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until)
+    jid, payload_s, priority, deps_s, max_attempts, ready_at, state, attempts, worker, lease_until = row
+    return {
+        "id": jid,
+        "payload": json.loads(payload_s),
+        "priority": priority,
+        "dependencies": json.loads(deps_s),
+        "max_attempts": max_attempts,
+        "ready_at": ready_at,
+        "state": state,
+        "attempts": attempts,
+        "worker": worker,
+        "lease_until": lease_until,
+    }
+
+
+def _ensure_schema(conn):
+    info = conn.execute("PRAGMA table_info(jobs)").fetchall()
+    if not info:
+        conn.execute(SCHEMA_SQL)
+        return
+    cols = {r[1] for r in info}
+    if cols == {"id", "data"}:
+        # Migrate legacy single-JSON table, preserving jobs.
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS jobs_new ("
+            "id TEXT PRIMARY KEY, "
+            "payload TEXT NOT NULL, "
+            "priority INTEGER NOT NULL, "
+            "dependencies TEXT NOT NULL, "
+            "max_attempts INTEGER NOT NULL, "
+            "ready_at INTEGER NOT NULL, "
+            "state TEXT NOT NULL, "
+            "attempts INTEGER NOT NULL, "
+            "worker TEXT, "
+            "lease_until INTEGER, "
+            "spec TEXT NOT NULL"
+            ")"
+        )
+        for (oid, data) in conn.execute("SELECT id, data FROM jobs").fetchall():
+            try:
+                view = json.loads(data)
+            except Exception:
+                continue
+            try:
+                payload = view.get("payload", {})
+                if not isinstance(payload, dict):
+                    payload = {}
+                # validate finite? keep as-is if possible
+                try:
+                    check_payload(payload)
+                except ValueError:
+                    payload = {}
+                priority = view.get("priority", 0)
+                if type(priority) is not int:
+                    priority = 0
+                deps = view.get("dependencies", [])
+                try:
+                    deps = normalize_dependencies(deps) if isinstance(deps, list) else []
+                except ValueError:
