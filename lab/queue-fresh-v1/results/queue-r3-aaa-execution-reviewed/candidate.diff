+import copy
+import json
+import multiprocessing as mp
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+EXPECTED_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+def _tmpdb(tmp):
+    return str(Path(tmp) / "q.sqlite")
+
+def _claim_worker(args):
+    db, worker, now, lease = args
+    q = Queue(db)
+    v = q.claim(worker, now, lease)
+    return (worker, v["id"] if v else None, v["attempts"] if v else None)
+
+def _durability_child(args):
+    dbp, out_q = args
+    out_q.put(Queue(dbp).get("a"))
+
+def _cli(db, req):
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+        json.dump(req, f)
+        p = f.name
+    # read file then remove via python to avoid shell rm
+    import os
+    try:
+        r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", p], capture_output=True, text=True, timeout=30)
+    finally:
+        try:
+            os.unlink(p)
+        except Exception:
+            pass
+    return r
+
+
+class RegressionTests(unittest.TestCase):
+    def test_rollback_atomic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "bad", "priority": True}])
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+            self.assertIsNone(q.get("b"))
+            # duplicate in batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c"}, {"id": "c"}])
+            self.assertIsNone(q.get("c"))
+            # unknown dep
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "d", "dependencies": ["missing"]}])
+            self.assertIsNone(q.get("d"))
+            # self dep
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "e", "dependencies": ["e"]}])
+            # cycle
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "dependencies": ["y"]}, {"id": "y", "dependencies": ["x"]}])
+            self.assertIsNone(q.get("x"))
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+            self.assertEqual(q.list(), before)
+
+    def test_rollback_no_recovery_side_effect(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # invalid submit must not recover expired lease
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "bad", "priority": "x"}])
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["worker"], "w")
+            # invalid claim must not recover either
+            with self.assertRaises(ValueError):
+                q.claim("", 20, 10)
+            self.assertEqual(q.get("a")["state"], "running")
+            # valid recover does recover
+            self.assertEqual(q.recover(10), ["a"])
+            self.assertEqual(q.get("a")["state"], "pending")
+
+    def test_idempotent_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "payload": {"x": 1}, "priority": 5, "dependencies": [], "max_attempts": 3, "ready_at": 0}])
+            # exact resubmit idempotent
+            v = q.submit([{"id": "a", "payload": {"x": 1}, "priority": 5, "max_attempts": 3, "ready_at": 0}])
+            self.assertEqual(v[0]["state"], "pending")
+            # normalized deps idempotent (unsorted/dup input normalized)
+            q.submit([{"id": "p"}, {"id": "qq"}])
+            q.submit([{"id": "r", "dependencies": ["qq", "p", "p"]}])
+            v2 = q.submit([{"id": "r", "dependencies": ["p", "qq"]}])
+            self.assertEqual(v2[0]["dependencies"], ["p", "qq"])
+            # idempotent even after state change
+            c = q.claim("w", 0, 10)
+            # claim picks highest priority: a(5) first
+            self.assertEqual(c["id"], "a")
+            v3 = q.submit([{"id": "a", "payload": {"x": 1}, "priority": 5}])
+            self.assertEqual(v3[0]["state"], "running")
+            self.assertEqual(v3[0]["attempts"], 1)
+            # conflict rejects batch and leaves DB unchanged
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": 2}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "new-ok"}, {"id": "a", "payload": {"x": 99}}])
+            self.assertIsNone(q.get("new-ok"))
+            self.assertEqual(q.get("a")["payload"], {"x": 1})
+
+    def test_validation_strict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            # bool is not int
+            for bad in [{"id": "a", "priority": True}, {"id": "a", "max_attempts": True}, {"id": "a", "ready_at": True}, {"id": "a", "ready_at": False}]:
+                with self.assertRaises(ValueError, msg=bad):
+                    q.submit([bad])
+            # non-finite payload
+            for badpayload in [{"nan": float("nan")}, {"inf": float("inf")}, {"ninf": float("-inf")}]:
+                with self.assertRaises(ValueError):
+                    q.submit([{"id": "a", "payload": badpayload}])
+            # nested non-finite
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": [1, float("nan")]}}])
+            # unknown field
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "extra": 1}])
+            # empty id, bad types
+            with self.assertRaises(ValueError):
+                q.submit([{"id": ""}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": 123}])
+            with self.assertRaises(ValueError):
+                q.submit("notalist")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": "x"}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(-1)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            self.assertEqual(q.list(), [])
+
+    def test_no_mutation_detached_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            inp = [{"id": "b", "payload": {"x": [1, 2]}, "dependencies": ["a", "a"]}, {"id": "a"}]
+            snapshot = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, snapshot)
+            # deps normalized sorted unique
+            self.assertEqual(views[0]["dependencies"], ["a"])
+            # detached: mutate returned view, DB unaffected
+            views[0]["payload"]["x"].append(99)
+            views[0]["dependencies"].append("zzz")
+            self.assertEqual(q.get("b")["payload"], {"x": [1, 2]})
+            self.assertEqual(q.get("b")["dependencies"], ["a"])
+            # exactly 10 keys
+            for v in q.list():
+                self.assertEqual(set(v.keys()), EXPECTED_KEYS)
+            # list sorted by id
+            self.assertEqual([v["id"] for v in q.list()], ["a", "b"])
+            # get detached
+            g = q.get("a")
+            g["payload"]["new"] = 1
+            self.assertEqual(q.get("a")["payload"], {})
+
+    def test_ordering_priority_lex(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "b", "priority": 0}, {"id": "a", "priority": 0}, {"id": "c", "priority": 10}])
+            c1 = q.claim("w", 0, 10)
+            self.assertEqual(c1["id"], "c")
+            q.complete("c", "w", c1["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "a")
+            q.complete("a", "w", c2["attempts"], 2)
+            c3 = q.claim("w", 2, 10)
+            self.assertEqual(c3["id"], "b")
+
+    def test_eligibility_ready_attempts(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "future", "ready_at": 100}, {"id": "now"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "now")
+            q.complete("now", "w", c["attempts"], 1)
+            self.assertIsNone(q.claim("w", 1, 10))
+            # ready_at gating after fail retry_delay
+            q.submit([{"id": "r", "max_attempts": 3}])
+            cr = q.claim("w", 1, 10)
+            self.assertEqual(cr["id"], "r")
+            q.fail("r", "w", cr["attempts"], 2, retry_delay=10)
+            self.assertEqual(q.get("r")["ready_at"], 12)
+            self.assertIsNone(q.claim("w", 5, 10))
+            crr = q.claim("w", 12, 10)
+            self.assertEqual(crr["id"], "r")
+
+    def test_expiry_retry_limit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 5)
+            self.assertEqual(c1["attempts"], 1)
+            # not expired yet
+            self.assertEqual(q.recover(4), [])
+            self.assertEqual(q.recover(5), ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # repeated recovery no-op
+            self.assertEqual(q.recover(5), [])
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            # expire when attempts == max -> failed, ready_at unchanged (5? actually ready_at was 5, lease 10)
+            # c2 lease_until = 10
+            self.assertEqual(q.recover(10), ["a"])
+            vf = q.get("a")
+            self.assertEqual(vf["state"], "failed")
+            self.assertEqual(vf["ready_at"], 5)
+            self.assertIsNone(q.claim("w", 11, 5))
+            # fail path to failed
+            q.submit([{"id": "b", "max_attempts": 1}])
+            cb = q.claim("w", 0, 10)
+            fb = q.fail("b", "w", cb["attempts"], 1)
+            self.assertEqual(fb["state"], "failed")
+
+    def test_stale_owner_rejection(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 10)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w2", c["attempts"], 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c["attempts"], 10)
+            # stale attempt type / wrong attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c["attempts"] + 1, 1)
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w1", 1, 1)
+            # invalid retry_delay bool
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c["attempts"], 1, retry_delay=True)
+            # state unchanged after failures (no recovery side-effect)
+            self.assertEqual(q.get("a")["state"], "running")
+            # expire then reclaim same worker, old attempt rejected
+            self.assertEqual(q.recover(10), ["a"])
+            c2 = q.claim("w1", 10, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 11)
+            # correct new attempt works
+            q.complete("a", "w1", 2, 11)
+            self.assertEqual(q.get("a")["state"], "succeeded")
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 2, 11)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 2, 11)
+            self.assertIsNone(q.claim("w1", 11, 10))
+
+    def test_failed_dep_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "dep")
+            q.fail("dep", "w", c["attempts"], 1)
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertEqual(q.get("child")["state"], "pending")
+            self.assertIsNone(q.claim("w", 1, 10))
+            # child stays pending, not auto-failed
+            self.assertEqual(q.get("child")["state"], "pending")
+
+    def test_multiprocess_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            Queue(db).submit([{"id": "a", "payload": {"n": 1}}])
+            ctx = mp.get_context("spawn")
+            out = ctx.Queue()
+            p = ctx.Process(target=_durability_child, args=((db, out),))
+            p.start()
+            p.join(timeout=30)
+            self.assertEqual(p.exitcode, 0)
+            got = out.get(timeout=10)
+            self.assertEqual(got["payload"], {"n": 1})
+
+    def test_concurrent_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            Queue(db).submit([{"id": "solo"}])
+            ctx = mp.get_context("spawn")
+            with ctx.Pool(8) as pool:
+                results = pool.map(_claim_worker, [(db, f"w{i}", 0, 10) for i in range(8)])
+            winners = [r for r in results if r[1] is not None]
+            self.assertEqual(len(winners), 1)
+            # reopen shows single running lease
+            v = Queue(db).get("solo")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["attempts"], 1)
+
+    def test_cli_durability_and_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "cli.sqlite")
+            r = _cli(db, {"op": "submit", "jobs": [{"id": "a"}, {"id": "b"}]})
+            self.assertEqual(r.returncode, 0, r.stderr)
+            out = json.loads(r.stdout)
+            self.assertEqual(len(out), 2)
+            self.assertTrue(r.stdout.endswith("\n"))
+            # sorted keys check: first line object keys sorted
+            r2 = _cli(db, {"op": "list"})
+            self.assertEqual(r2.returncode, 0)
+            lst = json.loads(r2.stdout)
+            self.assertEqual([v["id"] for v in lst], ["a", "b"])
+            # claim via CLI persists
+            r3 = _cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(r3.returncode, 0)
+            claimed = json.loads(r3.stdout)
+            self.assertIn(claimed["id"], ("a", "b"))
+            # second claim gets other job (both pending, lex smallest first)
+            r4 = _cli(db, {"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 10})
+            self.assertEqual(r4.returncode, 0)
+            claimed2 = json.loads(r4.stdout)
+            self.assertNotEqual(claimed["id"], claimed2["id"])
+            # third claim null (no eligible)
+            r5 = _cli(db, {"op": "claim", "worker": "w3", "now": 0, "lease_seconds": 10})
+            self.assertEqual(r5.returncode, 0)
+            self.assertIsNone(json.loads(r5.stdout))
+
+    def test_cli_errors_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "e.sqlite")
