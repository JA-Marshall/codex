+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def make_queue(tmpdir):
+    return Queue(Path(tmpdir) / "queue.db")
+
+
+class SubmitValidationTests(unittest.TestCase):
+    def test_s1_rejects_bool_and_unknown_and_dup(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": True}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "foo": 1}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            self.assertEqual(q.list(), [])
+
+    def test_s1_normalizes_no_mutate_idempotent_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "b"}, {"id": "c"}])
+            orig_deps = ["c", "b", "b"]
+            inp = [{"id": "a", "dependencies": list(orig_deps)}]
+            q.submit(inp)
+            self.assertEqual(inp[0]["dependencies"], ["c", "b", "b"])
+            v = q.get("a")
+            self.assertEqual(v["dependencies"], ["b", "c"])
+            v2 = q.submit([{"id": "a", "dependencies": ["b", "c"]}])
+            self.assertEqual(v2[0]["dependencies"], ["b", "c"])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 5}, {"id": "new"}])
+            self.assertIsNone(q.get("new"))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x"}, {"id": "y", "dependencies": ["missing"]}])
+            self.assertIsNone(q.get("x"))
+            self.assertIsNone(q.get("y"))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "s", "dependencies": ["s"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "p", "dependencies": ["q"]}, {"id": "q", "dependencies": ["p"]}])
+
+    def test_s1_finite_json_and_types(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"v": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "", "payload": {}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": 0}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            self.assertEqual(q.list(), [])
+
