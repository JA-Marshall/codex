+        )
+        # Migrate legacy single-blob table (data only) to data+spec.
+        cols = [row[1] for row in connection.execute("PRAGMA table_info(jobs)").fetchall()]
+        if cols == ["id", "data"]:
+            connection.execute("ALTER TABLE jobs ADD COLUMN spec TEXT NOT NULL DEFAULT '{}'")
