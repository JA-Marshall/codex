+class CLITests(unittest.TestCase):
+    def _run_cli(self, db, req_obj=None, raw_bytes=None):
+        # writes request file then runs CLI as fresh process; returns (rc, stdout, stderr)
+        with tempfile.TemporaryDirectory() as tmp2:
+            # db is path string outside; req file in tmp2
+            req_path = Path(tmp2) / "req.json"
+            if raw_bytes is not None:
+                req_path.write_bytes(raw_bytes)
+            else:
+                req_path.write_text(json.dumps(req_obj), encoding="utf-8")
+            proc = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req_path)], capture_output=True, text=True)
+            return proc.returncode, proc.stdout, proc.stderr
+
+    def test_s4_cli_success_sorted_and_persists(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            rc, out, err = self._run_cli(db, {"op": "submit", "jobs": [{"id": "b"}, {"id": "a"}]})
+            self.assertEqual(rc, 0)
+            self.assertTrue(out.endswith("\n"))
+            self.assertEqual(out.count("\n"), 1)
+            val = json.loads(out)
+            self.assertIsInstance(val, list)
+            # sorted keys check: raw output must have sorted keys
+            self.assertEqual(out, json.dumps(val, sort_keys=True) + "\n")
+            # persists across restarts
+            rc2, out2, _ = self._run_cli(db, {"op": "list"})
+            self.assertEqual(rc2, 0)
+            self.assertEqual([v["id"] for v in json.loads(out2)], ["a", "b"])
+            # claim via CLI
+            rc3, out3, _ = self._run_cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(rc3, 0)
+            self.assertEqual(json.loads(out3)["id"], "a")
+
+    def test_s4_cli_failures_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # need existing db file for some tests; create via valid submit
+            rc, out, _ = self._run_cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(rc, 0)
+            cases = [
+                {"op": "nope"},
+                {"op": "submit", "jobs": [{"id": "a"}], "extra": 1},
+                {"op": "get", "id": "a", "extra": 1},
+                {"op": "submit", "jobs": [{"id": ""}]},
+                {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10},
+                {"op": "get"},
+                {"jobs": [{"id": "x"}]},
+                [1, 2, 3],
+                None,
+                {"op": "list", "extra": 1},
+                {"op": "complete", "id": "a", "worker": "w", "attempt": 1, "now": 0},
+            ]
+            for c in cases:
+                rc, out, _ = self._run_cli(db, c)
+                self.assertEqual(rc, 2, msg=f"case {c!r} rc={rc} out={out!r}")
+                self.assertEqual(out, "", msg=f"case {c!r}")
+            # malformed JSON
+            rc, out, _ = self._run_cli(db, raw_bytes=b"{not json")
+            self.assertEqual(rc, 2)
+            self.assertEqual(out, "")
+            # invalid utf-8
+            rc, out, _ = self._run_cli(db, raw_bytes=b"\xff\xfe")
+            self.assertEqual(rc, 2)
+            self.assertEqual(out, "")
+            # missing file
+            proc = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(Path(tmp) / "nope.json")], capture_output=True, text=True)
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, "")
+            # unavailable database (directory as db path)
+            proc2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(Path(tmp)), "--request", str(Path(tmp) / "x.json")], capture_output=True, text=True)
+            # need a request file for db-error case; create one
+            req = Path(tmp) / "x.json"
+            req.write_text(json.dumps({"op": "list"}), encoding="utf-8")
+            proc2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(Path(tmp)), "--request", str(req)], capture_output=True, text=True)
+            self.assertEqual(proc2.returncode, 2)
+            self.assertEqual(proc2.stdout, "")
+
+    def test_s4_cli_batch_rollback_and_lease_via_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            rc, out, _ = self._run_cli(db, {"op": "submit", "jobs": [{"id": "ok"}]})
+            self.assertEqual(rc, 0)
+            # invalid batch must roll back
+            rc, out, _ = self._run_cli(db, {"op": "submit", "jobs": [{"id": "new1"}, {"id": "bad", "dependencies": ["missing"]}]})
+            self.assertEqual(rc, 2)
+            self.assertEqual(out, "")
+            rc, out, _ = self._run_cli(db, {"op": "get", "id": "new1"})
+            self.assertEqual(rc, 0)
+            self.assertIsNone(json.loads(out))
+            # lease expiry via CLI recover
+            rc, out, _ = self._run_cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 5})
+            self.assertEqual(rc, 0)
+            claimed = json.loads(out)
+            self.assertEqual(claimed["id"], "ok")
+            rc, out, _ = self._run_cli(db, {"op": "recover", "now": 5})
+            self.assertEqual(rc, 0)
+            self.assertEqual(json.loads(out), ["ok"])
+
+if __name__ == "__main__":
