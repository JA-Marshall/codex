+class ClaimRecoverTests(unittest.TestCase):
+    def test_s2_priority_lex_order_and_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([
+                {"id": "a", "priority": 1},
+                {"id": "b", "priority": 5},
+                {"id": "c", "priority": 5},
+                {"id": "late", "priority": 10, "ready_at": 100},
+            ])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "b")
+            self.assertEqual(c["attempts"], 1)
+            self.assertEqual(c["state"], "running")
+            c2 = q.claim("w2", 0, 10)
+            self.assertEqual(c2["id"], "c")
+            self.assertNotEqual(c2["id"], "late")
+
+    def test_s2_dependency_failed_stays_pending_via_exhaust(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "main", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "dep")
+            # exhaust via expiry -> failed (attempts 1 == max 1)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["dep"])
+            self.assertEqual(q.get("dep")["state"], "failed")
+            # main stays pending/ineligible
+            self.assertIsNone(q.claim("w", 5, 5))
+            self.assertEqual(q.get("main")["state"], "pending")
+
+    def test_s2_recover_resets_or_fails(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "j", "max_attempts": 2}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["lease_until"], 5)
+            self.assertEqual(q.recover(4), [])
+            self.assertEqual(q.get("j")["state"], "running")
+            ids = q.recover(5)
+            self.assertEqual(ids, ["j"])
+            v = q.get("j")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(q.recover(5), [])
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            # expire again -> now attempts(2) == max(2) => failed
+            ids2 = q.recover(10)
+            self.assertEqual(ids2, ["j"])
+            self.assertEqual(q.get("j")["state"], "failed")
+            # ready_at unchanged on failed path (still 5)
+            self.assertEqual(q.get("j")["ready_at"], 5)
+
+    def test_s2_claim_recovers_expired_and_validates(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c = q.claim("w1", 0, 5)
+            self.assertEqual(c["id"], "a")
+            with self.assertRaises(ValueError):
+                q.claim("", 5, 5)
+            self.assertEqual(q.get("a")["state"], "running")
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 5)
+            self.assertEqual(q.get("a")["state"], "running")
+            c2 = q.claim("w2", 5, 5)
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["attempts"], 2)
+
+    def test_s2_multiprocess_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "queue.db")
+            q = Queue(db)
+            q.submit([{"id": f"job-{i:02d}"} for i in range(5)])
+            script = (
+                "import sys; from durable_queue import Queue; "
+                "q=Queue(sys.argv[1]); "
+                "c=q.claim('w-'+sys.argv[2], 0, 100); "
+                "print(c['id'] if c else 'NONE')"
+            )
+            procs = [subprocess.Popen([sys.executable, "-c", script, db, str(i)], stdout=subprocess.PIPE, text=True) for i in range(5)]
+            outs = sorted([p.communicate()[0].strip() for p in procs])
+            self.assertEqual(len(set(outs)), 5)
+            self.assertNotIn("NONE", outs)
+
+    def test_s2_durability_across_reopen(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "queue.db"
+            Queue(db).submit([{"id": "a"}, {"id": "b"}])
+            c = Queue(db).claim("w", 0, 10)
+            self.assertIsNotNone(c)
+            v = Queue(db).get(c["id"])
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["worker"], "w")
+
