+        # argparse exits 2 on invalid usage; ensure empty stdout (it uses stderr).
+        # Re-raise to preserve exit code 2.
+        raise
+    # Read request file as UTF-8 strict.
+    try:
+        with open(args.request, "r", encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+    except Exception:
+        return _fail()
+    try:
+        request = json.loads(text)
+    except Exception:
+        return _fail()
+    if type(request) is not dict:
+        return _fail()
+    if "op" not in request:
+        return _fail()
+    op = request["op"]
+    if type(op) is not str or op not in _OPS_REQUIRED:
