+class FinishTests(unittest.TestCase):
+    def test_s3_complete_success_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            v = q.complete("a", "w", c["attempts"], 5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # terminal cannot be completed/failed/claimed again
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 6)
+            self.assertIsNone(q.claim("w", 6, 10))
+
+    def test_s3_fail_retry_and_exhaust(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 2, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 7)
+            self.assertIsNone(v["worker"])
+            # not ready yet
+            self.assertIsNone(q.claim("w", 6, 10))
+            c2 = q.claim("w", 7, 10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a", "w", c2["attempts"], 8)
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 7)
+
+    def test_s3_stale_wrongowner_expired_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 5)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c["attempts"], 1)
+            self.assertEqual(q.get("a")["state"], "running")
+            # stale attempt after reclaim
+            q.recover(5)
+            c2 = q.claim("w1", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 6)
+            self.assertEqual(q.get("a")["attempts"], 2)
+            self.assertEqual(q.get("a")["state"], "running")
+            # expired: now == lease_until invalid (need now < lease_until)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 2, 10)
+            # failed validation must not have recovered: still running
+            self.assertEqual(q.get("a")["state"], "running")
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            # invalid args no write
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 2, 6, retry_delay=True)
+            self.assertEqual(q.get("a")["state"], "running")
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 2, True)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_s3_attempts_never_exceed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["attempts"], 1)
+            q.complete("a", "w", 1, 1)
+            self.assertEqual(q.get("a")["attempts"], 1)
+            self.assertIsNone(q.claim("w", 1, 10))
+
