--- /dev/null
+++ b/tests/test_processes.py
@@ -0,0 +1,75 @@
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from durable_queue import Queue
+class ProcessDurability(unittest.TestCase):
+    def test_reopen_preserves(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a", "payload": {"n": 1}}, {"id": "b"}])
+            q2 = Queue(db)
+            self.assertEqual(len(q2.list()), 2)
+            self.assertEqual(q2.get("a")["payload"], {"n": 1})
+            c = q2.claim("w", 0, 10)
+            self.assertIsNotNone(c)
+            q3 = Queue(db)
+            self.assertEqual(q3.get(c["id"])["state"], "running")
+            q3.complete(c["id"], "w", c["attempts"], 1)
+            self.assertEqual(Queue(db).get(c["id"])["state"], "succeeded")
+    def test_concurrent_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "solo"}])
+            code = "import sys, json; from durable_queue import Queue; q=Queue(sys.argv[1]); c=q.claim(sys.argv[2], 0, 30); print(json.dumps(c, sort_keys=True) if c else 'null')"
+            procs = [subprocess.Popen([sys.executable, "-c", code, db, f"w{i}"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) for i in range(6)]
+            outs = []
+            for p in procs:
+                out, err = p.communicate(timeout=20)
+                self.assertEqual(p.returncode, 0, msg=err)
+                outs.append(out.strip())
+            wins = [o for o in outs if o != "null"]
+            self.assertEqual(len(wins), 1, msg=str(outs))
+            winner = json.loads(wins[0])
+            self.assertEqual(winner["id"], "solo")
+            self.assertEqual(winner["attempts"], 1)
+            # all losers got null, DB shows running with winner worker
