+                p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True)
+                return p
+            p = call({"op": "submit", "jobs": [{"id": "a"}, {"id": "b", "dependencies": ["a"]}]})
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            p = call({"op": "list"})
+            self.assertEqual(p.returncode, 0)
+            val = json.loads(p.stdout)
+            self.assertEqual(sorted([v["id"] for v in val]), ["a", "b"])
+            p = call({"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(p.returncode, 0)
+            claimed = json.loads(p.stdout)
+            self.assertEqual(claimed["id"], "a")
+            # prior committed work survives failing request
+            p = call({"op": "claim", "worker": "", "now": 0, "lease_seconds": 10})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            p = call({"op": "get", "id": "a"})
+            self.assertEqual(p.returncode, 0)
+            self.assertEqual(json.loads(p.stdout)["state"], "running")
+            # complete via fresh process
+            p = call({"op": "complete", "id": "a", "worker": "w", "attempt": claimed["attempts"], "now": 1})
+            self.assertEqual(p.returncode, 0)
+            p = call({"op": "claim", "worker": "w", "now": 1, "lease_seconds": 10})
+            self.assertEqual(p.returncode, 0)
+            self.assertEqual(json.loads(p.stdout)["id"], "b")
