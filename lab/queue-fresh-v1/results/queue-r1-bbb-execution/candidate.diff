+            cc = q.claim("w", 0, 5)
+            _ = q.get(cc["id"])
+            # still running, not recovered
+            self.assertEqual(q.get(cc["id"])["state"], "running")
+class ClaimRecover(unittest.TestCase):
+    def test_priority_order_and_dep_gate(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 10}, {"id": "mid", "priority": 10}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            c2 = q.claim("w", 0, 10)
+            self.assertEqual(c2["id"], "mid")
+    def test_failed_dep_stays_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "base", "max_attempts": 1}, {"id": "child", "dependencies": ["base"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "base")
+            q.fail("base", "w", c["attempts"], 1)
+            self.assertEqual(q.get("base")["state"], "failed")
+            self.assertIsNone(q.claim("w", 2, 10))
+            self.assertEqual(q.get("child")["state"], "pending")
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "j"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(q.recover(4), [])
+            self.assertEqual(q.recover(5), ["j"])
+            v = q.get("j")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["attempts"], 1)
+            self.assertEqual(q.recover(5), [])
+            # exhaustion leaves ready_at unchanged
+            q.submit([{"id": "e", "max_attempts": 1}])
+            ce = q.claim("w", 0, 5)
+            # make ready_at distinct then exhaust via recover
+            rec = q.recover(5)
+            self.assertIn("e", rec)
+            ve = q.get("e")
+            self.assertEqual(ve["state"], "failed")
+            self.assertEqual(ve["ready_at"], 0)
+    def test_claim_invalid_leaves_db_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
