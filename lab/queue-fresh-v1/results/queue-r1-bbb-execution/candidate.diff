+from durable_queue import Queue
+def tmp_queue(tmp):
+    return Queue(Path(tmp) / "q.db")
+class SubmitValidation(unittest.TestCase):
+    def test_unknown_field_rejects_and_rolls_back(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "c", "bogus": 1}])
+            self.assertIsNone(q.get("b"))
+            self.assertIsNone(q.get("c"))
+            self.assertIsNotNone(q.get("a"))
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            for bad in [{"id": "x", "priority": True}, {"id": "y", "max_attempts": False}, {"id": "z", "ready_at": True}]:
+                with self.assertRaises(ValueError):
+                    q.submit([bad])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+    def test_payload_finite_only(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"v": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"v": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": [1, 2, set([3])]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": "notobj"}])
+    def test_duplicate_cycle_unknown_self(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+    def test_idempotent_same_spec_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            v1 = q.submit([{"id": "a", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            v2 = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(v2[0]["state"], "running")
+            self.assertEqual(v2[0]["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            # ready_at change via fail still idempotent on original spec
+            q2 = tmp_queue(tmp)
+            # use fresh queue to fail after recovery? need to recover first
+            # complete with correct lease
+            q.complete("a", "w", c["attempts"], 1)
+            v3 = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(v3[0]["state"], "succeeded")
+    def test_no_input_mutation_and_view_shape(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            src = [{"id": "a", "payload": {"x": [1]}, "dependencies": ["b", "b"]}, {"id": "b"}]
+            frozen = copy.deepcopy(src)
+            views = q.submit(src)
+            self.assertEqual(src, frozen)
+            v = views[0]
+            self.assertEqual(set(v.keys()), set(["id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"]))
+            self.assertEqual(v["dependencies"], ["b"])
+            self.assertEqual(v["state"], "pending")
+            # detached
+            v["payload"]["x"].append(99)
+            self.assertNotEqual(q.get("a")["payload"], v["payload"])
+            # list sorted
