+from durable_queue import Queue
+def run_cli(db, req_obj=None, raw=None, req_path=None):
+    # helper: write req then run cli, return CompletedProcess
+    import tempfile as tf
+    import os
+    if req_path is None:
+        # create temp file in same tmp dir as db parent
+        tmpdir = str(Path(str(db)).parent)
+        fd, rp = tf.mkstemp(dir=tmpdir, suffix=".json")
+        os.close(fd)
+        req_path = Path(rp)
+        if raw is not None:
+            req_path.write_bytes(raw)
+        else:
+            req_path.write_text(json.dumps(req_obj), encoding="utf-8")
+    r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req_path)], capture_output=True, text=True, cwd=".")
+    return r
