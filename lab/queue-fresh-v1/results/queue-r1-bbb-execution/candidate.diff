+            r8 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req_file("c.json", {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10}))], capture_output=True, text=True, cwd=".")
+            self.assertEqual(r8.returncode, 0)
+            self.assertTrue(r8.stdout.endswith("\n"))
+    def test_cli_durability_survives_failure(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            tmp_p = Path(tmp)
+            def cli(obj):
+                p = tmp_p / "req.json"
+                p.write_text(json.dumps(obj), encoding="utf-8")
