+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA synchronous=NORMAL;")
+    except Exception:
+        pass
+    # Detect legacy schema (id,data) and migrate by recreating
+    existing = None
+    try:
+        rows = connection.execute("PRAGMA table_info(jobs)").fetchall()
+        if rows:
+            existing = {r[1] for r in rows}
+    except Exception:
+        existing = None
+    if existing is not None and existing != EXPECTED_COLUMNS:
+        # Legacy or unknown schema: drop and recreate (no valid contract DBs exist yet)
+        connection.execute("DROP TABLE IF EXISTS jobs")
+        existing = None
+    if existing is None or not existing:
+        connection.execute(SCHEMA)
+    else:
+        connection.execute(SCHEMA)
     return connection
