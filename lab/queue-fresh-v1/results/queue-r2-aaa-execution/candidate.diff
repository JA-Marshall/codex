+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on invalid usage; ensure stdout empty (it uses stderr)
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            request = json.load(stream)
+        if not isinstance(request, dict):
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if op not in _OPS:
+            raise ValueError("unknown op")
+        allowed = _ALLOWED[op]
+        required = _REQUIRED[op]
+        keys = set(request.keys()) - {"op"}
+        # No unknown fields
+        for k in keys:
+            if k not in allowed:
+                raise ValueError("unknown field")
+        for k in required:
+            if k not in request:
+                raise ValueError("missing field")
+        kwargs = {k: request[k] for k in keys}
+        queue = Queue(args.db)
+        method = getattr(queue, op)
+        # Call with only whitelisted kwargs
+        value = method(**kwargs)
+    except SystemExit:
+        raise
+    except Exception as exc:
+        # All errors -> exit 2 with empty stdout; stderr optional
+        try:
+            print(str(exc), file=sys.stderr)
+        except Exception:
+            pass
+        return 2
+    try:
+        sys.stdout.write(json.dumps(value, sort_keys=True) + "\n")
+    except Exception as exc:
+        try:
+            print(str(exc), file=sys.stderr)
+        except Exception:
+            pass
+        return 2
     return 0
 
 
