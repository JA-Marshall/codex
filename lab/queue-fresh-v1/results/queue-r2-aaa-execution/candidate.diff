+import copy
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def run_cli(db, request_obj=None, raw_bytes=None, request_text=None):
+    with tempfile.NamedTemporaryFile(mode="wb", delete=False, suffix=".json") as f:
+        if raw_bytes is not None:
+            f.write(raw_bytes)
+        elif request_text is not None:
+            f.write(request_text.encode("utf-8"))
+        else:
+            f.write(json.dumps(request_obj).encode("utf-8"))
+        req = f.name
+    try:
+        proc = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req],
+            capture_output=True,
+        )
+        return proc
+    finally:
+        try:
+            Path(req).unlink()
+        except Exception:
+            pass
+
+
+class RegressionTests(unittest.TestCase):
+    def test_invalid_batch_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}, {"id": "b"}])
+            before = q.list()
+            # various invalid batches must leave DB unchanged
+            invalid_batches = [
+                [{"id": "c"}, {"id": "c"}],  # dup within batch
+                [{"id": "d", "unknown": 1}],  # unknown field
+                [{"id": "e", "priority": True}],  # bool is not int
+                [{"id": "f", "payload": float("nan")}],  # non-finite
+                [{"id": "g", "dependencies": ["missing"]}],  # unknown dep
+                [{"id": "h", "dependencies": ["h"]}],  # self
+                [{"id": "i", "dependencies": ["j"]}, {"id": "j", "dependencies": ["i"]}],  # cycle
+                [{"id": "a", "priority": 99}],  # conflict with existing
+                [{"id": "", }],  # empty id
+                "notalist",
+            ]
+            for batch in invalid_batches:
+                with self.assertRaises(ValueError, msg=str(batch)):
+                    q.submit(batch)
+                self.assertEqual(q.list(), before)
+                # reopen durability: still same after reopen
+                self.assertEqual(Queue(Path(tmp) / "q.db").list(), before)
+
+    def test_idempotent_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            v1 = q.submit([{"id": "a", "priority": 5, "dependencies": [], "payload": {"x": 1}}])
+            # same normalized spec with different key order / dup deps order -> idempotent
+            v2 = q.submit([{"id": "a", "payload": {"x": 1}, "priority": 5, "dependencies": []}])
+            self.assertEqual(v1, v2)
+            # claim to change state, then resubmit original spec still idempotent
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            v3 = q.submit([{"id": "a", "priority": 5, "payload": {"x": 1}}])
+            self.assertEqual(v3[0]["state"], "running")
+            self.assertEqual(v3[0]["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            # whole-batch conflict rollback: valid new + conflicting existing
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "newjob"}, {"id": "a", "priority": 6}])
+            self.assertIsNone(q.get("newjob"))
+
+    def test_views_detached_exact_keys_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "b"}, {"id": "a", "payload": {"k": [1, 2]}, "dependencies": ["b", "b"]}])
+            lst = q.list()
+            self.assertEqual([v["id"] for v in lst], ["a", "b"])
+            expected_keys = {"id", "payload", "priority", "dependencies", "max_attempts",
+                             "ready_at", "state", "attempts", "worker", "lease_until"}
+            for v in lst:
+                self.assertEqual(set(v.keys()), expected_keys)
+            # detached: mutate returned view, refetch unchanged
+            lst[0]["payload"]["k"].append(99)
+            lst[0]["dependencies"].append("x")
+            fresh = q.get(lst[0]["id"])
+            self.assertNotIn("x", fresh["dependencies"])
+            self.assertNotIn(99, fresh["payload"].get("k", []))
+            # deps sorted unique
+            self.assertEqual(q.get("a")["dependencies"], ["b"])
+            # do not mutate caller
+            job = {"id": "m", "payload": {"a": 1}, "dependencies": ["b", "a"]}
+            # need b and a exist; submit m depends on a,b? a depends on b so ok
+            snapshot = copy.deepcopy(job)
+            q.submit([job])
+            self.assertEqual(job, snapshot)
+
+    def test_claim_order_and_dep_gating(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([
+                {"id": "low", "priority": 1},
+                {"id": "high", "priority": 10},
+                {"id": "mid", "priority": 10},
+            ])
+            c = q.claim("w", 0, 10)
+            # highest priority then lex smallest: high vs mid both 10 -> high < mid
+            self.assertEqual(c["id"], "high")
+            # dep gating
+            q2 = Queue(Path(tmp) / "q2.db")
+            q2.submit([{"id": "child", "dependencies": ["parent"]}, {"id": "parent"}])
+            c1 = q2.claim("w", 0, 10)
+            self.assertEqual(c1["id"], "parent")
+            self.assertIsNone(q2.claim("w2", 0, 10))  # child gated, parent running
+            q2.complete("parent", "w", c1["attempts"], 1)
+            c2 = q2.claim("w2", 1, 10)
+            self.assertEqual(c2["id"], "child")
+            # failed dep stays ineligible
+            with tempfile.TemporaryDirectory() as tmp2:
+                q3 = Queue(Path(tmp2) / "q.db")
+                q3.submit([{"id": "c", "dependencies": ["p"], "ready_at": 0}, {"id": "p", "max_attempts": 1}])
+                cp = q3.claim("w", 0, 10)
+                self.assertEqual(cp["id"], "p")
+                q3.fail("p", "w", cp["attempts"], 1)
+                # p now failed (attempts==max), c stays pending ineligible
+                self.assertEqual(q3.get("p")["state"], "failed")
+                self.assertIsNone(q3.claim("w", 1, 10))
+                self.assertEqual(q3.get("c")["state"], "pending")
+
+    def test_recover_and_implicit_claim_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 3}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["lease_until"], 5)
+            # not expired yet
+            self.assertEqual(q.recover(4), [])
+            # expired at 5
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)  # expired lease_until
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["attempts"], 1)
+            # repeated no-op
+            self.assertEqual(q.recover(5), [])
+            # implicit recover via claim
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["id"], "a")
+            # advance past lease, claim should recover then reclaim (maybe same job)
+            c3 = q.claim("w2", 10, 5)
+            self.assertIsNotNone(c3)
+            self.assertEqual(c3["id"], "a")
+            self.assertEqual(c3["worker"], "w2")
+            self.assertEqual(c3["attempts"], 3)  # attempts incremented
+            # max attempts -> failed on recover
+            with tempfile.TemporaryDirectory() as tmp2:
+                q4 = Queue(Path(tmp2) / "q.db")
+                q4.submit([{"id": "x", "max_attempts": 1}])
+                cx = q4.claim("w", 0, 5)
+                self.assertEqual(q4.recover(5), ["x"])
+                self.assertEqual(q4.get("x")["state"], "failed")
+                # ready_at unchanged (0)
+                self.assertEqual(q4.get("x")["ready_at"], 0)
+
+    def test_stale_wrongowner_expired_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 10)
+            before = q.list()
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w2", c["attempts"], 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 999, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c["attempts"], 10)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c["attempts"], 10)
+            # invalid args leave unchanged including no recover
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", True, 1)  # bool attempt
+            with self.assertRaises(ValueError):
+                q.claim("", 1, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", -1, 10)
+            self.assertEqual(q.list(), before)
+            # reclaim by same worker new attempt, old attempt rejected
+            q.recover(10)
+            c2 = q.claim("w1", 10, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 11)
+            # correct complete works
+            v = q.complete("a", "w1", 2, 11)
+            self.assertEqual(v["state"], "succeeded")
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 2, 12)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 2, 12)
+            self.assertIsNone(q.claim("w", 12, 10))
+
+    def test_retry_delay_and_bounds(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            self.assertIsNone(q.claim("w", 5, 10))
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["id"], "a")
+            # second fail reaches max -> failed, ready_at unchanged
+            v2 = q.fail("a", "w", c2["attempts"], 7, retry_delay=5)
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 999, 7)
+            # invalid retry_delay
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = Queue(Path(tmp2) / "q.db")
+                q2.submit([{"id": "b"}])
+                cb = q2.claim("w", 0, 10)
+                with self.assertRaises(ValueError):
+                    q2.fail("b", "w", cb["attempts"], 1, retry_delay=-1)
+                with self.assertRaises(ValueError):
+                    q2.fail("b", "w", cb["attempts"], 1, retry_delay=True)
+                # unchanged
+                self.assertEqual(q2.get("b")["state"], "running")
+
+    def test_subprocess_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            q = Queue(db)
+            q.submit([{"id": "a"}, {"id": "b"}, {"id": "c"}])
+            # concurrent claims from separate processes must give distinct leases
+            def claim_req(worker):
+                with tempfile.NamedTemporaryFile(mode="w", delete=False, suffix=".json") as f:
+                    json.dump({"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30}, f)
+                    name = f.name
+                return name
+            procs = []
+            reqs = []
+            for w in ["w1", "w2", "w3"]:
+                rn = claim_req(w)
+                reqs.append(rn)
+                procs.append(subprocess.Popen(
+                    [sys.executable, "-m", "durable_queue", "--db", str(db), "--request", rn],
+                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                ))
+            outs = [p.communicate() for p in procs]
+            ids = []
+            for out, p in zip(outs, procs):
+                self.assertEqual(p.returncode, 0)
+                val = json.loads(out[0].decode())
+                ids.append(val["id"] if val else None)
+            # all three distinct non-null (3 jobs, 3 workers)
+            self.assertEqual(sorted(ids), ["a", "b", "c"])
+            for r in reqs:
+                try:
+                    Path(r).unlink()
+                except Exception:
+                    pass
+            # fourth claim gets null (all leased)
+            with tempfile.NamedTemporaryFile(mode="w", delete=False, suffix=".json") as f:
+                json.dump({"op": "claim", "worker": "w4", "now": 0, "lease_seconds": 30}, f)
+                rn = f.name
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", rn],
+                               capture_output=True)
+            self.assertEqual(p.returncode, 0)
+            self.assertIsNone(json.loads(p.stdout.decode()))
+            Path(rn).unlink()
+
+    def test_reopen_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            Queue(db).submit([{"id": "a", "payload": {"n": 1}}])
+            c = Queue(db).claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # reopen in new process via CLI still sees running lease
+            proc = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(proc.returncode, 0)
+            val = json.loads(proc.stdout.decode())
+            self.assertEqual(val["state"], "running")
+            self.assertEqual(val["worker"], "w")
+            # complete via CLI then reopen sees succeeded
+            proc2 = run_cli(db, {"op": "complete", "id": "a", "worker": "w", "attempt": c["attempts"], "now": 1})
+            self.assertEqual(proc2.returncode, 0)
+            self.assertEqual(Queue(db).get("a")["state"], "succeeded")
+
+    def test_cli_contract(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            q = Queue(db)
+            q.submit([{"id": "a"}])
+            # success sorted keys single line
+            proc = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(proc.returncode, 0)
+            line = proc.stdout.decode()
+            self.assertTrue(line.endswith("\n"))
+            self.assertEqual(len(line.strip().splitlines()), 1)
+            obj = json.loads(line)
+            self.assertEqual(list(obj.keys()), sorted(obj.keys()))
+            # unknown op
+            proc = run_cli(db, {"op": "nope"})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # unknown field
+            proc = run_cli(db, {"op": "list", "extra": 1})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # malformed json
+            proc = run_cli(db, request_text="{not json")
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # non-object
+            proc = run_cli(db, [1, 2, 3])
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # missing file
+            proc = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db),
+                                   "--request", str(Path(tmp) / "missing.json")], capture_output=True)
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # invalid utf-8
+            proc = run_cli(db, raw_bytes=b"\xff\xfe")
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # ValueError from API -> exit 2 empty stdout, DB unchanged
+            before = q.list()
+            proc = run_cli(db, {"op": "complete", "id": "a", "worker": "w", "attempt": 1, "now": 0})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            self.assertEqual(q.list(), before)
+            # unavailable db (directory)
+            proc = run_cli(Path(tmp), {"op": "list"})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+
