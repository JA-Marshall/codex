+                    (lease, jid),
+                )
+            else:
+                conn.execute(
+                    "UPDATE jobs SET state='failed', worker=NULL, lease_until=NULL WHERE id=?",
+                    (jid,),
+                )
+            recovered.append(jid)
+    recovered.sort()
+    return recovered
