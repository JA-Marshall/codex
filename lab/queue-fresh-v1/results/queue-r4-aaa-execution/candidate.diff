+def _detect_cycle_with_new(graph, new_ids):
+    # graph: id -> list of deps (all deps are keys in graph, validated before call)
+    # Raise ValueError if any cycle includes a new id.
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {nid: WHITE for nid in graph}
+    stack = []
+    pos_in_stack = {}
+
+    def dfs(u):
+        color[u] = GRAY
+        pos_in_stack[u] = len(stack)
+        stack.append(u)
+        for w in graph.get(u, []):
+            if w not in color:
+                continue
+            if color[w] == GRAY:
+                # cycle from w .. u
+                idx = pos_in_stack[w]
+                cycle_nodes = stack[idx:] + [w]
+                for n in cycle_nodes:
+                    if n in new_ids:
+                        raise ValueError("cycle in dependencies")
+                # if cycle has no new node, ignore (existing corruption, not our batch)
+            elif color[w] == WHITE:
+                dfs(w)
+        stack.pop()
+        del pos_in_stack[u]
+        color[u] = BLACK
+
+    for nid in graph:
+        if color[nid] == WHITE:
+            dfs(nid)
