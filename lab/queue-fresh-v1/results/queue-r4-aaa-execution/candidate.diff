+def _ensure_schema(conn):
+    # Determine existing table shape
+    cur = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='jobs'")
+    row = cur.fetchone()
+    if row is None:
+        conn.execute(_SCHEMA_NEW)
+        return
+    # inspect columns
+    cols = conn.execute("PRAGMA table_info(jobs)").fetchall()
