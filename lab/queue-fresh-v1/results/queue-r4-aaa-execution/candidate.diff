+import copy
+import json
+import multiprocessing
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+def _tmpdb(tmp):
+    return str(Path(tmp) / "q.db")
+
+def _claim_worker(args):
+    db_path, worker, now, lease = args
+    try:
+        from durable_queue import Queue as Q
+        q = Q(db_path)
+        v = q.claim(worker, now, lease)
+        if v is None:
+            return None
+        return (v["id"], v["attempts"], v["worker"], v["lease_until"])
+    except Exception as e:
+        return ("ERROR", str(e))
+
+def _cli(db, req_obj=None, raw_bytes=None):
+    # write request file, run CLI, return (exitcode, stdout, stderr)
+    with tempfile.TemporaryDirectory() as td:
+        req_path = Path(td) / "req.json"
+        if raw_bytes is not None:
+            req_path.write_bytes(raw_bytes)
+        else:
+            req_path.write_text(json.dumps(req_obj), encoding="utf-8")
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req_path)],
+                           capture_output=True)
+        return p.returncode, p.stdout, p.stderr
+
+def _cli_file(db, req_path):
+    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req_path)],
+                       capture_output=True)
+    return p.returncode, p.stdout, p.stderr
+
+class SubmitTests(unittest.TestCase):
+    def test_batch_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            before = q.list()
+            # duplicate within batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "b"}])
+            self.assertEqual(q.list(), before)
+            # unknown dep
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "dependencies": ["nope"]}])
+            self.assertEqual(q.list(), before)
+            # self dep
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c", "dependencies": ["c"]}])
+            self.assertEqual(q.list(), before)
+            # cycle
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "dependencies": ["y"]}, {"id": "y", "dependencies": ["x"]}])
+            self.assertEqual(q.list(), before)
+            # unknown field
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "z", "foo": 1}])
+            self.assertEqual(q.list(), before)
+            # conflict resubmit with different spec + one new job => whole batch rejected
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 99}, {"id": "newjob"}])
+            self.assertEqual(q.list(), before)
+            self.assertIsNone(q.get("newjob"))
+
+    def test_strict_validation(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            # bool is not int
+            for bad in [{"id": "a", "priority": True}, {"id": "a", "max_attempts": True},
+                        {"id": "a", "ready_at": True}, {"id": "a", "payload": {"x": float("inf")}},
+                        {"id": "a", "payload": {"x": float("nan")}}, {"id": "a", "payload": []},
+                        {"id": "", }, {"id": "a", "dependencies": "x"},
+                        {"id": "a", "dependencies": [""]}, {"id": "a", "dependencies": [123]},
+                        {"id": "a", "max_attempts": 0}, {"id": "a", "max_attempts": 101},
+                        {"id": "a", "ready_at": -1}, {"id": "a", "priority": 1.5}]:
+                with self.assertRaises(ValueError, msg=str(bad)):
+                    q.submit([bad])
+            self.assertEqual(q.list(), [])
+            # jobs must be list
+            with self.assertRaises(ValueError):
+                q.submit({"id": "a"})
+            with self.assertRaises(ValueError):
+                q.submit("hi")
+            # job must be dict
+            with self.assertRaises(ValueError):
+                q.submit(["hi"])
+            # empty allowed
+            self.assertEqual(q.submit([]), [])
+
+    def test_normalize_and_no_mutate(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            inp = [{"id": "m"}, {"id": "z"}, {"id": "a", "dependencies": ["z", "m", "m", "z"]}]
+            orig = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, orig)
+            self.assertEqual(views[2]["dependencies"], ["m", "z"])
+            self.assertEqual(q.get("a")["dependencies"], ["m", "z"])
+            # detached
+            views[2]["payload"]["x"] = 1
+            views[2]["dependencies"].append("evil")
+            self.assertEqual(q.get("a")["payload"], {})
+            self.assertEqual(q.get("a")["dependencies"], ["m", "z"])
+            # exact keys
+            self.assertEqual(set(q.get("a").keys()),
+                {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"})
+
+    def test_idempotent_same_spec_after_state_change(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "priority": 5, "ready_at": 0}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # resubmit same original spec should be idempotent, return current view
+            views = q.submit([{"id": "a", "priority": 5, "ready_at": 0}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # recover changes ready_at, still idempotent
+            q.recover(10)
+            cur = q.get("a")
+            self.assertEqual(cur["ready_at"], 10)
+            views2 = q.submit([{"id": "a", "priority": 5, "ready_at": 0}])
+            self.assertEqual(views2[0]["ready_at"], 10)
+            # conflict
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+
+    def test_submit_batch_with_existing_dep(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "setup"}])
+            q.submit([{"id": "build", "dependencies": ["setup"]}])
+            self.assertEqual(q.get("build")["dependencies"], ["setup"])
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_ordering(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "c")
+            q.complete("c", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "a")
+
+    def test_claim_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "future", "ready_at": 100}, {"id": "ok"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "ok")
+            # future not eligible
+            q2 = Queue(_tmpdb(tmp))
+            # ok is running, future not ready => None
+            self.assertIsNone(q.claim("w2", 0, 10))
+            # failed dep stays ineligible
+            with tempfile.TemporaryDirectory() as tmp2:
+                qq = Queue(str(Path(tmp2)/"q.db"))
+                qq.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+                cc = qq.claim("w", 0, 5)
+                qq.fail("dep", "w", cc["attempts"], 1)
+                # dep attempts==max => failed
+                self.assertEqual(qq.get("dep")["state"], "failed")
+                self.assertIsNone(qq.claim("w", 1, 5))
+                self.assertEqual(qq.get("child")["state"], "pending")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["lease_until"], 5)
+            # not expired yet
+            self.assertEqual(q.recover(4), [])
+            # expired
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            cur = q.get("a")
+            self.assertEqual(cur["state"], "pending")
+            self.assertEqual(cur["ready_at"], 5)
+            self.assertIsNone(cur["worker"])
+            self.assertIsNone(cur["lease_until"])
+            self.assertEqual(cur["attempts"], 1)
+            # repeated no-op
+            self.assertEqual(q.recover(5), [])
+            self.assertEqual(q.recover(99), [])
+            # exhaust attempts -> failed, ready_at unchanged
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            q.recover(10)
+            cur2 = q.get("a")
+            self.assertEqual(cur2["state"], "failed")
+            self.assertEqual(cur2["ready_at"], 5)
+
+    def test_claim_does_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}, {"id": "b", "priority": -1}])
+            c = q.claim("w1", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # a expires at 5; claim at 5 should recover a then claim highest priority among eligible (a priority 0 > b -1)
+            c2 = q.claim("w2", 5, 5)
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["worker"], "w2")
+            self.assertEqual(c2["attempts"], 2)
+
+    def test_invalid_claim_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            before = q.get("a")
+            with self.assertRaises(ValueError):
+                q.claim("", 5, 5)
+            with self.assertRaises(ValueError):
+                q.claim("w2", True, 5)
+            with self.assertRaises(ValueError):
+                q.claim("w2", 5, 0)
+            with self.assertRaises(ValueError):
+                q.claim("w2", 5, True)
+            # no recovery happened
+            self.assertEqual(q.get("a"), before)
+            # invalid recover also no write
+            with self.assertRaises(ValueError):
+                q.recover(-1)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            self.assertEqual(q.get("a"), before)
+
+    def test_subprocess_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            q = Queue(db)
+            q.submit([{"id": "persist", "payload": {"n": 1}}])
+            # fresh process via subprocess
+            code = "from durable_queue import Queue; import sys; q=Queue(sys.argv[1]); print(q.get('persist')['payload'])"
+            p = subprocess.run([sys.executable, "-c", code, db], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 0, p.stderr)
+            self.assertIn("'n': 1", p.stdout)
+            # claim in subprocess, verify in parent
+            code2 = "from durable_queue import Queue; import sys; q=Queue(sys.argv[1]); v=q.claim('sub',0,10); print(v['id']+':'+str(v['attempts']))"
+            p2 = subprocess.run([sys.executable, "-c", code2, db], capture_output=True, text=True)
+            self.assertEqual(p2.returncode, 0, p2.stderr)
+            self.assertIn("persist:1", p2.stdout)
+            self.assertEqual(Queue(db).get("persist")["worker"], "sub")
+
+    def test_multiprocess_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            q = Queue(db)
+            q.submit([{"id": f"job{i:02d}"} for i in range(4)])
+            ctx = multiprocessing.get_context("spawn")
+            with ctx.Pool(8) as pool:
+                args = [(db, f"w{i}", 0, 10) for i in range(8)]
+                results = pool.map(_claim_worker, args)
+            # collect successful claims (non-None, non-error)
+            claimed = [r for r in results if r is not None and not (isinstance(r, tuple) and r[0] == "ERROR")]
+            ids = [r[0] for r in claimed]
+            # never share active lease: ids unique
+            self.assertEqual(len(ids), len(set(ids)), f"duplicate leases: {results}")
+            self.assertEqual(len(ids), 4)
+            # attempts never exceed: each claimed once with attempt 1
+            for r in claimed:
+                self.assertEqual(r[1], 1)
+            # further claims none (all running)
+            self.assertIsNone(Queue(db).claim("late", 0, 10))
+
+class FinishTests(unittest.TestCase):
+    def test_complete_fail_basic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            v = q.complete("a", "w", c["attempts"], 5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["ready_at"], 0)
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 6)
+            self.assertIsNone(q.claim("w", 6, 10))
+
+    def test_fail_retry(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "max_attempts": 3}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 2, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 7)
+            self.assertIsNone(v["worker"])
+            # not eligible until ready
+            self.assertIsNone(q.claim("w", 3, 10))
+            c2 = q.claim("w", 7, 10)
+            self.assertEqual(c2["attempts"], 2)
+
+    def test_stale_and_expiry_rejected_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 5)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c["attempts"], 1)
+            # recover to allow reclaim by w2, then stale attempt from w1 must fail even though same? test older attempt
+            q.recover(5)
+            c2 = q.claim("w1", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 6)  # old attempt
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 2, 10)  # now == lease_until (10) => not <
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("nope", "w1", 1, 1)
+            # invalid args no recovery/write: job still running with same lease
+            before = q.get("a")
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 2, 6, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", True, 6)
+            self.assertEqual(q.get("a"), before)
+            # expired lease completion must not recover other jobs silently? check DB unchanged for that job
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 2, 10)
+            # still running (not auto-recovered by failed complete)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_fail_to_failed_at_limit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 1)
+            # attempts(1) < max(1)? No => failed, ready unchanged (0)
+            self.assertEqual(v["state"], "failed")
+            self.assertEqual(v["ready_at"], 0)
+
+    def test_bool_rejected_finish(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", True, 1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], True)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], True)
+
+class CliTests(unittest.TestCase):
+    def test_cli_success_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            rc, out, err = _cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(rc, 0)
+            self.assertTrue(out.endswith(b"\n"))
+            val = json.loads(out.decode())
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: check raw output has sorted keys
+            raw = out.decode().strip()
+            # single line JSON
+            self.assertNotIn("\n", raw)
+            # persistence across restarts
+            rc2, out2, _ = _cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(rc2, 0)
+            self.assertEqual(json.loads(out2.decode())["id"], "a")
+            # claim via CLI
+            rc3, out3, _ = _cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(rc3, 0)
+            self.assertEqual(json.loads(out3.decode())["id"], "a")
+
+    def test_cli_failures(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            Queue(db).submit([{"id": "a"}])
+            # unknown op
+            rc, out, _ = _cli(db, {"op": "nope"})
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # unknown field
+            rc, out, _ = _cli(db, {"op": "get", "id": "a", "extra": 1})
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # missing field
+            rc, out, _ = _cli(db, {"op": "get"})
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # malformed JSON
+            rc, out, _ = _cli(db, raw_bytes=b"{not json")
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # non-object
+            rc, out, _ = _cli(db, raw_bytes=b"[]")
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # bad utf8
+            rc, out, _ = _cli(db, raw_bytes=b"\xff\xff")
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # API ValueError => exit 2 empty stdout
+            rc, out, _ = _cli(db, {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10})
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # missing file
+            rc, out, err = _cli_file(db, "/nonexistent-req-12345.json")
+            self.assertEqual(rc, 2); self.assertEqual(out, b"")
+            # db unavailable (directory as db)
+            with tempfile.TemporaryDirectory() as td2:
+                req = Path(td2)/"r.json"
+                req.write_text(json.dumps({"op": "list"}), encoding="utf-8")
+                p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", td2, "--request", str(req)], capture_output=True)
+                self.assertEqual(p.returncode, 2); self.assertEqual(p.stdout, b"")
+
