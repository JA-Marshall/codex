+    names = {c[1] for c in cols}
+    if "spec" in names and "payload" in names:
+        # already new schema; ensure table exists (no-op)
+        conn.execute(_SCHEMA_NEW)
+        return
+    if names == {"id", "data"} or ("data" in names and "spec" not in names):
