 import argparse
 import json
+import sys
 
 from .queue import Queue
 
+_OPS = {"submit", "get", "list", "claim", "recover", "complete", "fail"}
+
+# allowed kw fields per op (excluding 'op'); for fail retry_delay optional
+_REQUIRED = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now"},
+}
+_OPTIONAL = {
+    "submit": set(),
+    "get": set(),
+    "list": set(),
+    "claim": set(),
+    "recover": set(),
+    "complete": set(),
+    "fail": {"retry_delay"},
+}
+
+
+def _fail():
+    raise SystemExit(2)
+
 
 def main():
     parser = argparse.ArgumentParser()
     parser.add_argument("--db", required=True)
     parser.add_argument("--request", required=True)
     args = parser.parse_args()
-    with open(args.request, encoding="utf-8") as stream:
-        request = json.load(stream)
-    operation = request.pop("op")
-    value = getattr(Queue(args.db), operation)(**request)
-    print(json.dumps(value, sort_keys=True))
+    # read request file strictly as UTF-8 JSON object
+    try:
+        with open(args.request, "rb") as f:
+            raw = f.read()
+    except Exception:
+        sys.exit(2)
+        return 2
+    try:
+        text = raw.decode("utf-8")
+    except Exception:
+        sys.exit(2)
+        return 2
+    try:
+        request = json.loads(text)
+    except Exception:
+        sys.exit(2)
+        return 2
+    if type(request) is not dict:
+        sys.exit(2)
+        return 2
+    if "op" not in request:
+        sys.exit(2)
+        return 2
+    op = request["op"]
+    if type(op) is not str or op not in _OPS:
+        sys.exit(2)
+        return 2
+    keys = set(request.keys())
+    keys.discard("op")
+    req = _REQUIRED[op]
+    opt = _OPTIONAL[op]
+    allowed = req | opt
+    # no unknown fields, all required present
+    if keys != req and not (op == "fail" and (keys == req or keys == (req | opt))):
+        # general check: keys must equal req, or for fail may include optional
+        # For non-fail ops, require exact match
+        if op != "fail":
+            sys.exit(2)
+            return 2
+        # fail: allow req or req+retry_delay, nothing else
+        if keys != req and keys != (req | opt):
+            sys.exit(2)
+            return 2
+    else:
+        # for non-fail, keys==req already ensured by != check? need explicit
+        if op != "fail" and keys != req:
+            sys.exit(2)
+            return 2
+    # extra safety: unknown fields
+    if not keys.issubset(allowed):
+        sys.exit(2)
+        return 2
+    if not req.issubset(keys):
+        sys.exit(2)
+        return 2
+    kwargs = {k: request[k] for k in keys}
+    # dispatch; map any failure to exit 2 with empty stdout
+    try:
+        q = Queue(args.db)
+    except SystemExit as e:
+        raise
+    except Exception:
+        sys.exit(2)
+        return 2
+    try:
+        method = getattr(q, op)
+    except Exception:
+        sys.exit(2)
+        return 2
+    try:
+        value = method(**kwargs)
+    except SystemExit as e:
+        raise
+    except ValueError:
+        sys.exit(2)
+        return 2
+    except TypeError:
+        sys.exit(2)
+        return 2
+    except Exception:
+        sys.exit(2)
+        return 2
+    try:
+        out = json.dumps(value, sort_keys=True)
+    except Exception:
+        sys.exit(2)
+        return 2
+    sys.stdout.write(out + "\n")
     return 0
 
 
