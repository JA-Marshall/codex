+        return _fail()
+    allowed, required = _ALLOWED[op]
+    params = {k: v for k, v in request.items() if k != "op"}
+    # No unknown fields.
+    for k in params:
+        if k not in allowed:
+            return _fail()
+    for k in required:
+        if k not in params:
+            return _fail()
