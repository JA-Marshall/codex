+            self.assertEqual(rc, 2)
+            self.assertEqual(out, b"")
+
+    def test_cli_survives_failures(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            rc, out, _ = run_cli(db, {"op": "submit", "jobs": [{"id": "keep"}]})
+            self.assertEqual(rc, 0)
+            rc, out, _ = run_cli(db, {"op": "submit", "jobs": [{"id": "bad", "priority": "x"}]})
+            self.assertEqual(rc, 2)
+            self.assertEqual(out, b"")
+            rc, out, _ = run_cli(db, {"op": "get", "id": "keep"})
+            self.assertEqual(rc, 0)
+            self.assertIn("keep", out.decode())
+
+
+if __name__ == "__main__":
+    unittest.main()
