+def run_cli(db, req_obj=None, raw_bytes=None, req_path=None):
+    """Run CLI, return (returncode, stdout_bytes, stderr_bytes)."""
+    if req_path is None:
+        fd, rp = tempfile.mkstemp(suffix=".json")
+        os.close(fd)
+        if raw_bytes is not None:
+            Path(rp).write_bytes(raw_bytes)
+        else:
+            Path(rp).write_text(json.dumps(req_obj), encoding="utf-8")
+        req_path = rp
+        cleanup = True
+    else:
+        cleanup = False
+    try:
+        p = subprocess.run([EXE, "-m", "durable_queue", "--db", str(db), "--request", str(req_path)],
+                           capture_output=True, cwd=Path(__file__).resolve().parents[1])
+        return p.returncode, p.stdout, p.stderr
+    finally:
+        if cleanup:
+            try:
+                os.unlink(req_path)
+            except Exception:
+                pass
