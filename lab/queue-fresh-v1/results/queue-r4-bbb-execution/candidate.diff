+"""Focused regression tests for durable_queue contract (TDD)."""
+import copy
+import json
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def tmp_db(tmp):
+    return str(Path(tmp) / "queue.db")
+
+
+def run_cli(db, req_obj=None, raw_bytes=None, req_file_missing=False):
+    import os
+    with tempfile.TemporaryDirectory() as tmp2:
+        if req_file_missing:
+            req_path = os.path.join(tmp2, "missing_request.json")
+        else:
+            req_path = os.path.join(tmp2, "req.json")
+            if raw_bytes is not None:
+                with open(req_path, "wb") as f:
+                    f.write(raw_bytes)
+            else:
+                with open(req_path, "w", encoding="utf-8") as f:
+                    json.dump(req_obj, f)
+        proc = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req_path],
+            capture_output=True, timeout=10,
+        )
+        return proc.returncode, proc.stdout, proc.stderr
+
+
+class S1StorageTests(unittest.TestCase):
+    def test_wal_and_preserve(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            p = tmp_db(tmp)
+            q = Queue(p)
+            q.submit([{"id": "a"}])
+            con = sqlite3.connect(p)
+            try:
+                mode = con.execute("PRAGMA journal_mode").fetchone()[0]
+            finally:
+                con.close()
+            self.assertEqual(mode.lower(), "wal")
+            q2 = Queue(p)
+            self.assertIsNotNone(q2.get("a"))
+
+    def test_begin_immediate_helper(self):
+        from durable_queue import storage
+        self.assertTrue(hasattr(storage, "begin_immediate"))
+        with tempfile.TemporaryDirectory() as tmp:
+            p = tmp_db(tmp)
+            conn = storage.connect(p)
+            try:
+                storage.begin_immediate(conn)
+                conn.execute("COMMIT;")
+            finally:
+                conn.close()
+
