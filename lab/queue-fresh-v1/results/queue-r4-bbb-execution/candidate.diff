+                    orig_text = json.dumps(orig, sort_keys=True)
+                except Exception:
+                    orig_text = json.dumps({}, sort_keys=True)
+                connection.execute("UPDATE jobs SET orig=? WHERE id=?", (orig_text, job_id))
+        else:
