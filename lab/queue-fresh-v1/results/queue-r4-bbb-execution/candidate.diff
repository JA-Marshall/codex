+class S2SubmitTests(unittest.TestCase):
+    def test_no_mutation_and_normalize(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            inp = [{"id": "a", "payload": {"x": 1}, "priority": 1, "dependencies": ["b", "b"], "max_attempts": 3, "ready_at": 0}, {"id": "b"}]
+            orig = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, orig)
+            self.assertEqual(views[0]["dependencies"], ["b"])
+
+    def test_strict_types_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            bads = [
+                [{"id": "c", "priority": True}],
+                [{"id": "c", "max_attempts": True}],
+                [{"id": "c", "ready_at": True}],
+                [{"id": "c", "ready_at": -1}],
+                [{"id": "c", "max_attempts": 0}],
+                [{"id": "c", "max_attempts": 101}],
+                [{"id": "c", "payload": []}],
+                [{"id": "c", "payload": {"x": float("inf")}}],
+                [{"id": "", }],
+                [{"id": 123}],
+                [{"id": "c", "dependencies": "x"}],
+                [{"id": "c", "dependencies": [""]}],
+                [{"id": "c", "dependencies": [123]}],
+                [{"id": "c", "unknown": 1}],
+                ["notadict"],
+                [{"id": "c", "payload": {"k": {1, 2}}}],
+            ]
+            for b in bads:
+                with self.assertRaises(ValueError, msg=str(b)):
+                    q.submit(b)
+            # jobs must be list
+            with self.assertRaises(ValueError):
+                q.submit({"id": "c"})
+            # non-finite NaN payload
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "nan", "payload": {"x": float("nan")}}])
+            self.assertEqual(q.list(), [])
+
+    def test_atomic_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "keep"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": ""}])
+            self.assertIsNone(q.get("good"))
+            self.assertIsNotNone(q.get("keep"))
+            self.assertEqual(len(q.list()), 1)
+
+    def test_unknown_self_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "y", "dependencies": ["nope"]}])
+            self.assertIsNone(q.get("y"))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "s", "dependencies": ["s"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "p", "dependencies": ["q2"]}, {"id": "q2", "dependencies": ["p"]}])
+            self.assertIsNone(q.get("p"))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x"}, {"id": "x"}])
+
+    def test_idempotent_resubmit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a", "payload": {"v": 1}}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            views = q.submit([{"id": "a", "payload": {"v": 1}}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"v": 2}}])
+            g = q.get("a")
+            self.assertEqual(g["worker"], "w")
+            # deps order normalized idempotency
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = Queue(tmp_db(tmp2))
+                q2.submit([{"id": "b"}, {"id": "a2", "dependencies": ["b"]}])
+                v = q2.submit([{"id": "a2", "dependencies": ["b"]}])
+                self.assertEqual(v[0]["dependencies"], ["b"])
+
+    def test_views_detached_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "b"}, {"id": "a"}])
+            lst = q.list()
+            self.assertEqual([v["id"] for v in lst], ["a", "b"])
+            self.assertEqual(set(lst[0].keys()), {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"})
+            v = q.get("a")
+            v["payload"]["hack"] = 1
+            v["dependencies"].append("hack")
+            self.assertEqual(q.get("a")["payload"], {})
+            self.assertEqual(q.get("a")["dependencies"], [])
+            # get invalid id
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(None)
+
+    def test_empty_submit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            self.assertEqual(q.submit([]), [])
+
