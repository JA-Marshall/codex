+class S3ClaimRecoverTests(unittest.TestCase):
+    def test_priority_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 5}, {"id": "mid", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            q.complete("high", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            # high done, mid (pri 5) vs low (0): mid next (lexicographically high<mid but high gone)
+            self.assertEqual(c2["id"], "mid")
+
+    def test_ready_attempts_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "future", "ready_at": 10}, {"id": "ok"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "ok")
+            # future not eligible at 0
+            q2 = Queue(tmp_db(tmp) + "_2") if False else None
+            # dependency failed stays pending
+            with tempfile.TemporaryDirectory() as tmp2:
+                qq = Queue(tmp_db(tmp2))
+                qq.submit([{"id": "base", "max_attempts": 1}, {"id": "dep", "dependencies": ["base"]}])
+                cc = qq.claim("w", 0, 10)
+                self.assertEqual(cc["id"], "base")
+                qq.fail("base", "w", cc["attempts"], 1)
+                # base failed (attempts==max), dep must stay pending/ineligible
+                self.assertEqual(qq.get("base")["state"], "failed")
+                self.assertIsNone(qq.claim("w", 1, 10))
+                self.assertEqual(qq.get("dep")["state"], "pending")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["lease_until"], 10)
+            self.assertEqual(c["attempts"], 1)
+            # not expired yet
+            self.assertEqual(q.recover(5), [])
+            # expired
+            rec = q.recover(10)
+            self.assertEqual(rec, ["a"])
+            g = q.get("a")
+            self.assertEqual(g["state"], "pending")
+            self.assertEqual(g["ready_at"], 10)
+            self.assertIsNone(g["worker"])
+            self.assertIsNone(g["lease_until"])
+            # repeated no-op
+            self.assertEqual(q.recover(10), [])
+            # max attempts -> failed, ready_at unchanged
+            with tempfile.TemporaryDirectory() as tmp2:
+                qq = Queue(tmp_db(tmp2))
+                qq.submit([{"id": "b", "max_attempts": 1}])
+                cc = qq.claim("w", 0, 5)
+                rec2 = qq.recover(5)
+                self.assertEqual(rec2, ["b"])
+                gb = qq.get("b")
+                self.assertEqual(gb["state"], "failed")
+                self.assertEqual(gb["ready_at"], 0)
+
+    def test_claim_recovers_first(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c = q.claim("w1", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # at time 5, a expired; claim should recover a and then claim highest priority (a vs b tie -> a smallest)
+            c2 = q.claim("w2", 5, 5)
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["worker"], "w2")
+            self.assertEqual(c2["attempts"], 2)
+
+    def test_complete_fail_validation(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            att = c["attempts"]
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", att, 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", att + 1, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", att, 10)
+            # unknown
+            with self.assertRaises(ValueError):
+                q.complete("nope", "w", 1, 1)
+            # invalid args leave unchanged
+            g = q.get("a")
+            self.assertEqual(g["state"], "running")
+            # success
+            v = q.complete("a", "w", att, 1)
+            self.assertEqual(v["state"], "succeeded")
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", att, 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", att, 2)
+            self.assertIsNone(q.claim("w", 2, 10))
+
+    def test_stale_after_reclaim(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            a1 = c1["attempts"]
+            q.recover(5)
+            c2 = q.claim("w", 5, 5)
+            a2 = c2["attempts"]
+            self.assertNotEqual(a1, a2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", a1, 6)
+            # current succeeds
+            v = q.complete("a", "w", a2, 6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_fail_retry(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a", "max_attempts": 3}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            self.assertIsNone(v["worker"])
+            # not eligible until ready_at
+            self.assertIsNone(q.claim("w", 5, 10))
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["id"], "a")
+            # fail to terminal when attempts==max
+            with tempfile.TemporaryDirectory() as tmp2:
+                qq = Queue(tmp_db(tmp2))
+                qq.submit([{"id": "b", "max_attempts": 1}])
+                cc = qq.claim("w", 0, 10)
+                vf = qq.fail("b", "w", cc["attempts"], 1)
+                self.assertEqual(vf["state"], "failed")
+                self.assertEqual(vf["ready_at"], 0)
+
+    def test_invalid_leaves_unchanged_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            # invalid complete (wrong worker) must not recover even though lease expired at 5
+            with self.assertRaises(ValueError):
+                q.complete("a", "bad", c["attempts"], 6)
+            # job should still be running with old lease (not recovered to pending)
+            g = q.get("a")
+            self.assertEqual(g["state"], "running")
+            self.assertEqual(g["worker"], "w")
+            # invalid claim validation must not recover
+            with self.assertRaises(ValueError):
+                q.claim("", 6, 5)
+            g2 = q.get("a")
+            self.assertEqual(g2["state"], "running")
+            # invalid now type (bool)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_attempts_never_exceed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmp_db(tmp))
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 5)
+            q.fail("a", "w", c1["attempts"], 1)
+            c2 = q.claim("w", 1, 5)
+            self.assertEqual(c2["attempts"], 2)
+            q.fail("a", "w", c2["attempts"], 2)
+            self.assertEqual(q.get("a")["state"], "failed")
+            self.assertIsNone(q.claim("w", 3, 5))
+
