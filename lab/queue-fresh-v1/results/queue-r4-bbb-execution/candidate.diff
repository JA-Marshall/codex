+        if "orig" not in cols:
+            connection.execute("ALTER TABLE jobs ADD COLUMN orig TEXT")
+            # backfill orig from data where possible
+            rows = connection.execute("SELECT id, data FROM jobs").fetchall()
+            for job_id, data in rows:
