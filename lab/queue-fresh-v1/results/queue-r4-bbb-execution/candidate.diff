+def _has_cycle(graph):
+    # graph: dict id -> list of deps (only edges to nodes in graph matter; unknown already rejected)
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {node: WHITE for node in graph}
+    def dfs(node):
+        color[node] = GRAY
+        for nb in graph.get(node, []):
+            if nb not in graph:
+                continue
+            if color[nb] == GRAY:
+                return True
+            if color[nb] == WHITE and dfs(nb):
+                return True
+        color[node] = BLACK
+        return False
+    for n in graph:
+        if color[n] == WHITE:
+            if dfs(n):
+                return True
+    return False
