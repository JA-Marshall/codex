+class SubmitViewsTests(unittest.TestCase):
+    def test_invalid_batch_rolls_back(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "", "priority": 0}])
+            self.assertIsNone(q.get("b"))
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+
+    def test_idempotent_same_spec_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "payload": {"x": 1}}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # same original spec still idempotent after state change
+            v = q.submit([{"id": "a", "payload": {"x": 1}}])
+            self.assertEqual(v[0]["state"], "running")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": 2}}])
+            # conflicting batch fully rejected
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": 1}}, {"id": "a", "payload": {"x": 1}}])
+
+    def test_no_mutation_detached_exact_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            spec = {"id": "a", "payload": {"x": [1]}, "dependencies": ["b", "b"], "priority": 2}
+            orig = copy.deepcopy(spec)
+            q.submit([spec, {"id": "b"}])
+            self.assertEqual(spec, orig)
+            v = q.get("a")
+            self.assertEqual(set(v.keys()), {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"})
+            self.assertEqual(v["dependencies"], ["b"])
+            v["payload"]["x"].append(99)
+            self.assertEqual(q.get("a")["payload"], {"x": [1]})
+            # cycle / self / unknown rejected
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c", "dependencies": ["c"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "d", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "dependencies": ["y"]}, {"id": "y", "dependencies": ["x"]}])
+            # bool is not int, unknown field, non-finite payload
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "e", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "f", "extra": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "g", "payload": {"v": float("inf")}}])
+
+    def test_get_list_validate_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            # get/claim validation; get must not recover
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            self.assertEqual(q.get("a")["state"], "running")
+            # expired but still running until recover/claim
+            self.assertEqual(q.get("a")["state"], "running")
