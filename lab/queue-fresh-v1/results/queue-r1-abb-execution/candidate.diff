+    _ensure_schema(connection)
     return connection
+
+
+@contextlib.contextmanager
+def transaction(conn):
+    conn.execute("BEGIN IMMEDIATE;")
+    try:
+        yield conn
+    except Exception:
+        try:
+            conn.execute("ROLLBACK;")
+        except Exception:
+            pass
+        raise
+    else:
+        conn.execute("COMMIT;")
