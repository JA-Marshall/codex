+class SeparateProcessTests(unittest.TestCase):
+    def test_two_processes_never_share_active_lease(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmpdb(tmp)
+            q = Queue(db)
+            q.submit([{"id": f"j{i:02d}"} for i in range(5)])
+            code = (
+                "import sys, json; from durable_queue import Queue; "
+                "q=Queue(sys.argv[1]); v=q.claim(sys.argv[2], 0, 30); "
+                "print(v['id'] if v else 'NONE')"
+            )
+            p1 = subprocess.Popen([sys.executable, "-c", code, db, "w1"],
+                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            p2 = subprocess.Popen([sys.executable, "-c", code, db, "w2"],
+                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            o1, _ = p1.communicate()
+            o2, _ = p2.communicate()
+            self.assertEqual(p1.returncode, 0)
+            self.assertEqual(p2.returncode, 0)
+            r1 = o1.strip()
+            r2 = o2.strip()
+            self.assertNotEqual(r1, "NONE")
+            self.assertNotEqual(r2, "NONE")
+            self.assertNotEqual(r1, r2)
+
+    def test_durability_across_subprocess(self):
