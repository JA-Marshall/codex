+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_priority_and_retry_bound(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "b-1", "priority": 1}, {"id": "a-9", "priority": 5, "max_attempts": 1}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a-9")
+            q.fail("a-9", "w", c["attempts"], 1)
+            # max_attempts=1 -> failed terminal, next claim gets b-1
+            self.assertEqual(q.get("a-9")["state"], "failed")
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "b-1")
+
+    def test_claim_invalid_no_recovery_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            before = q.get("a")
+            with self.assertRaises(ValueError):
+                q.claim("", 10, 5)
+            with self.assertRaises(ValueError):
+                q.claim("w2", True, 5)
+            self.assertEqual(q.get("a"), before)
+
+    def test_recover_ready_at_and_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}, {"id": "b"}])
+            q.claim("w", 0, 5)
+            # only one claimed; claim second
+            q.claim("w", 0, 5)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a", "b"])
+            self.assertEqual(q.get("a")["ready_at"], 5)
+            self.assertEqual(q.get("a")["state"], "pending")
+            self.assertEqual(q.recover(5), [])
+
+    def test_stale_complete_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            q.recover(5)
+            c2 = q.claim("w", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c1["attempts"], 6)
+            # wrong owner / expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", c2["attempts"], 6)
+            # valid completes
+            q.complete("a", "w", c2["attempts"], 6)
+            self.assertEqual(q.get("a")["state"], "succeeded")
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c2["attempts"], 6)
+
+    def test_fail_retry_delay(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_tmpdb(tmp))
+            q.submit([{"id": "a", "max_attempts": 3}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["ready_at"], 6)
+            self.assertEqual(v["state"], "pending")
+            self.assertIsNone(q.claim("w", 5, 10))
+            self.assertIsNotNone(q.claim("w", 6, 10))
