+"""Durable SQLite storage foundation: WAL, timeouts, txn helper, normalized schema."""
+import contextlib
 import sqlite3
 
 
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS jobs (
+  id TEXT PRIMARY KEY,
+  payload TEXT NOT NULL,
+  priority INTEGER NOT NULL,
+  dependencies TEXT NOT NULL,
+  max_attempts INTEGER NOT NULL,
+  spec_ready_at INTEGER NOT NULL,
+  ready_at INTEGER NOT NULL,
+  state TEXT NOT NULL,
+  attempts INTEGER NOT NULL,
+  worker TEXT,
+  lease_until INTEGER
+);
+CREATE INDEX IF NOT EXISTS idx_jobs_claim ON jobs(state, ready_at, priority, id);
+CREATE INDEX IF NOT EXISTS idx_jobs_lease ON jobs(state, lease_until);
+"""
+
+
+def _ensure_schema(conn):
+    # Detect legacy single-blob schema (id, data) vs normalized schema.
+    cur = conn.execute(
+        "SELECT sql FROM sqlite_master WHERE type='table' AND name='jobs'"
+    ).fetchone()
+    if cur is None or cur[0] is None:
+        conn.executescript(SCHEMA)
+        return
+    sql = cur[0]
+    # Normalized schema contains 'payload'; legacy contains 'data'.
+    if "payload" in sql and "spec_ready_at" in sql:
+        conn.executescript(SCHEMA)
+        return
+    # Legacy migration: jobs(id TEXT PRIMARY KEY, data TEXT NOT NULL)
+    import json as _json
+    try:
+        cols = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
+    except Exception:
+        cols = []
+    if cols == ["id", "data"]:
+        rows = conn.execute("SELECT id, data FROM jobs").fetchall()
+        conn.execute("ALTER TABLE jobs RENAME TO jobs_legacy")
+        conn.executescript(SCHEMA)
+        for jid, data in rows:
+            try:
+                v = _json.loads(data)
+            except Exception:
+                continue
+            try:
+                payload = _json.dumps(v.get("payload", {}), sort_keys=True, separators=(",", ":"))
+                priority = int(v.get("priority", 0))
+                deps = _json.dumps(sorted(set(v.get("dependencies", []))), separators=(",", ":"))
+                max_a = int(v.get("max_attempts", 3))
+                ra = int(v.get("ready_at", 0))
+                state = v.get("state", "pending")
+                attempts = int(v.get("attempts", 0))
+                worker = v.get("worker")
+                lease = v.get("lease_until")
+            except Exception:
+                continue
+            conn.execute(
+                "INSERT INTO jobs(id,payload,priority,dependencies,max_attempts,spec_ready_at,ready_at,state,attempts,worker,lease_until)"
+                " VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+                (jid, payload, priority, deps, max_a, ra, ra, state, attempts, worker, lease),
+            )
+        conn.execute("DROP TABLE jobs_legacy")
+    else:
+        conn.executescript(SCHEMA)
+
+
 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
-    connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
