+import copy
+import json
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+VIEW_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+def _claim_worker_mp(db_path, worker, out_q):
+    try:
+        from durable_queue import Queue as Q
+        qq = Q(db_path)
+        v = qq.claim(worker, 0, 60)
+        out_q.put((worker, v["id"] if v else None, v["attempts"] if v else None))
+    except Exception as e:
+        out_q.put((worker, "ERR:"+str(e), None))
+
+def tmp_queue(tmp):
+    return Queue(Path(tmp) / "q.db")
+
+def cli(db, req_obj=None, raw_bytes=None, req_text=None):
+    # helper: write request file then run CLI, return CompletedProcess
+    with tempfile.NamedTemporaryFile(mode="wb", delete=False, dir=str(Path(db).parent)) as f:
+        rp = Path(f.name)
+        if raw_bytes is not None:
+            f.write(raw_bytes)
+        elif req_text is not None:
+            f.write(req_text.encode("utf-8"))
+        else:
+            f.write(json.dumps(req_obj).encode("utf-8"))
+    try:
+        r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(rp)], capture_output=True)
+        return r
+    finally:
+        try: rp.unlink()
+        except: pass
+
+def cli_json(db, obj):
+    r = cli(db, req_obj=obj)
+    assert r.returncode == 0, (r.returncode, r.stderr)
+    assert r.stdout.endswith(b"\n")
+    assert r.stdout.count(b"\n") == 1
+    val = json.loads(r.stdout.decode("utf-8"))
+    return val, r
