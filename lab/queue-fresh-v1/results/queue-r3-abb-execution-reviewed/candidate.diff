+                {"op":"list","bogus":1},  # unknown field
+                {"op":"nosuch"},  # unknown op
+                {"bogus":1},  # missing op
+                ["list"],  # non-object
+                {"op":"get"},  # missing required
+                {"op":"get","id":"a","extra":1},
+                {"op":"claim","worker":"w","now":0},  # missing lease_seconds
+                {"op":"fail","id":"a","worker":"w","attempt":1,"now":0,"retry_delay":0,"x":1},
+                {"op":"submit","jobs":[{"id":"a","priority":True}]},  # API ValueError
+                {"op":"get","id":""},
+            ]
+            for req in cases:
+                r = cli(db, req_obj=req)
+                self.assertEqual(r.returncode, 2, req)
+                self.assertEqual(r.stdout, b"", req)
+            # malformed json
+            r = cli(db, req_text="{bad json")
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, b"")
+            # invalid utf-8
+            r = cli(db, raw_bytes=b"\xff\xfe")
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, b"")
+            # missing file
+            r = subprocess.run([sys.executable,"-m","durable_queue","--db",str(db),"--request",str(Path(tmp)/"nope.json")], capture_output=True)
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, b"")
+            # invalid usage (missing args)
+            r = subprocess.run([sys.executable,"-m","durable_queue","--db",str(db)], capture_output=True)
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, b"")
+            # unavailable db (is a directory)
+            r = cli(Path(tmp), req_obj={"op":"list"})
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, b"")
+
+if __name__ == "__main__":
+    unittest.main()
