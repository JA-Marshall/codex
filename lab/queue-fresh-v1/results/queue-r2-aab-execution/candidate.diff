+def _has_cycle(graph):
+    # graph: id -> list(deps)
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {n: WHITE for n in graph}
+    def dfs(u, stack):
+        color[u] = GRAY
+        for w in graph.get(u, []):
+            if w not in graph:
+                continue
+            if color[w] == GRAY:
+                return True
+            if color[w] == WHITE and dfs(w, stack):
+                return True
+        color[u] = BLACK
+        return False
+    for n in graph:
+        if color[n] == WHITE:
+            if dfs(n, []):
+                return True
+    return False
