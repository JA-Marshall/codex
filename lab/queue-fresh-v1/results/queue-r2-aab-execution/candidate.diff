 import argparse
 import json
+import sys
 
 from .queue import Queue
 
+_OPS = {"submit", "get", "list", "claim", "recover", "complete", "fail"}
+_REQUIRED = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now"},
+}
+_ALLOWED = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now", "retry_delay"},
+}
 
