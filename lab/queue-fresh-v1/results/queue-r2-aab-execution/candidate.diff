+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on invalid usage; ensure empty stdout (it uses stderr)
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            request = json.load(stream)
+        if not isinstance(request, dict):
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if not isinstance(op, str) or op not in _OPS:
+            raise ValueError("unknown operation")
+        keys = set(request.keys()) - {"op"}
+        if not keys.issubset(_ALLOWED[op]):
+            raise ValueError("unknown field")
+        if not _REQUIRED[op].issubset(keys):
+            raise ValueError("missing field")
+        kwargs = {k: request[k] for k in keys}
+        try:
+            queue = Queue(args.db)
+        except Exception:
+            raise ValueError("unavailable database")
+        try:
+            method = getattr(queue, op)
+        except AttributeError:
+            raise ValueError("unknown operation")
+        try:
+            value = method(**kwargs)
+        except TypeError as e:
+            raise ValueError(str(e))
+        sys.stdout.write(json.dumps(value, sort_keys=True) + "\n")
+        sys.stdout.flush()
+        return 0
+    except SystemExit:
+        raise
+    except (ValueError, TypeError, KeyError, OSError, IOError, UnicodeError, json.JSONDecodeError) as e:
+        # ensure nothing was written to stdout: we only write on success, so ok
+        return 2
+    except Exception:
+        return 2
 
 
