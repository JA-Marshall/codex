+                self.assertEqual(p.stdout, "")
+                p = call({"op": "get", "id": "b"})
+                self.assertEqual(p.returncode, 0)
+                self.assertIsNone(json.loads(p.stdout))
+
+
+if __name__ == "__main__":
+    unittest.main()
