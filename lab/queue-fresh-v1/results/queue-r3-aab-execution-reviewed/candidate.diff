+def _has_cycle(graph):
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {node: WHITE for node in graph}
+
+    def dfs(node):
+        color[node] = GRAY
+        for dep in graph.get(node, []):
+            if dep not in graph:
+                continue
+            if color[dep] == GRAY:
+                return True
+            if color[dep] == WHITE:
+                if dfs(dep):
+                    return True
+        color[node] = BLACK
+        return False
+
+    for node in graph:
+        if color[node] == WHITE:
+            if dfs(node):
+                return True
+    return False
+
+
+def _recover_view_in_place(view, now):
+    if view.get("state") != "running":
+        return False
+    lu = view.get("lease_until")
+    if type(lu) is not int:
