+                    "id": view.get("id", jid),
+                    "payload": view.get("payload", {}),
+                    "priority": view.get("priority", 0),
+                    "dependencies": sorted(set(view.get("dependencies", []))),
+                    "max_attempts": view.get("max_attempts", 3),
+                    "ready_at": view.get("ready_at", 0),
+                }
+                # Ensure dependencies sorted unique strings; if invalid, keep as-is list.
+                deps = spec["dependencies"]
+                if not isinstance(deps, list):
+                    deps = []
+                    spec["dependencies"] = deps
+                connection.execute(
+                    "UPDATE jobs SET spec=? WHERE id=?",
+                    (json.dumps(spec, sort_keys=True), jid),
+                )
+            except Exception:
+                continue
+    except Exception:
+        connection.close()
+        raise
     return connection
