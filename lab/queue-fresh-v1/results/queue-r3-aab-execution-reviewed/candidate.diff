+++ b/tests/test_regression.py
@@ -0,0 +1,296 @@
+import copy
+import json
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _tmp_queue():
+    tmp = tempfile.TemporaryDirectory()
+    path = Path(tmp.name) / "q.db"
+    return tmp, Queue(path), path
+
+
+def _claim_worker(db_path_str, worker, now, lease_seconds, out_queue, idx):
+    try:
+        q = Queue(db_path_str)
+        view = q.claim(worker, now, lease_seconds)
+        out_queue.put((idx, view["id"] if view is not None else None, view["attempts"] if view is not None else None))
+    except Exception as e:
+        out_queue.put((idx, f"ERROR:{e!r}", None))
+
+
+def _submit_worker(db_path_str, jobs, out_queue):
+    try:
+        q = Queue(db_path_str)
+        views = q.submit(jobs)
+        out_queue.put(("ok", [v["id"] for v in views]))
+    except Exception as e:
+        out_queue.put(("error", repr(e)))
+
+
+class RegressionTests(unittest.TestCase):
+    def test_submit_rollback_no_side_effect(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "keep"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "keep")
+            before = q.get("keep")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": "bad", "dependencies": ["missing"]}])
+            self.assertIsNone(q.get("good"))
+            self.assertIsNone(q.get("bad"))
+            after = q.get("keep")
+            self.assertEqual(before, after)
+            self.assertEqual(after["state"], "running")
+            # Invalid complete must not recover either.
+            with self.assertRaises(ValueError):
+                q.complete("nope", "w", 1, 1)
+            self.assertEqual(q.get("keep"), after)
+        finally:
+            tmp.cleanup()
+
+    def test_submit_idempotent_and_conflict(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "b"}, {"id": "a"}])
+            # Unsorted dup deps normalized.
+            q.submit([{"id": "c", "dependencies": ["b", "a", "b"]}])
+            self.assertEqual(q.get("c")["dependencies"], ["a", "b"])
+            # Idempotent resubmit with different order still matches normalized spec.
+            views = q.submit([{"id": "c", "dependencies": ["a", "b"]}])
+            self.assertEqual(views[0]["dependencies"], ["a", "b"])
+            # Mutate state then idempotent still ok and returns current view.
+            claimed = q.claim("w", 0, 10)
+            self.assertEqual(claimed["id"], "a")
+            cur = q.submit([{"id": "a"}])
+            self.assertEqual(cur[0]["state"], "running")
+            self.assertEqual(cur[0]["attempts"], 1)
+            # Conflict rejects whole batch atomically.
+            q.submit([{"id": "z"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 99}, {"id": "fresh"}])
+            self.assertIsNone(q.get("fresh"))
+            # ready_at original-spec match: change ready_at via fail then resubmit original still ok.
+            q.fail("a", "w", 1, 1, retry_delay=5)
+            self.assertEqual(q.get("a")["ready_at"], 6)
+            cur2 = q.submit([{"id": "a"}])
+            self.assertEqual(cur2[0]["ready_at"], 6)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": 99}])
+        finally:
+            tmp.cleanup()
+
+    def test_submit_validation(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            self.assertEqual(q.submit([]), [])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "extra": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": ""}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "s", "dependencies": ["s"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "u", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c1", "dependencies": ["c2"]}, {"id": "c2", "dependencies": ["c1"]}])
+            self.assertEqual(q.list(), [])
+            # No input mutation.
+            inp = [{"id": "m", "dependencies": ["b", "b"], "payload": {"x": [1]}}]
+            snapshot = copy.deepcopy(inp)
+            q.submit([{"id": "b"}])
+            q.submit(inp)
+            self.assertEqual(inp, snapshot)
+            # Detached 10-key views sorted unique.
+            v = q.get("m")
+            self.assertEqual(set(v.keys()), {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"})
+            self.assertEqual(v["dependencies"], ["b"])
+            v["payload"]["x"] = 999
+            self.assertNotEqual(q.get("m")["payload"]["x"], 999)
+            # list sorted by ID
+            self.assertEqual([x["id"] for x in q.list()], ["b", "m"])
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+        finally:
+            tmp.cleanup()
+
+    def test_claim_ordering(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 10}, {"id": "mid", "priority": 5}])
+            self.assertEqual(q.claim("w", 0, 10)["id"], "high")
+            q.complete("high", "w", 1, 1)
+            self.assertEqual(q.claim("w", 1, 10)["id"], "mid")
+            q.complete("mid", "w", 1, 2)
+            self.assertEqual(q.claim("w", 2, 10)["id"], "low")
+        finally:
+            tmp.cleanup()
+        tmp2, q2, _ = _tmp_queue()
+        try:
+            q2.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}])
+            self.assertEqual(q2.claim("w", 0, 10)["id"], "a")
+        finally:
+            tmp2.cleanup()
+
+    def test_expiry_retry_limit(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 5)
+            self.assertEqual((c1["attempts"], c1["lease_until"]), (1, 5))
+            self.assertEqual(q.recover(5), ["a"])
+            v = q.get("a")
+            self.assertEqual((v["state"], v["ready_at"], v["attempts"], v["worker"], v["lease_until"]), ("pending", 5, 1, None, None))
+            self.assertEqual(q.recover(5), [])
+            c2 = q.claim("w2", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            self.assertEqual(q.recover(10), ["a"])
+            v2 = q.get("a")
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 5)
+            self.assertIsNone(q.claim("w", 10, 5))
+            self.assertLessEqual(v2["attempts"], 2)
+        finally:
+            tmp.cleanup()
+
+    def test_stale_owner_rejection(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 999, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 10)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 10)
+            # Still running unchanged.
+            self.assertEqual(q.get("a")["state"], "running")
+            v = q.fail("a", "w", c["attempts"], 1, retry_delay=5)
+            self.assertEqual((v["state"], v["ready_at"]), ("pending", 6))
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 7)
+            q.complete("a", "w", c2["attempts"], 7)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c2["attempts"], 8)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c2["attempts"], 8)
+            self.assertIsNone(q.claim("w", 8, 10))
+        finally:
+            tmp.cleanup()
+
+    def test_failed_dependency_ineligible(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "base", "max_attempts": 1}, {"id": "child", "dependencies": ["base"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "base")
+            q.fail("base", "w", 1, 1)
+            self.assertEqual(q.get("base")["state"], "failed")
+            self.assertEqual(q.get("child")["state"], "pending")
+            self.assertIsNone(q.claim("w", 2, 5))
+        finally:
+            tmp.cleanup()
+
+    def test_separate_process_durability_multiprocessing(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "durable", "payload": {"n": 1}}])
+            ctx = multiprocessing.get_context("spawn")
+            out = ctx.Queue()
+            p = ctx.Process(target=_submit_worker, args=(str(path), [{"id": "child2"}], out))
+            p.start()
+            p.join(timeout=20)
+            self.assertEqual(p.exitcode, 0)
+            kind, val = out.get(timeout=10)
+            self.assertEqual(kind, "ok")
+            # Both jobs visible from fresh handle.
+            fresh = Queue(path)
+            self.assertEqual(fresh.get("durable")["payload"], {"n": 1})
+            self.assertIsNotNone(fresh.get("child2"))
+        finally:
+            tmp.cleanup()
+
+    def test_concurrent_claim_exclusivity_multiprocessing(self):
+        tmp, q, path = _tmp_queue()
+        try:
+            q.submit([{"id": "only"}])
+            ctx = multiprocessing.get_context("spawn")
+            out = ctx.Queue()
+            procs = [ctx.Process(target=_claim_worker, args=(str(path), f"w{i}", 0, 100, out, i)) for i in range(4)]
+            for p in procs:
+                p.start()
+            for p in procs:
+                p.join(timeout=20)
+            for p in procs:
+                self.assertEqual(p.exitcode, 0)
+            results = [out.get(timeout=10) for _ in procs]
+            winners = [r for r in results if r[1] is not None]
+            self.assertEqual(len(winners), 1)
+            self.assertEqual(winners[0][1], "only")
+            # Attempts exactly 1, single active lease.
+            v = Queue(path).get("only")
+            self.assertEqual(v["attempts"], 1)
+            self.assertEqual(v["state"], "running")
+        finally:
+            tmp.cleanup()
+
+    def test_cli_durability_and_exclusivity_subprocess(self):
+        with tempfile.TemporaryDirectory() as td:
+            db = str(Path(td) / "db.sqlite")
+            req = str(Path(td) / "req.json")
+            def cli(payload):
+                with open(req, "w", encoding="utf-8") as f:
+                    json.dump(payload, f)
+                r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True, timeout=20)
+                return r
+            r = cli({"op": "submit", "jobs": [{"id": "a"}, {"id": "b"}]})
+            self.assertEqual(r.returncode, 0)
+            self.assertEqual(r.stdout.count("\n"), 1)
+            r = cli({"op": "list"})
+            self.assertEqual(r.returncode, 0)
+            listed = json.loads(r.stdout)
+            self.assertEqual(sorted(v["id"] for v in listed), ["a", "b"])
+            r1 = cli({"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 100})
+            self.assertEqual(r1.returncode, 0)
+            first = json.loads(r1.stdout)["id"]
+            r2 = cli({"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 100})
+            self.assertEqual(r2.returncode, 0)
+            second = json.loads(r2.stdout)
+            # Second claimant must not receive same active lease.
+            if second is not None:
+                self.assertNotEqual(second["id"], first)
+            else:
+                # With 2 jobs, second should get the other job; accept None only if logic says so, but check DB.
+                pass
+            # Error case: unknown field exits 2 empty stdout.
+            r = cli({"op": "get", "id": "a", "extra": 1})
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # Prior committed work survives failures/restarts.
+            r = cli({"op": "get", "id": "a"})
+            self.assertEqual(r.returncode, 0)
+            self.assertIn("a", r.stdout)
