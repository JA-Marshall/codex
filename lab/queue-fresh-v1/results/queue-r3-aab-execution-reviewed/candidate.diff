+        # If help exited 0, argparse printed to stdout -> violates empty-stdout on non-JSON. Convert 0 to 2? But -h is not part of contract.
+        # Preserve argparse code except force 2 for any parse failure/success that is not JSON success.
+        code = e.code
+        if code != 0:
+            raise
+        # --help case: exit 2 with empty stdout is impossible since help already printed. Re-exit 2.
+        raise SystemExit(2)
+    if not args.db or not args.request:
+        return 2
+    # Read request file as UTF-8 strict.
+    try:
