+        except ValueError:
+            return 2
+        except TypeError:
+            return 2
+        except Exception:
+            # Unavailable database (sqlite errors, OSError) -> exit 2.
+            # Any other unexpected error also maps to 2 per "unavailable database" safety.
+            return 2
+    except SystemExit:
+        raise
+    except Exception:
+        return 2
+    try:
+        out = json.dumps(value, sort_keys=True, allow_nan=False)
+    except Exception:
+        return 2
