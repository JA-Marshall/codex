+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on error; ensure stdout empty (it uses stderr)
+        # Re-raise to preserve exit code
+        raise
+    # Read request file strict UTF-8
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+    except Exception:
+        return _fail()
+    try:
+        request = json.loads(text)
+    except Exception:
+        return _fail()
+    if not isinstance(request, dict):
+        return _fail()
+    if "op" not in request:
+        return _fail()
+    op = request.get("op")
+    if not isinstance(op, str) or op not in _OPS:
+        return _fail()
+    keys = set(request.keys()) - {"op"}
+    allowed = _ALLOWED[op]
+    required = _REQUIRED[op]
+    # No unknown fields
+    if not keys <= allowed:
+        return _fail()
+    if not required <= keys:
+        return _fail()
+    kwargs = {k: request[k] for k in keys}
+    # Dispatch with DB availability handling
+    try:
+        queue = Queue(args.db)
+    except Exception:
+        return _fail()
+    try:
+        method = getattr(queue, op)
+        value = method(**kwargs)
+    except ValueError:
+        return _fail()
+    except TypeError:
+        return _fail()
+    except Exception:
+        # Any other API error that is not ValueError? Contract says API ValueError -> exit2.
+        # For unavailable database (sqlite errors) -> exit2 as well.
+        return _fail()
+    try:
+        out = json.dumps(value, sort_keys=True, allow_nan=False)
+    except Exception:
+        return _fail()
+    sys.stdout.write(out + "\n")
     return 0
 
 
