+class SubprocessDurabilityTests(unittest.TestCase):
+    def _run_cli(self, db, req_obj):
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, dir=Path(db).parent) as f:
+            json.dump(req_obj, f)
+            req_path = f.name
+        try:
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req_path], capture_output=True, text=True, timeout=20)
+            return p
+        finally:
+            try:
+                Path(req_path).unlink()
+            except Exception:
+                pass
+
+    def test_submit_survives_restart_via_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            p = self._run_cli(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"x": 1}}]})
+            self.assertEqual(p.returncode, 0, msg=p.stderr)
+            # fresh process list
+            p2 = self._run_cli(db, {"op": "list"})
+            self.assertEqual(p2.returncode, 0)
+            data = json.loads(p2.stdout)
+            self.assertEqual(len(data), 1)
+            self.assertEqual(data[0]["id"], "a")
+
+    def test_separate_processes_never_share_active_lease(self):
+        import concurrent.futures as cf
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            q = Queue(db)
+            q.submit([{"id": "a"}, {"id": "b"}, {"id": "c"}])
+            def _claim_via_cli(worker):
+                import json as _j, subprocess as _sp, sys as _sys, tempfile as _tf
+                from pathlib import Path as _P
+                with _tf.NamedTemporaryFile(mode="w", suffix=".json", delete=False, dir=str(_P(db).parent)) as _f:
+                    _j.dump({"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30}, _f)
+                    _rp = _f.name
+                try:
+                    _p = _sp.run([_sys.executable, "-m", "durable_queue", "--db", str(db), "--request", _rp], capture_output=True, text=True, timeout=20)
+                    if _p.returncode != 0:
+                        return "ERR:" + _p.stderr
+                    _v = _j.loads(_p.stdout)
+                    return _v["id"] if _v else None
+                finally:
+                    try:
+                        _P(_rp).unlink()
+                    except Exception:
+                        pass
+            with cf.ThreadPoolExecutor(max_workers=3) as ex:
+                futs = [ex.submit(_claim_via_cli, f"w{i}") for i in range(3)]
+                ids = [f.result(timeout=20) for f in futs]
+            self.assertEqual(sorted(ids), ["a", "b", "c"])
+            # verify no duplicate active leases in db
+            states = {v["id"]: v for v in Queue(db).list()}
+            workers = [states[i]["worker"] for i in ["a", "b", "c"]]
+            self.assertEqual(len(set(workers)), 3)
+            self.assertTrue(all(s["state"] == "running" for s in [states[i] for i in ["a", "b", "c"]]))
