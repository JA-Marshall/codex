+            p = run_cli(db, {"op": "list"})
+            self.assertEqual(p.returncode, 0)
+            ids = [x["id"] for x in json.loads(p.stdout)]
+            self.assertIn("a", ids)
+            # concurrent CLI claims exclusivity: fresh db with single job
+            with tempfile.TemporaryDirectory() as tmp2:
+                db2 = str(Path(tmp2) / "q.db")
+                p = run_cli(db2, {"op": "submit", "jobs": [{"id": "only"}]})
+                self.assertEqual(p.returncode, 0)
+                # launch two CLI claims concurrently
+                req1 = str(Path(tmp2) / "req1.json")
+                req2 = str(Path(tmp2) / "req2.json")
+                Path(req1).write_text(json.dumps({"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 10}), encoding="utf-8")
+                Path(req2).write_text(json.dumps({"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 10}), encoding="utf-8")
+                p1 = subprocess.Popen([sys.executable, "-m", "durable_queue", "--db", db2, "--request", req1], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+                p2 = subprocess.Popen([sys.executable, "-m", "durable_queue", "--db", db2, "--request", req2], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+                o1, _ = p1.communicate(timeout=15)
+                o2, _ = p2.communicate(timeout=15)
+                self.assertEqual(p1.returncode, 0)
+                self.assertEqual(p2.returncode, 0)
+                v1 = json.loads(o1) if o1.strip() != "null" else None
+                v2 = json.loads(o2) if o2.strip() != "null" else None
+                got = [v1, v2]
+                # one must be the job, other null
+                non_null = [g for g in got if g is not None]
+                nulls = [g for g in got if g is None]
+                self.assertEqual(len(non_null), 1)
+                self.assertEqual(len(nulls), 1)
+                self.assertEqual(non_null[0]["id"], "only")
