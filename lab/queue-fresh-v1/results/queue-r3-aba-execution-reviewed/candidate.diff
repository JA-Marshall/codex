+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on usage error; ensure stdout empty (it uses stderr)
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            request = json.load(stream)
+        if type(request) is not dict:
+            raise ValueError("non-object request")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if type(op) is not str or op not in _OPS:
+            raise ValueError("unknown op")
+        kwargs = {k: v for k, v in request.items() if k != "op"}
+        allowed = _ALLOWED[op]
+        required = _REQUIRED[op]
+        keys = set(kwargs.keys())
+        if not keys.issubset(allowed):
+            raise ValueError("unknown field")
+        if not required.issubset(keys):
+            raise ValueError("missing field")
+        queue = Queue(args.db)
+        method = getattr(queue, op)
+        value = method(**kwargs)
+        out = json.dumps(value, sort_keys=True, allow_nan=False, ensure_ascii=False)
+        sys.stdout.write(out + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except Exception as e:
+        # Any ValueError/IO/usage/DB failure -> exit 2 empty stdout
+        try:
+            sys.stderr.write(f"error: {e}\n")
+        except Exception:
+            pass
+        return 2
 
 
