+"""Regression tests for durable_queue contract (S4)."""
+import copy
+import json
+import math
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def mkpath(tmp):
+    return Path(tmp) / "q.db"
+
+
+def run_cli(db, request_obj=None, raw_bytes=None):
+    # helper using repo-local temp for request file when db is persistent dir
+    # db is path string; request file alongside db
+    import os
+    dbp = str(db)
+    parent = str(Path(dbp).parent)
+    req = str(Path(parent) / "req_cli.json")
+    if raw_bytes is not None:
+        Path(req).write_bytes(raw_bytes)
+    else:
+        Path(req).write_text(json.dumps(request_obj), encoding="utf-8")
+    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", dbp, "--request", req],
+                       capture_output=True, text=True)
+    return p
+
