+class ProcessTests(unittest.TestCase):
+    def test_separate_process_reopen_persists(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(mkpath(tmp))
+            Queue(db).submit([{"id": "a", "payload": {"x": 1}}])
+            # reopen in separate process via multiprocessing
+            ctx = multiprocessing.get_context("spawn")
+            out = ctx.Queue()
+            p = ctx.Process(target=_reopen_get, args=(db, out))
+            p.start(); p.join(10)
+            self.assertEqual(p.exitcode, 0)
+            view = out.get(timeout=5)
+            self.assertEqual(view["payload"], {"x": 1})
