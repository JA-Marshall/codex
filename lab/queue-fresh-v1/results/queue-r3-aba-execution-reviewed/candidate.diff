+def _reopen_get(db_path, out_q):
+    from durable_queue import Queue as Q2
+    q = Q2(db_path).get("a")
+    out_q.put(q)
+
+
+def _claim_worker(db_path, worker, now, lease, out_q):
+    from durable_queue import Queue as Q
+    try:
+        qq = Q(db_path)
+        v = qq.claim(worker, now, lease)
+        out_q.put((worker, v["id"] if v else None, v["attempts"] if v else None))
+    except Exception as e:
+        out_q.put((worker, f"ERR:{e}", None))
+
