+class CLITests(unittest.TestCase):
+    def test_cli_success_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a", "priority": 2}]})
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            val = json.loads(p.stdout)
+            # sorted keys check: raw stdout should have keys sorted
+            raw = p.stdout.strip()
+            # json dumps sorted ensures order; verify by reloading with sort
+            self.assertEqual(raw, json.dumps(val, sort_keys=True))
+            for op_req, check in [
+                ({"op": "get", "id": "a"}, lambda v: v["id"] == "a"),
+                ({"op": "list"}, lambda v: isinstance(v, list)),
+                ({"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10}, lambda v: v["id"] == "a"),
+                ({"op": "recover", "now": 5}, lambda v: v == []),
+            ]:
+                pp = run_cli(db, op_req)
+                self.assertEqual(pp.returncode, 0, f"{op_req} {pp.stderr}")
+                self.assertTrue(pp.stdout.endswith("\n"))
+                self.assertTrue(check(json.loads(pp.stdout)))
+
+    def test_cli_errors_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            cases = [
+                {"op": "submit", "jobs": [{"id": "x", "bogus": 1}]},
+                {"op": "unknown"},
+                {"op": "list", "extra": 1},
+                {"op": "get"},
+                {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10},
+                {"op": "recover", "now": True},
+                [1, 2],
+                {"jobs": []},
+            ]
+            for c in cases:
+                p = run_cli(db, c)
+                self.assertEqual(p.returncode, 2, f"case {c} got {p.returncode} {p.stderr}")
+                self.assertEqual(p.stdout, "", f"case {c}")
+            # malformed json
+            p = run_cli(db, raw_bytes=b"{not json")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid utf8
+            p = run_cli(db, raw_bytes=b"\xff\xfe")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing file
+            missing = str(Path(tmp) / "missing.json")
+            pp = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", missing], capture_output=True, text=True)
+            self.assertEqual(pp.returncode, 2)
+            self.assertEqual(pp.stdout, "")
+            # unavailable db
+            bad_db = str(Path(tmp) / "no_dir" / "q.db")
+            req = str(Path(tmp) / "r.json")
+            Path(req).write_text(json.dumps({"op": "list"}), encoding="utf-8")
+            pp = subprocess.run([sys.executable, "-m", "durable_queue", "--db", bad_db, "--request", req], capture_output=True, text=True)
+            self.assertEqual(pp.returncode, 2)
+            self.assertEqual(pp.stdout, "")
