+            q = Queue(mkpath(tmp))
+            q.submit([{"id": "a", "ready_at": 10}, {"id": "b", "max_attempts": 1}])
+            # b ready at 0, a not ready until 10, so first claim gets b
+            self.assertEqual(q.claim("w", 0, 10)["id"], "b")
+            # reset
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(mkpath(tmp))
+            q.submit([{"id": "dep"}, {"id": "main", "dependencies": ["dep"]}])
+            self.assertEqual(q.claim("w", 0, 10)["id"], "dep")
+            # main ineligible until dep succeeded
+            # claim again should be None (dep running, main blocked)
+            self.assertIsNone(q.claim("w2", 0, 10))
