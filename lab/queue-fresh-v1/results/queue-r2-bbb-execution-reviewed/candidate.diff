+"""Storage helpers: WAL, timeouts, schema, strict validators."""
+import json
+import math
 import sqlite3
 
+BUSY_TIMEOUT_MS = 5000
+
+SCHEMA_SQL = """
+CREATE TABLE IF NOT EXISTS jobs (
+    id TEXT PRIMARY KEY,
+    payload TEXT NOT NULL,
+    priority INTEGER NOT NULL,
+    dependencies TEXT NOT NULL,
+    max_attempts INTEGER NOT NULL,
+    ready_at INTEGER NOT NULL,
+    state TEXT NOT NULL,
+    attempts INTEGER NOT NULL,
+    worker TEXT,
+    lease_until INTEGER,
+    spec TEXT NOT NULL
+)
+"""
+
+
+def _ensure_schema(connection):
+    # Detect legacy schema (id, data) and migrate, else create new schema.
+    cur = connection.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='jobs'"
+    ).fetchone()
+    if cur is None:
+        connection.execute(SCHEMA_SQL)
+        connection.commit()
+        return
+    cols = [r[1] for r in connection.execute("PRAGMA table_info(jobs)").fetchall()]
+    if "data" in cols and "spec" not in cols:
+        # Legacy migration: read old rows, rebuild new table.
+        rows = connection.execute("SELECT id, data FROM jobs").fetchall()
+        connection.execute("DROP TABLE jobs")
+        connection.execute(SCHEMA_SQL)
+        for old_id, old_data in rows:
+            try:
+                view = json.loads(old_data)
+            except Exception:
+                continue
+            # Reconstruct normalized spec from old view submission fields.
+            payload = view.get("payload", {})
+            priority = view.get("priority", 0)
+            deps = sorted(set(view.get("dependencies", []))) if isinstance(view.get("dependencies", []), list) else []
+            max_attempts = view.get("max_attempts", 3)
+            ready_at = view.get("ready_at", 0)
+            state = view.get("state", "pending")
+            attempts = view.get("attempts", 0)
+            worker = view.get("worker")
+            lease_until = view.get("lease_until")
+            spec = {
+                "id": old_id,
+                "payload": payload,
+                "priority": priority,
+                "dependencies": deps,
+                "max_attempts": max_attempts,
+                "ready_at": ready_at,
+            }
+            # Coerce types defensively for legacy data (already validated at write time).
+            connection.execute(
+                "INSERT INTO jobs (id, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until, spec) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+                (
+                    old_id,
+                    json.dumps(payload, sort_keys=True),
+                    int(priority),
+                    json.dumps(deps, sort_keys=True),
+                    int(max_attempts),
+                    int(ready_at),
+                    str(state),
+                    int(attempts),
+                    worker,
+                    lease_until,
+                    json.dumps(spec, sort_keys=True),
+                ),
+            )
+        connection.commit()
+        return
+    # Ensure new schema exists (no-op if already correct).
+    connection.execute(SCHEMA_SQL)
+    connection.commit()
+
 
 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
-    connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
-    )
+    # timeout in seconds for sqlite3; also set busy_timeout pragma in ms.
+    connection = sqlite3.connect(str(path), timeout=30.0, isolation_level=None)
+    try:
+        connection.execute("PRAGMA journal_mode=WAL")
+        connection.execute(f"PRAGMA busy_timeout={BUSY_TIMEOUT_MS}")
+        connection.execute("PRAGMA synchronous=NORMAL")
+    except Exception:
+        pass
+    # Ensure schema in autocommit mode, then return connection.
+    # _ensure_schema commits internally.
+    _ensure_schema(connection)
     return connection
