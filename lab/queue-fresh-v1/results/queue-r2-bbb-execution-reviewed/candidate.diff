+# ---- strict validators ----
+def is_strict_int(v):
+    return type(v) is int
+
+
+def validate_id(v):
+    if not isinstance(v, str) or len(v) == 0:
+        raise ValueError("invalid id")
+
+
+def validate_worker(v):
+    if not isinstance(v, str) or len(v) == 0:
+        raise ValueError("invalid worker")
+
+
+def validate_now(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid now")
+
+
+def validate_lease_seconds(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("invalid lease_seconds")
+
+
+def validate_attempt(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("invalid attempt")
+
+
+def validate_retry_delay(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid retry_delay")
+
+
+def validate_priority(v):
+    if type(v) is not int:
+        raise ValueError("invalid priority")
+
+
+def validate_max_attempts(v):
+    if type(v) is not int or not (1 <= v <= 100):
+        raise ValueError("invalid max_attempts")
+
+
+def validate_ready_at(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid ready_at")
+
+
+def _check_json_value(v):
+    if v is None:
+        return
+    if isinstance(v, bool):
+        return
+    if type(v) is int:
+        return
+    if isinstance(v, float):
+        if not math.isfinite(v):
+            raise ValueError("non-finite JSON number")
+        return
+    if isinstance(v, str):
+        return
+    if isinstance(v, list):
+        for item in v:
+            _check_json_value(item)
+        return
+    if isinstance(v, dict):
+        for k, item in v.items():
+            if not isinstance(k, str):
+                raise ValueError("invalid JSON object key")
+            _check_json_value(item)
+        return
+    raise ValueError("invalid JSON value")
+
+
+def validate_payload(v):
+    if not isinstance(v, dict):
+        raise ValueError("invalid payload")
+    _check_json_value(v)
+
+
+def validate_dependencies_raw(v):
+    if not isinstance(v, list):
+        raise ValueError("invalid dependencies")
+    for item in v:
+        if not isinstance(item, str) or len(item) == 0:
+            raise ValueError("invalid dependency id")
