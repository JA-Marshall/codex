+    args = parser.parse_args(argv)
+    db_path = args.db
+    req_path = args.request
+    try:
+        with open(req_path, "rb") as f:
+            raw = f.read()
+        try:
+            text = raw.decode("utf-8")
+        except UnicodeDecodeError:
+            return 2
+        try:
+            request = json.loads(text)
+        except Exception:
+            return 2
+        if not isinstance(request, dict):
+            return 2
+        if "op" not in request:
+            return 2
+        op = request["op"]
+        if op not in _OPS:
+            return 2
+        allowed = _ALLOWED[op]
+        required = _REQUIRED[op]
+        keys = set(request.keys())
+        # op must be present; no unknown fields beyond op+allowed
+        if not keys.issubset({"op"} | allowed):
+            return 2
+        if not required.issubset(keys):
+            return 2
+        kwargs = {k: request[k] for k in allowed if k in request}
+        try:
+            queue = Queue(db_path)
+        except Exception:
+            return 2
+        try:
+            method = getattr(queue, op)
+            value = method(**kwargs)
+        except (ValueError, TypeError):
+            return 2
+        except Exception:
+            return 2
+        try:
+            out = json.dumps(value, sort_keys=True)
+        except Exception:
+            return 2
+        sys.stdout.write(out + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except Exception:
+        return 2
 
 
