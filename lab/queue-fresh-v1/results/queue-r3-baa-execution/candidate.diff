+        "priority INTEGER NOT NULL, "
+        "dependencies TEXT NOT NULL, "
+        "max_attempts INTEGER NOT NULL, "
+        "ready_at INTEGER NOT NULL)"
     )
-    return connection
+    conn.execute(
+        "CREATE TABLE IF NOT EXISTS jobs ("
+        "id TEXT PRIMARY KEY, "
+        "state TEXT NOT NULL, "
+        "attempts INTEGER NOT NULL, "
+        "worker TEXT, "
+        "lease_until INTEGER, "
+        "ready_at INTEGER NOT NULL, "
+        "FOREIGN KEY(id) REFERENCES specs(id))"
+    )
+
+
+def connect(path):
+    """Open SQLite DB, enable WAL+timeout, ensure schema. Caller must close."""
+    conn = sqlite3.connect(str(path), timeout=30.0, isolation_level=None)
+    _apply_pragmas(conn)
+    _ensure_schema(conn)
+    return conn
+
+
+@contextlib.contextmanager
+def transaction(path):
+    """BEGIN IMMEDIATE transaction; commit on success, rollback on error."""
+    conn = connect(path)
+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        yield conn
+        conn.execute("COMMIT")
+    except Exception:
+        try:
+            conn.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
