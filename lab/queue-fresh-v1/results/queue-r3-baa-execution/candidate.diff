+class MultiprocessTests(unittest.TestCase):
+    def test_submit_survives_restart_separate_process(self):
+        with tempfile.TemporaryDirectory() as td:
+            db = str(Path(td) / "q.db")
+            Queue(db).submit([{"id": "init"}])
+            ctx = multiprocessing.get_context("spawn")
+            p = ctx.Process(target=_child_submit, args=(db, [{"id": "from-child", "payload": {"v": 1}}]))
+            p.start()
+            p.join(timeout=20)
+            self.assertEqual(p.exitcode, 0)
+            q = Queue(db)
+            self.assertEqual(q.get("from-child")["payload"], {"v": 1})
+            self.assertIsNotNone(q.get("init"))
+
+    def test_concurrent_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as td:
+            db = str(Path(td) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": "solo"}])
+            ctx = multiprocessing.get_context("spawn")
+            out_q = ctx.Queue()
+            barrier = ctx.Barrier(4)
+            procs = [
+                ctx.Process(target=_child_claim, args=(db, f"w{i}", 0, 10, out_q, barrier))
+                for i in range(4)
+            ]
+            for p in procs:
+                p.start()
+            for p in procs:
+                p.join(timeout=20)
+            for p in procs:
+                self.assertEqual(p.exitcode, 0)
+            results = []
+            while not out_q.empty():
+                results.append(out_q.get())
+            self.assertEqual(len(results), 4)
+            winners = [r for r in results if r[1] == "solo"]
+            nones = [r for r in results if r[1] is None]
+            self.assertEqual(len(winners), 1, results)
+            self.assertEqual(len(nones), 3, results)
+            # attempts must be exactly 1, no double-claim
+            self.assertEqual(Queue(db).get("solo")["attempts"], 1)
