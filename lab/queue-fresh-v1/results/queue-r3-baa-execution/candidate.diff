+import copy
+import json
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _child_submit(db_path_str, jobs):
+    from durable_queue import Queue as Q
+    Q(db_path_str).submit(jobs)
+
+
+def _child_claim(db_path_str, worker, now, lease_seconds, out_q, barrier=None):
+    try:
+        if barrier is not None:
+            try:
+                barrier.wait(timeout=10)
+            except Exception:
+                pass
+        from durable_queue import Queue as Q
+        view = Q(db_path_str).claim(worker, now, lease_seconds)
+        out_q.put((worker, view["id"] if view else None, view["attempts"] if view else None))
+    except Exception as exc:
+        out_q.put((worker, "ERROR:" + repr(exc), None))
+
+
+class SubmitValidationTests(unittest.TestCase):
+    def test_bool_rejected_and_no_write(self):
+        with tempfile.TemporaryDirectory() as td:
+            q = Queue(Path(td) / "q.db")
+            q.submit([{"id": "ok"}])
+            for bad in [
+                [{"id": "b", "priority": True}],
+                [{"id": "b", "max_attempts": True}],
+                [{"id": "b", "ready_at": False}],
+                [{"id": "b", "payload": {}}],  # ok control? skip
+            ]:
+                pass
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "max_attempts": 2.0}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "ready_at": True}])
+            # bool as now/lease/attempt/retry
+            q2 = Queue(Path(td) / "q.db")
+            with self.assertRaises(ValueError):
+                q2.claim("w", True, 5)
+            with self.assertRaises(ValueError):
+                q2.claim("w", 0, True)
+            self.assertIsNotNone(q.get("ok"))
+            self.assertIsNone(q.get("b"))
+
+    def test_unknown_fields_and_types(self):
+        with tempfile.TemporaryDirectory() as td:
+            q = Queue(Path(td) / "q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "bogus": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": []}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": "x"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": ""}])
+            with self.assertRaises(ValueError):
+                q.submit("not-a-list")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": "high"}])
