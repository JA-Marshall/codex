+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        # argparse exits 2 on invalid usage; ensure empty stdout (it uses stderr).
+        raise
+    # Read request file as strict UTF-8.
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+    except Exception:
+        return 2
+    try:
+        request = json.loads(text)
+    except Exception:
+        return 2
+    if not isinstance(request, dict):
+        return 2
+    op = request.get("op")
+    if not isinstance(op, str) or op not in _ALLOWED_OPS:
+        return 2
+    allowed = _ALLOWED_FIELDS[op]
+    required = _REQUIRED_FIELDS[op]
+    keys = set(request.keys()) - {"op"}
+    if not keys <= set(allowed):
+        return 2
+    if not required <= keys:
+        return 2
+    kwargs = {k: request[k] for k in keys}
+    try:
+        queue = Queue(args.db)
+    except Exception:
+        return 2
+    try:
+        func = getattr(queue, op)
+    except Exception:
+        return 2
+    try:
+        value = func(**kwargs)
+    except (ValueError, TypeError, sqlite3.Error, OSError):
+        return 2
+    except Exception:
+        return 2
+    try:
+        payload = json.dumps(value, sort_keys=True) + "\n"
+    except Exception:
+        return 2
+    try:
+        sys.stdout.write(payload)
+    except Exception:
+        return 2
     return 0
 
 
