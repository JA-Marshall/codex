+    def test_expiry_retry_stale_matrix(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "j", "max_attempts": 2}])
+            c1 = q.claim("w1", 0, 10)
+            # stale: wrong attempt after reclaim
+            q.recover(10)
+            c2 = q.claim("w1", 10, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("j", "w1", 1, 11)
+            # fail last attempt -> failed, ready_at unchanged (10)
+            v = q.fail("j", "w1", 2, 11, retry_delay=5)
+            self.assertEqual(v["state"], "failed")
+            self.assertEqual(v["ready_at"], 10)
+            self.assertIsNone(q.claim("w1", 20, 10))
+            with self.assertRaises(ValueError):
+                q.fail("j", "w1", 2, 21)
