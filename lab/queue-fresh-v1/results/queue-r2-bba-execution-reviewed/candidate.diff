+            val = json.loads(p1.stdout)
+            self.assertEqual(val[0]["id"], "a")
+            # fresh process get survives
+            req.write_text(json.dumps({"op": "get", "id": "a"}), encoding="utf-8")
+            p2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req)], capture_output=True, text=True, timeout=10)
+            self.assertEqual(p2.returncode, 0, p2.stderr)
+            self.assertEqual(json.loads(p2.stdout)["payload"], {"z": 1})
