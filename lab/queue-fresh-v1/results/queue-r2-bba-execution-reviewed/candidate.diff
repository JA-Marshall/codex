+"""Durable SQLite storage with WAL, timeouts, transactions and validators."""
+import contextlib
+import math
 import sqlite3
 
+BUSY_TIMEOUT_MS = 5000
+CONNECT_TIMEOUT_S = 30.0
+
 
 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
-    connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
-    )
-    return connection
+    conn = sqlite3.connect(str(path), timeout=CONNECT_TIMEOUT_S, isolation_level=None, check_same_thread=True)
+    try:
+        conn.execute(f"PRAGMA busy_timeout={BUSY_TIMEOUT_MS}")
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute("PRAGMA synchronous=NORMAL")
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
+        )
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS specs (id TEXT PRIMARY KEY, spec TEXT NOT NULL)"
+        )
+    except Exception:
+        conn.close()
+        raise
+    return conn
+
+
+@contextlib.contextmanager
+def atomic(conn):
+    conn.execute("BEGIN IMMEDIATE")
+    try:
+        yield conn
+        conn.execute("COMMIT")
+    except Exception:
+        try:
+            conn.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+
+
+def is_strict_int(v):
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def is_nonempty_str(v):
+    return isinstance(v, str) and len(v) > 0
+
+
+def check_finite_json(value):
+    """Validate value is finite JSON (None/bool/strict int/finite float/str/list/dict)."""
+    if value is None or isinstance(value, bool):
+        return True
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("non-finite JSON number")
+        return True
+    if isinstance(value, str):
+        return True
+    if isinstance(value, list):
+        for item in value:
+            check_finite_json(item)
+        return True
+    if isinstance(value, dict):
+        for k, v in value.items():
+            if not isinstance(k, str):
+                raise ValueError("JSON object keys must be strings")
+            check_finite_json(v)
+        return True
+    raise ValueError("non-JSON value")
+
+
+def validate_now(now):
+    if not is_strict_int(now) or now < 0:
+        raise ValueError("invalid now")
+
+
+def validate_worker(worker):
+    if not is_nonempty_str(worker):
+        raise ValueError("invalid worker")
