@@ -0,0 +1,207 @@
+"""TDD red test S1/S2: atomic submit, validators, views."""
+import tempfile
+import unittest
+from pathlib import Path
+from durable_queue import Queue
+
+class SubmitAtomicityTests(unittest.TestCase):
+    def test_invalid_batch_rolls_back_zero_writes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": ""}])
+            self.assertIsNone(q.get("b"))
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+
+    def test_bool_not_int_and_unknown_fields(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "nope": 1}])
+            self.assertEqual(q.list(), [])
+
+    def test_cycle_and_self_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_view_keys_detached_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            views = q.submit([{"id": "b"}, {"id": "a"}])
+            expect_keys = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+            for v in views:
+                self.assertEqual(set(v.keys()), expect_keys)
