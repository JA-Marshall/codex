+    args = parser.parse_args(argv)
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+        request = json.loads(text)
+        if not isinstance(request, dict):
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if op not in _OPS:
+            raise ValueError("unknown op")
+        keys = set(request.keys()) - {"op"}
+        allowed = _FIELDS[op]
+        if not keys <= allowed:
+            raise ValueError("unknown fields")
+        if not _REQUIRED[op] <= keys:
+            raise ValueError("missing fields")
+        kwargs = {k: request[k] for k in keys}
+        queue = Queue(args.db)
+        method = getattr(queue, op)
+        try:
+            value = method(**kwargs)
+        except TypeError as e:
+            raise ValueError("invalid arguments") from e
+        out = json.dumps(value, sort_keys=True, allow_nan=False)
+        sys.stdout.write(out + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except BaseException as e:
+        # argparse errors already exit with code 2; other errors -> exit 2 empty stdout
+        if isinstance(e, SystemExit):
+            raise
+        try:
+            sys.stderr.write(f"error: {type(e).__name__}\n")
+        except Exception:
+            pass
+        return 2
 
 
