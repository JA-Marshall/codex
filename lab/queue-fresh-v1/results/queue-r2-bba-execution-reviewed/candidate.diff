+class MultiprocessAndCLITests(unittest.TestCase):
+    def _cli(self, db, req):
+        import json, subprocess, sys
+        with open(req["__file__"], "w", encoding="utf-8") as f:
+            json.dump({k: v for k, v in req.items() if k != "__file__"}, f)
+        proc = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req["__file__"]], capture_output=True, text=True, timeout=10)
+        return proc
+
+    def test_multiprocess_claim_exclusivity(self):
+        import json, subprocess, sys
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            script = (
+                "import sys, json; "
+                "from durable_queue import Queue; "
+                "q=Queue(sys.argv[1]); "
+                "v=q.claim(sys.argv[2], 0, 60); "
+                "print(json.dumps(v.get('id') if v else None))"
+            )
+            p1 = subprocess.Popen([sys.executable, "-c", script, db, "w1"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            p2 = subprocess.Popen([sys.executable, "-c", script, db, "w2"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            o1, _ = p1.communicate(timeout=10)
+            o2, _ = p2.communicate(timeout=10)
+            got = [json.loads(o1), json.loads(o2)]
+            self.assertEqual(sorted([g for g in got if g is not None]), ["only"])
+            self.assertIn(None, got)
+            # exactly one active lease in DB
+            v = Queue(db).get("only")
+            self.assertEqual(v["state"], "running")
+            self.assertIn(v["worker"], ("w1", "w2"))
+
+    def test_cli_durability_and_sorted_newline(self):
+        import json, subprocess, sys
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            req = Path(tmp) / "r.json"
+            req.write_text(json.dumps({"op": "submit", "jobs": [{"id": "a", "payload": {"z": 1}}]}), encoding="utf-8")
+            p1 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req)], capture_output=True, text=True, timeout=10)
+            self.assertEqual(p1.returncode, 0, p1.stderr)
+            self.assertTrue(p1.stdout.endswith("\n"))
