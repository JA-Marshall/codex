+    def test_complete_fail_stale_expired_terminal(self):
+        with tempfile.TemporaryDirectory(dir=".") as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", c1["attempts"], 1)
+            # stale attempt type bool
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", True, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c1["attempts"], 10)
+            self.assertEqual(q.get("a")["state"], "running")
+            # fail with retry_delay schedules
+            v = q.fail("a", "w", c1["attempts"], 1, retry_delay=3)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 4)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # reclaim same worker, old attempt rejected
+            c2 = q.claim("w", 4, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c1["attempts"], 5)
+            # complete succeeds, ready_at unchanged
+            vc = q.complete("a", "w", c2["attempts"], 5)
+            self.assertEqual(vc["state"], "succeeded")
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c2["attempts"], 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c2["attempts"], 6)
+            self.assertIsNone(q.claim("w", 6, 10))
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 6)
+            # invalid retry_delay
+            q.submit([{"id": "z"}])
+            cz = q.claim("w", 6, 10)
+            with self.assertRaises(ValueError):
+                q.fail("z", "w", cz["attempts"], 7, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("z", "w", cz["attempts"], 7, retry_delay=True)
+            self.assertEqual(q.get("z")["state"], "running")
