+    def test_cli_all_exit2_paths(self):
+        import json, subprocess, tempfile
+        from pathlib import Path as P
+        def run(db, obj=None, raw=None, missing=False):
+            import tempfile as T
+            d = T.mkdtemp(dir=".")
+            try:
+                rp = P(d) / "r.json"
+                if missing:
+                    rp = P(d) / "nope.json"
+                elif raw is not None:
+                    rp.write_bytes(raw)
+                else:
+                    rp.write_text(json.dumps(obj), encoding="utf-8")
+                proc = subprocess.run(["python3.12", "-m", "durable_queue", "--db", str(db), "--request", str(rp)], capture_output=True, text=True, cwd=".")
+                return proc
+            finally:
+                import shutil
+                shutil.rmtree(d, ignore_errors=True)
+        with tempfile.TemporaryDirectory(dir=".") as tmp:
+            db = str(P(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            # malformed
+            pr = run(db, raw=b"{not json")
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # non-object
+            pr = run(db, obj=[1,2])
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # unknown op
+            pr = run(db, obj={"op": "nope"})
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # unknown fields
+            pr = run(db, obj={"op": "list", "extra": 1})
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # missing file
+            pr = run(db, missing=True)
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # invalid utf-8
+            pr = run(db, raw=b"\xff\xfe")
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # ValueError via API (bad id)
+            pr = run(db, obj={"op": "get", "id": ""})
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # invalid usage missing field
+            pr = run(db, obj={"op": "get"})
+            self.assertEqual(pr.returncode, 2); self.assertEqual(pr.stdout, "")
+            # unavailable db (parent missing)
+            pr2 = subprocess.run(["python3.12", "-m", "durable_queue", "--db", "/nonexistent-dir-xyz/q.db", "--request", "/dev/null"], capture_output=True, text=True, cwd=".")
+            # /dev/null is not valid JSON object? still exit 2
+            self.assertEqual(pr2.returncode, 2); self.assertEqual(pr2.stdout, "")
+            # success list sorted keys newline
+            import json as J
+            pr = run(db, obj={"op": "list"})
+            self.assertEqual(pr.returncode, 0)
+            self.assertTrue(pr.stdout.endswith("\n"))
+            self.assertEqual(pr.stdout, J.dumps(J.loads(pr.stdout), sort_keys=True) + "\n")
