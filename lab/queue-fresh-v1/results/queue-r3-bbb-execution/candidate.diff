+    args = parser.parse_args(argv)
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+        try:
+            request = json.loads(text)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f"malformed request: {exc}") from exc
+        if type(request) is not dict:
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if type(op) is not str or op not in _OPS_ALLOWED:
+            raise ValueError("unknown operation")
+        allowed = _OPS_ALLOWED[op]
+        required = _OPS_REQUIRED[op]
+        keys = set(request.keys()) - {"op"}
+        if not keys.issuperset(required) or not keys.issubset(allowed):
+            raise ValueError("invalid fields")
+        kwargs = {k: request[k] for k in keys}
+        try:
+            queue = Queue(args.db)
+        except (OSError, sqlite3.Error, ValueError) as exc:
+            raise ValueError(f"unavailable database: {exc}") from exc
+        try:
+            func = getattr(queue, op)
+        except AttributeError as exc:
+            raise ValueError("unknown operation") from exc
+        try:
+            value = func(**kwargs)
+        except TypeError as exc:
+            raise ValueError(f"invalid usage: {exc}") from exc
+        try:
+            payload = json.dumps(value, sort_keys=True)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f"unserializable result: {exc}") from exc
+        sys.stdout.write(payload + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except (ValueError, OSError, sqlite3.Error, UnicodeDecodeError) as exc:
+        try:
+            sys.stderr.write(f"error: {exc}\n")
+        except Exception:
+            pass
+        return 2
+    except Exception as exc:
+        try:
+            sys.stderr.write(f"error: {exc}\n")
+        except Exception:
+            pass
+        return 2
 
 
