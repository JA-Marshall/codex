+"""Focused regression tests (TDD, expanded per step)."""
+import copy
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue, storage
+
+
+def _child_submit(db_path, qname):
+    from durable_queue import Queue
+    Queue(db_path).submit([{"id": qname}])
+
+
+def _child_claim(db_path, out_q, worker):
+    from durable_queue import Queue
+    try:
+        v = Queue(db_path).claim(worker, 0, 10)
+        out_q.put(v["id"] if v else None)
+    except Exception as e:
+        out_q.put(f"ERR:{e}")
+
+
