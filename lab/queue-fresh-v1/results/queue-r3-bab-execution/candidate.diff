+def _claim_worker(idx, db_path, out_queue):
+    try:
+        from durable_queue import Queue
+        qq = Queue(db_path)
+        c = qq.claim(f"w{idx}", 0, 60)
+        out_queue.put((idx, c["id"] if c else None))
+    except Exception as e:
+        out_queue.put((idx, f"ERR:{e!r}"))
