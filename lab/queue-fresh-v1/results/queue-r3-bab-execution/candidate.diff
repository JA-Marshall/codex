+            code = (
+                "from durable_queue import Queue; "
+                f"Queue({db!r}).submit([{{'id': 'persist', 'payload': {{'v': 1}}}}])"
+            )
+            p = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 0, msg=p.stderr)
+            q = Queue(db)
+            v = q.get("persist")
+            self.assertIsNotNone(v)
+            self.assertEqual(v["payload"], {"v": 1})
+
+    def test_concurrent_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(pathlib.Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": f"j{i}"} for i in range(5)])
+            ctx = multiprocessing.get_context("fork")
+            out = ctx.Queue()
+            procs = [ctx.Process(target=_claim_worker, args=(i, db, out)) for i in range(8)]
+            for p in procs:
+                p.start()
+            for p in procs:
+                p.join(timeout=20)
+            for p in procs:
+                self.assertEqual(p.exitcode, 0)
+            results = []
+            while not out.empty():
+                results.append(out.get())
+            ids = [r[1] for r in results if r[1] and not str(r[1]).startswith("ERR")]
+            self.assertEqual(len(ids), 5)
+            self.assertEqual(len(set(ids)), 5)
+            self.assertEqual(sorted(ids), [f"j{i}" for i in range(5)])
+            self.assertIsNone(Queue(db).claim("extra", 0, 60))
