+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on invalid usage; ensure stdout empty (it uses stderr)
+        raise
+    # Read request file strictly as UTF-8 JSON
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+    except FileNotFoundError:
+        return _fail("missing file")
+    except UnicodeDecodeError:
+        return _fail("invalid utf-8")
+    except OSError:
+        return _fail("unavailable file")
+    except Exception:
+        return _fail("unavailable file")
+    try:
+        request = json.loads(text)
+    except Exception:
+        return _fail("malformed request")
+    if not isinstance(request, dict):
+        return _fail("non-object request")
+    if "op" not in request:
+        return _fail("missing op")
+    op = request.get("op")
+    allowed = {"submit", "get", "list", "claim", "recover", "complete", "fail"}
+    if not isinstance(op, str) or op not in allowed:
+        return _fail("unknown operation")
+    # Strict per-op fields (no unknown, no missing except fail retry_delay optional)
+    expected = {
+        "submit": {"jobs"},
+        "get": {"id"},
+        "list": set(),
+        "claim": {"worker", "now", "lease_seconds"},
+        "recover": {"now"},
+        "complete": {"id", "worker", "attempt", "now"},
+        "fail": {"id", "worker", "attempt", "now"},
+    }
+    keys = set(request.keys())
+    # All keys must be strings (JSON object keys always strings, but be strict)
+    for k in keys:
+        if not isinstance(k, str):
+            return _fail("unknown field")
+    fields = keys - {"op"}
+    if op == "fail":
+        # retry_delay optional
+        if "retry_delay" in fields:
+            fields_check = fields - {"retry_delay"}
+            if fields_check != expected["fail"]:
+                return _fail("invalid fields")
+        else:
+            if fields != expected["fail"]:
+                return _fail("invalid fields")
+    else:
+        if fields != expected[op]:
+            return _fail("invalid fields")
+    # Build kwargs without mutating request
+    kwargs = {k: request[k] for k in fields}
+    # Dispatch
+    try:
+        from .queue import Queue
+    except Exception:
+        return _fail("unavailable database")
+    try:
+        queue = Queue(args.db)
+    except Exception:
+        return _fail("unavailable database")
+    try:
+        method = getattr(queue, op, None)
+        if method is None:
+            return _fail("unknown operation")
+        value = method(**kwargs)
+    except ValueError:
+        return _fail("invalid request")
+    except TypeError:
+        return _fail("invalid request")
+    except Exception:
+        # sqlite errors / unavailable DB -> exit 2
+        try:
+            import sqlite3 as _sqlite3
+            if isinstance(sys.exc_info()[1], _sqlite3.Error):
+                return _fail("unavailable database")
+        except Exception:
+            pass
+        # Fallback: treat OSError as DB unavailable, else invalid request
+        exc = sys.exc_info()[1]
+        if isinstance(exc, OSError):
+            return _fail("unavailable database")
+        return _fail("invalid request")
+    try:
+        out = json.dumps(value, sort_keys=True, allow_nan=False)
+    except Exception:
+        return _fail("invalid result")
+    try:
+        sys.stdout.write(out + "\n")
+    except Exception:
+        return _fail("write failed")
     return 0
 
 
