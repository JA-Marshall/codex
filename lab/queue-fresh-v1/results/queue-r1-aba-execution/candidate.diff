+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse already prints to stderr; ensure stdout empty and exit 2
+        raise
+    try:
+        raw = Path(args.request).read_bytes()
+        text = raw.decode("utf-8")
+        req = json.loads(text)
+        if not isinstance(req, dict):
+            raise ValueError("request must be object")
+        if "op" not in req:
+            raise ValueError("missing op")
+        # copy without mutating original file content handling
+        op = req.get("op")
+        if not isinstance(op, str) or op not in _ALLOWED:
+            raise ValueError("unknown op")
+        # build kwargs without op
+        kwargs = {k: v for k, v in req.items() if k != "op"}
+        allowed = _ALLOWED[op]
+        required = _REQUIRED[op]
+        for k in kwargs:
+            if k not in allowed:
+                raise ValueError("unknown field")
+        for k in required:
+            if k not in kwargs:
+                raise ValueError("missing field")
+        try:
+            queue = Queue(args.db)
+        except Exception as e:
+            raise ValueError("unavailable database") from e
+        method = getattr(queue, op)
+        try:
+            value = method(**kwargs)
+        except TypeError as e:
+            raise ValueError("invalid arguments") from e
+        out = json.dumps(value, sort_keys=True, ensure_ascii=False, allow_nan=False)
+        sys.stdout.write(out + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except Exception as e:
+        # failures exit 2 with empty stdout; optionally stderr
+        try:
+            print(str(e), file=sys.stderr)
+        except Exception:
+            pass
+        return 2
 
 
