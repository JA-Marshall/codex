+"""Durable SQLite storage with WAL, timeouts and transaction helper."""
 import sqlite3
+from contextlib import contextmanager
 
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS jobs (
+  id TEXT PRIMARY KEY,
+  spec TEXT NOT NULL,
+  payload TEXT NOT NULL,
+  priority INTEGER NOT NULL,
+  dependencies TEXT NOT NULL,
+  max_attempts INTEGER NOT NULL,
+  ready_at INTEGER NOT NULL,
+  state TEXT NOT NULL,
+  attempts INTEGER NOT NULL,
+  worker TEXT,
+  lease_until INTEGER
+);
+CREATE INDEX IF NOT EXISTS idx_jobs_state_ready ON jobs(state, ready_at);
+CREATE INDEX IF NOT EXISTS idx_jobs_claim ON jobs(state, ready_at, priority, id);
+CREATE INDEX IF NOT EXISTS idx_jobs_running_lease ON jobs(state, lease_until);
+"""
+
+def _ensure_schema(conn):
+    # Detect existing table
+    row = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='jobs'"
+    ).fetchone()
+    if row is None:
+        conn.executescript(_SCHEMA)
+        return
+    cols = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
+    if set(cols) == {"id", "data"}:
