+def _has_cycle(graph):
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {n: WHITE for n in graph}
+
+    def visit(n, stack):
+        color[n] = GRAY
+        for m in graph.get(n, []):
+            if m not in graph:
+                continue
+            c = color.get(m, WHITE)
+            if c == GRAY:
+                return True
+            if c == WHITE:
+                if visit(m, stack):
+                    return True
+        color[n] = BLACK
+        return False
+
+    for node in list(graph.keys()):
+        if color[node] == WHITE:
+            if visit(node, []):
+                return True
+    return False
