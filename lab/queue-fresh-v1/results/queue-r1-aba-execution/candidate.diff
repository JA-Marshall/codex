@@ -0,0 +1,306 @@
+"""Focused regression tests per CONTRACT (covers rollback, leases, retries, processes)."""
+import copy
+import json
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _claim_worker(db_path_str, worker, now, lease_seconds, queue):
+    try:
+        q = Queue(db_path_str)
+        v = q.claim(worker, now, lease_seconds)
+        queue.put({"id": v["id"] if v else None, "worker": worker})
+    except Exception as e:
+        queue.put({"error": str(e)})
+
+
+def _get_worker(db_path_str, job_id, queue):
+    try:
+        v = Queue(db_path_str).get(job_id)
+        queue.put(v["payload"] if v else None)
+    except Exception as e:
+        queue.put({"error": str(e)})
+
+
+class RegressionTests(unittest.TestCase):
+    def test_invalid_batch_rolls_back(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "ok"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}, {"id": "b"}])
+            self.assertIsNone(q.get("a"))
+            self.assertIsNone(q.get("b"))
+            self.assertIsNotNone(q.get("ok"))
+            self.assertEqual(q.list(), before)
+            # duplicate within batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x"}, {"id": "x"}])
+            self.assertIsNone(q.get("x"))
+            # self dependency
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "s", "dependencies": ["s"]}])
+            self.assertIsNone(q.get("s"))
+            # cycle
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c1", "dependencies": ["c2"]}, {"id": "c2", "dependencies": ["c1"]}])
+            self.assertIsNone(q.get("c1"))
+            # unknown field
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "u", "bogus": 1}])
+            self.assertIsNone(q.get("u"))
+            # bool as int rejected
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b1", "priority": True}])
+            self.assertIsNone(q.get("b1"))
+
+    def test_idempotent_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            v1 = q.submit([{"id": "a", "payload": {"x": 1}, "dependencies": []}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # same normalized spec (explicit defaults, reordered deps) is idempotent
+            v2 = q.submit([{"id": "a", "payload": {"x": 1}, "priority": 0, "dependencies": [], "max_attempts": 3, "ready_at": 0}])
+            self.assertEqual(v2[0]["state"], "running")
+            self.assertEqual(v2[0]["attempts"], 1)
+            # conflict rejects whole batch and leaves DB unchanged
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": 2}}, {"id": "new1"}])
+            self.assertIsNone(q.get("new1"))
+            self.assertEqual(q.get("a")["payload"], {"x": 1})
+
+    def test_no_mutation_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            orig = [{"id": "m", "payload": {"a": [1, 2]}, "dependencies": ["b", "b", "a2"]}, {"id": "a2"}, {"id": "b"}]
+            snapshot = copy.deepcopy(orig)
+            q.submit(orig)
+            self.assertEqual(orig, snapshot)
+            v = q.get("m")
+            self.assertEqual(v["dependencies"], ["a2", "b"])
+            v["payload"]["a"].append(99)
+            v["dependencies"].append("zzz")
+            v2 = q.get("m")
+            self.assertEqual(v2["payload"], {"a": [1, 2]})
+            self.assertEqual(v2["dependencies"], ["a2", "b"])
+            # exact 10 keys
+            self.assertEqual(set(v2.keys()), {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"})
+
+    def test_priority_and_dependency_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "low", "priority": 1}, {"id": "high", "priority": 5}, {"id": "mid", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")  # highest priority, smallest id among ties
+            q.complete("high", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "mid")
+            # dependency failed stays pending/ineligible
+            q2 = Queue(Path(tmp) / "q2.db")
+            q2.submit([{"id": "p"}, {"id": "d", "dependencies": ["p"]}])
+            cp = q2.claim("w", 0, 10)
+            q2.fail("p", "w", cp["attempts"], 1)
+            # p pending again (max 3), d never eligible until p succeeds
+            # fail p to terminal: need max_attempts=1 case
+            q3 = Queue(Path(tmp) / "q3.db")
+            q3.submit([{"id": "p1", "max_attempts": 1}, {"id": "d1", "dependencies": ["p1"]}])
+            c3 = q3.claim("w", 0, 10)
+            q3.fail("p1", "w", c3["attempts"], 1)
+            self.assertEqual(q3.get("p1")["state"], "failed")
+            self.assertIsNone(q3.claim("w", 1, 10))  # d1 ineligible, p1 terminal
+            self.assertEqual(q3.get("d1")["state"], "pending")
+
+    def test_stale_completion_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "j"}])
+            c1 = q.claim("w1", 0, 10)
+            ids = q.recover(10)
+            self.assertEqual(ids, ["j"])
+            c2 = q.claim("w1", 10, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("j", "w1", c1["attempts"], 11)
+            v = q.get("j")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["attempts"], 2)
+            # wrong owner and expired also rejected without recovery
+            with self.assertRaises(ValueError):
+                q.complete("j", "other", c2["attempts"], 11)
+            self.assertEqual(q.get("j")["state"], "running")
+            # expired lease: complete at lease boundary fails
+            with self.assertRaises(ValueError):
+                q.complete("j", "w1", c2["attempts"], 20)
+            # no implicit recovery on failed complete: still running until explicit recover
+            self.assertEqual(q.get("j")["state"], "running")
+
+    def test_bounded_retries(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "r", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            q.fail("r", "w", c1["attempts"], 1, retry_delay=5)
+            v = q.get("r")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            c2 = q.claim("w", 6, 10)
+            self.assertIsNotNone(c2)
+            self.assertEqual(c2["attempts"], 2)
+            q.fail("r", "w", c2["attempts"], 7)
+            v2 = q.get("r")
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 6)  # unchanged on terminal fail
+            self.assertIsNone(q.claim("w", 7, 10))
+            self.assertLessEqual(v2["attempts"], 2)
+
+    def test_recover_terminal_and_noop(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "t", "max_attempts": 1}])
+            c = q.claim("w", 0, 5)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["t"])
+            v = q.get("t")
+            self.assertEqual(v["state"], "failed")
+            ready = v["ready_at"]
+            self.assertEqual(ready, 0)
+            # repeated recovery no-op
+            self.assertEqual(q.recover(5), [])
+            self.assertEqual(q.recover(100), [])
+
+    def test_invalid_inputs_no_recovery_or_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "k"}])
+            c = q.claim("w", 0, 10)
+            before = q.get("k")
+            # invalid claim args must not recover
+            with self.assertRaises(ValueError):
+                q.claim("", 10, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 10, True)
+            self.assertEqual(q.get("k"), before)
+            # invalid recover
+            with self.assertRaises(ValueError):
+                q.recover(-1)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            self.assertEqual(q.get("k"), before)
+            # invalid complete/fail
+            with self.assertRaises(ValueError):
+                q.complete("k", "w", c["attempts"], True)
+            with self.assertRaises(ValueError):
+                q.fail("k", "w", c["attempts"], 1, retry_delay=-1)
+            self.assertEqual(q.get("k"), before)
+            # get validation
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+
+    def test_separate_process_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "persist", "payload": {"n": 1}}])
+            ctx = multiprocessing.get_context("spawn")
+            mq = ctx.Queue()
+            p = ctx.Process(target=_get_worker, args=(db, "persist", mq))
+            p.start()
+            p.join(timeout=20)
+            self.assertEqual(p.exitcode, 0)
+            self.assertEqual(mq.get(timeout=10), {"n": 1})
+            # subprocess CLI durability
+            req = Path(tmp) / "req.json"
+            req.write_text(json.dumps({"op": "get", "id": "persist"}), encoding="utf-8")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True, timeout=20)
+            self.assertEqual(r.returncode, 0)
+            self.assertEqual(json.loads(r.stdout)["payload"], {"n": 1})
+
+    def test_claim_exclusivity_two_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            ctx = multiprocessing.get_context("spawn")
+            mq = ctx.Queue()
+            p1 = ctx.Process(target=_claim_worker, args=(db, "w1", 0, 30, mq))
+            p2 = ctx.Process(target=_claim_worker, args=(db, "w2", 0, 30, mq))
+            p1.start()
+            p2.start()
+            p1.join(timeout=20)
+            p2.join(timeout=20)
+            self.assertEqual(p1.exitcode, 0)
+            self.assertEqual(p2.exitcode, 0)
+            r1 = mq.get(timeout=10)
+            r2 = mq.get(timeout=10)
+            got = sorted([r1.get("id"), r2.get("id")], key=lambda x: (x is None, x))
+            self.assertEqual(got, ["only", None])
+
+    def test_expired_lease_repends(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "e"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["lease_until"], 10)
+            ids = q.recover(10)
+            self.assertEqual(ids, ["e"])
+            v = q.get("e")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 10)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+
+    def test_cli_canonical_and_errors(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            req = Path(tmp) / "req.json"
+            req.write_text(json.dumps({"op": "submit", "jobs": [{"id": "a"}]}), encoding="utf-8")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True, timeout=20)
+            self.assertEqual(r.returncode, 0)
+            self.assertTrue(r.stdout.endswith("\n"))
+            self.assertEqual(r.stdout, json.dumps(json.loads(r.stdout), sort_keys=True) + "\n")
+            bad = Path(tmp) / "bad.json"
+            bad.write_text(json.dumps({"op": "claim", "worker": "", "now": 0, "lease_seconds": 10}), encoding="utf-8")
+            r2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad)], capture_output=True, text=True, timeout=20)
+            self.assertEqual(r2.returncode, 2)
+            self.assertEqual(r2.stdout, "")
+            # unknown field
+            bad2 = Path(tmp) / "bad2.json"
+            bad2.write_text(json.dumps({"op": "list", "extra": 1}), encoding="utf-8")
+            r3 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad2)], capture_output=True, text=True, timeout=20)
+            self.assertEqual(r3.returncode, 2)
+            self.assertEqual(r3.stdout, "")
+            # malformed + missing file
+            bad3 = Path(tmp) / "bad3.json"
+            bad3.write_bytes(b"\xff\xff")
+            r4 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad3)], capture_output=True, text=True, timeout=20)
+            self.assertEqual(r4.returncode, 2)
+            self.assertEqual(r4.stdout, "")
+            r5 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp)/"nope.json")], capture_output=True, text=True, timeout=20)
+            self.assertEqual(r5.returncode, 2)
+            self.assertEqual(r5.stdout, "")
+
+    def test_claim_recovers_before_select(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "priority": 0}, {"id": "b", "priority": 100}])
+            ca = q.claim("w", 0, 5)
+            self.assertEqual(ca["id"], "b")
+            # a still pending; b running with lease 5
+            # at now=5, b expires and should re-pend with ready_at=5, then claim picks highest priority (b again)
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["id"], "b")
+            self.assertEqual(c2["attempts"], 2)
+
+
