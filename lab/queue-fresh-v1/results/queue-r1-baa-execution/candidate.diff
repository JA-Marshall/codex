+
+def cli(db, req_obj=None, raw=None, as_text=None):
+    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as f:
+        if as_text is not None:
+            f.write(as_text)
+        elif raw is not None:
+            # write bytes? use text path
+            f.write(raw)
+        else:
+            f.write(json.dumps(req_obj))
+        req = f.name
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req],
+                           capture_output=True, text=True)
+        return p
+    finally:
+        try:
+            os.unlink(req)
+        except OSError:
+            pass
+
+def cli_bytes(db, data: bytes):
+    fd, req = tempfile.mkstemp(suffix=".json")
+    os.close(fd)
+    Path(req).write_bytes(data)
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req],
+                           capture_output=True, text=True)
+        return p
+    finally:
+        try:
+            os.unlink(req)
+        except OSError:
+            pass
