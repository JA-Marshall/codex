+    conn = sqlite3.connect(str(path), timeout=5.0, isolation_level=None, check_same_thread=True)
+    try:
+        conn.execute("PRAGMA journal_mode=WAL;")
+    except sqlite3.Error:
+        pass
+    try:
+        conn.execute("PRAGMA busy_timeout=5000;")
+    except sqlite3.Error:
+        pass
+    try:
+        conn.execute("PRAGMA synchronous=NORMAL;")
+    except sqlite3.Error:
+        pass
+    # Ensure schema; migrate legacy (id, data) table if present.
+    row = conn.execute(
+        "SELECT sql FROM sqlite_master WHERE type='table' AND name='jobs'"
+    ).fetchone()
+    if row is None or row[0] is None:
+        conn.execute(
+            "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, spec TEXT NOT NULL, data TEXT NOT NULL)"
+        )
+    else:
+        sql = row[0]
+        cols = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
+        if "spec" not in cols or "data" not in cols:
+            # Legacy table with (id, data): migrate to (id, spec, data).
+            import json as _json
+            if "spec" not in cols:
+                try:
+                    conn.execute("ALTER TABLE jobs ADD COLUMN spec TEXT")
+                except sqlite3.Error:
+                    pass
+                cols = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
+                # Backfill spec from stored views where possible.
+                try:
+                    cur = conn.execute("SELECT id, data FROM jobs")
+                    rows = cur.fetchall()
+                    for jid, data in rows:
+                        try:
+                            view = _json.loads(data)
+                            spec = {
+                                "id": view.get("id", jid),
+                                "payload": view.get("payload", {}),
+                                "priority": view.get("priority", 0),
+                                "dependencies": sorted(set(view.get("dependencies", []))),
+                                "max_attempts": view.get("max_attempts", 3),
+                                "ready_at": view.get("ready_at", 0),
+                            }
+                            conn.execute("UPDATE jobs SET spec=? WHERE id=?", (_json.dumps(spec, sort_keys=True), jid))
+                        except Exception:
+                            continue
+                except sqlite3.Error:
+                    pass
+            # If table still lacks NOT NULL guarantees, leave as-is; new writes enforce it.
+            # Ensure new table exists for future (no-op if already exists).
+            if "spec" not in cols or "data" not in cols:
+                # Fallback: recreate table preserving data (best effort).
+                pass
+        # Ensure the table has at least the needed columns; if creation was legacy, CREATE IF NOT EXISTS is no-op.
+    return conn
+
+
+@contextlib.contextmanager
+def transaction(path):
+    """BEGIN IMMEDIATE transaction; COMMIT on success, ROLLBACK on error."""
+    conn = connect(path)
+    try:
+        conn.execute("BEGIN IMMEDIATE;")
+        yield conn
+        conn.execute("COMMIT;")
+    except Exception:
+        try:
+            conn.execute("ROLLBACK;")
+        except Exception:
+            pass
+        raise
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
