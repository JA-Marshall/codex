+    args = parser.parse_args(argv)
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+        try:
+            request = json.loads(text)
+        except Exception:
+            return 2
+        if not isinstance(request, dict):
+            return 2
+        if "op" not in request:
+            return 2
+        op = request["op"]
+        if not isinstance(op, str) or op not in _OPS:
+            return 2
+        allowed = _ALLOWED[op]
+        required = _REQUIRED[op]
+        keys = set(request.keys()) - {"op"}
+        if not required.issubset(keys):
+            return 2
+        if not keys.issubset(allowed):
+            return 2
+        kwargs = {k: request[k] for k in keys}
+        try:
+            queue = Queue(args.db)
+        except Exception:
+            return 2
+        try:
+            method = getattr(queue, op, None)
+            if not callable(method):
+                return 2
+            value = method(**kwargs)
+        except ValueError:
+            return 2
+        except TypeError:
+            return 2
+        except (sqlite3.Error, OSError):
+            return 2
+        except Exception:
+            # Any other failure during DB operation -> exit 2 per "unavailable database".
+            return 2
+        try:
+            out = json.dumps(value, sort_keys=True, allow_nan=False)
+        except Exception:
+            return 2
+        sys.stdout.write(out + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except (FileNotFoundError, IsADirectoryError, OSError, UnicodeDecodeError, ValueError, sqlite3.Error):
+        return 2
+    except Exception:
+        return 2
 
 
