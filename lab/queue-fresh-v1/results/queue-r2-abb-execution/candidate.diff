+    def test_recover_changes_ready_at_but_idempotent_still(self):
+        with tempfile.TemporaryDirectory() as t:
+            p = tmpdb(t)
+            q = Queue(p)
+            q.submit([{"id": "a", "ready_at": 0}])
+            c = q.claim("w", 0, 10)
