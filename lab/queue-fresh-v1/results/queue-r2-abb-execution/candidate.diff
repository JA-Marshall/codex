+    def test_idempotent_original_spec(self):
+        with tempfile.TemporaryDirectory() as t:
+            p = tmpdb(t)
+            q = Queue(p)
+            q.submit([{"id": "a", "payload": {"x": 1}, "dependencies": ["b", "b"]}, {"id": "b"}])
+            # normalized deps sorted unique -> resubmit normalized should be idempotent
+            v = q.submit([{"id": "a", "payload": {"x": 1}, "dependencies": ["b"]}, {"id": "b"}])
+            self.assertEqual(v[0]["dependencies"], ["b"])
+            # conflict payload
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": 2}}])
+            # conflict priority default vs explicit? default 0 matches
+            v2 = q.submit([{"id": "a", "payload": {"x": 1}, "dependencies": ["b"]}])
+            self.assertEqual(v2[0]["payload"], {"x": 1})
+            # state change then idempotent resubmit still ok
+            c = q.claim("w", 0, 10)
+            # claim should be b (lex smallest among eligible? a depends on b so b first)
+            self.assertEqual(c["id"], "b")
+            q.complete("b", "w", c["attempts"], 1)
+            # resubmit original spec for b even after succeeded should be no-op
+            v3 = q.submit([{"id": "b"}])
