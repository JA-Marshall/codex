+class LifecycleTests(unittest.TestCase):
+    def test_stale_and_owner_and_expiry_rejected_without_write(self):
+        with tempfile.TemporaryDirectory() as t:
+            q = Queue(tmpdb(t))
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w1", 0, 5)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c1["attempts"], 1)
+            # stale attempt (0)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 999, 1)
+            # still running unchanged
+            g = q.get("a")
+            self.assertEqual(g["state"], "running")
+            self.assertEqual(g["worker"], "w1")
+            # expire then complete should fail and not recover
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c1["attempts"], 5)
+            # lease expired but complete rejected without recovering
+            g2 = q.get("a")
+            self.assertEqual(g2["state"], "running")
+            self.assertEqual(g2["lease_until"], 5)
+            # recover now works
+            self.assertEqual(q.recover(5), ["a"])
+            # reclaim increments attempt
+            c2 = q.claim("w1", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            # old attempt rejected even same worker
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 6)
+            q.complete("a", "w1", 2, 6)
+            self.assertEqual(q.get("a")["state"], "succeeded")
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 2, 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", 2, 6)
+            self.assertIsNone(q.claim("w1", 6, 5))
