+        conn.execute("PRAGMA busy_timeout = 5000")
+        # WAL for concurrent readers/writer durability
+        try:
+            conn.execute("PRAGMA journal_mode = WAL")
+        except Exception:
+            pass
+        _ensure_schema(conn)
+    except Exception:
+        conn.close()
+        raise
+    return conn
+
+def _ensure_schema(conn):
+    rows = list(conn.execute("PRAGMA table_info(jobs)").fetchall())
+    if not rows:
+        conn.execute(CREATE_SQL)
+        return
+    cols = [r[1] for r in rows]
+    if cols == ["id", "data"]:
+        _migrate_legacy(conn)
+        return
+    # if already new schema (superset check), ensure table exists
+    if set(cols) == set(NEW_COLUMNS) or cols == NEW_COLUMNS:
+        # ensure existence (already exists)
+        return
+    # Unexpected schema: recreate fresh if empty, else try to keep?
+    # If table has data with unknown schema, drop and recreate to meet contract.
+    # To preserve, attempt migration best-effort; fallback recreate.
+    count = conn.execute("SELECT COUNT(*) FROM jobs").fetchone()[0]
+    if count == 0:
+        conn.execute("DROP TABLE jobs")
+        conn.execute(CREATE_SQL)
+        return
+    # Try best-effort: drop and recreate (data unrecoverable) - shouldn't happen in tests
+    # Preserve by reading raw? Raise to surface.
+    # Instead, attempt to create missing columns? Simplest: ensure CREATE (IF NOT EXISTS does nothing).
+    # Check missing columns and add them.
+    existing = set(cols)
+    for col in NEW_COLUMNS:
+        if col not in existing:
+            # add with sensible default; orig_spec needs text
+            if col in ("payload", "dependencies", "orig_spec"):
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col} TEXT NOT NULL DEFAULT ''")
+            elif col in ("worker", "lease_until"):
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col}")
+            elif col in ("state",):
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col} TEXT NOT NULL DEFAULT 'pending'")
+            else:
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col} INTEGER NOT NULL DEFAULT 0")
+
+def _migrate_legacy(conn):
+    old = list(conn.execute("SELECT id, data FROM jobs").fetchall())
+    conn.execute("DROP TABLE jobs")
+    conn.execute(CREATE_SQL)
+    for jid, data in old:
+        try:
+            view = json.loads(data)
+        except Exception:
+            continue
+        try:
+            jid2 = view.get("id", jid)
+            payload = view.get("payload", {})
+            if not isinstance(payload, dict):
+                payload = {}
+            priority = view.get("priority", 0)
+            if type(priority) is not int:
+                try:
+                    priority = int(priority)
+                except Exception:
+                    priority = 0
+            deps = view.get("dependencies", [])
+            if not isinstance(deps, list):
+                deps = []
+            deps = sorted({d for d in deps if isinstance(d, str) and d != ""})
+            max_attempts = view.get("max_attempts", 3)
+            if type(max_attempts) is not int or not (1 <= max_attempts <= 100):
+                max_attempts = 3
+            ready_at = view.get("ready_at", 0)
+            if type(ready_at) is not int or ready_at < 0:
+                ready_at = 0
+            state = view.get("state", "pending")
+            if state not in ("pending", "running", "succeeded", "failed"):
+                state = "pending"
+            attempts = view.get("attempts", 0)
+            if type(attempts) is not int or attempts < 0:
+                attempts = 0
+            worker = view.get("worker", None)
+            if worker is not None and not (isinstance(worker, str) and worker != ""):
+                worker = None
+            lease_until = view.get("lease_until", None)
+            if lease_until is not None and not (type(lease_until) is int and lease_until >= 0):
+                lease_until = None
+            if state != "running":
+                worker = None
+                lease_until = None
+            orig = {"id": jid2, "payload": payload, "priority": priority, "dependencies": deps, "max_attempts": max_attempts, "ready_at": ready_at}
+            conn.execute(
+                "INSERT OR REPLACE INTO jobs (id, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until, orig_spec) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+                (jid2, json.dumps(payload, sort_keys=True), priority, json.dumps(deps), max_attempts, ready_at, state, attempts, worker, lease_until, json.dumps(orig, sort_keys=True)),
+            )
+        except Exception:
+            continue
