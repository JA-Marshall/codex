+    """Open SQLite DB, enable WAL + busy timeout, ensure schema, preserve rows."""
+    conn = sqlite3.connect(str(path), timeout=30.0, isolation_level=None, check_same_thread=True)
+    try:
+        try:
+            conn.execute("PRAGMA journal_mode=WAL;")
+        except Exception:
+            pass
+        try:
+            conn.execute("PRAGMA busy_timeout = 5000;")
+        except Exception:
+            pass
+        try:
+            conn.execute("PRAGMA synchronous = NORMAL;")
+        except Exception:
+            pass
+        cols = _table_columns(conn)
+        if not cols:
+            conn.execute(_CREATE_SQL)
+        elif cols != EXPECTED_COLUMNS:
+            migrated = _migrate_legacy(conn, cols)
+            if not migrated:
+                # Unknown schema variant: ensure expected table exists without dropping data.
+                # Create if missing (already exists) -> try to add missing columns.
+                conn.execute(_CREATE_SQL)
+        else:
+            conn.execute(_CREATE_SQL)
+    except Exception:
+        # If schema setup failed, keep connection usable if possible; re-raise
+        # only if jobs table is unusable.
+        try:
+            conn.execute("SELECT 1 FROM jobs LIMIT 1")
+        except Exception as exc:
+            conn.close()
+            raise exc
+    return conn
