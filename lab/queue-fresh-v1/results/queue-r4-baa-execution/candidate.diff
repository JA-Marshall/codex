+def _has_cycle(graph):
+    # graph: id -> list of deps; iterative DFS
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {node: WHITE for node in graph}
+    def visit(start):
+        stack = [(start, 0)]
+        while stack:
+            node, idx = stack[-1]
+            if color[node] == WHITE:
+                color[node] = GRAY
+            deps = graph.get(node, [])
+            advanced = False
+            for i in range(idx, len(deps)):
+                nxt = deps[i]
+                if nxt not in graph:
+                    continue
+                if color[nxt] == GRAY:
+                    return True
+                if color[nxt] == WHITE:
+                    stack[-1] = (node, i + 1)
+                    stack.append((nxt, 0))
+                    advanced = True
+                    break
+            if not advanced:
+                color[node] = BLACK
+                stack.pop()
+        return False
+    for n in graph:
+        if color[n] == WHITE:
+            if visit(n):
+                return True
+    return False
 
 
