+def db_path(tmpdir):
+    return str(Path(tmpdir) / "q.db")
+
+VIEW_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+def cli(db, req_obj=None, req_path=None, raw_bytes=None):
+    # helper to run CLI; returns CompletedProcess
+    import tempfile as tf
+    if raw_bytes is not None:
+        f = tf.NamedTemporaryFile(delete=False, suffix=".json")
+        f.write(raw_bytes)
+        f.close()
+        rp = f.name
+    elif req_path is not None:
+        rp = req_path
+    else:
+        f = tf.NamedTemporaryFile(delete=False, suffix=".json", mode="w", encoding="utf-8")
+        json.dump(req_obj, f)
+        f.close()
+        rp = f.name
+    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", rp],
+                       capture_output=True, text=True)
+    return p
+
+
