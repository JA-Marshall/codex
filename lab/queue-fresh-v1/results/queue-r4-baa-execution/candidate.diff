+                if nv["state"] == "pending" and not (nv["attempts"] < nv["max_attempts"]):
+                    conn.execute("UPDATE jobs SET state='failed' WHERE id=?", (id,))
+                    nrow = _fetch_row(conn, id)
+                conn.execute("COMMIT")
+                return _row_to_view(nrow)
+            except Exception:
+                try:
+                    conn.execute("ROLLBACK")
+                except Exception:
+                    pass
+                raise
+        finally:
+            try:
+                conn.close()
+            except Exception:
+                pass
