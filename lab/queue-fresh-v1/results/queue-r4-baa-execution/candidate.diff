+            self.assertEqual(p.returncode, 0, p.stderr)
+            q2 = Queue(db)
+            v = q2.get("persist")
+            self.assertIsNotNone(v)
+            self.assertEqual(v["payload"], {"n": 1})
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(Path(marker).read_text(), "persist")
+
+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = db_path(tmp)
+            q = Queue(db)
+            q.submit([{"id": "only"}])
+            script = (
+                "import sys;"
+                "from durable_queue import Queue;"
+                f"q=Queue({db!r});"
+                "v=q.claim(sys.argv[1],0,30);"
+                "print(v['id'] if v else 'NONE')"
+            )
+            procs = [
+                subprocess.Popen([sys.executable, "-c", script, f"w{i}"],
+                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+                for i in range(2)
+            ]
+            outs = []
+            for pr in procs:
+                out, err = pr.communicate(timeout=20)
+                self.assertEqual(pr.returncode, 0, err)
+                outs.append(out.strip())
+            self.assertIn("only", outs)
+            self.assertIn("NONE", outs)
+            self.assertNotEqual(outs[0], outs[1])
+            # DB shows single running lease
+            self.assertEqual(Queue(db).get("only")["state"], "running")
+            self.assertEqual(Queue(db).get("only")["attempts"], 1)
+
+
+class CLITests(unittest.TestCase):
+    def test_cli_success_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = db_path(tmp)
+            p = cli(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"z": 1}}]})
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            val = json.loads(p.stdout)
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: check raw string has alphabetical order for get
+            p2 = cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p2.returncode, 0)
+            raw = p2.stdout.strip()
+            # keys sorted: attempts before dependencies before id ...
+            self.assertLess(raw.index('"attempts"'), raw.index('"dependencies"'))
+            self.assertTrue(p2.stdout.endswith("\n"))
+
+    def test_cli_errors_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = db_path(tmp)
+            cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            cases = [
+                {"op": "list", "extra": 1},
+                {"op": "bogus"},
+                {"op": "get"},
+                {"op": "submit", "jobs": [{"id": ""}]},
+                {"op": "get", "id": ""},
+                {"op": "claim", "worker": "w", "now": True, "lease_seconds": 10},
+            ]
+            for req in cases:
+                p = cli(db, req)
+                self.assertEqual(p.returncode, 2, req)
+                self.assertEqual(p.stdout, "", req)
+            # malformed JSON
+            import tempfile as tf
+            f = tf.NamedTemporaryFile(delete=False, suffix=".json", mode="w", encoding="utf-8")
+            f.write("{not json")
+            f.close()
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", f.name],
+                               capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # non-object
+            f2 = tf.NamedTemporaryFile(delete=False, suffix=".json", mode="w", encoding="utf-8")
+            f2.write("[1,2]")
+            f2.close()
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", f2.name],
+                               capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp)/"nope.json")],
+                               capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid utf-8
+            fb = tf.NamedTemporaryFile(delete=False, suffix=".json")
+            fb.write(b"\xff\xfe")
+            fb.close()
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", fb.name],
+                               capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+
+    def test_cli_restart_survival(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = db_path(tmp)
+            self.assertEqual(cli(db, {"op": "submit", "jobs": [{"id": "k"}]}).returncode, 0)
+            # failing request must not wipe prior work
+            p = cli(db, {"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(p.returncode, 2)
+            p2 = cli(db, {"op": "get", "id": "k"})
+            self.assertEqual(p2.returncode, 0)
+            self.assertEqual(json.loads(p2.stdout)["id"], "k")
+
+
+if __name__ == "__main__":
+    unittest.main()
