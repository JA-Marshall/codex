+def require_worker(worker):
+    if type(worker) is not str or worker == "":
+        raise ValueError("invalid worker")
+
+
+def require_job_id(jid):
+    if type(jid) is not str or jid == "":
+        raise ValueError("invalid id")
+
+
+def require_lease_seconds(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("invalid lease_seconds")
+
+
+def require_attempt(v):
+    if type(v) is not int or v < 1:
+        raise ValueError("invalid attempt")
+
+
+def require_retry_delay(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid retry_delay")
+
+
+def require_priority(v):
+    if type(v) is not int:
+        raise ValueError("invalid priority")
+
+
+def require_max_attempts(v):
+    if type(v) is not int or not (1 <= v <= 100):
+        raise ValueError("invalid max_attempts")
+
+
+def require_ready_at(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("invalid ready_at")
+
+
+def _check_json_value(v):
+    if v is None:
+        return
+    t = type(v)
+    if t is bool:
+        return
+    if t is int:
+        return
+    if t is float:
+        if not math.isfinite(v):
+            raise ValueError("non-finite JSON number")
+        return
+    if t is str:
+        return
+    if t is list:
+        for item in v:
+            _check_json_value(item)
+        return
+    if t is dict:
+        for k, item in v.items():
+            if type(k) is not str:
+                raise ValueError("invalid payload key")
+            _check_json_value(item)
+        return
+    raise ValueError("invalid JSON value")
+
+
+def require_payload(v):
+    if type(v) is not dict:
+        raise ValueError("invalid payload")
+    for k in v.keys():
+        if type(k) is not str:
+            raise ValueError("invalid payload key")
+    _check_json_value(v)
