+import copy
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+VIEW_KEYS = {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"}
+
+
+def tmpdb(tmp):
+    return str(Path(tmp) / "q.db")
+
+
+def cli(db, req, tmpdir):
+    reqfile = Path(tmpdir) / "req.json"
+    if isinstance(req, (dict, list)):
+        reqfile.write_text(json.dumps(req), encoding="utf-8")
+    elif isinstance(req, bytes):
+        reqfile.write_bytes(req)
+    else:
+        reqfile.write_text(str(req), encoding="utf-8")
+    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(reqfile)],
+                       capture_output=True)
+    return p
