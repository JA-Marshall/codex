+class LeaseMatrixTest(unittest.TestCase):
+    def test_priority_lexicographic_and_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmpdb(tmp))
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "c")
+            q.complete("c", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "a")
+            # dependency blocking
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = Queue(str(Path(tmp2) / "q.db"))
+                q2.submit([{"id": "dep"}, {"id": "main", "dependencies": ["dep"]}])
+                # main not eligible before dep succeeds
+                first = q2.claim("w", 0, 10)
+                self.assertEqual(first["id"], "dep")
+                # fail dep -> main stays pending ineligible
+                q2.fail("dep", "w", first["attempts"], 1, retry_delay=5)
+                # dep pending but not ready; main also ineligible
+                self.assertIsNone(q2.claim("w", 1, 10))
+                cdep = q2.claim("w", 6, 10)
+                self.assertEqual(cdep["id"], "dep")
+                q2.complete("dep", "w", cdep["attempts"], 7)
+                cmain = q2.claim("w", 7, 10)
+                self.assertEqual(cmain["id"], "main")
