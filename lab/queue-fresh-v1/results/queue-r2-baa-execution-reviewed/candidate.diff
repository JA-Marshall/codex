+    def test_atomic_batch_rejects(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(tmpdb(tmp))
+            q.submit([{"id": "ok"}])
+            before = q.list()
+            # duplicate in batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "n1"}, {"id": "n1"}])
+            # unknown dep
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "n2", "dependencies": ["ghost"]}])
+            # self dep
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "n3", "dependencies": ["n3"]}])
+            # cycle
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c1", "dependencies": ["c2"]}, {"id": "c2", "dependencies": ["c1"]}])
+            # conflict resubmit
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "ok", "priority": 99}])
+            # unknown field
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "n4", "zzz": 1}])
