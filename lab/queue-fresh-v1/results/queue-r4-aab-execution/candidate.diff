+            self.assertEqual(p.returncode, 0, p.stderr)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            val = json.loads(p.stdout)
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys check: raw stdout should have keys in order
+            raw = p.stdout.strip()
+            # for list result, check inner object keys sorted by ensuring dumps sorted equals raw for that structure
+            self.assertEqual(json.dumps(val, sort_keys=True), raw)
+            # list via CLI persists
+            with open(req, "w", encoding="utf-8") as f:
+                json.dump({"op": "list"}, f)
+            p2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True)
+            self.assertEqual(p2.returncode, 0)
+            self.assertEqual(len(json.loads(p2.stdout)), 1)
+
+    def test_cli_failures_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # need valid db first
+            Queue(db).submit([{"id": "a"}])
+            cases = []
+            # malformed JSON
+            cases.append(("malformed", b"{not json"))
+            # non-object
+            cases.append(("nonobject", json.dumps([1, 2]).encode()))
+            # unknown op
+            cases.append(("unknownop", json.dumps({"op": "nope"}).encode()))
+            # unknown field
+            cases.append(("unknownfield", json.dumps({"op": "list", "extra": 1}).encode()))
+            # missing field
+            cases.append(("missingfield", json.dumps({"op": "get"}).encode()))
+            # api ValueError (unknown dep)
+            cases.append(("apierror", json.dumps({"op": "submit", "jobs": [{"id": "x", "dependencies": ["missing"]}]}).encode()))
+            # bad UTF-8
+            cases.append(("badutf8", b"\xff\xfe"))
+            for name, raw in cases:
+                with self.subTest(name=name):
+                    req = str(Path(tmp) / f"{name}.json")
+                    with open(req, "wb") as f:
+                        f.write(raw)
+                    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True)
+                    self.assertEqual(p.returncode, 2, name)
+                    self.assertEqual(p.stdout, b"", name)
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp) / "does-not-exist.json")], capture_output=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # db error (directory as db)
+            req = str(Path(tmp) / "ok.json")
+            with open(req, "w", encoding="utf-8") as f:
+                json.dump({"op": "list"}, f)
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", tmp, "--request", req], capture_output=True)
+            # sqlite connecting to directory fails -> exit 2 empty stdout
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+
+    def test_cli_persistence_across_restarts(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            def run(req_obj):
+                req = str(Path(tmp) / "tmp_req.json")
+                with open(req, "w", encoding="utf-8") as f:
+                    json.dump(req_obj, f)
+                p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True)
+                return p
+            p = run({"op": "submit", "jobs": [{"id": "a"}, {"id": "b", "dependencies": ["a"]}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            p = run({"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(p.returncode, 0)
+            claimed = json.loads(p.stdout)
+            self.assertEqual(claimed["id"], "a")
+            p = run({"op": "complete", "id": "a", "worker": "w", "attempt": claimed["attempts"], "now": 1})
+            self.assertEqual(p.returncode, 0)
+            p = run({"op": "claim", "worker": "w", "now": 1, "lease_seconds": 10})
+            self.assertEqual(json.loads(p.stdout)["id"], "b")
+            # failed request must not lose committed work
+            p = run({"op": "submit", "jobs": [{"id": "bad", "dependencies": ["missing"]}]})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            p = run({"op": "list"})
+            self.assertEqual(p.returncode, 0)
+            ids = sorted(v["id"] for v in json.loads(p.stdout))
+            self.assertEqual(ids, ["a", "b"])
+
+
+if __name__ == "__main__":
+    unittest.main()
