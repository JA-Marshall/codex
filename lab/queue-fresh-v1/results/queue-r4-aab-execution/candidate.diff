+            max_a = v.get("max_attempts", 3)
+            ready = v.get("ready_at", 0)
+            state = v.get("state", "pending")
+            attempts = v.get("attempts", 0)
+            worker = v.get("worker", None)
+            lease = v.get("lease_until", None)
+            try:
+                payload_s = _j2.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+                deps_s = _j2.dumps(deps_norm, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+                spec_payload_s = payload_s
+            except Exception:
+                payload_s = "{}"
+                deps_s = "[]"
+                spec_payload_s = "{}"
+            try:
+                priority_i = int(priority)
+            except Exception:
+                priority_i = 0
+            try:
+                max_i = int(max_a)
+            except Exception:
+                max_i = 3
+            try:
+                ready_i = int(ready)
+            except Exception:
+                ready_i = 0
+            try:
+                att_i = int(attempts)
+            except Exception:
+                att_i = 0
+            conn.execute(
+                "INSERT OR REPLACE INTO jobs (id, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until, spec_payload, spec_priority, spec_dependencies, spec_max_attempts, spec_ready_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
+                (oid, payload_s, priority_i, deps_s, max_i, ready_i, state, att_i, worker, lease, spec_payload_s, priority_i, deps_s, max_i, ready_i),
+            )
+        return
+    # Unknown schema shape: ensure new table exists.
+    conn.execute(_SCHEMA_NEW)
