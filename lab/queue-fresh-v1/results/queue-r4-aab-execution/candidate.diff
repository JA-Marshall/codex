+                if color[nxt] == GRAY:
+                    return True
+                if color[nxt] == WHITE:
+                    stack.append((nxt, 0))
+            else:
+                color[node] = BLACK
+                stack.pop()
+        return False
+
+    for n in nodes:
+        if color[n] == WHITE:
+            if visit(n):
+                return True
+    return False
