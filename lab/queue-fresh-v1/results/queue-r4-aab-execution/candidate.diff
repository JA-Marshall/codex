+    if "data" in cols and "state" not in cols:
+        # Migrate legacy single-blob table.
+        import json as _json
+        old_rows = list(conn.execute("SELECT id, data FROM jobs").fetchall())
+        conn.execute("DROP TABLE jobs")
+        conn.execute(_SCHEMA_NEW)
+        for oid, data in old_rows:
+            try:
+                v = _json.loads(data)
+            except Exception:
+                continue
+            import json as _j2
+            payload = v.get("payload", {})
+            priority = v.get("priority", 0)
+            deps = v.get("dependencies", [])
+            try:
