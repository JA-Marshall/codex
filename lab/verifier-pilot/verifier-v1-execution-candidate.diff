diff --git a/dependency_order.py b/dependency_order.py
index df55e1d..216282b 100644
--- a/dependency_order.py
+++ b/dependency_order.py
@@ -1,5 +1,38 @@
 """Order tasks for execution."""
 
+import heapq
+
 
 def order_tasks(graph: dict[str, list[str]]) -> list[str]:
-    return sorted(graph)
+    if not isinstance(graph, dict):
+        raise ValueError("graph must be a dict")
+    for key, deps in graph.items():
+        if not isinstance(key, str) or not key:
+            raise ValueError("task names must be nonempty strings")
+        if not isinstance(deps, list):
+            raise ValueError("dependencies must be lists")
+        for dep in deps:
+            if not isinstance(dep, str) or not dep:
+                raise ValueError("dependency names must be nonempty strings")
+            if dep not in graph:
+                raise ValueError(f"unknown dependency: {dep!r}")
+    indegree = {}
+    dependents: dict[str, list[str]] = {key: [] for key in graph}
+    for key, deps in graph.items():
+        unique = set(deps)
+        indegree[key] = len(unique)
+        for dep in unique:
+            dependents[dep].append(key)
+    heap = [key for key, deg in indegree.items() if deg == 0]
+    heapq.heapify(heap)
+    result: list[str] = []
+    while heap:
+        task = heapq.heappop(heap)
+        result.append(task)
+        for dependent in dependents[task]:
+            indegree[dependent] -= 1
+            if indegree[dependent] == 0:
+                heapq.heappush(heap, dependent)
+    if len(result) != len(graph):
+        raise ValueError("cycle detected")
+    return result
diff --git a/tests/test_regression.py b/tests/test_regression.py
