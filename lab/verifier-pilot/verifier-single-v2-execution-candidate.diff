diff --git a/tests/test_regression.py b/tests/test_regression.py
new file mode 100644
index 0000000..b210fd1
--- /dev/null
+++ b/tests/test_regression.py
@@ -0,0 +1,154 @@
+import copy
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from dependency_order import order_tasks
+import cli
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+CLI_PATH = REPO_ROOT / "cli.py"
+
+
+def run_cli_bytes(payload: bytes):
+    with tempfile.NamedTemporaryFile(delete=False, suffix=".json") as f:
+        f.write(payload)
+        name = f.name
+    try:
+        proc = subprocess.run(
+            [sys.executable, str(CLI_PATH), name],
+            capture_output=True,
+        )
+        return proc
+    finally:
+        Path(name).unlink(missing_ok=True)
+
+
+class RegressionTests(unittest.TestCase):
+    def test_tie_break_smallest_available_first(self):
+        # 'b' and 'c' available; 'b' smallest runs first, unlocking 'a'
+        # which is smaller than 'c', so 'a' must come before 'c'.
+        self.assertEqual(
+            order_tasks({"b": [], "a": ["b"], "c": []}),
+            ["b", "a", "c"],
+        )
+        # All independent: pure lexicographic order.
+        self.assertEqual(
+            order_tasks({"c": [], "b": [], "a": []}),
+            ["a", "b", "c"],
+        )
+
+    def test_diamond(self):
+        graph = {"a": [], "b": ["a"], "c": ["a"], "d": ["b", "c"]}
+        self.assertEqual(order_tasks(graph), ["a", "b", "c", "d"])
+
+    def test_duplicate_dependencies_count_once(self):
+        self.assertEqual(order_tasks({"a": [], "b": ["a", "a"]}), ["a", "b"])
+
+    def test_disconnected_components_order(self):
+        self.assertEqual(
+            order_tasks({"b": ["a"], "a": [], "d": ["c"], "c": []}),
+            ["a", "b", "c", "d"],
+        )
+
+    def test_invalid_shape(self):
+        bad_graphs = [
+            [],
+            "a",
+            None,
+            123,
+            {"": []},
+            {123: []},
+            {None: []},
+            {("a",): []},
+            {"a": "b"},
+            {"a": ("b",)},
+            {"a": "notalist"},
+            {"a": [123]},
+            {"a": [None]},
+            {"a": [""]},
+            {"a": [123]},
+            {"a": ["a", 1]},
+        ]
+        for bad in bad_graphs:
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    order_tasks(bad)
+
+    def test_unknown_dependency(self):
+        with self.assertRaises(ValueError):
+            order_tasks({"a": ["b"]})
+        with self.assertRaises(ValueError):
+            order_tasks({"a": [], "b": ["missing"]})
+
+    def test_self_cycle(self):
+        with self.assertRaises(ValueError):
+            order_tasks({"a": ["a"]})
+
+    def test_simple_cycle(self):
+        with self.assertRaises(ValueError):
+            order_tasks({"a": ["b"], "b": ["a"]})
+
+    def test_disconnected_cycle(self):
+        with self.assertRaises(ValueError):
+            order_tasks({"a": [], "b": [], "x": ["y"], "y": ["x"]})
+        with self.assertRaises(ValueError):
+            order_tasks({"a": ["b"], "b": ["a"], "c": [], "d": ["c"]})
+
+    def test_does_not_mutate_input(self):
+        graph = {"a": [], "b": ["a", "a"], "c": ["a"], "d": ["b", "c"]}
+        snapshot = copy.deepcopy(graph)
+        order_tasks(graph)
+        self.assertEqual(graph, snapshot)
+        # Inner lists must be unchanged objects content-wise.
+        self.assertEqual(graph["b"], ["a", "a"])
+
+    def test_cli_success_bytes(self):
+        graph = {"b": ["a"], "a": [], "z": []}
+        proc = run_cli_bytes(json.dumps(graph).encode("utf-8"))
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stdout, b'["a", "b", "z"]\n')
+        self.assertTrue(proc.stdout.endswith(b"\n"))
+        self.assertEqual(proc.stdout.count(b"\n"), 1)
+
+    def test_cli_invalid_graph_exits_2_empty_stdout(self):
+        proc = run_cli_bytes(json.dumps({"a": ["b"]}).encode("utf-8"))
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, b"")
+
+    def test_cli_cycle_exits_2_empty_stdout(self):
+        proc = run_cli_bytes(json.dumps({"a": ["b"], "b": ["a"]}).encode("utf-8"))
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, b"")
+
+    def test_cli_non_dict_json_exits_2_empty_stdout(self):
+        proc = run_cli_bytes(b"[]")
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, b"")
+
+    def test_cli_bad_json_exits_2_empty_stdout(self):
+        proc = run_cli_bytes(b"{not json}")
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, b"")
+
+    def test_cli_missing_file_exits_2_empty_stdout(self):
+        proc = subprocess.run(
+            [sys.executable, str(CLI_PATH), "missing-no-such-file.json"],
+            capture_output=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, b"")
+
+    def test_cli_usage_exits_2_empty_stdout(self):
+        for argv in [[sys.executable, str(CLI_PATH)], [sys.executable, str(CLI_PATH), "a", "b"]]:
+            with self.subTest(argv=argv):
+                proc = subprocess.run(argv, capture_output=True)
+                self.assertEqual(proc.returncode, 2)
+                self.assertEqual(proc.stdout, b"")
+
+
+if __name__ == "__main__":
+    unittest.main()
