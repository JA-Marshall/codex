index df55e1d..4409b23 100644
--- a/dependency_order.py
+++ b/dependency_order.py
@@ -1,5 +1,36 @@
 """Order tasks for execution."""
+import heapq
 
 
 def order_tasks(graph: dict[str, list[str]]) -> list[str]:
-    return sorted(graph)
+    if not isinstance(graph, dict):
+        raise ValueError("graph must be a dict")
+    for key, value in graph.items():
+        if not isinstance(key, str) or key == "":
+            raise ValueError(f"invalid task name: {key!r}")
+        if not isinstance(value, list):
+            raise ValueError(f"invalid dependencies for {key!r}")
+        for dep in value:
+            if not isinstance(dep, str) or dep == "":
+                raise ValueError(f"invalid dependency for {key!r}: {dep!r}")
+            if dep not in graph:
+                raise ValueError(f"unknown dependency {dep!r} for {key!r}")
+    deduped = {task: set(deps) for task, deps in graph.items()}
+    indegree = {task: len(deps) for task, deps in deduped.items()}
+    dependents: dict[str, set[str]] = {task: set() for task in graph}
+    for task, deps in deduped.items():
+        for dep in deps:
+            dependents[dep].add(task)
+    heap = [task for task, deg in indegree.items() if deg == 0]
+    heapq.heapify(heap)
+    result: list[str] = []
+    while heap:
+        current = heapq.heappop(heap)
+        result.append(current)
+        for nxt in dependents[current]:
+            indegree[nxt] -= 1
+            if indegree[nxt] == 0:
+                heapq.heappush(heap, nxt)
+    if len(result) != len(graph):
+        raise ValueError("cycle detected")
+    return result
