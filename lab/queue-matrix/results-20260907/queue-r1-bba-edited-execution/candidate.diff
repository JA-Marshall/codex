+            pathlib.Path(helper).write_text(textwrap.dedent("""
+                import sys
+                from durable_queue import Queue
+                q = Queue(sys.argv[1])
+                v = q.claim("helper", 0, 30)
+                print("GOT" if v else "NONE")
+            """))
+            v = q.claim("parent", 0, 30)
+            self.assertIsNotNone(v)
+            env = dict(os.environ)
+            env["PYTHONPATH"] = str(pathlib.Path.cwd()) + os.pathsep + env.get("PYTHONPATH", "")
