+def strict_int(v):
+    return type(v) is int
+
+
+def is_finite_json(v):
+    if v is None:
+        return True
+    if isinstance(v, bool):
+        return True
+    if type(v) is int:
+        return True
+    if isinstance(v, float):
+        return math.isfinite(v)
+    if isinstance(v, str):
+        return True
+    if isinstance(v, list):
+        return all(is_finite_json(x) for x in v)
+    if isinstance(v, dict):
