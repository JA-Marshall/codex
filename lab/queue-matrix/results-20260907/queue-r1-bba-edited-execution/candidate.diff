+"""Focused regression tests (TDD red for s2: submit/views)."""
+import copy
+import pathlib
+import tempfile
+import unittest
+
+from durable_queue import Queue, storage
+
+
+class StorageTxTests(unittest.TestCase):
+    def test_wal_and_transaction_helper(self):
+        self.assertTrue(hasattr(storage, "transaction"), "missing transaction helper")
+        self.assertTrue(hasattr(storage, "strict_int"), "missing strict_int")
+        with tempfile.TemporaryDirectory() as tmp:
+            p = str(pathlib.Path(tmp) / "q.db")
+            c = storage.connect(p)
+            try:
+                mode = list(c.execute("PRAGMA journal_mode"))[0][0]
+            finally:
+                c.close()
+            self.assertEqual(mode.lower(), "wal")
+
+    def test_strict_int_rejects_bool(self):
+        self.assertTrue(storage.strict_int(3))
+        self.assertFalse(storage.strict_int(True))
+        self.assertFalse(storage.strict_int(False))
+        self.assertFalse(storage.strict_int(3.0))
+
+    def test_finite_json_rejects_nan(self):
+        self.assertTrue(storage.is_finite_json({"a": 1}))
+        self.assertFalse(storage.is_finite_json({"a": float("nan")}))
+        self.assertFalse(storage.is_finite_json({"a": float("inf")}))
+
+
+class SubmitViewsTests(unittest.TestCase):
+    def _q(self, tmp):
+        return Queue(pathlib.Path(tmp) / "q.db")
+
+    def test_submit_rejects_unknown_field_and_leaves_db_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
