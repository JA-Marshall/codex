+    def test_claim_validates_and_no_recovery_on_invalid(self):
+        import tempfile
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # expire it: lease_until=5; invalid claim should not recover
+            with self.assertRaises(ValueError):
+                q.claim("", 10, 5)
+            with self.assertRaises(ValueError):
+                q.claim("w2", 10, True)
+            with self.assertRaises(ValueError):
+                q.claim("w2", True, 5)
+            # still running, not recovered
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
