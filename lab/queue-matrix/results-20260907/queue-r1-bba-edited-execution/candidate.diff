+    def test_cli_success_and_exit2(self):
+        import json, subprocess, sys, tempfile
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(pathlib.Path(tmp) / "q.db")
+            req = str(pathlib.Path(tmp) / "req.json")
+            pathlib.Path(req).write_text(json.dumps({"op": "submit", "jobs": [{"id": "a"}]}), encoding="utf-8")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0)
+            self.assertEqual(json.loads(r.stdout)[0]["id"], "a")
+            self.assertTrue(r.stdout.endswith("\n"))
+            # bad op -> exit 2 empty stdout
+            pathlib.Path(req).write_text(json.dumps({"op": "nope"}), encoding="utf-8")
+            r2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True)
+            self.assertEqual(r2.returncode, 2)
+            self.assertEqual(r2.stdout, "")
+            # unknown field -> exit 2
+            pathlib.Path(req).write_text(json.dumps({"op": "list", "extra": 1}), encoding="utf-8")
+            r3 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True)
+            self.assertEqual(r3.returncode, 2)
+            self.assertEqual(r3.stdout, "")
+            # malformed json -> exit 2
+            pathlib.Path(req).write_text("{not json", encoding="utf-8")
