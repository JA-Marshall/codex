+            q = self._q(tmp)
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 10}, {"id": "future", "priority": 100, "ready_at": 50}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            self.assertEqual(c["attempts"], 1)
+            self.assertEqual(c["lease_until"], 10)
