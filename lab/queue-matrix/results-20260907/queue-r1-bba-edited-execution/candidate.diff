+    def test_two_processes_compete_exactly_one_wins(self):
+        import concurrent.futures, os, subprocess, sys, tempfile, textwrap, json
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(pathlib.Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "race"}])
+            code = "import sys; from durable_queue import Queue; v=Queue(sys.argv[1]).claim(sys.argv[2], 0, 30); print('WIN:'+v['worker'] if v else 'NONE')"
+            env = dict(os.environ)
+            import pathlib as _pl
+            env["PYTHONPATH"] = str(_pl.Path.cwd()) + os.pathsep + env.get("PYTHONPATH", "")
+            def run(w):
+                return subprocess.run([sys.executable, "-c", code, db, w], capture_output=True, text=True, env=env, cwd=str(_pl.Path.cwd()))
+            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
+                f1 = ex.submit(run, "w1")
+                f2 = ex.submit(run, "w2")
+                r1 = f1.result()
+                r2 = f2.result()
+            outs = sorted([r1.stdout.strip(), r2.stdout.strip()])
+            self.assertEqual(len(outs), 2)
+            wins = [o for o in outs if o.startswith("WIN:")]
+            nones = [o for o in outs if o == "NONE"]
+            self.assertEqual(len(wins), 1)
+            self.assertEqual(len(nones), 1)
