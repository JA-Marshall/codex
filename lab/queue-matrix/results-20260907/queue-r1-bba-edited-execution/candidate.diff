+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # idempotent
+            self.assertEqual(q.recover(5), [])
+            # exhaust attempts -> failed
+            c2 = q.claim("w", 5, 5)
