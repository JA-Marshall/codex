+            c1 = q.claim("w1", 0, 5)
+            self.assertEqual(c1["id"], "b")
+            # b expires at 5; at now=10 claim should recover b then pick highest priority eligible (b again, priority 100)
+            c2 = q.claim("w2", 10, 5)
+            self.assertEqual(c2["id"], "b")
+            self.assertEqual(c2["worker"], "w2")
