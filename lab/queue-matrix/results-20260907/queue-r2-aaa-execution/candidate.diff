+++ b/tests/test_regression.py
@@ -0,0 +1,231 @@
+import copy
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def tmp_queue(tmpdir):
+    return Queue(Path(tmpdir) / "q.db")
+
+
+class SubmitViewsTests(unittest.TestCase):
+    def test_no_mutation_and_exact_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            inp = [{"id": "a", "payload": {"x": [1, 2]}, "dependencies": ["b", "b"], "priority": 1}]
+            orig = copy.deepcopy(inp)
+            # need b first for dependency
+            q.submit([{"id": "b"}])
+            views = q.submit(inp)
+            self.assertEqual(inp, orig)
+            v = views[0]
+            self.assertEqual(set(v.keys()), {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"})
+            self.assertEqual(v["dependencies"], ["b"])
+            self.assertEqual(v["state"], "pending")
+            # detached
+            v["payload"]["x"].append(99)
+            v["dependencies"].append("zz")
+            self.assertEqual(q.get("a")["payload"], {"x": [1, 2]})
+            self.assertEqual(q.get("a")["dependencies"], ["b"])
+
+    def test_bool_not_int_and_finite(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            for bad in [
+                [{"id": "x", "priority": True}],
+                [{"id": "x", "max_attempts": True}],
+                [{"id": "x", "ready_at": True}],
+                [{"id": "x", "payload": {"v": float("inf")}}],
+                [{"id": "x", "payload": {"v": float("nan")}}],
+                [{"id": "x", "payload": [float("-inf")]}],
+                [{"id": "x", "unknown": 1}],
+                [{"id": "", }],
+                [{"id": 123}],
+                ["not-a-dict"],
+                [{"id": "x", "dependencies": "a"}],
+                [{"id": "x", "dependencies": [""]}],
+                [{"id": "x", "dependencies": [123]}],
+                [{"id": "x", "max_attempts": 0}],
+                [{"id": "x", "max_attempts": 101}],
+                [{"id": "x", "ready_at": -1}],
+                [{"id": "x", "payload": []}],
+            ]:
+                with self.assertRaises(ValueError, msg=str(bad)):
+                    q.submit(bad)
+            self.assertEqual(q.list(), [])
+
+    def test_atomic_rollback_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a", "payload": {"n": 1}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "c", "priority": True}])
+            self.assertIsNone(q.get("b"))
+            self.assertIsNone(q.get("c"))
+            # idempotent same-spec
+            v = q.submit([{"id": "a", "payload": {"n": 1}}])
+            self.assertEqual(v[0]["payload"], {"n": 1})
+            # conflict
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"n": 2}}])
+            self.assertEqual(q.get("a")["payload"], {"n": 1})
+            # whole batch conflict rolls back new inserts too
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "new1"}, {"id": "a", "payload": {"n": 9}}])
+            self.assertIsNone(q.get("new1"))
+
+    def test_unknown_self_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "y", "dependencies": ["y"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c1", "dependencies": ["c2"]}, {"id": "c2", "dependencies": ["c1"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "d1"}, {"id": "d1"}])
+            self.assertEqual(q.list(), [])
+            # valid diamond then cycle attempt
+            q.submit([{"id": "a"}, {"id": "b", "dependencies": ["a"]}, {"id": "c", "dependencies": ["a"]}])
+            # self via existing? new job depending on itself
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "z", "dependencies": ["z"]}])
+
+    def test_idempotent_after_state_change(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a", "ready_at": 0}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # same original spec still idempotent even though live ready_at/state changed later
+            q.recover(10)
+            self.assertEqual(q.get("a")["ready_at"], 10)
+            v = q.submit([{"id": "a", "ready_at": 0}])
+            self.assertEqual(v[0]["state"], "pending")
+            self.assertEqual(v[0]["ready_at"], 10)
+
+    def test_get_list_validation_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            for bad in ["", 123, None, True]:
+                with self.assertRaises(ValueError):
+                    q.get(bad)
+            # get/list do not recover implicitly: still running after expiry time
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.list()[0]["state"], "running")
+
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_priority_lex_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "b", "priority": 5}, {"id": "a", "priority": 5}, {"id": "c", "priority": 10}])
+            self.assertEqual(q.claim("w", 0, 10)["id"], "c")
+            self.assertEqual(q.claim("w", 0, 10)["id"], "a")
+            self.assertEqual(q.claim("w", 0, 10)["id"], "b")
+
+    def test_eligibility_ready_attempts_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "base"}, {"id": "child", "dependencies": ["base"]}, {"id": "future", "ready_at": 10}])
+            # child ineligible until base succeeded
+            self.assertEqual(q.claim("w", 0, 10)["id"], "base")
+            self.assertIsNone(q.claim("w", 0, 10))
+            q.complete("base", "w", 1, 1)
+            self.assertEqual(q.claim("w", 1, 10)["id"], "child")
+            self.assertIsNone(q.claim("w", 1, 10))  # future not ready
+            self.assertEqual(q.claim("w", 10, 10)["id"], "future")
+
+    def test_failed_dep_stays_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "base", "max_attempts": 1}, {"id": "child", "dependencies": ["base"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "base")
+            q.fail("base", "w", 1, 1)
+            self.assertEqual(q.get("base")["state"], "failed")
+            self.assertIsNone(q.claim("w", 1, 10))
+            self.assertEqual(q.get("child")["state"], "pending")
+
+    def test_recover_bounded_and_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "m1", "max_attempts": 1}, {"id": "m2", "max_attempts": 5}])
+            q.claim("w", 0, 10)
+            q.claim("w", 0, 5)
+            # m1 lease 10, m2 lease 5 (claim order: lex smallest first since same priority: m1 then m2)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["m2"])
+            self.assertEqual(q.get("m2")["ready_at"], 5)
+            ids = q.recover(10)
+            self.assertEqual(ids, ["m1"])
+            self.assertEqual(q.get("m1")["state"], "failed")
+            self.assertEqual(q.get("m1")["ready_at"], 0)
+            self.assertEqual(q.recover(10), [])
+
+    def test_invalid_claim_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            q.claim("w", 0, 10)
+            for args in [("", 20, 10), ("w", True, 10), ("w", 20, True), ("w", -1, 10), ("w", 20, 0)]:
+                with self.assertRaises(ValueError):
+                    q.claim(*args)
+            self.assertEqual(q.get("a")["state"], "running")
+
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_fail_paths(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 10)
+            v = q.complete("a", "w", 1, 5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["ready_at"], 0)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 6)
+
+    def test_fail_retry_and_exhaust(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "b", "max_attempts": 2}])
+            q.claim("w", 0, 10)
+            v = q.fail("b", "w", 1, 5, retry_delay=7)
+            self.assertEqual((v["state"], v["ready_at"]), ("pending", 12))
+            c = q.claim("w", 12, 10)
+            self.assertEqual(c["attempts"], 2)
+            v2 = q.fail("b", "w", 2, 13)
+            self.assertEqual(v2["state"], "failed")
+
+    def test_stale_wrong_expired_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "c", "max_attempts": 3}])
+            q.claim("w1", 0, 5)
+            q.recover(5)
+            q.claim("w1", 5, 10)
+            with self.assertRaises(ValueError):
+                q.complete("c", "w1", 1, 6)
+            with self.assertRaises(ValueError):
+                q.complete("c", "other", 2, 6)
+            with self.assertRaises(ValueError):
+                q.complete("c", "w1", 2, 15)
+            self.assertEqual(q.get("c")["state"], "running")
+            before = q.get("c")
+            with self.assertRaises(ValueError):
+                q.fail("c", "w1", 2, 6, retry_delay=-1)
+            self.assertEqual(q.get("c"), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
