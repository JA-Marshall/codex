+                dependencies = view.get("dependencies", [])
+                max_attempts = view.get("max_attempts", 3)
+                ready_at = view.get("ready_at", 0)
+                state = view.get("state", "pending")
+                attempts = view.get("attempts", 0)
+                worker = view.get("worker", None)
+                lease_until = view.get("lease_until", None)
+                if not isinstance(jid2, str) or not jid2:
+                    continue
+                if not isinstance(payload, dict):
+                    payload = {}
+                if not isinstance(dependencies, list):
+                    dependencies = []
+                # normalize dependencies
+                deps = sorted({d for d in dependencies if isinstance(d, str) and d})
+                import json as _j
+                spec = {
+                    "id": jid2,
+                    "payload": payload,
+                    "priority": priority if type(priority) is int else 0,
+                    "dependencies": deps,
+                    "max_attempts": max_attempts if type(max_attempts) is int and 1 <= max_attempts <= 100 else 3,
+                    "ready_at": ready_at if type(ready_at) is int and ready_at >= 0 else 0,
+                }
+                conn.execute(
+                    "INSERT INTO jobs (id, spec, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+                    (jid2, _j.dumps(spec, sort_keys=True), _j.dumps(payload, sort_keys=True), spec["priority"], _j.dumps(deps), spec["max_attempts"], view.get("ready_at", spec["ready_at"]) if type(view.get("ready_at", 0)) is int else spec["ready_at"], state if state in ("pending","running","succeeded","failed") else "pending", attempts if type(attempts) is int and attempts >= 0 else 0, worker if isinstance(worker, str) else None, lease_until if type(lease_until) is int else None),
