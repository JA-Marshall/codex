@@ -0,0 +1,109 @@
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+
+def run_cli(db_path, payload=None, raw_bytes=None):
+    """Run one CLI invocation in a fresh process. Returns (returncode, stdout_bytes, stderr_bytes)."""
+    with tempfile.NamedTemporaryFile(mode="wb", suffix=".json", delete=False) as f:
+        if raw_bytes is not None:
+            f.write(raw_bytes)
+        else:
+            f.write(json.dumps(payload).encode("utf-8"))
+        req = f.name
+    try:
+        p = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db_path), "--request", req],
+            capture_output=True,
+        )
+        return p.returncode, p.stdout, p.stderr
+    finally:
+        try:
+            Path(req).unlink()
+        except OSError:
+            pass
+
+
+class ProcessDurabilityTests(unittest.TestCase):
+    def test_reopen_durability_via_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            rc, out, _ = run_cli(db, {"op": "submit", "jobs": [{"id": "build", "payload": {"t": "all"}}]})
+            self.assertEqual(rc, 0)
+            # fresh process get
+            rc, out, _ = run_cli(db, {"op": "get", "id": "build"})
+            self.assertEqual(rc, 0)
+            val = json.loads(out.decode("utf-8"))
+            self.assertEqual(val["payload"], {"t": "all"})
+            # fresh process list
+            rc, out, _ = run_cli(db, {"op": "list"})
+            self.assertEqual(rc, 0)
+            vals = json.loads(out.decode("utf-8"))
+            self.assertEqual([v["id"] for v in vals], ["build"])
+            # claim + complete across restarts
+            rc, out, _ = run_cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(rc, 0)
+            claim = json.loads(out.decode("utf-8"))
+            self.assertEqual(claim["id"], "build")
+            rc, out, _ = run_cli(db, {"op": "complete", "id": "build", "worker": "w", "attempt": claim["attempts"], "now": 1})
+            self.assertEqual(rc, 0)
+            self.assertEqual(json.loads(out.decode("utf-8"))["state"], "succeeded")
+
+    def test_failed_request_preserves_commit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            rc, out, _ = run_cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(rc, 0)
+            rc, out, _ = run_cli(db, {"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(rc, 2)
+            self.assertEqual(out, b"")
+            rc, out, _ = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(rc, 0)
+            self.assertEqual(json.loads(out.decode("utf-8"))["id"], "a")
+
+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            rc, out, _ = run_cli(db, {"op": "submit", "jobs": [{"id": "only"}]})
+            self.assertEqual(rc, 0)
+            with ThreadPoolExecutor(max_workers=2) as ex:
+                f1 = ex.submit(run_cli, db, {"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 30})
+                f2 = ex.submit(run_cli, db, {"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 30})
+                (rc1, out1, _), (rc2, out2, _) = f1.result(), f2.result()
+            self.assertEqual(rc1, 0)
+            self.assertEqual(rc2, 0)
+            v1 = json.loads(out1.decode("utf-8"))
+            v2 = json.loads(out2.decode("utf-8"))
+            # exactly one wins the lease; the other gets null
+            got = sorted([json.dumps(v, sort_keys=True) for v in (v1, v2)])
+            self.assertIn("null", got)
+            winner = v1 if v1 is not None else v2
+            self.assertIsNotNone(winner)
+            self.assertEqual(winner["id"], "only")
+            self.assertIn(winner["worker"], ("w1", "w2"))
+            # loser is None
+            loser = v2 if winner is v1 else v1
+            self.assertIsNone(loser)
+
+    def test_cli_error_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            for payload, raw in [
+                ({"op": "bogus"}, None),
+                ({"op": "list", "extra": 1}, None),
+                ({"op": "get"}, None),
+                (None, b"{bad"),
+                (None, b"[]"),
+                (None, b"\xff\xfe"),
+            ]:
+                rc, out, _ = run_cli(db, payload, raw_bytes=raw)
+                self.assertEqual(rc, 2, msg=str(payload))
+                self.assertEqual(out, b"")
+
+
+if __name__ == "__main__":
+    unittest.main()
