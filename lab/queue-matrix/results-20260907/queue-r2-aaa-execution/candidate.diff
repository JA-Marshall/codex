+    args = parser.parse_args(argv)
+    # Read request file as UTF-8, must be single JSON object
+    try:
+        with open(args.request, "rb") as stream:
+            raw = stream.read()
+    except OSError:
+        return 2
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        return 2
+    try:
+        request = json.loads(text)
+    except json.JSONDecodeError:
+        return 2
+    except ValueError:
+        return 2
+    if not isinstance(request, dict):
+        return 2
+    if "op" not in request:
+        return 2
+    op = request["op"]
+    if not isinstance(op, str) or op not in _OP_FIELDS:
+        return 2
+    allowed = _OP_FIELDS[op] | {"op"}
+    for key in request.keys():
+        if key not in allowed:
+            return 2
+    for key in _REQUIRED_FIELDS[op]:
+        if key not in request:
+            return 2
+    kwargs = {k: v for k, v in request.items() if k != "op"}
+    try:
+        queue = Queue(args.db)
+    except Exception:
+        return 2
+    try:
+        method = getattr(queue, op)
+    except AttributeError:
+        return 2
+    try:
+        value = method(**kwargs)
+    except TypeError:
+        return 2
+    except ValueError:
+        return 2
+    except Exception:
+        return 2
+    try:
+        out = json.dumps(value, sort_keys=True) + "\n"
+    except Exception:
+        return 2
+    sys.stdout.write(out)
     return 0
 
 
