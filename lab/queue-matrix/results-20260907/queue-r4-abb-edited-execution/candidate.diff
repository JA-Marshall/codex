+    def test_cycle_via_existing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b"}])
+            # now submitting c depending on a, and updating? Actually need cycle: submit b2? Use new jobs forming cycle with existing
+            # Existing: a->b. Add c->a and then try to resubmit b depending on c (conflict-free new edge would be cycle but b exists; resubmit same id with different spec is conflict anyway)
+            # Simpler: a->b exists; submit c->a ok, d->c ok; then try batch e->d, plus new dep creating cycle: submit f->e and e->f in one batch (already covered)
+            # Direct: submit x->y, y->x covered. For existing cycle: q has p (no deps); submit batch [q2 deps [p], p-resubmit with dep q2] -> second is conflict/cycle; must reject
+            q2 = make_queue(tmp)  # same db
