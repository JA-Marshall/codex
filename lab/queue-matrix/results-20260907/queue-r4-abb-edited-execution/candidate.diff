+"""JSON CLI for durable_queue."""
 import argparse
 import json
+import sys
 
 from .queue import Queue
 
+OPS = {"submit", "get", "list", "claim", "recover", "complete", "fail"}
+ALLOWED_FIELDS = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now", "retry_delay"},
+}
 
-def main():
+def _fail(msg=None):
+    if msg is not None:
+        try:
+            print(str(msg), file=sys.stderr)
+        except Exception:
+            pass
+    return 2
+
+def main(argv=None):
     parser = argparse.ArgumentParser()
     parser.add_argument("--db", required=True)
     parser.add_argument("--request", required=True)
-    args = parser.parse_args()
-    with open(args.request, encoding="utf-8") as stream:
-        request = json.load(stream)
-    operation = request.pop("op")
-    value = getattr(Queue(args.db), operation)(**request)
-    print(json.dumps(value, sort_keys=True))
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on usage error with empty stdout; preserve.
+        raise
+    db_path = args.db
+    req_path = args.request
+    try:
+        with open(req_path, "rb") as f:
+            raw = f.read()
+    except Exception as e:
+        return _fail(e)
+    try:
+        text = raw.decode("utf-8")
+    except Exception as e:
+        return _fail(e)
+    try:
+        request = json.loads(text)
+    except Exception as e:
+        return _fail(e)
+    if not isinstance(request, dict):
+        return _fail("request must be object")
+    if "op" not in request:
+        return _fail("missing op")
+    op = request.get("op")
+    if not isinstance(op, str) or op not in OPS:
+        return _fail("unknown op")
+    allowed = ALLOWED_FIELDS[op]
+    keys = set(request.keys()) - {"op"}
+    if not keys.issubset(allowed):
+        return _fail("unknown field")
+    kwargs = {k: request[k] for k in keys}
+    # Fail on missing required handled via method call TypeError.
+    try:
+        queue = Queue(db_path)
+    except SystemExit:
+        raise
+    except Exception as e:
+        return _fail(e)
+    try:
+        method = getattr(queue, op)
+    except Exception as e:
+        return _fail(e)
+    try:
+        value = method(**kwargs)
+    except SystemExit:
+        raise
+    except (ValueError, TypeError) as e:
+        return _fail(e)
+    except Exception as e:
+        return _fail(e)
+    try:
+        out = json.dumps(value, sort_keys=True)
+    except Exception as e:
+        return _fail(e)
+    try:
+        sys.stdout.write(out + "\n")
+    except Exception as e:
+        return _fail(e)
     return 0
 
 
