@@ -0,0 +1,117 @@
+"""Separate-process durability and claim exclusivity (AC3/AC6)."""
+import json
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+def _claim_worker(db_str, worker, now, lease, out_q):
+    try:
+        from durable_queue import Queue as Q
+        q = Q(db_str)
+        v = q.claim(worker, now, lease)
+        out_q.put((worker, v["id"] if v else None, v["attempts"] if v else None))
+    except Exception as e:
+        out_q.put((worker, f"ERR:{e}", None))
+
+class ProcessTests(unittest.TestCase):
+    def test_durability_across_reopen_and_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            q = Queue(db)
+            q.submit([{"id":"a","payload":{"n":1},"priority":3}])
+            # reopen in same process
+            self.assertEqual(Queue(db).get("a")["payload"], {"n":1})
+            # fresh process via CLI submit+get
+            req = Path(tmp)/"r.json"
+            req.write_text(json.dumps({"op":"submit","jobs":[{"id":"b","priority":1}]}), encoding="utf-8")
+            r = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(req)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            self.assertTrue(r.stdout.endswith("\n"))
+            self.assertEqual(json.loads(r.stdout)["0" if False else 0 if False else "dummy"] if False else json.loads(r.stdout)[0]["id"], "b")
+            req.write_text(json.dumps({"op":"get","id":"a"}), encoding="utf-8")
+            r = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(req)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0)
+            self.assertEqual(json.loads(r.stdout)["id"], "a")
+            # failed request must survive prior commits
+            req.write_text(json.dumps({"op":"submit","jobs":[{"id":"bad","unknown":1}]}), encoding="utf-8")
+            r = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(req)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            self.assertIsNotNone(Queue(db).get("a"))
+            self.assertIsNotNone(Queue(db).get("b"))
+
+    def test_contended_claim_exclusivity_multiprocess(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            Queue(db).submit([{"id":"only"}])
+            ctx = multiprocessing.get_context("spawn")
+            out = ctx.Queue()
+            procs = [ctx.Process(target=_claim_worker, args=(db, f"w{i}", 0, 10, out)) for i in range(4)]
+            for p in procs: p.start()
+            for p in procs: p.join(timeout=20)
+            results = [out.get() for _ in procs]
+            got = [wid for _, wid, _ in results if wid == "only"]
+            self.assertEqual(len(got), 1, results)
+            # second round: no active lease left to claim
+            self.assertIsNone(Queue(db).claim("late", 0, 10))
+
+    def test_contended_claim_subprocess_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            Queue(db).submit([{"id":"a"},{"id":"b"}])
+            reqs = []
+            for i in range(2):
+                p = Path(tmp)/f"claim{i}.json"
+                p.write_text(json.dumps({"op":"claim","worker":f"w{i}","now":0,"lease_seconds":10}), encoding="utf-8")
+                reqs.append(p)
+            procs = [subprocess.Popen([sys.executable,"-m","durable_queue","--db",db,"--request",str(r)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) for r in reqs]
+            outs = [p.communicate() for p in procs]
+            for (o,e), p in zip(outs, procs):
+                self.assertEqual(p.returncode, 0, e)
+            ids = sorted([json.loads(o)["id"] for o,e in outs if o.strip() != "null"])
+            self.assertEqual(ids, ["a","b"])
+
+    def test_cli_strictness(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            Queue(db).submit([{"id":"a"}])
+            def run(obj=None, raw=None):
+                pf = Path(tmp)/"req.json"
+                if raw is not None:
+                    pf.write_bytes(raw)
+                else:
+                    pf.write_text(json.dumps(obj), encoding="utf-8")
+                r = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(pf)], capture_output=True, text=True)
+                return r
+            # unknown field
+            r = run({"op":"get","id":"a","extra":1})
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, "")
+            # unknown op
+            r = run({"op":"nope"})
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, "")
+            # non-object
+            r = run([1,2])
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, "")
+            # malformed
+            pf = Path(tmp)/"req.json"; pf.write_text("{not json", encoding="utf-8")
+            r = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(pf)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, "")
+            # invalid utf-8
+            r = run(raw=b"\xff\xfe")
+            self.assertEqual(r.returncode, 2); self.assertEqual(r.stdout, "")
+            # success sorted keys + newline
+            r = run({"op":"get","id":"a"})
+            self.assertEqual(r.returncode, 0)
+            self.assertTrue(r.stdout.endswith("\n"))
+            self.assertEqual(r.stdout.count("\n"), 1)
+            # keys sorted
+            line = r.stdout.strip()
+            self.assertEqual(line, json.dumps(json.loads(line), sort_keys=True))
+
+if __name__ == "__main__":
+    unittest.main()
