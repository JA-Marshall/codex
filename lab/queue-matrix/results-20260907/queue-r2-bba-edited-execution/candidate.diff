+"""Focused regression tests for durable_queue contract (AC1-AC5)."""
+import copy
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+EXACT_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+def tmp_queue(tmpdir=None):
+    d = tempfile.TemporaryDirectory()
+    p = Path(d.name) / "q.db"
+    q = Queue(p)
+    return d, p, q
+
+class SubmitValidationTests(unittest.TestCase):
+    def test_unknown_field_rejected_and_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"b"}, {"id":"c","bogus":1}])
+            self.assertIsNone(q.get("b"))
+            self.assertIsNone(q.get("c"))
+            self.assertEqual(q.get("a")["id"], "a")
+
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","priority":True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","max_attempts":True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","ready_at":False}])
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            q.submit([{"id":"a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a","w",True,1)
+            with self.assertRaises(ValueError):
+                q.fail("a","w",c["attempts"],1,retry_delay=False)
+
+    def test_nonfinite_payload_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{"x":float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{"x":float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":[1,2]}])  # not object
+            self.assertIsNone(q.get("a"))
+
+    def test_duplicate_self_unknown_cycle_atomic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a"},{"id":"a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","dependencies":["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","dependencies":["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"x","dependencies":["y"]},{"id":"y","dependencies":["x"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_cycle_detection_three_nodes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","dependencies":["c"]},{"id":"b","dependencies":["a"]},{"id":"c","dependencies":["b"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_no_mutation_and_normalized_sorted_unique(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"m"},{"id":"z"}])
+            orig = {"id":"a","dependencies":["z","m","m","z"],"payload":{"k":1}}
+            snapshot = copy.deepcopy(orig)
+            views = q.submit([orig])
+            self.assertEqual(orig, snapshot)
+            self.assertEqual(views[0]["dependencies"], ["m","z"])
+            self.assertEqual(q.get("a")["dependencies"], ["m","z"])
+
+    def test_idempotent_same_spec_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a","priority":5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # resubmit same original spec should be no-op returning current view (running)
+            v = q.submit([{"id":"a","priority":5}])
+            self.assertEqual(v[0]["state"], "running")
+            self.assertEqual(v[0]["attempts"], 1)
+            # conflict rejects whole batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","priority":6}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","priority":5},{"id":"b","priority":1},{"id":"a","priority":5}])  # dup in batch even if existing?
+            # ready_at change via fail then idempotent still matches original
+            q2 = Queue(Path(tmp)/"q2.db")
+            q2.submit([{"id":"j","ready_at":0}])
+            cl = q2.claim("w",0,5)
+            q2.fail("j","w",cl["attempts"],1,retry_delay=10)
+            self.assertEqual(q2.get("j")["ready_at"], 11)
+            v2 = q2.submit([{"id":"j","ready_at":0}])
+            self.assertEqual(v2[0]["ready_at"], 11)  # current view preserved
+            with self.assertRaises(ValueError):
+                q2.submit([{"id":"j","ready_at":11}])  # conflicts with original
+
+    def test_exact_keys_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            v = q.submit([{"id":"a","payload":{"x":[1,2]}}])[0]
+            self.assertEqual(set(v.keys()), EXACT_KEYS)
+            v["payload"]["x"].append(99)
+            v["dependencies"].append("evil")
+            g = q.get("a")
+            self.assertEqual(g["payload"], {"x":[1,2]})
+            self.assertEqual(g["dependencies"], [])
+            lst = q.list()
+            lst[0]["payload"]["x"].append(100)
+            self.assertEqual(q.get("a")["payload"], {"x":[1,2]})
+
+    def test_get_list_validation_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a"}])
+            c = q.claim("w",0,5)
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get(None)
+            # get/ list do not recover
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.list()[0]["state"], "running")
+            # list sorted by ID
+            q.submit([{"id":"m"},{"id":"b"}])
+            self.assertEqual([v["id"] for v in q.list()], ["a","b","m"])
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_priority_and_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"low","priority":1},{"id":"high","priority":10},{"id":"mid","priority":5,"ready_at":100}])
+            c = q.claim("w",0,10)
+            self.assertEqual(c["id"], "high")
+            self.assertEqual(c["attempts"], 1)
+            self.assertEqual(c["worker"], "w")
+            self.assertEqual(c["lease_until"], 10)
+            c2 = q.claim("w",0,10)
+            self.assertEqual(c2["id"], "low")
+            self.assertIsNone(q.claim("w",0,10))  # mid not ready
+
+    def test_claim_respects_dependencies_and_failed_dep(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a"},{"id":"b","dependencies":["a"]}])
+            # b not eligible until a succeeded
+            self.assertEqual(q.claim("w",0,10)["id"], "a")
+            self.assertIsNone(q.claim("w",0,10))
+            # fail a with max_attempts=1 -> failed, b stays pending ineligible
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = Queue(Path(tmp2)/"q.db")
+                q2.submit([{"id":"a","max_attempts":1},{"id":"b","dependencies":["a"]}])
+                cl = q2.claim("w",0,10)
+                q2.fail("b" if False else "a","w",cl["attempts"],1)
+                self.assertEqual(q2.get("a")["state"], "failed")
+                self.assertIsNone(q2.claim("w",1,10))
+                self.assertEqual(q2.get("b")["state"], "pending")
+
+    def test_claim_recovers_first(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a","priority":1},{"id":"b","priority":100}])
+            c = q.claim("w1",0,5)
+            self.assertEqual(c["id"], "b")
+            # at now=5, b expired -> claim should recover b then claim highest eligible (b again, priority 100)
+            c2 = q.claim("w2",5,10)
+            self.assertEqual(c2["id"], "b")
+            self.assertEqual(c2["worker"], "w2")
+            self.assertEqual(c2["attempts"], 2)
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a","max_attempts":3},{"id":"b","max_attempts":1}])
+            ca = q.claim("w",0,5)
+            self.assertEqual(ca["id"], "a")
+            cb = q.claim("w",0,5)
+            self.assertEqual(cb["id"], "b")
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a","b"])
+            self.assertEqual(q.get("a")["state"], "pending")
+            self.assertEqual(q.get("a")["ready_at"], 5)
+            self.assertIsNone(q.get("a")["worker"])
+            self.assertIsNone(q.get("a")["lease_until"])
+            self.assertEqual(q.get("b")["state"], "failed")
+            # idempotent
+            self.assertEqual(q.recover(5), [])
+            self.assertEqual(q.recover(6), [])
+
+    def test_claim_validation_leaves_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a"}])
+            q.claim("w",0,5)
+            with self.assertRaises(ValueError):
+                q.claim("",5,10)
+            with self.assertRaises(ValueError):
+                q.claim("w",-1,10)
+            with self.assertRaises(ValueError):
+                q.claim("w",5,0)
+            # expired job should still be running (no recovery on invalid claim)
+            self.assertEqual(q.get("a")["state"], "running")
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_and_fail_flows(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a","max_attempts":3}])
+            c = q.claim("w",0,10)
+            v = q.complete("a","w",c["attempts"],5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a","w",c["attempts"],6)
+            with self.assertRaises(ValueError):
+                q.fail("a","w",c["attempts"],6)
+            self.assertIsNone(q.claim("w",6,10))
+
+    def test_fail_retry_and_exhaust(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a","max_attempts":2}])
+            c1 = q.claim("w",0,10)
+            v = q.fail("a","w",c1["attempts"],5,retry_delay=7)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 12)
+            self.assertIsNone(v["worker"])
+            c2 = q.claim("w",12,10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a","w",c2["attempts"],13)
+            self.assertEqual(v2["state"], "failed")
+
+    def test_stale_wrongowner_expired_norecovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a"},{"id":"b"}])
+            c = q.claim("w1",0,5)
+            self.assertEqual(c["id"], "a")
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a","w2",c["attempts"],1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a","w1",999,1)
+            # expired: now == lease_until is expired (requires now < lease)
+            with self.assertRaises(ValueError):
+                q.complete("a","w1",c["attempts"],5)
+            # must not have recovered/written
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.get("a")["worker"], "w1")
+            # reclaim after recover then old attempt rejected even same worker
+            q.recover(5)
+            c2 = q.claim("w1",5,10)
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a","w1",1,6)
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("nope","w1",1,6)
+            # invalid retry_delay
+            with self.assertRaises(ValueError):
+                q.fail("a","w1",c2["attempts"],6,retry_delay=-1)
+
+    def test_invalid_args_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp)/"q.db")
+            q.submit([{"id":"a"}])
+            c = q.claim("w",0,10)
+            before = q.get("a")
+            with self.assertRaises(ValueError):
+                q.complete("", "w", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.fail("a","w",c["attempts"],-1)
+            self.assertEqual(q.get("a"), before)
+
+if __name__ == "__main__":
+    unittest.main()
