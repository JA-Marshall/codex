+            self.assertEqual(c1["attempts"], 1)
+            q.fail("a", "w", 1, 1)
+            c2 = q.claim("w", 1, 5)
+            self.assertEqual(c2["attempts"], 2)
+            v = q.fail("a", "w", 2, 2)
+            self.assertEqual(v["state"], "failed")
+            # cannot claim terminal
+            self.assertIsNone(q.claim("w", 2, 5))
+            # cannot complete/failed terminal
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 2, 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 2, 2)
+            self.assertLessEqual(q.get("a")["attempts"], 2)
+
+    def test_priority_tie_lexicographic(self):
