+    def test_concurrent_claim_exclusivity(self):
+        import tempfile, json, subprocess, sys, concurrent.futures
+        from pathlib import Path
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            def _claim_cli(worker):
+                req = Path(tmp) / f"c-{worker}.json"
+                req.write_text(json.dumps({"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30}), encoding="utf-8")
+                pr = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True)
+                if pr.returncode != 0:
+                    return "error"
+                v = json.loads(pr.stdout.decode())
+                return v["id"] if v else None
+            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
+                futs = [ex.submit(_claim_cli, w) for w in ("w1", "w2")]
+                res = [f.result() for f in futs]
+            self.assertEqual(sorted([str(x) for x in res]), ["None", "only"])
