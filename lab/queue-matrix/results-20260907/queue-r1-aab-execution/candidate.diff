+def _has_cycle(graph):
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {node: WHITE for node in graph}
+
+    def visit(node, stack):
+        color[node] = GRAY
+        for dep in graph.get(node, []):
+            if dep not in graph:
+                continue
+            c = color.get(dep, WHITE)
+            if c == GRAY:
+                return True
+            if c == WHITE:
+                if visit(dep, stack):
+                    return True
+        color[node] = BLACK
+        return False
+
+    for node in list(graph.keys()):
+        if color[node] == WHITE:
+            if visit(node, []):
+                return True
+    return False
