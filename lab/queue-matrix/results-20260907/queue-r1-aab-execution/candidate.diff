+                            deps_n = sorted(set(deps)) if isinstance(deps, list) else []
+                        except Exception:
+                            deps_n = []
+                        spec = {
+                            "id": v.get("id", jid),
+                            "payload": payload if isinstance(payload, dict) else {},
+                            "priority": priority if type(priority) is int else 0,
+                            "dependencies": deps_n,
+                            "max_attempts": v.get("max_attempts", 3) if type(v.get("max_attempts", 3)) is int else 3,
+                            "ready_at": v.get("ready_at", 0) if type(v.get("ready_at", 0)) is int else 0,
+                        }
+                        conn.execute(
+                            "UPDATE jobs SET spec=? WHERE id=?",
+                            (json.dumps(spec, sort_keys=True, allow_nan=False), jid),
+                        )
+                    except Exception:
+                        try:
+                            fallback = {
+                                "id": jid,
+                                "payload": {},
+                                "priority": 0,
+                                "dependencies": [],
+                                "max_attempts": 3,
+                                "ready_at": 0,
+                            }
+                            conn.execute(
+                                "UPDATE jobs SET spec=? WHERE id=?",
+                                (json.dumps(fallback, sort_keys=True), jid),
+                            )
+                        except Exception:
+                            pass
+            cols2 = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
+            # Ensure data column exists (should already)
+            if "data" not in cols2:
+                raise RuntimeError("unsupported legacy schema")
+    return conn
+
+
+def begin_immediate(conn):
+    conn.execute("BEGIN IMMEDIATE")
