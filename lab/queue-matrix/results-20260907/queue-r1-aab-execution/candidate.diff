-    operation = request.pop("op")
-    value = getattr(Queue(args.db), operation)(**request)
-    print(json.dumps(value, sort_keys=True))
-    return 0
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse already prints to stderr; ensure stdout empty and exit 2
+        raise
+    try:
+        with open(args.request, encoding="utf-8", errors="strict") as stream:
+            text = stream.read()
+        try:
+            request = json.loads(text)
+        except Exception:
+            return 2
+        if not isinstance(request, dict):
+            return 2
+        if "op" not in request:
+            return 2
+        op = request["op"]
+        if not isinstance(op, str) or op not in _OPS:
+            return 2
+        allowed = _ALLOWED_KW[op]
+        required = _REQUIRED_KW[op]
+        keys = set(request.keys())
+        keys.discard("op")
+        # No unknown fields
+        if not keys.issubset(allowed):
+            return 2
+        if not required.issubset(keys):
+            return 2
+        # Extra check: keys must exactly be subset and include required; optional retry_delay allowed
+        kwargs = {k: request[k] for k in keys}
+        # Strict: reject non-string keys? JSON keys always strings, already.
+        try:
+            queue = Queue(args.db)
+        except Exception:
+            return 2
+        try:
+            method = getattr(queue, op)
+        except Exception:
+            return 2
+        try:
+            value = method(**kwargs)
+        except ValueError:
+            return 2
+        except TypeError:
+            return 2
+        except (sqlite3.Error, OSError):
+            return 2
+        except Exception:
+            # Any other API error treated as unavailable/invalid -> exit 2 per contract
+            # But preserve stdout empty
+            return 2
+        try:
+            out = json.dumps(value, sort_keys=True, allow_nan=False)
+        except Exception:
+            return 2
+        sys.stdout.write(out + "\n")
+        return 0
+    except (OSError, UnicodeDecodeError, ValueError):
+        return 2
+    except SystemExit:
+        raise
+    except Exception:
+        return 2
 
 
