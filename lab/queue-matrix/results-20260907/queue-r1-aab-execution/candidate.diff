@@ -0,0 +1,439 @@
+import copy
+import json
+import pathlib
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+def make_queue(tmp):
+    return Queue(Path(tmp) / "q.db")
+
+VIEW_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+class SubmitTests(unittest.TestCase):
+    def test_empty_submit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            self.assertEqual(q.submit([]), [])
+            self.assertEqual(q.list(), [])
+
+    def test_defaults_and_view_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            views = q.submit([{"id": "a"}])
+            self.assertEqual(set(views[0].keys()), VIEW_KEYS)
+            v = views[0]
+            self.assertEqual(v["payload"], {})
+            self.assertEqual(v["priority"], 0)
+            self.assertEqual(v["dependencies"], [])
+            self.assertEqual(v["max_attempts"], 3)
+            self.assertEqual(v["ready_at"], 0)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["attempts"], 0)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+
+    def test_sorted_unique_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}, {"id": "c"}])
+            v = q.submit([{"id": "d", "dependencies": ["c", "b", "c", "b"]}])[0]
+            self.assertEqual(v["dependencies"], ["b", "c"])
+
+    def test_unknown_fields_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "unknown": 1}])
+            self.assertEqual(q.list(), [])
+
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            for job in [{"id":"a","priority":True},{"id":"a","max_attempts":True},{"id":"a","ready_at":True},{"id":"a","ready_at":False}]:
+                with self.assertRaises(ValueError, msg=str(job)):
+                    q.submit([job])
+            self.assertEqual(q.list(), [])
+            # now/lease/attempt/retry bools
+            q.submit([{"id":"a"}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", True, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], True)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 1, retry_delay=True)
+            # state must be unchanged running
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_payload_finite_json(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{"v":float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{"v":float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":[1,2]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":"str"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{(1,2):1}}] if False else [{"id":"a","payload":{1:2}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{"x":(1,2)}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","payload":{"x":{1}}}])
+            self.assertEqual(q.list(), [])
+            # valid nested
+            v = q.submit([{"id":"ok","payload":{"a":[1,2.5,"x",True,None],"b":{"c":False}}}])[0]
+            self.assertEqual(v["payload"], {"a":[1,2.5,"x",True,None],"b":{"c":False}})
+
+    def test_duplicate_ids_in_batch_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a"},{"id":"a"}])
+            self.assertEqual(q.list(), [])
+
+    def test_unknown_self_cycle_invalid_atomic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"b","dependencies":["unknown"]}])
+            self.assertIsNone(q.get("b"))
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"c","dependencies":["c"]}])
+            self.assertIsNone(q.get("c"))
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"x","dependencies":["y"]},{"id":"y","dependencies":["x"]}])
+            self.assertIsNone(q.get("x"))
+            self.assertIsNone(q.get("y"))
+            # atomic: one invalid rejects whole batch including valid prefix
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"good"},{"id":"bad","dependencies":["nope"]}])
+            self.assertIsNone(q.get("good"))
+            # invalid batch must not recover either: setup expired lease then invalid submit
+            q2 = Queue(Path(tmp)/"q2.db")
+            q2.submit([{"id":"a"}])
+            c = q2.claim("w", 0, 5)
+            with self.assertRaises(ValueError):
+                q2.submit([{"id":"z","dependencies":["missing"]}])
+            self.assertEqual(q2.get("a")["state"], "running")
+
+    def test_batch_dep_on_batch_ok(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            views = q.submit([{"id":"b","dependencies":["a"]}, {"id":"a"}])
+            self.assertEqual([v["id"] for v in views], ["b","a"])
+
+    def test_idempotent_resubmit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a","priority":5,"payload":{"x":1}}])
+            c = q.claim("w", 0, 10)
+            # resubmit same normalized spec even after state change -> idempotent, returns current view
+            views = q.submit([{"id":"a","priority":5,"payload":{"x":1}}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # conflict with different spec rejects batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"a","priority":6}])
+            # mixed batch with conflict rolls back valid newcomer
+            with self.assertRaises(ValueError):
+                q.submit([{"id":"new"},{"id":"a","priority":99}])
+            self.assertIsNone(q.get("new"))
+
+    def test_idempotent_normalized_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}, {"id":"b","dependencies":["a"]}])
+            # resubmit with unsorted/duplicate deps that normalize same -> idempotent
+            views = q.submit([{"id":"b","dependencies":["a","a"]}])
+            self.assertEqual(views[0]["dependencies"], ["a"])
+
+    def test_detached_and_no_mutate(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            inp = {"id":"a","payload":{"x":[1]},"dependencies":["b"]}
+            # need existing dep b
+            q.submit([{"id":"b"}])
+            orig = copy.deepcopy(inp)
+            views = q.submit([inp])
+            self.assertEqual(inp, orig)
+            views[0]["payload"]["x"].append(99)
+            views[0]["dependencies"].append("evil")
+            v2 = q.get("a")
+            self.assertEqual(v2["payload"], {"x":[1]})
+            self.assertEqual(v2["dependencies"], ["b"])
+            # get detached
+            g = q.get("a")
+            g["payload"]["x"] = "tamper"
+            self.assertNotEqual(q.get("a")["payload"], "tamper")
+            # list detached
+            l = q.list()
+            l[0]["payload"] = "tamper"
+            self.assertNotEqual(q.list()[0]["payload"], "tamper")
+
+    def test_get_list_validation_no_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c = q.claim("w", 0, 5)
+            # get/list do not recover
+            self.assertEqual(q.get("a")["state"], "running")
+            _ = q.list()
+            self.assertEqual(q.get("a")["state"], "running")
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get(None)
+            # list sorted by id
+            q2 = Queue(Path(tmp)/"q2.db")
+            q2.submit([{"id":"z"},{"id":"a"},{"id":"m"}])
+            self.assertEqual([v["id"] for v in q2.list()], ["a","m","z"])
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_validation_no_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c = q.claim("w", 0, 5)
+            for args in [("",0,5),("w",True,5),("w",0,True),("w",-1,5),("w",0,0),(123,0,5)]:
+                with self.assertRaises(ValueError, msg=str(args)):
+                    q.claim(*args)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_claim_priority_id_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"b","priority":0},{"id":"a","priority":0},{"id":"c","priority":10}])
+            self.assertEqual(q.claim("w",0,10)["id"], "c")
+            self.assertEqual(q.claim("w",0,10)["id"], "a")
+            self.assertEqual(q.claim("w",0,10)["id"], "b")
+
+    def test_claim_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"future","ready_at":10},{"id":"ready"}])
+            self.assertEqual(q.claim("w",0,10)["id"], "ready")
+            self.assertIsNone(q.claim("w",0,10))
+            # ready_at gating
+            self.assertEqual(q.claim("w",10,10)["id"] if False else None, None)
+            # max_attempts gating via fail to exhausted? use max 1 then fail
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = Queue(Path(tmp2)/"q.db")
+                q2.submit([{"id":"a","max_attempts":1}])
+                c = q2.claim("w",0,10)
+                q2.fail("a","w",c["attempts"],1)
+                self.assertEqual(q2.get("a")["state"], "failed")
+                self.assertIsNone(q2.claim("w",10,10))
+
+    def test_failed_dep_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"parent","max_attempts":1},{"id":"child","dependencies":["parent"]}])
+            c = q.claim("w",0,5)
+            self.assertEqual(c["id"], "parent")
+            q.fail("parent","w",c["attempts"],1)
+            self.assertEqual(q.get("parent")["state"], "failed")
+            self.assertIsNone(q.claim("w",5,5))
+            self.assertEqual(q.get("child")["state"], "pending")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a","max_attempts":3}])
+            c = q.claim("w",0,5)
+            self.assertEqual(q.recover(4), [])
+            self.assertEqual(q.recover(5), ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["attempts"], 1)
+            # repeated no-op
+            self.assertEqual(q.recover(5), [])
+            # to failed when attempts==max
+            q2 = Queue(Path(tmp)/"q2.db")
+            q2.submit([{"id":"b","max_attempts":1}])
+            q2.claim("w",0,5)
+            self.assertEqual(q2.recover(5), ["b"])
+            vb = q2.get("b")
+            self.assertEqual(vb["state"], "failed")
+            self.assertEqual(vb["ready_at"], 0)
+            # sorted ids
+            q3 = Queue(Path(tmp)/"q3.db")
+            q3.submit([{"id":"z"},{"id":"a"},{"id":"m"}])
+            q3.claim("w",0,5)
+            q3.claim("w",0,5)
+            q3.claim("w",0,5)
+            self.assertEqual(q3.recover(5), ["a","m","z"])
+
+    def test_claim_recovers_first(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c = q.claim("w",0,5)
+            # at now=5 lease expired; claim should recover then claim same job
+            c2 = q.claim("w2",5,5)
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["attempts"], 2)
+            self.assertEqual(c2["worker"], "w2")
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_success(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c = q.claim("w",0,10)
+            v = q.complete("a","w",c["attempts"],5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["ready_at"], 0)
+
+    def test_fail_retry_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a","max_attempts":3}])
+            c = q.claim("w",0,10)
+            v = q.fail("a","w",c["attempts"],2,retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 7)
+            # terminal
+            q2 = Queue(Path(tmp)/"q2.db")
+            q2.submit([{"id":"b","max_attempts":1}])
+            cb = q2.claim("w",0,10)
+            vb = q2.fail("b","w",cb["attempts"],1,retry_delay=5)
+            self.assertEqual(vb["state"], "failed")
+            self.assertEqual(vb["ready_at"], 0)
+
+    def test_stale_wrong_expired_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c = q.claim("w",0,5)
+            with self.assertRaises(ValueError):
+                q.complete("a","other",c["attempts"],1)
+            with self.assertRaises(ValueError):
+                q.complete("a","w",999,1)
+            with self.assertRaises(ValueError):
+                q.complete("a","w",c["attempts"],5)
+            with self.assertRaises(ValueError):
+                q.complete("unknown","w",1,1)
+            self.assertEqual(q.get("a")["state"], "running")
+            # fail same checks
+            with self.assertRaises(ValueError):
+                q.fail("a","other",c["attempts"],1)
+            with self.assertRaises(ValueError):
+                q.fail("a","w",c["attempts"],5)
+            self.assertEqual(q.get("a")["state"], "running")
+            # invalid args no recover: lease expired but invalid attempt must not recover
+            q3 = Queue(Path(tmp)/"q3.db")
+            q3.submit([{"id":"x"}])
+            cx = q3.claim("w",0,5)
+            with self.assertRaises(ValueError):
+                q3.complete("x","w",999,6)
+            self.assertEqual(q3.get("x")["state"], "running")
+
+    def test_old_attempt_after_reclaim(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c1 = q.claim("w",0,5)
+            q.recover(5)
+            c2 = q.claim("w",5,5)
+            with self.assertRaises(ValueError):
+                q.complete("a","w",c1["attempts"],6)
+            v = q.complete("a","w",c2["attempts"],6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_terminal_final(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id":"a"}])
+            c = q.claim("w",0,10)
+            q.complete("a","w",c["attempts"],1)
+            with self.assertRaises(ValueError):
+                q.complete("a","w",c["attempts"],2)
+            with self.assertRaises(ValueError):
+                q.fail("a","w",c["attempts"],2)
+            self.assertIsNone(q.claim("w",2,10))
+
+class CLITests(unittest.TestCase):
+    def _req(self, tmp, obj=None, raw=None):
+        p = Path(tmp)/"req.json"
+        if raw is not None:
+            p.write_bytes(raw)
+        else:
+            p.write_text(json.dumps(obj), encoding="utf-8")
+        return str(p)
+    def _run(self, db, req):
+        p = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",req], capture_output=True, text=True)
+        return p
+    def test_cli_success_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            req = self._req(tmp, {"op":"submit","jobs":[{"id":"a","payload":{"z":1,"a":2}}]})
+            p = self._run(db, req)
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n") and not p.stdout.endswith("\n\n"))
+            val = json.loads(p.stdout)
+            self.assertEqual(list(val[0].keys()), sorted(val[0].keys()))
+            # fail without retry_delay succeeds
+            req2 = self._req(tmp, {"op":"claim","worker":"w","now":0,"lease_seconds":10})
+            p2 = self._run(db, req2)
+            self.assertEqual(p2.returncode, 0)
+            claim = json.loads(p2.stdout)
+            req3 = self._req(tmp, {"op":"fail","id":"a","worker":"w","attempt":claim["attempts"],"now":1})
+            p3 = self._run(db, req3)
+            self.assertEqual(p3.returncode, 0)
+
+    def test_cli_failures_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp)/"q.db")
+            # seed
+            req = self._req(tmp, {"op":"submit","jobs":[{"id":"a"}]})
+            self.assertEqual(self._run(db, req).returncode, 0)
+            cases = [
+                {"op":"bogus"},
+                {"op":"list","extra":1},
+                {"op":"submit","jobs":[{"id":""}]},
+                {"op":"claim","worker":"w","now":0},
+                {"op":"get","id":""},
+                {"op":"recover","now":True},
+            ]
+            for c in cases:
+                req = self._req(tmp, c)
+                p = self._run(db, req)
+                self.assertEqual(p.returncode, 2, msg=str(c))
+                self.assertEqual(p.stdout, "", msg=str(c))
+            # malformed, non-object, missing, utf8
+            req = self._req(tmp, raw=b"not json")
+            p = self._run(db, req)
+            self.assertEqual(p.returncode, 2); self.assertEqual(p.stdout, "")
+            req = self._req(tmp, raw=b"[]")
+            p = self._run(db, req)
+            self.assertEqual(p.returncode, 2); self.assertEqual(p.stdout, "")
+            p = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(Path(tmp)/"missing.json")], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2); self.assertEqual(p.stdout, "")
+            req = self._req(tmp, raw=b"\xff\xfe")
+            p = self._run(db, req)
+            self.assertEqual(p.returncode, 2); self.assertEqual(p.stdout, "")
+
+if __name__ == "__main__":
+    unittest.main()
