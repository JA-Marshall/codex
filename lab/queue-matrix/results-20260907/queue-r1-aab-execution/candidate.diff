+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+_REPO = str(Path(__file__).resolve().parent.parent)
+
+def _env():
+    e = dict(os.environ)
+    e["PYTHONPATH"] = _REPO + (os.pathsep + e["PYTHONPATH"] if e.get("PYTHONPATH") else "")
+    return e
+
+def _req_file(tmpdir, obj):
+    p = Path(tmpdir) / "req.json"
+    p.write_text(json.dumps(obj), encoding="utf-8")
+    return str(p)
+
+class ProcessTests(unittest.TestCase):
+    def test_reopen_preserves_commits(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id":"a","payload":{"n":1}},{"id":"b","dependencies":["a"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            req = _req_file(tmp, {"op":"list"})
+            p = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",req], capture_output=True, text=True, env=_env())
+            self.assertEqual(p.returncode, 0)
+            vals = json.loads(p.stdout)
+            self.assertEqual(sorted(v["id"] for v in vals), ["a","b"])
+            av = [v for v in vals if v["id"]=="a"][0]
+            req2 = _req_file(tmp, {"op":"complete","id":"a","worker":"w","attempt":av["attempts"],"now":1})
+            p2 = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",req2], capture_output=True, text=True, env=_env())
+            self.assertEqual(p2.returncode, 0)
+            q2 = Queue(db)
+            self.assertEqual(q2.get("a")["state"], "succeeded")
+            req_bad = _req_file(tmp, {"op":"submit","jobs":[{"id":"bad","dependencies":["missing"]}]})
+            pb = subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",req_bad], capture_output=True, text=True, env=_env())
+            self.assertEqual(pb.returncode, 2)
+            self.assertEqual(pb.stdout, "")
+            self.assertEqual(q2.get("a")["state"], "succeeded")
+            self.assertIsNone(q2.get("bad"))
+
+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id":f"j{i}"} for i in range(5)])
+            helper = Path(tmp)/"claimer.py"
+            helper.write_text(
+                "import json,sys\n"
+                "from durable_queue import Queue\n"
+                "db=sys.argv[1]; worker=sys.argv[2]\n"
+                "q=Queue(db)\n"
+                "try:\n"
+                "  v=q.claim(worker,0,60)\n"
+                "  print(json.dumps(v[\'id\'] if v else None))\n"
+                "except Exception:\n"
+                "  print(json.dumps(None))\n",
+                encoding="utf-8")
+            procs = []
+            for i in range(5):
+                procs.append(subprocess.Popen([sys.executable, str(helper), db, f"w{i}"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=_env()))
+            ids = []
+            for pr in procs:
+                out, err = pr.communicate(timeout=30)
+                self.assertEqual(pr.returncode, 0, msg=err)
+                ids.append(json.loads(out.strip()))
+            self.assertEqual(sorted(ids), [f"j{i}" for i in range(5)])
+            self.assertIsNone(Queue(db).claim("extra", 0, 60))
+            states = Queue(db).list()
+            workers = sorted(v["worker"] for v in states)
+            self.assertEqual(workers, [f"w{i}" for i in range(5)])
+
+    def test_concurrent_same_job_single_winner(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id":"only"}])
+            helper = Path(tmp)/"claimer2.py"
+            helper.write_text(
+                "import json,sys\n"
+                "from durable_queue import Queue\n"
+                "db=sys.argv[1]; worker=sys.argv[2]\n"
+                "q=Queue(db)\n"
+                "v=q.claim(worker,0,60)\n"
+                "print(json.dumps(v[\'id\'] if v else None))\n",
+                encoding="utf-8")
+            p1 = subprocess.Popen([sys.executable, str(helper), db, "w1"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=_env())
+            p2 = subprocess.Popen([sys.executable, str(helper), db, "w2"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=_env())
+            o1,_ = p1.communicate(timeout=30)
+            o2,_ = p2.communicate(timeout=30)
+            r1 = json.loads(o1.strip())
+            r2 = json.loads(o2.strip())
+            self.assertTrue((r1=="only") ^ (r2=="only"), msg=f"{r1} {r2}")
+            other = r2 if r1=="only" else r1
+            self.assertIsNone(other)
+
+if __name__ == "__main__":
+    unittest.main()
