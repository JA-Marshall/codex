+            v = json.loads(out3.decode())
+            self.assertEqual(v["id"], "a")
+            # reopen via API in new Queue instance (simulates restart)
+            q2 = Queue(db)
+            self.assertEqual(q2.get("a")["state"], "running")
+            rc4, out4, _ = _cli(db, {"op": "complete", "id": "a", "worker": "w", "attempt": v["attempts"], "now": 1})
+            self.assertEqual(rc4, 0)
+            self.assertEqual(Queue(db).get("a")["state"], "succeeded")
