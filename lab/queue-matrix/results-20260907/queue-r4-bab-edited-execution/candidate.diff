+def _cli(db, req_obj=None, raw_bytes=None, req_path=None):
+    """Run CLI as separate process; return (returncode, stdout, stderr)."""
+    with tempfile.TemporaryDirectory() as t2:
+        if req_path is None:
+            rp = Path(t2) / "req.json"
+            if raw_bytes is not None:
+                rp.write_bytes(raw_bytes)
+            else:
+                rp.write_text(json.dumps(req_obj), encoding="utf-8")
+        else:
+            rp = req_path
+        p = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", db, "--request", str(rp)],
+            capture_output=True,
+        )
+        return p.returncode, p.stdout, p.stderr
