+    def test_parallel_claim_exclusivity(self):
+        # Spawn two processes truly in parallel attempting claim.
+        import concurrent.futures
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            Queue(db).submit([{"id": "x"}])
+            def do_claim(worker):
+                with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+                    json.dump({"op": "claim", "worker": worker, "now": 0, "lease_seconds": 100}, f)
+                    name = f.name
+                try:
+                    p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", name], capture_output=True)
+                    return p.returncode, p.stdout
+                finally:
+                    try:
+                        Path(name).unlink()
+                    except Exception:
+                        pass
+            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
+                f1 = ex.submit(do_claim, "w1")
+                f2 = ex.submit(do_claim, "w2")
+                r1 = f1.result()
+                r2 = f2.result()
+            self.assertEqual(r1[0], 0)
+            self.assertEqual(r2[0], 0)
+            v1 = json.loads(r1[1].decode())
+            v2 = json.loads(r2[1].decode())
+            # Exactly one wins.
+            got = [v for v in (v1, v2) if v is not None]
+            nulls = [v for v in (v1, v2) if v is None]
+            self.assertEqual(len(got), 1)
+            self.assertEqual(len(nulls), 1)
