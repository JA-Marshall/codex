+"""SQLite storage foundation with WAL, timeouts, schema and transactions."""
+
+import contextlib
 import sqlite3
 
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS jobs (
+    id TEXT PRIMARY KEY,
+    payload_json TEXT NOT NULL,
+    priority INTEGER NOT NULL,
+    dependencies_json TEXT NOT NULL,
+    max_attempts INTEGER NOT NULL,
+    ready_at INTEGER NOT NULL,
+    state TEXT NOT NULL,
+    attempts INTEGER NOT NULL,
+    worker TEXT,
+    lease_until INTEGER,
+    spec_json TEXT NOT NULL
+)
+"""
 
-def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
-    connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
+def _ensure_schema(connection):
+    # Detect legacy schema (id, data) and migrate if present.
+    cur = connection.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name='jobs'"
     )
+    row = cur.fetchone()
+    if row is None:
+        connection.execute(_SCHEMA)
+        return
+    cols = [r[1] for r in connection.execute("PRAGMA table_info(jobs)").fetchall()]
+    if cols == ["id", "data"]:
+        # Migrate legacy rows: each data is a JSON view.
+        import json as _json
+        old_rows = connection.execute("SELECT id, data FROM jobs").fetchall()
+        connection.execute("ALTER TABLE jobs RENAME TO jobs_legacy")
+        connection.execute(_SCHEMA)
+        for old_id, old_data in old_rows:
+            try:
+                view = _json.loads(old_data)
+            except Exception:
+                continue
+            # Reconstruct spec from view fields.
+            payload = view.get("payload", {})
+            priority = view.get("priority", 0)
+            deps = sorted(set(view.get("dependencies", [])))
+            max_attempts = view.get("max_attempts", 3)
+            ready_at = view.get("ready_at", 0)
+            state = view.get("state", "pending")
+            attempts = view.get("attempts", 0)
+            worker = view.get("worker")
+            lease_until = view.get("lease_until")
+            spec = {
+                "dependencies": deps,
+                "id": old_id,
+                "max_attempts": max_attempts,
+                "payload": payload,
+                "priority": priority,
+                "ready_at": ready_at,
+            }
+            connection.execute(
+                "INSERT INTO jobs (id, payload_json, priority, dependencies_json,"
+                " max_attempts, ready_at, state, attempts, worker, lease_until, spec_json)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    old_id,
+                    _json.dumps(payload, sort_keys=True, separators=(",", ":")),
+                    priority,
+                    _json.dumps(deps, separators=(",", ":")),
+                    max_attempts,
+                    ready_at,
+                    state,
+                    attempts,
+                    worker,
+                    lease_until,
+                    _json.dumps(spec, sort_keys=True, separators=(",", ":")),
+                ),
+            )
+        connection.execute("DROP TABLE jobs_legacy")
+    else:
+        connection.execute(_SCHEMA)
+
+
+def connect(path):
+    """Open a SQLite connection with WAL, busy timeout and ensured schema.
+
+    Uses autocommit mode (isolation_level=None) so callers control
+    transactions explicitly with BEGIN IMMEDIATE / COMMIT / ROLLBACK.
+    Caller is responsible for closing. Preserves existing jobs.
+    """
+    connection = sqlite3.connect(str(path), timeout=5.0, isolation_level=None)
+    try:
+        connection.execute("PRAGMA journal_mode=WAL")
+        connection.execute("PRAGMA busy_timeout=5000")
+        connection.execute("PRAGMA synchronous=NORMAL")
+        _ensure_schema(connection)
+    except Exception:
+        connection.close()
+        raise
     return connection
+
+
+@contextlib.contextmanager
+def transaction(path):
+    """Yield a connection inside BEGIN IMMEDIATE; commit or rollback."""
+    connection = connect(path)
+    try:
+        connection.execute("BEGIN IMMEDIATE")
+        yield connection
+        connection.execute("COMMIT")
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    finally:
+        connection.close()
