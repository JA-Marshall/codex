@@ -0,0 +1,175 @@
+"""Separate-process durability and claim exclusivity."""
+import json
+import multiprocessing
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _cli(db_path, request_obj):
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+        json.dump(request_obj, f)
+        req = f.name
+    try:
+        p = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db_path), "--request", req],
+            capture_output=True, text=True, timeout=30,
+        )
+        return p
+    finally:
+        try:
+            Path(req).unlink()
+        except Exception:
+            pass
+
+
+def _claim_worker(db_path, barrier, out_queue, worker, now, lease):
+    try:
+        barrier.wait(timeout=10)
+    except Exception:
+        pass
+    try:
+        q = Queue(db_path)
+        v = q.claim(worker, now, lease)
+        out_queue.put((worker, v["id"] if v else None, v["attempts"] if v else None))
+    except Exception as e:
+        out_queue.put((worker, "ERROR:" + str(e), None))
+
+
+class ProcessTests(unittest.TestCase):
+    def test_cli_durability_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = _cli(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"x": 1}}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            val = json.loads(p.stdout)
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: raw stdout should have keys sorted; check by reloading with sort
+            self.assertEqual(p.stdout, json.dumps(val, sort_keys=True) + "\n")
+            # fresh process get survives
+            p2 = _cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p2.returncode, 0, p2.stderr)
+            self.assertEqual(json.loads(p2.stdout)["payload"], {"x": 1})
+            # list in fresh process
+            p3 = _cli(db, {"op": "list"})
+            self.assertEqual(p3.returncode, 0)
+            self.assertEqual(len(json.loads(p3.stdout)), 1)
+
+    def test_cli_strict_errors_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # need a valid db first
+            p0 = _cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p0.returncode, 0)
+            for bad in [
+                {"op": "submit", "jobs": [{"id": "a"}], "extra": 1},
+                {"op": "nope"},
+                {"op": "get", "id": "a", "extra": 1},
+                {"op": "list", "extra": 1},
+                {"jobs": [{"id": "a"}]},
+                {"op": "get"},
+                {"op": "submit", "jobs": [{"id": "a", "bogus": 1}]},
+            ]:
+                p = _cli(db, bad)
+                self.assertEqual(p.returncode, 2, str(bad))
+                self.assertEqual(p.stdout, "", str(bad))
+            # malformed JSON
+            with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+                f.write("{not json")
+                req = f.name
+            try:
+                p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req],
+                                   capture_output=True, text=True, timeout=30)
+                self.assertEqual(p.returncode, 2)
+                self.assertEqual(p.stdout, "")
+            finally:
+                Path(req).unlink()
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp) / "nope.json")],
+                               capture_output=True, text=True, timeout=30)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid utf-8
+            bad_path = Path(tmp) / "bad.json"
+            bad_path.write_bytes(b"\xff\xfe not utf8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad_path)],
+                               capture_output=True, text=True, timeout=30)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+
+    def test_durability_kill_restart_reopen(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            q = Queue(db)
+            q.submit([{"id": "a", "payload": {"v": 1}}, {"id": "b", "priority": 3}])
+            c = q.claim("w1", 0, 100)
+            self.assertIsNotNone(c)
+            del q
+            # reopen in fresh object (simulates restart)
+            q2 = Queue(db)
+            self.assertEqual(q2.get(c["id"])["worker"], "w1")
+            self.assertEqual(len(q2.list()), 2)
+            # subprocess fresh process sees same
+            p = _cli(str(db), {"op": "list"})
+            self.assertEqual(p.returncode, 0)
+            self.assertEqual(len(json.loads(p.stdout)), 2)
+
+    def test_contended_claim_exclusivity_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": "only"}])
+            ctx = multiprocessing.get_context("spawn")
+            barrier = ctx.Barrier(6)
+            out = ctx.Queue()
+            procs = [ctx.Process(target=_claim_worker, args=(db, barrier, out, f"w{i}", 0, 10)) for i in range(6)]
+            for pr in procs:
+                pr.start()
+            for pr in procs:
+                pr.join(timeout=30)
+                self.assertEqual(pr.exitcode, 0)
+            results = []
+            while not out.empty():
+                results.append(out.get())
+            winners = [r for r in results if r[1] == "only"]
+            self.assertEqual(len(results), 6)
+            self.assertEqual(len(winners), 1, results)
+            # DB shows single active lease
+            q2 = Queue(db)
+            v = q2.get("only")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["attempts"], 1)
+            self.assertEqual(v["worker"], winners[0][0])
+
+    def test_parallel_claims_distinct_jobs(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": f"j{i}"} for i in range(4)])
+            ctx = multiprocessing.get_context("spawn")
+            barrier = ctx.Barrier(4)
+            out = ctx.Queue()
+            procs = [ctx.Process(target=_claim_worker, args=(db, barrier, out, f"w{i}", 0, 10)) for i in range(4)]
+            for pr in procs:
+                pr.start()
+            for pr in procs:
+                pr.join(timeout=30)
+            ids = []
+            while not out.empty():
+                _w, jid, _a = out.get()
+                ids.append(jid)
+            self.assertEqual(sorted(ids), ["j0", "j1", "j2", "j3"])
+            # all running, distinct owners
+            q2 = Queue(db)
+            owners = sorted(v["worker"] for v in q2.list())
+            self.assertEqual(len(set(owners)), 4)
+
+
+if __name__ == "__main__":
+    unittest.main()
