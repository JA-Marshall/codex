+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)  # lease_until 10
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", 1, 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 99, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 10)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 10)
+            # still running, not recovered
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.get("a")["worker"], "w")
+            self.assertEqual(q.get("a")["lease_until"], 10)
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            # invalid retry_delay
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 1, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 1, retry_delay=True)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_old_attempt_rejected_after_reclaim(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            self.assertEqual(c1["attempts"], 1)
+            q.recover(5)
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            v = q.complete("a", "w", 2, 6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_complete_fail_validation(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            q.claim("w", 0, 10)
+            for args in [("", "w", 1, 1), ("a", "", 1, 1), ("a", "w", 0, 1), ("a", "w", True, 1), ("a", "w", 1, -1), ("a", "w", 1, True)]:
+                with self.assertRaises(ValueError, msg=str(args)):
+                    q.complete(*args)
+            self.assertEqual(q.get("a")["state"], "running")
+
+
+if __name__ == "__main__":
+    unittest.main()
