@@ -0,0 +1,253 @@
+"""Focused regression tests for durable_queue contract (S1-S3)."""
+import copy
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+def mkqueue(tmp):
+    return Queue(Path(tmp) / "queue.db")
+
+class SubmitViewsTests(unittest.TestCase):
+    def test_submit_rejects_bool_as_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            self.assertEqual(q.list(), [])
+
+    def test_submit_rejects_nonfinite_payload(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            self.assertEqual(q.list(), [])
+
+    def test_submit_rejects_unknown_field_and_rolls_back(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": "bad", "unknown": 1}])
+            self.assertEqual(q.list(), [])
+
+    def test_submit_no_input_mutation_and_normalized_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            inp = [{"id": "a", "dependencies": ["b", "b", "c"]}, {"id": "b"}, {"id": "c"}]
+            snapshot = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, snapshot)
+            self.assertEqual(views[0]["dependencies"], ["b", "c"])
+            self.assertEqual(q.get("a")["dependencies"], ["b", "c"])
+
+    def test_submit_duplicate_ids_in_batch_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            self.assertEqual(q.list(), [])
+
+    def test_submit_unknown_self_cycle_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_submit_idempotent_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # same original spec after state change -> no-op, returns current view
+            views = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # conflict spec -> reject whole batch, db unchanged
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            self.assertEqual(q.get("a")["priority"], 5)
+            # conflicting batch with one new job must roll back new job too
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "newjob"}, {"id": "a", "priority": 99}])
+            self.assertIsNone(q.get("newjob"))
+
+    def test_views_exact_keys_detached_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "b"}, {"id": "a"}])
+            self.assertEqual([v["id"] for v in q.list()], ["a", "b"])
+            v = q.get("a")
+            self.assertEqual(sorted(v.keys()), sorted(["id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"]))
+            v["payload"]["x"] = 1
+            v["dependencies"].append("zzz")
+            self.assertEqual(q.get("a")["payload"], {})
+            self.assertEqual(q.get("a")["dependencies"], [])
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+
+    def test_submit_ready_at_idempotent_uses_original(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "ready_at": 0, "max_attempts": 2}])
+            c = q.claim("w", 0, 5)
+            q.fail("a", "w", c["attempts"], 1, retry_delay=10)
+            # current ready_at is 11
+            self.assertEqual(q.get("a")["ready_at"], 11)
+            # resubmit original spec -> no-op, keeps mutated ready_at
+            views = q.submit([{"id": "a", "ready_at": 0, "max_attempts": 2}])
+            self.assertEqual(views[0]["ready_at"], 11)
+            self.assertEqual(views[0]["state"], "pending")
+            # resubmit with mutated ready_at -> conflict
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": 11, "max_attempts": 2}])
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_validation_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            # start a lease then let it expire
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["lease_until"], 5)
+            with self.assertRaises(ValueError):
+                q.claim("", 10, 5)
+            with self.assertRaises(ValueError):
+                q.claim("w", 10, True)
+            with self.assertRaises(ValueError):
+                q.claim("w", -1, 5)
+            # invalid claim must not have recovered expired lease
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.get("a")["worker"], "w")
+
+    def test_claim_priority_lex_and_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 5, "ready_at": 10}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            q.complete("a", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "b")
+            # c not ready yet
+            self.assertIsNone(q.claim("other", 1, 10)) if False else None
+            # finish b, still c not ready at now=1
+            q.complete("b", "w", c2["attempts"], 2)
+            self.assertIsNone(q.claim("w", 1, 10))
+            self.assertEqual(q.claim("w", 10, 10)["id"], "c")
+
+    def test_claim_recovers_expired_first(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "priority": 1}, {"id": "b", "priority": 100}])
+            c = q.claim("w1", 0, 5)
+            self.assertEqual(c["id"], "b")
+            # b lease expires at 5; at now=5 claim should recover b then claim highest priority (b again)
+            c2 = q.claim("w2", 5, 5)
+            self.assertEqual(c2["id"], "b")
+            self.assertEqual(c2["worker"], "w2")
+            self.assertEqual(c2["attempts"], 2)
+
+    def test_recover_sorted_ready_at_failed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}, {"id": "b", "max_attempts": 3}])
+            ca = q.claim("w", 0, 5)
+            # claim b as well? need to claim sequentially: a first (lex), then b
+            # ca is a; claim b
+            cb = q.claim("w", 0, 7)
+            self.assertEqual({ca["id"], cb["id"]}, {"a", "b"})
+            ids = q.recover(7)
+            self.assertEqual(ids, ["a", "b"])
+            self.assertEqual(q.get("a")["state"], "failed")
+            self.assertEqual(q.get("b")["state"], "pending")
+            self.assertEqual(q.get("b")["ready_at"], 7)
+            self.assertIsNone(q.get("b")["worker"])
+            # repeated no-op
+            self.assertEqual(q.recover(7), [])
+            with self.assertRaises(ValueError):
+                q.recover(True)
+
+    def test_failed_dependency_stays_pending(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "dep")
+            q.recover(5)
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertIsNone(q.claim("w", 5, 5))
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_fail_validation_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"] + 1, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 10)
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            # still running unchanged
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.get("a")["attempts"], 1)
+
+    def test_fail_retry_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c1["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            self.assertIsNone(v["worker"])
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a", "w", c2["attempts"], 7)
+            self.assertEqual(v2["state"], "failed")
+            # terminal cannot be completed/failed/claimed
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 2, 8)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 2, 8)
+            self.assertIsNone(q.claim("w", 8, 10))
+
+    def test_stale_attempt_rejected_after_reclaim(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 5}])
+            c1 = q.claim("w", 0, 5)
+            # expire and reclaim with same worker
+            q.recover(5)
+            c2 = q.claim("w", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            v = q.complete("a", "w", 2, 6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_complete_leaves_ready_at(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "ready_at": 3}])
+            c = q.claim("w", 3, 10)
+            v = q.complete("a", "w", c["attempts"], 4)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertEqual(v["ready_at"], 3)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+
+if __name__ == "__main__":
+    unittest.main()
