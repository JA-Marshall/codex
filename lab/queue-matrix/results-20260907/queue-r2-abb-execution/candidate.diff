+def _has_cycle(graph):
+    # graph: dict id -> list of deps (only edges to nodes in graph matter for cycle?
+    # but unknown deps already rejected, so all deps are nodes)
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {node: WHITE for node in graph}
+    def visit(start):
+        stack = [(start, 0)]
+        while stack:
+            node, idx = stack[-1]
+            if color[node] == WHITE:
+                color[node] = GRAY
+            deps = graph.get(node, [])
+            # only consider deps that are in graph (all should be)
+            advanced = False
+            # iterate deps from idx
+            while idx < len(deps):
+                dep = deps[idx]
+                idx += 1
+                stack[-1] = (node, idx)
+                if dep not in graph:
+                    continue
+                if color[dep] == GRAY:
+                    return True
+                if color[dep] == WHITE:
+                    stack.append((dep, 0))
+                    advanced = True
+                    break
+            if not advanced:
+                color[node] = BLACK
+                stack.pop()
+        return False
+    for n in graph:
+        if color[n] == WHITE:
+            if visit(n):
+                return True
+    return False
