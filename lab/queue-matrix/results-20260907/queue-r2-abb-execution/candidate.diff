@@ -0,0 +1,97 @@
+"""Separate-process durability and claim exclusivity (S4)."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+def run_cli(db, req):
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+        json.dump(req, f)
+        req_path = f.name
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req_path],
+                           capture_output=True, text=True, timeout=15)
+        return p
+    finally:
+        Path(req_path).unlink(missing_ok=True)
+
+def run_cli_raw(db, raw_bytes):
+    with tempfile.NamedTemporaryFile(mode="wb", suffix=".json", delete=False) as f:
+        f.write(raw_bytes)
+        req_path = f.name
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req_path],
+                           capture_output=True, text=True, timeout=15)
+        return p
+    finally:
+        Path(req_path).unlink(missing_ok=True)
+
+class ProcessTests(unittest.TestCase):
+    def test_reopen_durability_via_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"n": 1}}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            p2 = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p2.returncode, 0, p2.stderr)
+            self.assertEqual(json.loads(p2.stdout)["payload"], {"n": 1})
+            # list in fresh process
+            p3 = run_cli(db, {"op": "list"})
+            self.assertEqual(p3.returncode, 0)
+            self.assertEqual(len(json.loads(p3.stdout)), 1)
+
+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "only"}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            # two separate processes race to claim
+            c1 = run_cli(db, {"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 30})
+            self.assertEqual(c1.returncode, 0, c1.stderr)
+            c2 = run_cli(db, {"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 30})
+            self.assertEqual(c2.returncode, 0, c2.stderr)
+            v1 = json.loads(c1.stdout)
+            v2 = json.loads(c2.stdout)
+            # exactly one wins
+            won = [v for v in (v1, v2) if v is not None]
+            self.assertEqual(len(won), 1)
+            # loser is null
+            self.assertIn(None, (v1, v2))
+
+    def test_cli_error_empty_stdout_exit2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p.returncode, 0)
+            # unknown field
+            bad = run_cli(db, {"op": "get", "id": "a", "extra": 1})
+            self.assertEqual(bad.returncode, 2)
+            self.assertEqual(bad.stdout, "")
+            # malformed json
+            bad2 = run_cli_raw(db, b"{not json")
+            self.assertEqual(bad2.returncode, 2)
+            self.assertEqual(bad2.stdout, "")
+            # invalid utf-8
+            bad3 = run_cli_raw(db, b"\xff\xfe")
+            self.assertEqual(bad3.returncode, 2)
+            self.assertEqual(bad3.stdout, "")
+
+    def test_cli_success_sorted_keys_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            # sorted keys: attempt to verify ordering of keys in raw output
+            p2 = run_cli(db, {"op": "get", "id": "a"})
+            raw = p2.stdout.strip()
+            # keys should appear in sorted order in the serialized form
+            import re
+            keys = re.findall(r'"([^"]+)":', raw)
+            self.assertEqual(keys, sorted(keys))
+
+if __name__ == "__main__":
+    unittest.main()
