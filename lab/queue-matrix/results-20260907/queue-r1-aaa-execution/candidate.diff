+"""Focused regression tests for full public contract (stdlib only)."""
+import copy
+import json
+import math
+import pathlib
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from durable_queue import Queue
+
+
+def mkqueue(tmp):
+    return Queue(pathlib.Path(tmp) / "q.db")
+
+
+def view_keys(v):
+    return set(v.keys())
+
+
+EXPECTED_KEYS = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+
+
+class SubmitValidationTests(unittest.TestCase):
+    def test_empty_list(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            self.assertEqual(q.submit([]), [])
+            self.assertEqual(q.list(), [])
+
+    def test_defaults_and_normalization(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "b"}, {"id": "c"}])
+            views = q.submit([{"id": "a", "dependencies": ["c", "b", "b"]}])
+            v = views[0]
+            self.assertEqual(v["payload"], {})
+            self.assertEqual(v["priority"], 0)
+            self.assertEqual(v["dependencies"], ["b", "c"])
+    def test_sorted_unique_deps_valid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "b"}, {"id": "c"}])
+            v = q.submit([{"id": "a", "dependencies": ["c", "b", "b"]}])[0]
+            self.assertEqual(v["dependencies"], ["b", "c"])
+
+    def test_view_exact_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            v = q.submit([{"id": "a"}])[0]
+            self.assertEqual(set(v.keys()), EXPECTED_KEYS)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["attempts"], 0)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+
+    def test_unknown_fields_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            for bad in [{"id": "a", "foo": 1}, {"id": "a", "state": "pending"}, {"id": "a", "attempts": 0}]:
+                with self.assertRaises(ValueError):
+                    q.submit([bad])
+            self.assertEqual(q.list(), [])
+
+    def test_strict_types(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            # bool is not int for priority/max_attempts/ready_at
+            for bad in [
+                {"id": "a", "priority": True},
+                {"id": "a", "priority": 1.0},
+                {"id": "a", "priority": "0"},
+                {"id": "a", "max_attempts": True},
+                {"id": "a", "max_attempts": 0},
+                {"id": "a", "max_attempts": 101},
+                {"id": "a", "max_attempts": 1.0},
+                {"id": "a", "ready_at": True},
+                {"id": "a", "ready_at": -1},
+                {"id": "a", "ready_at": 1.5},
+                {"id": "a", "payload": []},
+                {"id": "a", "payload": None},
+                {"id": "a", "dependencies": "x"},
+                {"id": "a", "dependencies": [True]},
+                {"id": "a", "dependencies": [""]},
+                {"id": "", },
+                {"id": 123},
+                {"id": True},
+                {"payload": {}},
+                "notadict",
+                None,
+            ]:
+                if isinstance(bad, dict) and "id" not in bad and bad not in ("notadict", None):
+                    job = dict(bad); job.setdefault("id", "x")
+                    # for {"payload":{}} missing id case already covered; skip
+                    pass
+                with self.assertRaises(ValueError, msg=f"bad={bad!r}"):
+                    if bad in ("notadict", None):
+                        q.submit([bad])
+                    else:
+                        q.submit([bad])
+            self.assertEqual(q.list(), [])
+
+    def test_jobs_not_list(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            for bad in [None, {}, "x", True, 123]:
+                with self.assertRaises(ValueError):
+                    q.submit(bad)
+            self.assertEqual(q.list(), [])
+
+    def test_payload_finite(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            for bad_payload in [{"x": float("nan")}, {"x": float("inf")}, {"x": float("-inf")}, {"x": {"y": float("nan")}}]:
+                with self.assertRaises(ValueError):
+                    q.submit([{"id": "a", "payload": bad_payload}])
+            # tuple invalid, non-string keys invalid
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": (1, 2)}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {1: "x"}}])
+            self.assertEqual(q.list(), [])
+            # valid nested payload retains types
+            payload = {"s": "hi", "i": 3, "f": 1.5, "b": True, "n": None, "l": [1, "a"], "d": {"k": [2]}}
+            v = q.submit([{"id": "a", "payload": payload}])[0]
+            self.assertEqual(v["payload"], payload)
+
+    def test_duplicate_batch_ids(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            self.assertEqual(q.list(), [])
+
+    def test_unknown_self_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["c"]}, {"id": "c", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_atomic_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "ok"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": ""}])
+            self.assertEqual([x["id"] for x in q.list()], ["ok"])
+            # invalid batch referencing unknown must not add partial
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "n1"}, {"id": "n2", "dependencies": ["unknown"]}])
+            self.assertEqual([x["id"] for x in q.list()], ["ok"])
+
+    def test_invalid_submit_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # expired at 10, but invalid submit must not recover
+            with self.assertRaises(ValueError):
+                q.submit([{"id": ""}])
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["worker"], "w")
+
+    def test_idempotent_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "priority": 2}])
+            c = q.claim("w", 0, 10)
+            # resubmit same normalized spec after state change -> idempotent, returns current view
+            v = q.submit([{"id": "a", "priority": 2}])[0]
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["attempts"], 1)
+            # defaults vs explicit defaults are idempotent
+            q2 = mkqueue(tmp)  # same db? different file? use same q
+            with tempfile.TemporaryDirectory() as tmp2:
+                qq = Queue(pathlib.Path(tmp2) / "q.db")
+                qq.submit([{"id": "x"}])
+                v2 = qq.submit([{"id": "x", "payload": {}, "priority": 0, "dependencies": [], "max_attempts": 3, "ready_at": 0}])[0]
+                self.assertEqual(v2["state"], "pending")
+            # conflict rejects whole batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 99}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "new"}, {"id": "a", "priority": 99}])
+            self.assertIsNone(q.get("new"))
+            # payload key order insensitive
+            with tempfile.TemporaryDirectory() as tmp3:
+                q3 = Queue(pathlib.Path(tmp3) / "q.db")
+                q3.submit([{"id": "p", "payload": {"b": 1, "a": 2}}])
+                v3 = q3.submit([{"id": "p", "payload": {"a": 2, "b": 1}}])[0]
+                self.assertEqual(v3["payload"], {"a": 2, "b": 1})
+
+    def test_no_mutate_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            orig = {"id": "a", "payload": {"x": [1]}, "dependencies": ["b", "b"]}
+            inp = [{"id": "b"}, orig]
+            snapshot = copy.deepcopy(inp)
+            q.submit(inp)
+            self.assertEqual(inp, snapshot)
+            v = q.get("a")
+            v["payload"]["x"].append(99)
+            v["dependencies"].append("zzz")
+            v2 = q.get("a")
+            self.assertEqual(v2["payload"], {"x": [1]})
+            self.assertEqual(v2["dependencies"], ["b"])
+            # returned submit views detached
+            views = q.submit([{"id": "b"}])
+            views[0]["payload"]["new"] = 1
+            self.assertEqual(q.get("b")["payload"], {})
+
+    def test_get_list_validation_no_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "b"}, {"id": "a"}])
+            self.assertEqual([x["id"] for x in q.list()], ["a", "b"])
+            self.assertIsNone(q.get("missing"))
+            for bad in ["", 123, None, True, b"x"]:
+                with self.assertRaises(ValueError):
+                    q.get(bad)
+            # no implicit recovery
+            q.submit([{"id": "c"}])
+            c = q.claim("w", 0, 5)
+            # c is one of a/b/c (smallest id among eligible? all priority 0 -> a)
+            self.assertEqual(c["id"], "a")
+            # get/list at expired time must not recover
+            g = q.get("a")
+            self.assertEqual(g["state"], "running")
+            lst = q.list()
+            self.assertEqual([x for x in lst if x["id"]=="a"][0]["state"], "running")
+            rec = q.recover(5)
+            self.assertIn("a", rec)
+
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_validation_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            for args in [("", 10, 5), (123, 10, 5), (True, 10, 5), ("w", -1, 5), ("w", True, 5), ("w", 1.0, 5), ("w", 10, 0), ("w", 10, -1), ("w", 10, True), ("w", 10, 1.5)]:
+                with self.assertRaises(ValueError, msg=f"{args}"):
+                    q.claim(*args)
+            # expired lease (10) must still be running (no recovery happened)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_claim_priority_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "low", "priority": 1}, {"id": "high", "priority": 5}, {"id": "high2", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            q.complete("high", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "high2")
+
+    def test_claim_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "fut", "ready_at": 100}, {"id": "ok"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "ok")
+            # dependency failed stays pending
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = Queue(pathlib.Path(tmp2) / "q.db")
+                q2.submit([{"id": "base", "max_attempts": 1}, {"id": "child", "dependencies": ["base"]}])
+                b = q2.claim("w", 0, 10)
+                q2.fail("base", "w", b["attempts"], 1)
+                self.assertEqual(q2.get("base")["state"], "failed")
+                self.assertIsNone(q2.claim("w", 1, 10))
+                self.assertEqual(q2.get("child")["state"], "pending")
+
+    def test_claim_recovers_first(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c = q.claim("w", 0, 10)  # claims a (smallest id)
+            self.assertEqual(c["id"], "a")
+            # at now=10, a expires (ready_at becomes 10), claim should recover then claim a again (still highest? tie -> a)
+            c2 = q.claim("w2", 10, 10)
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["attempts"], 2)
+            self.assertEqual(c2["worker"], "w2")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 3}, {"id": "b", "max_attempts": 1}])
+            ca = q.claim("w", 0, 10)  # a
+            # complete a? no, keep running; claim b next
+            # need to complete a to get b? Actually claim picks smallest id first; after a running, next claim gets b
+            cb = q.claim("w", 0, 10)
+            self.assertEqual(cb["id"], "b")
+            # recover before expiry -> []
+            self.assertEqual(q.recover(5), [])
+            # recover at expiry
+            ids = q.recover(10)
+            self.assertEqual(ids, ["a", "b"])
+            va = q.get("a")
+            self.assertEqual(va["state"], "pending")
+            self.assertEqual(va["ready_at"], 10)
+            self.assertIsNone(va["worker"])
+            self.assertIsNone(va["lease_until"])
+            self.assertEqual(va["attempts"], 1)
+            vb = q.get("b")
+            # attempts(1) == max(1) -> failed, ready_at unchanged (0)
+            self.assertEqual(vb["state"], "failed")
+            self.assertEqual(vb["ready_at"], 0)
+            # repeated no-op
+            self.assertEqual(q.recover(10), [])
+            self.assertEqual(q.recover(99), [])
+            # validation
+            for bad in [True, -1, 1.5, None, "0"]:
+                with self.assertRaises(ValueError):
+                    q.recover(bad)
+
+    def test_recover_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "z"}, {"id": "a"}, {"id": "m"}])
+            q.claim("w", 0, 5)  # a
+            q.claim("w", 0, 5)  # m
+            q.claim("w", 0, 5)  # z
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a", "m", "z"])
+
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_basic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            v = q.complete("a", "w", c["attempts"], 5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["ready_at"], 0)
+            # terminal cannot be completed again
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 6)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 6)
+            self.assertIsNone(q.claim("w", 6, 10))
+
+    def test_fail_retry_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c1["attempts"], 5, retry_delay=7)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 12)
+            self.assertEqual(v["attempts"], 1)
+            c2 = q.claim("w", 12, 10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a", "w", c2["attempts"], 13)
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 12)  # unchanged
+            self.assertIsNone(q.claim("w", 13, 10))
+
+    def test_stale_wrong_expired_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            ca = q.claim("w", 0, 10)  # a
+            cb = q.claim("w", 0, 5)  # b, lease_until 5
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", ca["attempts"], 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 999, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("b", "w", cb["attempts"], 5)
+            with self.assertRaises(ValueError):
+                q.fail("b", "w", cb["attempts"], 6)
+            # unknown job
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            # invalid args
+            for args in [("", "w", 1, 1), ("a", "", 1, 1), ("a", "w", 0, 1), ("a", "w", True, 1), ("a", "w", 1, True), ("a", "w", 1, -1)]:
+                with self.assertRaises(ValueError):
+                    q.complete(*args)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 1, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 1, retry_delay=True)
+            # verify no writes happened for a
+            va = q.get("a")
+            self.assertEqual(va["state"], "running")
+            self.assertEqual(va["attempts"], 1)
+
+    def test_no_recovery_on_failed_complete(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "exp"}, {"id": "tgt"}])
+            ce = q.claim("w", 0, 5)  # exp
+            ct = q.claim("w", 0, 10)  # tgt
+            # failed complete on tgt (wrong worker) at time beyond exp expiry must not recover exp
+            with self.assertRaises(ValueError):
+                q.complete("tgt", "wrong", ct["attempts"], 6)
+            self.assertEqual(q.get("exp")["state"], "running")
+            # failed fail likewise
+            with self.assertRaises(ValueError):
+                q.fail("tgt", "wrong", ct["attempts"], 6)
+            self.assertEqual(q.get("exp")["state"], "running")
+
+    def test_old_attempt_rejected_after_reclaim(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 10)
+            q.fail("a", "w", c1["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 2)
+            v = q.complete("a", "w", 2, 2)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_attempts_never_exceed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["attempts"], 1)
+            v = q.fail("a", "w", 1, 1)
+            self.assertEqual(v["state"], "failed")
+            self.assertEqual(v["attempts"], 1)
+            self.assertIsNone(q.claim("w", 1, 10))
+
+
+if __name__ == "__main__":
+    unittest.main()
