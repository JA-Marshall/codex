+"""Separate-process durability and claim exclusivity (stdlib only)."""
+import json
+import pathlib
+import subprocess
+import sys
+import tempfile
+import threading
+import unittest
+
+from durable_queue import Queue
+
+
+def cli(db_path, request_obj=None, raw_bytes=None):
+    """Run CLI in a fresh process. Returns CompletedProcess."""
+    with tempfile.NamedTemporaryFile(mode="wb", delete=False, suffix=".json") as f:
+        req_path = f.name
+        if raw_bytes is not None:
+            f.write(raw_bytes)
+        else:
+            f.write(json.dumps(request_obj).encode("utf-8"))
+    try:
+        p = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db_path), "--request", req_path],
+            capture_output=True,
+        )
+        return p
+    finally:
+        try:
+            pathlib.Path(req_path).unlink()
+        except Exception:
+            pass
+
+
+class ProcessDurabilityTests(unittest.TestCase):
+    def test_reopen_preserves_commits(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = pathlib.Path(tmp) / "q.db"
+            q1 = Queue(db)
+            q1.submit([{"id": "a", "payload": {"n": 1}}])
+            # reopen in new instance same process
+            q2 = Queue(db)
+            self.assertEqual(q2.get("a")["payload"], {"n": 1})
+            # claim then reopen
+            c = q2.claim("w", 0, 10)
+            q3 = Queue(db)
+            self.assertEqual(q3.get("a")["state"], "running")
+            q3.complete("a", "w", c["attempts"], 1)
+            q4 = Queue(db)
+            self.assertEqual(q4.get("a")["state"], "succeeded")
+
+    def test_cli_submit_survives_restart(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = pathlib.Path(tmp) / "q.db"
+            p = cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            out = json.loads(p.stdout.decode("utf-8"))
+            self.assertEqual(out[0]["id"], "a")
+            # fresh process list
+            p2 = cli(db, {"op": "list"})
+            self.assertEqual(p2.returncode, 0)
+            self.assertTrue(p2.stdout.endswith(b"\n"))
+            # exactly one newline at end
+            txt = p2.stdout.decode("utf-8")
+            self.assertTrue(txt.endswith("\n") and not txt.endswith("\n\n"))
+            vals = json.loads(txt)
+            self.assertEqual([v["id"] for v in vals], ["a"])
+            # failed request must not wipe commits
+            p3 = cli(db, {"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(p3.returncode, 2)
+            self.assertEqual(p3.stdout, b"")
+            p4 = cli(db, {"op": "list"})
+            self.assertEqual(p4.returncode, 0)
+            self.assertEqual([v["id"] for v in json.loads(p4.stdout.decode())], ["a"])
+
+    def test_two_processes_never_share_lease(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = pathlib.Path(tmp) / "q.db"
+            Queue(db).submit([{"id": "only"}])
+            results = [None, None]
+            codes = [None, None]
+            def claimant(idx):
+                p = cli(db, {"op": "claim", "worker": f"w{idx}", "now": 0, "lease_seconds": 30})
+                codes[idx] = p.returncode
+                if p.returncode == 0:
+                    try:
+                        results[idx] = json.loads(p.stdout.decode("utf-8"))
+                    except Exception:
+                        results[idx] = "badjson"
+                else:
+                    results[idx] = None
+            threads = [threading.Thread(target=claimant, args=(i,)) for i in range(2)]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join()
+            self.assertEqual(codes, [0, 0])
+            # exactly one gets the job, other gets null
+            got = [r for r in results if r is not None]
+            nulls = [r for r in results if r is None]
+            self.assertEqual(len(got), 1)
+            self.assertEqual(len(nulls), 1)
+            self.assertEqual(got[0]["id"], "only")
+            # DB shows single running with attempts 1
+            v = Queue(db).get("only")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["attempts"], 1)
+            self.assertIn(v["worker"], ("w0", "w1"))
+
+    def test_concurrent_many_jobs_distinct(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = pathlib.Path(tmp) / "q.db"
+            Queue(db).submit([{"id": f"j{i}"} for i in range(4)])
+            n = 4
+            results = [None]*n
+            def claimant(idx):
+                p = cli(db, {"op": "claim", "worker": f"w{idx}", "now": 0, "lease_seconds": 30})
+                self.assertEqual(p.returncode, 0, p.stderr)
+                results[idx] = json.loads(p.stdout.decode("utf-8"))
+            threads = [threading.Thread(target=claimant, args=(i,)) for i in range(n)]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join()
+            ids = [r["id"] for r in results if r is not None]
+            self.assertEqual(len(ids), 4)
+            self.assertEqual(len(set(ids)), 4)
+            # all running, attempts 1 each
+            for v in Queue(db).list():
+                self.assertEqual(v["state"], "running")
+                self.assertEqual(v["attempts"], 1)
+
+    def test_cli_success_sorted_keys_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = pathlib.Path(tmp) / "q.db"
+            Queue(db).submit([{"id": "a", "payload": {"z": 1, "a": 2}}])
+            p = cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p.returncode, 0)
+            txt = p.stdout.decode("utf-8")
+            self.assertTrue(txt.endswith("\n"))
+            self.assertEqual(txt.count("\n"), 1)
+            # keys sorted: check raw text ordering of top-level keys
+            # parse and re-dump sorted should equal raw (minus newline)
+            val = json.loads(txt)
+            self.assertEqual(txt, json.dumps(val, sort_keys=True, ensure_ascii=False) + "\n")
+
+    def test_cli_failures_exit2_empty(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = pathlib.Path(tmp) / "q.db"
+            Queue(db).submit([{"id": "a"}])
+            cases = [
+                {"op": "bogus"},
+                {"op": "list", "extra": 1},
+                {"op": "get"},
+                {"op": "get", "id": ""},
+                {"op": "submit", "jobs": [{"id": ""}]},
+                {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10},
+                {"op": "recover", "now": True},
+                {"op": "complete", "id": "a", "worker": "w", "attempt": 1, "now": 0},
+                "notadict",
+                [1, 2],
+            ]
+            for req in cases:
+                if isinstance(req, dict):
+                    p = cli(db, req)
+                else:
+                    p = cli(db, raw_bytes=json.dumps(req).encode())
+                self.assertEqual(p.returncode, 2, msg=f"req={req!r} stdout={p.stdout!r}")
+                self.assertEqual(p.stdout, b"", msg=f"req={req!r}")
+            # malformed, invalid utf-8, missing file
+            p = cli(db, raw_bytes=b"not json{")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            p = cli(db, raw_bytes=b"\xff\xfe")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            p = subprocess.run(
+                [sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(pathlib.Path(tmp)/"nope.json")],
+                capture_output=True,
+            )
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # unavailable db (is a directory)
+            p = subprocess.run(
+                [sys.executable, "-m", "durable_queue", "--db", str(tmp), "--request", str(pathlib.Path(tmp)/"nope2.json")],
+                capture_output=True,
+            )
+            # could be missing file or unavailable db; either way exit 2 empty stdout
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+
+
+if __name__ == "__main__":
+    unittest.main()
