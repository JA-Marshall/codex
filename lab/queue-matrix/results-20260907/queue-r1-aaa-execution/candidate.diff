 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
-    connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
-    )
-    return connection
+    conn = sqlite3.connect(str(path), timeout=30.0, isolation_level=None, check_same_thread=True)
+    # Durability / concurrency settings.
+    try:
+        conn.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        conn.execute("PRAGMA synchronous=NORMAL;")
+    except Exception:
+        pass
+    conn.execute(SCHEMA)
+    return conn
+
+
+@contextlib.contextmanager
+def immediate(path_or_conn):
+    """Yield a connection holding a BEGIN IMMEDIATE transaction.
+
+    Accepts a path (creates connection) or an existing connection.
+    Commits on success, rolls back on exception.
+    """
+    if isinstance(path_or_conn, sqlite3.Connection):
+        conn = path_or_conn
+        own = False
+    else:
+        conn = connect(path_or_conn)
+        own = True
+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        yield conn
+        conn.execute("COMMIT")
+    except Exception:
+        try:
+            conn.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    finally:
+        if own:
+            try:
+                conn.close()
+            except Exception:
+                pass
