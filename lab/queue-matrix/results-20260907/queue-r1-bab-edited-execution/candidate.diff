+                "payload": payload,
+                "priority": priority,
+                "ready_at": ready_at,
+            }
+            spec_json = json.dumps(spec_obj, sort_keys=True, separators=(",", ":"))
+        except Exception:
+            continue
+        try:
+            connection.execute("UPDATE jobs SET spec=? WHERE id=?", (spec_json, jid))
+        except Exception:
+            pass
     return connection
+
+
+@contextlib.contextmanager
+def transaction(connection):
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        yield connection
+        connection.execute("COMMIT")
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+
