+def is_strict_int(value):
+    return type(value) is int
+
+
+def validate_now(now):
+    if type(now) is not int or now < 0:
+        raise ValueError("invalid now")
+
+
+def validate_lease_seconds(lease_seconds):
+    if type(lease_seconds) is not int or lease_seconds <= 0:
+        raise ValueError("invalid lease_seconds")
+
+
+def validate_retry_delay(retry_delay):
+    if type(retry_delay) is not int or retry_delay < 0:
+        raise ValueError("invalid retry_delay")
+
+
+def validate_worker(worker):
+    if not isinstance(worker, str) or worker == "":
+        raise ValueError("invalid worker")
+
+
+def validate_id(value):
+    if not isinstance(value, str) or value == "":
+        raise ValueError("invalid id")
+
+
+def validate_attempt(attempt):
+    if type(attempt) is not int or attempt < 1:
+        raise ValueError("invalid attempt")
+
+
+def ensure_finite_json(value):
+    """Raise ValueError if value is not finite JSON (dict/list/str/int/float/bool/None)."""
+    if value is None:
+        return
+    if type(value) is bool:
+        return
+    if type(value) is int:
+        return
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError("non-finite JSON number")
+        return
+    if type(value) is str:
+        return
+    if type(value) is list:
+        for item in value:
+            ensure_finite_json(item)
+        return
+    if type(value) is dict:
+        for key, item in value.items():
+            if type(key) is not str:
+                raise ValueError("invalid JSON object key")
+            ensure_finite_json(item)
+        return
+    raise ValueError("invalid JSON value")
