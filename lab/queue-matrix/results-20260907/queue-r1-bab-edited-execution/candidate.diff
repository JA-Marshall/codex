+def _tmp_db(tmpdir):
+    return str(pathlib.Path(tmpdir) / "q.db")
+
+
+def _write_request(tmpdir, name, obj=None, raw=None, binary=None):
+    p = pathlib.Path(tmpdir) / name
+    if binary is not None:
+        p.write_bytes(binary)
+    elif raw is not None:
+        p.write_text(raw, encoding="utf-8")
+    else:
+        p.write_text(json.dumps(obj), encoding="utf-8")
+    return str(p)
+
+
+def _cli(db, req):
+    return subprocess.run(
+        [sys.executable, "-m", "durable_queue", "--db", db, "--request", req],
+        capture_output=True, text=True, timeout=20,
+    )
