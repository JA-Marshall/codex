+class SeparateProcessTests(unittest.TestCase):
+    def test_claim_exclusivity_two_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmp_db(tmp)
+            Queue(db).submit([{"id": "only"}])
+            req1 = _write_request(tmp, "r1.json", {"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 10})
+            req2 = _write_request(tmp, "r2.json", {"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 10})
+
+            def _do(req):
+                return _cli(db, req)
+
+            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
+                f1 = ex.submit(_do, req1)
+                f2 = ex.submit(_do, req2)
+                r1 = f1.result()
+                r2 = f2.result()
+            self.assertEqual(r1.returncode, 0)
+            self.assertEqual(r2.returncode, 0)
+            v1 = json.loads(r1.stdout)
+            v2 = json.loads(r2.stdout)
+            got = sorted([json.dumps(v, sort_keys=True) for v in (v1, v2)])
+            # Exactly one null, one lease
+            self.assertIn("null", got)
+            lease = v1 if v1 is not None else v2
+            self.assertIsNotNone(lease)
+            self.assertEqual(lease["id"], "only")
+            self.assertEqual(lease["attempts"], 1)
+            # Third claim gets null
+            req3 = _write_request(tmp, "r3.json", {"op": "claim", "worker": "w3", "now": 0, "lease_seconds": 10})
+            r3 = _cli(db, req3)
+            self.assertEqual(json.loads(r3.stdout), None)
+
+    def test_durability_survives_reopen(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _tmp_db(tmp)
+            Queue(db).submit([{"id": "a", "payload": {"n": 1}}, {"id": "b", "priority": 5}])
+            # Reopen fresh process-equivalent (new instance)
+            q2 = Queue(db)
+            self.assertEqual(q2.get("a")["payload"], {"n": 1})
+            c = q2.claim("w", 0, 10)
+            self.assertEqual(c["id"], "b")
+            # Reopen again: running lease survives
+            q3 = Queue(db)
+            self.assertEqual(q3.get("b")["state"], "running")
+            self.assertEqual(q3.get("b")["worker"], "w")
+            # Failed batch does not persist
+            with self.assertRaises(ValueError):
