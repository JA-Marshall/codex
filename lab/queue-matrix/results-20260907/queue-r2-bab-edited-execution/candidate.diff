+"""Focused regression tests for contract matrix (S4)."""
+import copy
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _tmp_queue(tmpdir):
+    return Queue(Path(tmpdir) / "q.db")
+
+
+class SubmitValidationTests(unittest.TestCase):
+    def test_unknown_field_rejected_and_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "bogus": 1}, {"id": "c"}])
+            self.assertIsNone(q.get("b"))
+            self.assertIsNone(q.get("c"))
+            self.assertEqual(q.get("a")["id"], "a")
+
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            for bad in [{"id": "a", "priority": True},
+                        {"id": "a", "max_attempts": True},
+                        {"id": "a", "ready_at": True},
+                        {"id": "a", "payload": {"x": 1}, "priority": False}]:
+                with self.assertRaises(ValueError, msg=str(bad)):
+                    q.submit([bad])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", True, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], True)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 1, retry_delay=True)
+
+    def test_nonfinite_payload_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            self.assertEqual(q.list(), [])
+
+    def test_tuple_and_nonjson_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": (1, 2)}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ("b",)}])
+            with self.assertRaises(ValueError):
+                q.submit("notalist")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": ""}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": 123}])
+
+    def test_no_mutation_and_sorted_unique_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            job = {"id": "a", "dependencies": ["z", "m", "z"], "payload": {"k": [1, 2]}}
+            snapshot = copy.deepcopy(job)
+            views = q.submit([{"id": "m"}, {"id": "z"}, job])
+            self.assertEqual(job, snapshot)
+            self.assertEqual(views[2]["dependencies"], ["m", "z"])
+            self.assertEqual(q.get("a")["dependencies"], ["m", "z"])
+
+    def test_duplicate_self_unknown_cycle_atomic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]},
+                          {"id": "b", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]},
+                          {"id": "b", "dependencies": ["c"]},
+                          {"id": "c", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_idempotent_same_spec_noop_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            q.submit([{"id": "a", "priority": 5, "payload": {"x": 1}}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # Same normalized original spec is no-op even though state changed.
+            views = q.submit([{"id": "a", "priority": 5, "payload": {"x": 1}}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # Different spec conflicts and rolls back whole batch.
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}, {"id": "b"}])
+            self.assertIsNone(q.get("b"))
+            # Deps order-insensitive idempotency.
+            q2 = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "dep"}, {"id": "n", "dependencies": ["dep"]}])
+            views2 = q.submit([{"id": "n", "dependencies": ["dep"]}])
+            self.assertEqual(views2[0]["dependencies"], ["dep"])
+
+    def test_exact_keys_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            q.submit([{"id": "a", "payload": {"x": 1}}])
+            v = q.get("a")
+            self.assertEqual(set(v.keys()),
+                             {"id", "payload", "priority", "dependencies",
+                              "max_attempts", "ready_at", "state", "attempts",
+                              "worker", "lease_until"})
+            v["payload"]["x"] = 999
+            v["dependencies"].append("evil")
+            v2 = q.get("a")
+            self.assertEqual(v2["payload"], {"x": 1})
+            self.assertEqual(v2["dependencies"], [])
+            lst = q.list()
+            lst[0]["payload"]["x"] = 999
+            self.assertEqual(q.get("a")["payload"], {"x": 1})
+
+    def test_get_list_validation_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = _tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            # Expired but get/list must not recover implicitly.
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
+            for bad in [None, 123, "", True, ["a"]]:
+                with self.assertRaises(ValueError, msg=repr(bad)):
+                    q.get(bad)
+            self.assertEqual([x["id"] for x in q.list()], ["a"])
+
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_priority_and_id_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
