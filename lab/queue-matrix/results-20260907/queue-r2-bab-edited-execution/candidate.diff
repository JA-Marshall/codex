new file mode 100644
index 0000000..46e7099
--- /dev/null
+++ b/tests/test_processes.py
@@ -0,0 +1,158 @@
+"""Separate-process durability and claim exclusivity plus CLI contract (S4)."""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+PY312 = "python3.12"
+REPO = Path(__file__).resolve().parents[1]
+
+
+def _run_cli(db_path, request_obj=None, raw_bytes=None, request_text=None):
+    with tempfile.NamedTemporaryFile(mode="wb", suffix=".json", delete=False) as tmp:
+        if raw_bytes is not None:
+            tmp.write(raw_bytes)
+        elif request_text is not None:
+            tmp.write(request_text.encode("utf-8"))
+        else:
+            tmp.write(json.dumps(request_obj).encode("utf-8"))
+        req = tmp.name
+    try:
+        proc = subprocess.run(
+            [PY312, "-m", "durable_queue", "--db", str(db_path), "--request", req],
+            cwd=str(REPO), capture_output=True, timeout=20,
+        )
+        return proc
+    finally:
+        try:
+            os.unlink(req)
+        except OSError:
+            pass
+
+
+def _cli_ok(db_path, request_obj):
+    proc = _run_cli(db_path, request_obj=request_obj)
+    assert proc.returncode == 0, f"cli failed: {proc.returncode} {proc.stderr!r}"
+    assert proc.stdout.endswith(b"\n"), "missing trailing newline"
+    # Exactly one newline at end and one JSON value.
+    assert proc.stdout.count(b"\n") == 1, f"stdout newlines: {proc.stdout!r}"
+    value = json.loads(proc.stdout.decode("utf-8"))
+    # Sorted keys check: re-dump with sort_keys must equal raw (minus newline).
+    raw_text = proc.stdout.decode("utf-8").strip()
+    assert raw_text == json.dumps(value, sort_keys=True, allow_nan=False), \
+        "keys not sorted"
+    return value
+
+
+class ProcessDurabilityTests(unittest.TestCase):
+    def test_kill_restart_reopen_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # Submit in one fresh process via CLI.
+            v = _cli_ok(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"n": 1}}]})
+            self.assertEqual(v[0]["id"], "a")
+            # Kill-restart: new process reads same DB.
+            code = (
+                "import sys; sys.path.insert(0, %r);"
+                "from durable_queue import Queue;"
+                "q=Queue(%r); print(q.get('a')['payload']);"
+            ) % (str(REPO), db)
+            proc = subprocess.run([PY312, "-c", code], capture_output=True, timeout=20)
+            self.assertEqual(proc.returncode, 0)
+            self.assertIn(b"{'n': 1}", proc.stdout)
+            # Claim in fresh process, then verify separate process sees running.
+            claim = _cli_ok(db, {"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 100})
+            self.assertEqual(claim["id"], "a")
+            get = _cli_ok(db, {"op": "get", "id": "a"})
+            self.assertEqual(get["state"], "running")
+            self.assertEqual(get["worker"], "w1")
+
+    def test_contended_claim_exclusivity_subprocess(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            _cli_ok(db, {"op": "submit", "jobs": [{"id": "only"}]})
+            script = (
+                "import sys; sys.path.insert(0, %r);"
+                "from durable_queue import Queue;"
+                "import json;"
+                "q=Queue(%r);"
+                "v=q.claim('W-%s', 0, 100);"
+                "print(json.dumps(v, sort_keys=True) if v else 'null');"
+            )
+            procs = []
+            for i in range(8):
+                code = script % (str(REPO), db, i)
+                p = subprocess.Popen([PY312, "-c", code], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+                procs.append(p)
+            outs = []
+            for p in procs:
+                out, err = p.communicate(timeout=20)
+                self.assertEqual(p.returncode, 0, msg=err)
+                outs.append(out.decode().strip())
+            won = [o for o in outs if o != "null"]
+            self.assertEqual(len(won), 1, msg=f"expected single winner, got {outs}")
+            winner = json.loads(won[0])
+            self.assertEqual(winner["id"], "only")
+            # Lease still active: fresh claim must be null.
+            claim2 = _cli_ok(db, {"op": "claim", "worker": "late", "now": 1, "lease_seconds": 10})
+            self.assertIsNone(claim2)
+
+    def test_cli_strictness(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            _cli_ok(db, {"op": "submit", "jobs": []})
+            # Unknown field -> exit 2 empty stdout.
+            proc = _run_cli(db, request_obj={"op": "list", "extra": 1})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Unknown op.
+            proc = _run_cli(db, request_obj={"op": "nope"})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Missing required kwarg.
+            proc = _run_cli(db, request_obj={"op": "get"})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Non-object request.
+            proc = _run_cli(db, request_obj=[1, 2])
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Malformed JSON.
+            proc = _run_cli(db, request_text="{not json")
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Invalid UTF-8.
+            proc = _run_cli(db, raw_bytes=b"\xff\xfe not utf8")
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Missing file.
+            proc = subprocess.run(
+                [PY312, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp) / "absent.json")],
+                cwd=str(REPO), capture_output=True, timeout=20,
+            )
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # API ValueError -> exit 2 empty stdout (bad submit).
+            proc = _run_cli(db, request_obj={"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(proc.returncode, 2)
+            self.assertEqual(proc.stdout, b"")
+            # Durability: prior committed work survives failures.
+            _cli_ok(db, {"op": "submit", "jobs": [{"id": "keep"}]})
+            _run_cli(db, request_obj={"op": "submit", "jobs": [{"id": ""}]})
+            get = _cli_ok(db, {"op": "get", "id": "keep"})
+            self.assertEqual(get["id"], "keep")
+            # Sorted keys + newline on success already checked in _cli_ok.
+            # fail without retry_delay (optional) succeeds.
+            _cli_ok(db, {"op": "submit", "jobs": [{"id": "f1"}]})
+            c = _cli_ok(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(c["id"], "f1")
+            f = _cli_ok(db, {"op": "complete", "id": "f1", "worker": "w", "attempt": c["attempts"], "now": 1})
+            self.assertEqual(f["state"], "succeeded")
+
+
+if __name__ == "__main__":
+    unittest.main()
