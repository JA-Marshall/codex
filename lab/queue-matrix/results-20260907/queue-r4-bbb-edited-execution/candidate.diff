+"""Durable SQLite storage with WAL, timeouts, schema and transaction helper."""
+import contextlib
 import sqlite3
 
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS jobs (
+    id TEXT PRIMARY KEY,
+    spec TEXT NOT NULL,
+    payload TEXT NOT NULL,
+    priority INTEGER NOT NULL,
+    dependencies TEXT NOT NULL,
+    max_attempts INTEGER NOT NULL,
+    ready_at INTEGER NOT NULL,
+    state TEXT NOT NULL,
+    attempts INTEGER NOT NULL,
+    worker TEXT,
+    lease_until INTEGER
+);
+"""
+
+def _ensure_schema(conn):
+    # Detect legacy schema (id, data) and migrate if needed.
+    cols = {r[1]: r for r in conn.execute("PRAGMA table_info(jobs);").fetchall()}
+    if not cols:
+        conn.execute(SCHEMA)
+        return
+    if set(cols.keys()) == {"id", "data"}:
+        # Migrate legacy rows: data holds full view JSON.
+        import json as _json
+        rows = list(conn.execute("SELECT id, data FROM jobs;").fetchall())
+        conn.execute("DROP TABLE jobs;")
+        conn.execute(SCHEMA)
+        for _id, _data in rows:
+            try:
+                v = _json.loads(_data)
+            except Exception:
+                continue
+            # Reconstruct spec from view (best effort; old code never mutated ready_at)
+            try:
+                spec = {
+                    "id": v.get("id", _id),
+                    "payload": v.get("payload", {}),
+                    "priority": v.get("priority", 0),
+                    "dependencies": sorted(set(v.get("dependencies", []))),
+                    "max_attempts": v.get("max_attempts", 3),
+                    "ready_at": v.get("ready_at", 0),
+                }
+                conn.execute(
+                    "INSERT INTO jobs (id, spec, payload, priority, dependencies, max_attempts, ready_at, state, attempts, worker, lease_until)"
+                    " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                    (
+                        spec["id"],
+                        _json.dumps(spec, sort_keys=True, separators=(",", ":")),
+                        _json.dumps(spec["payload"], sort_keys=True, separators=(",", ":")),
+                        spec["priority"],
+                        _json.dumps(spec["dependencies"], separators=(",", ":")),
+                        spec["max_attempts"],
+                        v.get("ready_at", 0),
+                        v.get("state", "pending"),
+                        v.get("attempts", 0),
+                        v.get("worker"),
+                        v.get("lease_until"),
+                    ),
+                )
+            except Exception:
+                continue
+        return
+    # Ensure new-schema table exists (IF NOT EXISTS covers fresh); if table exists
+    # but lacks columns (partial), recreate? For forward compat, create if missing.
+    # Check required columns present; if not, raise to surface corruption.
