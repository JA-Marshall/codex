+    def test_separate_process_claim_exclusivity(self):
+        import json as _j
+        import concurrent.futures as _cf
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            def do_claim(worker):
+                p = self._cli(db, {"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30})
+                if p.returncode != 0:
+                    return (p.returncode, "FAIL")
+                return (p.returncode, _j.loads(p.stdout.decode()))
+            with _cf.ThreadPoolExecutor(max_workers=2) as ex:
+                # Use processes via subprocess concurrently: run two claims in parallel threads (each spawns process)
+                f1 = ex.submit(do_claim, "w1")
+                f2 = ex.submit(do_claim, "w2")
+                r1 = f1.result()
+                r2 = f2.result()
+            # Both invocations must succeed (exit 0); exactly one returns a view, other null
+            self.assertEqual(r1[0], 0, r1)
+            self.assertEqual(r2[0], 0, r2)
+            vals = [r1[1], r2[1]]
+            claimed = [v for v in vals if isinstance(v, dict)]
+            nulls = [v for v in vals if v is None]
+            self.assertEqual(len(claimed), 1)
+            self.assertEqual(len(nulls), 1)
+            # Leases must be exclusive: only one worker owns the job
+            owner = claimed[0]["worker"]
+            self.assertIn(owner, ("w1", "w2"))
+            cur = Queue(db).get("only")
+            self.assertEqual(cur["worker"], owner)
+
