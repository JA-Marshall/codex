+@contextlib.contextmanager
+def transaction(path):
+    """Yield a connection holding a BEGIN IMMEDIATE write transaction.
+
+    Commits on success, rolls back on exception. Provides cross-process
+    atomicity for submit/claim/recover/complete/fail.
+    """
+    conn = connect(path)
+    try:
+        conn.execute("BEGIN IMMEDIATE;")
+        yield conn
+        conn.execute("COMMIT;")
+    except Exception:
+        try:
+            conn.execute("ROLLBACK;")
+        except Exception:
+            pass
+        raise
+    finally:
+        try:
+            conn.close()
+        except Exception:
+            pass
