+    try:
+        args = parser.parse_args()
+    except SystemExit as e:
+        # argparse already uses exit 2 for usage errors; ensure empty stdout (it uses stderr).
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            text = stream.read()
+        try:
+            request = json.loads(text)
+        except Exception:
+            raise ValueError("malformed json")
+        if not isinstance(request, dict):
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if not isinstance(op, str) or op not in _OPS:
+            raise ValueError("unknown op")
+        allowed = _FIELDS[op]
+        required = _REQUIRED[op]
+        keys = set(request.keys()) - {"op"}
+        for k in keys:
+            if k not in allowed:
+                raise ValueError("unknown field")
+        for k in required:
+            if k not in request:
+                raise ValueError("missing field")
+        kwargs = {k: request[k] for k in keys}
+        try:
+            queue = Queue(args.db)
+        except Exception as e:
+            raise ValueError("unavailable database") from e
+        try:
+            if op == "submit":
+                value = queue.submit(**kwargs)
+            elif op == "get":
+                value = queue.get(**kwargs)
+            elif op == "list":
+                value = queue.list(**kwargs)
+            elif op == "claim":
+                value = queue.claim(**kwargs)
+            elif op == "recover":
+                value = queue.recover(**kwargs)
+            elif op == "complete":
+                value = queue.complete(**kwargs)
+            elif op == "fail":
+                value = queue.fail(**kwargs)
+            else:
+                raise ValueError("unknown op")
+        except ValueError:
+            raise
+        except Exception as e:
+            raise ValueError("operation failed") from e
+        sys.stdout.write(json.dumps(value, sort_keys=True) + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except Exception as e:
+        # Must exit 2 with empty stdout; optionally note on stderr.
+        try:
+            sys.stderr.write("error\n")
+        except Exception:
+            pass
+        return 2
 
 
