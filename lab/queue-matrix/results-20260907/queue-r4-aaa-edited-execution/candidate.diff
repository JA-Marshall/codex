+class ValidationTests(unittest.TestCase):
+    def test_bool_rejected_for_int_fields(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": False}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", True, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], True)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 1, retry_delay=True)
+            self.assertEqual(q.list()[0]["state"], "running")
+
+    def test_unknown_fields_and_types(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "unknown": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": ""}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": 123}])
+            with self.assertRaises(ValueError):
+                q.submit("notalist")
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": []}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": (1, 2)}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": "x"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": [""]}])
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.claim("", 0, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", -1, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, 0)
+            self.assertEqual(q.list(), [])
+
+    def test_view_exact_keys_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            v = q.submit([{"id": "a", "payload": {"x": [1, 2]}, "dependencies": ["b"], "max_attempts": 2, "priority": 5, "ready_at": 3}, {"id": "b"}])
+            # deps unsorted input normalized tested separately; check keys
+            expected_keys = {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"}
+            for view in v:
+                self.assertEqual(set(view.keys()), expected_keys)
+            g = q.get("a")
+            self.assertEqual(set(g.keys()), expected_keys)
+            self.assertEqual(g["dependencies"], ["b"])
+            # detached: mutate returned, refetch unchanged
+            g["payload"]["x"].append(99)
+            g["dependencies"].append("zzz")
+            g2 = q.get("a")
+            self.assertEqual(g2["payload"], {"x": [1, 2]})
+            self.assertEqual(g2["dependencies"], ["b"])
+            # do not mutate caller input
+            inp = [{"id": "c", "dependencies": ["b", "b", "a"]}]
+            orig = copy.deepcopy(inp)
+            q.submit(inp)
+            self.assertEqual(inp, orig)
+            self.assertEqual(q.get("c")["dependencies"], ["a", "b"])
+
+    def test_submit_rollback_atomic(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "ok"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "new1"}, {"id": "new1"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "new2"}, {"id": "bad", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "b", "dependencies": ["a", "missing2"]}])
+            self.assertEqual(q.list(), before)
