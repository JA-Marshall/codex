+import json, subprocess, sys, tempfile
+from pathlib import Path
+from durable_queue import Queue
+def run(db, req):
+    return subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",req],capture_output=True,timeout=20)
+def req(tmp,obj=None,raw=None,bin=None):
+    p=Path(tmp)/"r.json"
+    if bin is not None: p.write_bytes(bin)
+    elif raw is not None: p.write_text(raw,encoding="utf-8")
+    else: p.write_text(json.dumps(obj),encoding="utf-8")
+    return str(p)
+import tempfile as tf
+tmp=tf.mkdtemp()
+db=str(Path(tmp)/"q.db")
+# success cases
+r=run(db, req(tmp, {"op":"submit","jobs":[{"id":"a"}]}))
+assert r.returncode==0 and r.stdout.endswith(b"\n") and r.stdout.count(b"\n")==1, r
+assert json.loads(r.stdout)[0]["id"]=="a"
+print("PASS submit-cli")
+r2=run(db, req(tmp, {"op":"list"}))
+assert r2.returncode==0 and r2.stdout.endswith(b"\n")
+print("PASS list-cli")
+r3=run(db, req(tmp, {"op":"claim","worker":"w","now":0,"lease_seconds":10}))
+assert r3.returncode==0 and json.loads(r3.stdout)["id"]=="a"
+print("PASS claim-cli")
+r4=run(db, req(tmp, {"op":"get","id":"a"}))
+assert json.loads(r4.stdout)["state"]=="running"
+print("PASS get-cli")
+# durability: bad request then get still works
+bad=run(db, req(tmp, {"op":"claim","worker":"w","now":0,"lease_seconds":0}))
+assert bad.returncode==2 and bad.stdout==b"", bad
+r5=run(db, req(tmp, {"op":"get","id":"a"}))
+assert json.loads(r5.stdout)["state"]=="running"
+print("PASS durability-after-fail")
+# exit2 cases
+cases=[({"op":"nope"},None,None),({"op":"get","id":"a","extra":1},None,None),({"op":"list","x":1},None,None),({"op":"get"},None,None),(None,"[1,2",None),(None,"[1,2,3]",None),(None,None,b"\xff\xfe bad")]
+for obj,raw,bin in cases:
+    if bin is not None: rq=req(tmp,bin=bin)
+    elif raw is not None: rq=req(tmp,raw=raw)
+    else: rq=req(tmp,obj)
+    rr=run(db,rq)
+    assert rr.returncode==2 and rr.stdout==b"", (obj,raw,bin,rr.returncode,rr.stdout)
+print("PASS exit2-misc")
+rr=run(db, req(tmp, {"op":"claim","worker":"w","now":0,"lease_seconds":0}))
+assert rr.returncode==2 and rr.stdout==b""
+print("PASS exit2-valueerror")
+rr=subprocess.run([sys.executable,"-m","durable_queue","--db",db,"--request",str(Path(tmp)/"missing.json")],capture_output=True,timeout=20)
+assert rr.returncode==2 and rr.stdout==b""
+print("PASS exit2-missing-file")
+rr=subprocess.run([sys.executable,"-m","durable_queue","--db",tmp,"--request",req(tmp,{"op":"list"})],capture_output=True,timeout=20)
+assert rr.returncode==2 and rr.stdout==b""
+print("PASS exit2-bad-db")
+# invalid usage (missing args) -> exit 2 empty stdout
+rr=subprocess.run([sys.executable,"-m","durable_queue","--db",db],capture_output=True,timeout=20)
+assert rr.returncode==2 and rr.stdout==b""
+print("PASS exit2-usage")
+# sorted keys check
+rr=run(db, req(tmp, {"op":"get","id":"a"}))
+raw=rr.stdout.decode()
+val=json.loads(raw)
+assert raw==json.dumps(val,sort_keys=True)+"\n"
+print("PASS sorted-keys")
+print("ALL-CLI-PASSED")
