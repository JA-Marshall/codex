+def _ensure_schema(connection):
+    # Detect old single-blob schema and migrate if needed.
+    rows = connection.execute("PRAGMA table_info(jobs)").fetchall()
+    if not rows:
+        connection.execute(_NEW_SCHEMA)
+        return
+    cols = {r[1] for r in rows}
+    if cols == {"id", "data"}:
+        _migrate_old(connection)
+        return
+    # Ensure new table exists (no-op if already correct).
+    connection.execute(_NEW_SCHEMA)
