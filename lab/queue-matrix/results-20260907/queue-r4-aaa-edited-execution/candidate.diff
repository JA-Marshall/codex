+def _migrate_old(connection):
+    import json as _json
+    old_rows = list(connection.execute("SELECT id, data FROM jobs").fetchall())
+    connection.execute("DROP TABLE jobs")
+    connection.execute(_NEW_SCHEMA)
+    for jid, data in old_rows:
