+            self.assertEqual(c["lease_until"], 5)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "bad", "dependencies": ["nope"]}])
+            # expired lease must still be running (no implicit recovery on error)
+            self.assertEqual(q.get("a")["state"], "running")
