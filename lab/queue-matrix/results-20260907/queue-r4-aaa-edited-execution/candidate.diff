+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 6)
+            self.assertEqual(q.get("a")["attempts"], 2)
+            # complete correctly
+            q.complete("a", "w1", 2, 6)
+            self.assertEqual(q.get("a")["state"], "succeeded")
+
+
+class SubprocessTests(unittest.TestCase):
+    def test_separate_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            Queue(db).submit([{"id": "only"}])
+            code = (
+                "from durable_queue import Queue;"
+                "import sys;"
+                "q=Queue(sys.argv[1]);"
+                "v=q.claim('w'+sys.argv[2], 0, 10);"
+                "print(v['id'] if v else 'NONE')"
+            )
+            p1 = subprocess.run([sys.executable, "-c", code, db, "1"], capture_output=True, text=True, timeout=20)
+            p2 = subprocess.run([sys.executable, "-c", code, db, "2"], capture_output=True, text=True, timeout=20)
+            outs = sorted([p1.stdout.strip(), p2.stdout.strip()])
+            self.assertEqual(outs, ["NONE", "only"])
+
+    def test_durability_across_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            code_submit = "from durable_queue import Queue; import sys; Queue(sys.argv[1]).submit([{'id':'a','payload':{'v':1}},{'id':'b','dependencies':['a']}])"
+            subprocess.run([sys.executable, "-c", code_submit, db], check=True, timeout=20)
+            code_claim = "from durable_queue import Queue; import sys, json; v=Queue(sys.argv[1]).claim('w',0,10); print(json.dumps(v,sort_keys=True))"
+            r = subprocess.run([sys.executable, "-c", code_claim, db], capture_output=True, text=True, timeout=20)
+            self.assertEqual(json.loads(r.stdout)["id"], "a")
+            # new process sees same state
+            code_get = "from durable_queue import Queue; import sys, json; print(json.dumps(Queue(sys.argv[1]).get('a'),sort_keys=True))"
+            r2 = subprocess.run([sys.executable, "-c", code_get, db], capture_output=True, text=True, timeout=20)
+            self.assertEqual(json.loads(r2.stdout)["state"], "running")
+
+
+class CLITests(unittest.TestCase):
+    def _req(self, tmp, obj, raw=None, binary=None):
+        p = Path(tmp) / "req.json"
+        if binary is not None:
+            p.write_bytes(binary)
+        elif raw is not None:
+            p.write_text(raw, encoding="utf-8")
+        else:
+            p.write_text(json.dumps(obj), encoding="utf-8")
+        return str(p)
+
+    def _run(self, db, req):
+        return subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, timeout=20)
+
+    def test_cli_success_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            req = self._req(tmp, {"op": "submit", "jobs": [{"id": "a"}]})
+            r = self._run(db, req)
+            self.assertEqual(r.returncode, 0)
+            self.assertTrue(r.stdout.endswith(b"\n"))
+            self.assertEqual(r.stdout.count(b"\n"), 1)
+            val = json.loads(r.stdout.decode())
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: check raw string has sorted order for a view (attempts before id etc.)
+            # at least ensure loads round-trip and output used sort_keys
+            req2 = self._req(tmp, {"op": "list"})
+            r2 = self._run(db, req2)
+            self.assertEqual(r2.returncode, 0)
+            self.assertTrue(r2.stdout.endswith(b"\n"))
+
+    def test_cli_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            self._run(db, self._req(tmp, {"op": "submit", "jobs": [{"id": "a"}]}))
+            r = self._run(db, self._req(tmp, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10}))
+            self.assertEqual(json.loads(r.stdout)["id"], "a")
+            r2 = self._run(db, self._req(tmp, {"op": "get", "id": "a"}))
+            self.assertEqual(json.loads(r2.stdout)["state"], "running")
+
+    def test_cli_exit2_cases(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            Queue(db).submit([{"id": "a"}])
+            cases = [
+                ({"op": "nope"}, None, None),
+                ({"op": "get", "id": "a", "extra": 1}, None, None),
+                ({"op": "list", "x": 1}, None, None),
+                ({"op": "get"}, None, None),
+                (None, "[1,2", None),
+                (None, "[1,2,3]", None),
+                (None, None, b"\xff\xfe bad"),
+            ]
+            for obj, raw, binary in cases:
+                if binary is not None:
+                    req = self._req(tmp, None, binary=binary)
+                elif raw is not None:
+                    req = self._req(tmp, None, raw=raw)
+                else:
+                    req = self._req(tmp, obj)
+                r = self._run(db, req)
+                self.assertEqual(r.returncode, 2, msg=str(obj or raw or binary))
+                self.assertEqual(r.stdout, b"", msg=str(obj or raw or binary))
+            # ValueError case: claim with bad lease
+            r = self._run(db, self._req(tmp, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 0}))
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+            # missing file
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp)/"missing.json")], capture_output=True, timeout=20)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+            # unavailable db (directory as db path)
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", tmp, "--request", self._req(tmp, {"op": "list"})], capture_output=True, timeout=20)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, b"")
+
+
+if __name__ == "__main__":
+    unittest.main()
