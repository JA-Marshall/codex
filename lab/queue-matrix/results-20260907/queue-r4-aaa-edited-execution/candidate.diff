+def _has_cycle(adj):
+    visited = set()
+    rec = set()
+    for start in adj:
+        if start in visited:
+            continue
+        stack = [(start, iter(adj.get(start, [])))]
+        visited.add(start)
+        rec.add(start)
+        while stack:
+            node, it = stack[-1]
+            try:
+                nb = next(it)
+                if nb not in adj:
+                    continue
+                if nb not in visited:
+                    visited.add(nb)
+                    rec.add(nb)
+                    stack.append((nb, iter(adj.get(nb, []))))
+                elif nb in rec:
+                    return True
+            except StopIteration:
+                rec.remove(node)
+                stack.pop()
+    return False
