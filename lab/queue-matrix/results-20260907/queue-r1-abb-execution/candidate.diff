+"""S1 regression: strict submit validation, atomicity, idempotency, detached views."""
+import tempfile
+import unittest
+from pathlib import Path
+from durable_queue import Queue
+
+def mkqueue(tmp):
+    return Queue(Path(tmp) / "q.db")
+
+class S1SubmitTests(unittest.TestCase):
+    def test_unknown_field_rejected_and_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "c", "bogus": 1}])
+            ids = sorted(j["id"] for j in q.list())
+            self.assertEqual(ids, ["a"])
+
+    def test_bool_ready_at_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": True}])
+            self.assertEqual(q.list(), [])
+
+    def test_cycle_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_idempotent_resubmit_noop(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "payload": {"x": 1}}])
+            # normalized same spec with different dep order / defaults should be noop
+            v = q.submit([{"id": "a", "payload": {"x": 1}}])
+            self.assertEqual(len(v), 1)
+            self.assertEqual(q.list()[0]["payload"], {"x": 1})
+
+    def test_conflict_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "priority": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 2}])
+            self.assertEqual(q.list()[0]["priority"], 1)
+
+    def test_detached_views(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            v = q.submit([{"id": "a", "payload": {"x": [1]}}])[0]
+            v["payload"]["x"].append(999)
+            self.assertEqual(q.get("a")["payload"], {"x": [1]})
+            g = q.get("a")
+            g["payload"]["x"].append(999)
+            self.assertEqual(q.get("a")["payload"], {"x": [1]})
+
+    def test_no_mutate_input(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            inp = [{"id": "a", "dependencies": ["b", "b"]}, {"id": "b"}]
+            import copy
+            snap = copy.deepcopy(inp)
+            q.submit(inp)
+            self.assertEqual(inp, snap)
+
+if __name__ == "__main__":
+    unittest.main()
