+    # If table has unexpected columns, migrate by reading if possible
+    # Fallback: create new schema table
+    if set(cols) == {"id", "spec", "data"}:
+        return
+    # Attempt generic migration: drop and recreate only if empty
+    cnt = conn.execute("SELECT COUNT(*) FROM jobs").fetchone()[0]
+    if cnt == 0:
+        conn.execute("DROP TABLE jobs")
+        conn.execute(_SCHEMA_NEW)
+    else:
+        # Try to migrate assuming 'data' holds view JSON and 'spec' may exist
+        _migrate_generic(conn, cols)
+
+def _migrate_v0_to_v1(conn):
+    import json as _json
+    rows = conn.execute("SELECT id, data FROM jobs").fetchall()
+    conn.execute("CREATE TABLE IF NOT EXISTS jobs_new (id TEXT PRIMARY KEY, spec TEXT NOT NULL, data TEXT NOT NULL)")
+    for jid, data in rows:
+        try:
+            view = _json.loads(data)
+        except Exception:
+            continue
+        # Derive spec from view
+        try:
+            spec = {
+                "id": view["id"],
+                "payload": view.get("payload", {}),
+                "priority": view.get("priority", 0),
+                "dependencies": sorted(set(view.get("dependencies", []))),
+                "max_attempts": view.get("max_attempts", 3),
+                "ready_at": view.get("ready_at", 0),
+            }
+            spec_json = _json.dumps(spec, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+            # Normalize data view to exact keys
+            norm_view = {
+                "id": view["id"],
+                "payload": view.get("payload", {}),
+                "priority": view.get("priority", 0),
+                "dependencies": sorted(set(view.get("dependencies", []))),
+                "max_attempts": view.get("max_attempts", 3),
+                "ready_at": view.get("ready_at", 0),
+                "state": view.get("state", "pending"),
+                "attempts": view.get("attempts", 0),
+                "worker": view.get("worker", None),
+                "lease_until": view.get("lease_until", None),
+            }
+            data_json = _json.dumps(norm_view, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+        except Exception:
+            continue
+        conn.execute("INSERT OR REPLACE INTO jobs_new (id, spec, data) VALUES (?, ?, ?)", (jid, spec_json, data_json))
+    conn.execute("DROP TABLE jobs")
+    conn.execute("ALTER TABLE jobs_new RENAME TO jobs")
+
+def _migrate_generic(conn, cols):
+    import json as _json
+    # Best effort: read id/spec/data if present
+    try:
+        rows = conn.execute("SELECT id, spec, data FROM jobs").fetchall()
+        # already new-like
+        return
+    except Exception:
+        pass
+    # Recreate
+    cnt = 0
+    try:
+        cnt = conn.execute("SELECT COUNT(*) FROM jobs").fetchone()[0]
+    except Exception:
+        pass
+    if cnt == 0:
+        try:
+            conn.execute("DROP TABLE jobs")
+        except Exception:
+            pass
+        conn.execute(_SCHEMA_NEW)
