+    def test_stale_attempt_rejected(self):
+        import tempfile
+        from pathlib import Path
+        from durable_queue import Queue
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            # expire and reclaim by other worker
+            c2 = q.claim("w2", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            # state unchanged: still running owned by w2
+            self.assertEqual(q.get("a")["worker"], "w2")
+
+    def test_fail_retry(self):
+        import tempfile
+        from pathlib import Path
+        from durable_queue import Queue
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", 1, 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            # second fail exhausts
+            c2 = q.claim("w", 6, 10)
+            v2 = q.fail("a", "w", 2, 7)
+            self.assertEqual(v2["state"], "failed")
