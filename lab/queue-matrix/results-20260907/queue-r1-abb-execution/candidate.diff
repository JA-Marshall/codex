+"""Real separate-process durability and claim exclusivity."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+def _run_claim_subprocess(db, worker, now, lease):
+    code = (
+        "import json, sys; "
+        "from durable_queue import Queue; "
+        f"q=Queue({str(db)!r}); "
+        f"v=q.claim({worker!r}, {now!r}, {lease!r}); "
+        "print(json.dumps(v, sort_keys=True))"
+    )
+    return subprocess.Popen([sys.executable, "-c", code], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+
+class ProcessTests(unittest.TestCase):
+    def test_reopen_preserves_commits(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a", "payload": {"x": 1}}, {"id": "b"}])
+            # fresh process via CLI list
+            import tempfile as tf
+            req = Path(tmp) / "req.json"
+            req.write_text(json.dumps({"op": "list"}), encoding="utf-8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 0, msg=p.stderr[:500])
+            vals = json.loads(p.stdout)
+            self.assertEqual(sorted(v["id"] for v in vals), ["a", "b"])
+            # reopen in-process also sees same
+            self.assertEqual(Queue(db).get("a")["payload"], {"x": 1})
+
+    def test_claim_exclusivity_concurrent(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            # launch 4 concurrent claimants for 2 jobs
+            procs = [_run_claim_subprocess(db, f"w{i}", 0, 10) for i in range(4)]
+            outs = []
+            for pr in procs:
+                out, err = pr.communicate(timeout=30)
+                self.assertEqual(pr.returncode, 0, msg=err[:500])
+                v = json.loads(out.strip())
+                outs.append(v)
+            claimed = [v["id"] for v in outs if v is not None]
+            # no duplicate active lease
+            self.assertEqual(len(claimed), len(set(claimed)), msg=f"duplicate claim: {claimed}")
+            # at most 2 claimed (only 2 jobs)
+            self.assertLessEqual(len(claimed), 2)
+            # exactly 2 should be claimed since 4 workers and 2 jobs (all eligible)
+            self.assertEqual(len(claimed), 2)
+            self.assertEqual(set(claimed), {"a", "b"})
+            # further claim gets None
+            self.assertIsNone(Queue(db).claim("wX", 0, 10))
+
+    def test_cli_failure_preserves_db(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            req = Path(tmp) / "bad.json"
+            req.write_text(json.dumps({"op": "submit", "jobs": [{"id": "b", "priority": True}]}), encoding="utf-8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req)], capture_output=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # prior work survives
+            self.assertEqual(sorted(j["id"] for j in Queue(db).list()), ["a"])
+
+if __name__ == "__main__":
+    unittest.main()
