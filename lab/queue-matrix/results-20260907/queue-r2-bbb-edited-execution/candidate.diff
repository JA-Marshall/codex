+"""Normalized durable storage with WAL and atomic transaction helper."""
+import contextlib
+import json
 import sqlite3
 
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS jobs (
+    id TEXT PRIMARY KEY,
+    spec TEXT NOT NULL,
+    payload TEXT NOT NULL,
+    priority INTEGER NOT NULL,
+    deps TEXT NOT NULL,
+    max_attempts INTEGER NOT NULL,
+    ready_at INTEGER NOT NULL,
+    state TEXT NOT NULL,
+    attempts INTEGER NOT NULL,
+    worker TEXT,
+    lease_until INTEGER
+)
+"""
+
+def _ensure_schema(conn):
+    row = conn.execute(
+        "SELECT sql FROM sqlite_master WHERE type='table' AND name='jobs'"
+    ).fetchone()
+    if row is None or row[0] is None:
+        conn.execute(SCHEMA)
+        return
+    cols = {r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()}
+    if "spec" in cols:
+        conn.execute(SCHEMA)
+        return
+    if "data" in cols:
+        conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS jobs_new (
+                id TEXT PRIMARY KEY,
+                spec TEXT NOT NULL,
+                payload TEXT NOT NULL,
+                priority INTEGER NOT NULL,
+                deps TEXT NOT NULL,
+                max_attempts INTEGER NOT NULL,
+                ready_at INTEGER NOT NULL,
+                state TEXT NOT NULL,
+                attempts INTEGER NOT NULL,
+                worker TEXT,
+                lease_until INTEGER
+            )
+            """
+        )
+        try:
+            old_rows = conn.execute("SELECT id, data FROM jobs").fetchall()
