@@ -0,0 +1,140 @@
+"""Process-level durability and claim exclusivity + strict CLI (TDD red first)."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+PY = "python3.12"
+
+def run_cli(db, req_obj=None, raw_bytes=None, raw_text=None):
+    with tempfile.NamedTemporaryFile(mode="wb", delete=False, dir=str(Path.cwd())) as f:
+        if raw_bytes is not None:
+            f.write(raw_bytes)
+        elif raw_text is not None:
+            f.write(raw_text.encode("utf-8"))
+        else:
+            f.write(json.dumps(req_obj).encode("utf-8"))
+        req_path = f.name
+    try:
+        p = subprocess.run([PY, "-m", "durable_queue", "--db", str(db), "--request", req_path],
+                           capture_output=True, timeout=20)
+        return p
+    finally:
+        try:
+            Path(req_path).unlink()
+        except Exception:
+            pass
+
+class ProcessDurabilityTests(unittest.TestCase):
+    def test_submit_survives_separate_process(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            code_submit = f"from durable_queue import Queue; Queue({db!r}).submit([{{'id':'a','payload':{{'x':1}}}}])"
+            r1 = subprocess.run([PY, "-c", code_submit], capture_output=True, timeout=20)
+            self.assertEqual(r1.returncode, 0, r1.stderr.decode()[:2000])
+            code_get = f"from durable_queue import Queue; print(Queue({db!r}).get('a')['payload'])"
+            r2 = subprocess.run([PY, "-c", code_get], capture_output=True, timeout=20)
+            self.assertEqual(r2.returncode, 0, r2.stderr.decode()[:2000])
+            self.assertIn("'x': 1", r2.stdout.decode())
+
+    def test_contended_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            setup = f"from durable_queue import Queue; Queue({db!r}).submit([{{'id':'job1'}},{{'id':'job2'}},{{'id':'job3'}}])"
+            r0 = subprocess.run([PY, "-c", setup], capture_output=True, timeout=20)
+            self.assertEqual(r0.returncode, 0, r0.stderr.decode()[:2000])
+            # spawn 6 contending claimants at same now
+            procs = []
+            for i in range(6):
+                code = (
+                    f"from durable_queue import Queue;"
+                    f"v=Queue({db!r}).claim('w{i}',0,30);"
+                    f"print(v['id'] if v else 'NONE')"
+                )
+                procs.append(subprocess.Popen([PY, "-c", code], stdout=subprocess.PIPE, stderr=subprocess.PIPE))
+            outs = []
+            for p in procs:
+                out, err = p.communicate(timeout=20)
+                self.assertEqual(p.returncode, 0, err.decode()[:2000])
+                outs.append(out.decode().strip())
+            claimed = [o for o in outs if o != "NONE"]
+            # only 3 jobs exist, at most 3 claims; each claimed id must be unique (single active lease)
+            self.assertEqual(len(claimed), 3, outs)
+            self.assertEqual(len(set(claimed)), 3, outs)
+            self.assertEqual(sorted(set(claimed)), ["job1", "job2", "job3"])
+
+    def test_single_lease_two_processes_never_same(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            setup = f"from durable_queue import Queue; Queue({db!r}).submit([{{'id':'only'}}])"
+            self.assertEqual(subprocess.run([PY, "-c", setup], capture_output=True, timeout=20).returncode, 0)
+            results = []
+            for i in range(2):
+                code = f"from durable_queue import Queue; v=Queue({db!r}).claim('w{i}',0,30); print(v['id'] if v else 'NONE')"
+                # run sequentially but in separate processes: second must see lease held
+                r = subprocess.run([PY, "-c", code], capture_output=True, timeout=20)
+                self.assertEqual(r.returncode, 0)
+                results.append(r.stdout.decode().strip())
+            self.assertEqual(results[0], "only")
+            self.assertEqual(results[1], "NONE")
+
+class CliStrictTests(unittest.TestCase):
+    def test_cli_success_sorted_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a", "priority": 1}]})
+            self.assertEqual(p.returncode, 0, p.stderr.decode()[:2000])
+            self.assertTrue(p.stdout.endswith(b"\n"))
+            self.assertEqual(p.stdout.count(b"\n"), 1)
+            val = json.loads(p.stdout.decode())
+            self.assertIsInstance(val, list)
+            # sorted keys check: raw text should have keys sorted
+            p2 = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p2.returncode, 0)
+            text = p2.stdout.decode()
+            self.assertTrue(text.endswith("\n"))
+            obj = json.loads(text)
+            self.assertEqual(obj["id"], "a")
+            # ensure sorted keys by comparing to dumps sorted
+            self.assertEqual(text, json.dumps(obj, sort_keys=True) + "\n")
+
+    def test_cli_error_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # unknown field
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a"}], "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # unknown op
+            p2 = run_cli(db, {"op": "nope"})
+            self.assertEqual(p2.returncode, 2)
+            self.assertEqual(p2.stdout, b"")
+            # malformed: non-object
+            p3 = run_cli(db, raw_text="[1,2]")
+            self.assertEqual(p3.returncode, 2)
+            self.assertEqual(p3.stdout, b"")
+            # invalid UTF-8
+            p4 = run_cli(db, raw_bytes=b"\xff\xfe bad")
+            self.assertEqual(p4.returncode, 2)
+            self.assertEqual(p4.stdout, b"")
+            # ValueError from API (bad id) -> exit 2 empty stdout
+            p5 = run_cli(db, {"op": "get", "id": ""})
+            self.assertEqual(p5.returncode, 2)
+            self.assertEqual(p5.stdout, b"")
+
+    def test_cli_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "d1"}]})
+            self.assertEqual(p.returncode, 0)
+            p2 = run_cli(db, {"op": "list"})
+            self.assertEqual(p2.returncode, 0)
+            self.assertEqual([j["id"] for j in json.loads(p2.stdout.decode())], ["d1"])
+            p3 = run_cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10})
+            self.assertEqual(p3.returncode, 0)
+            self.assertEqual(json.loads(p3.stdout.decode())["id"], "d1")
+
+if __name__ == "__main__":
+    unittest.main()
