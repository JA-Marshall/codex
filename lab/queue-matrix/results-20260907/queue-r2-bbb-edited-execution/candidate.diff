+def _has_cycle(graph):
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {node: WHITE for node in graph}
+
+    def dfs(node, stack):
+        color[node] = GRAY
+        for dep in graph.get(node, []):
+            if dep not in graph:
+                continue
+            if color.get(dep, WHITE) == GRAY:
+                return True
+            if color.get(dep, WHITE) == WHITE:
+                if dfs(dep, stack):
+                    return True
+        color[node] = BLACK
+        return False
+
