+"""Focused regression tests for contract matrix (TDD red first)."""
+import copy
+import tempfile
+import unittest
+from pathlib import Path
+from durable_queue import Queue
+
+def make_queue(tmp):
+    return Queue(Path(tmp) / "q.db")
+
+class SubmitValidationTests(unittest.TestCase):
+    def test_rejects_unknown_field_and_rolls_back(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": "c", "bogus": 1}])
+            ids = sorted(j["id"] for j in q.list())
+            self.assertEqual(ids, ["a"])
+
+    def test_rejects_duplicate_ids_in_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            self.assertEqual(q.list(), [])
+
+    def test_rejects_self_dependency(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_rejects_unknown_dependency(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_rejects_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_idempotent_same_spec_after_state_change(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            q.complete("a", "w", c["attempts"], 1)
+            # resubmit identical original spec should be no-op returning current view
+            views = q.submit([{"id": "a"}])
+            self.assertEqual(views[0]["state"], "succeeded")
+            self.assertEqual(views[0]["attempts"], 1)
+
+    def test_conflict_rejects_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "priority": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 2}, {"id": "b"}])
+            self.assertEqual([j["id"] for j in q.list()], ["a"])
+
+    def test_does_not_mutate_input(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            orig = [{"id": "a", "dependencies": ["b", "b"], "payload": {"x": [1]}} , {"id": "b"}]
+            snapshot = copy.deepcopy(orig)
+            q.submit(orig)
+            self.assertEqual(orig, snapshot)
+
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": True}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+
+    def test_rejects_nonfinite_payload(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            self.assertEqual(q.list(), [])
+
+    def test_empty_submit_allowed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            self.assertEqual(q.submit([]), [])
+
+class ViewTests(unittest.TestCase):
+    def test_get_list_detached_sorted_exact_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "b"}, {"id": "a", "dependencies": ["b"]}])
+            expected_keys = {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"}
+            lst = q.list()
+            self.assertEqual([j["id"] for j in lst], ["a","b"])
+            for v in lst:
+                self.assertEqual(set(v.keys()), expected_keys)
+            # detached
+            v = q.get("a")
+            v["payload"]["hack"] = 1
+            v["dependencies"].append("hack")
+            v2 = q.get("a")
+            self.assertNotIn("hack", v2["payload"])
+            self.assertNotIn("hack", v2["dependencies"])
+            # invalid id
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_priority_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 5}, {"id": "mid", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            # complete high then next should be mid (same prio, lex smallest among remaining high-prio? high done, mid vs low)
+            q.complete("high", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "mid")
+
+    def test_claim_invalid_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # invalid claim must not recover expired lease
+            with self.assertRaises(ValueError):
+                q.claim("", 10, 10)
+            # job still running with expired lease, not auto-recovered
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["worker"], "w")
+
+    def test_recover_pending_or_failed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 5)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "failed")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # idempotent
+            self.assertEqual(q.recover(5), [])
+
+    def test_recover_sets_ready_at_to_expired_lease(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            q.recover(5)
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+
+    def test_failed_dependency_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "dep")
+            q.recover(5)  # dep -> failed
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertIsNone(q.claim("w", 5, 10))
+            self.assertEqual(q.get("child")["state"], "pending")
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_stale_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            q.recover(5)  # expires, pending again
+            c2 = q.claim("w", 5, 10)
+            # old attempt must be rejected even same worker
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c1["attempts"], 6)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", c2["attempts"], 6)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c2["attempts"], 15)
+            # correct
+            v = q.complete("a", "w", c2["attempts"], 6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_fail_retry_and_exhaust(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c1["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            self.assertIsNone(v["worker"])
+            # not eligible before ready_at
+            self.assertIsNone(q.claim("w", 2, 10))
+            c2 = q.claim("w", 6, 10)
+            self.assertEqual(c2["id"], "a")
+            v2 = q.fail("a", "w", c2["attempts"], 7)
+            self.assertEqual(v2["state"], "failed")
+
+    def test_complete_terminal_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = make_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            q.complete("a", "w", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 2)
+            self.assertIsNone(q.claim("w", 2, 10))
+
+if __name__ == "__main__":
+    unittest.main()
