+            line = r.stdout.strip()
+            self.assertLess(line.index('"attempts"'), line.index('"dependencies"'))
+            val = json.loads(line)
+            self.assertEqual(val[0]["payload"], {"a": 2, "b": 1})
+
+    def test_exit2_empty_stdout_cases(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            Queue(db).submit([{"id": "a"}])
+            cases = [
+                {"op": "submit", "jobs": [{"id": ""}]},
+                {"op": "get", "id": "", "extra": 1},
+                {"op": "list", "extra": 1},
+                {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10},
+                {"op": "nope"},
+                {"jobs": []},
+                {"op": "get"},
+            ]
+            for req in cases:
+                r = _cli(db, req, tmp=tmp)
+                self.assertEqual(r.returncode, 2, req)
+                self.assertEqual(r.stdout, "", req)
+            # malformed json
+            p = pathlib.Path(tmp) / "req.json"
+            p.write_text("{not json", encoding="utf-8")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(p)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # non-object
+            p.write_text("[]", encoding="utf-8")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(p)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # invalid utf-8
+            p.write_bytes(b"\xff\xfe")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(p)], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # missing file
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(pathlib.Path(tmp)/"missing.json")], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
+            # unknown op field / unknown operation
+            r = _cli(db, {"op": "claim", "worker": "w", "now": 0, "lease_seconds": 10, "bogus": 1}, tmp=tmp)
+            self.assertEqual(r.returncode, 2)
+            self.assertEqual(r.stdout, "")
