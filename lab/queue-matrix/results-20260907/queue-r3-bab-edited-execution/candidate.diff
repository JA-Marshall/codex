+def _migrate_legacy(conn, rows):
+    # rows: list of (id, data)
+    conn.execute(
+        """CREATE TABLE IF NOT EXISTS jobs_new (
+          id TEXT PRIMARY KEY,
+          spec TEXT NOT NULL,
+          payload TEXT NOT NULL,
+          priority INTEGER NOT NULL,
+          dependencies TEXT NOT NULL,
+          max_attempts INTEGER NOT NULL,
+          ready_at INTEGER NOT NULL,
+          state TEXT NOT NULL,
+          attempts INTEGER NOT NULL,
+          worker TEXT,
+          lease_until INTEGER
+        )"""
     )
+    for jid, data in rows:
+        try:
+            view = json.loads(data)
+        except Exception:
+            continue
+        if not isinstance(view, dict):
+            continue
+        payload = view.get("payload", {})
+        priority = view.get("priority", 0)
+        deps = view.get("dependencies", [])
+        max_attempts = view.get("max_attempts", 3)
+        ready_at = view.get("ready_at", 0)
+        state = view.get("state", "pending")
+        attempts = view.get("attempts", 0)
+        worker = view.get("worker")
+        lease_until = view.get("lease_until")
+        if not isinstance(payload, dict):
+            payload = {}
+        if type(priority) is not int:
+            try:
+                priority = int(priority)
+            except Exception:
+                priority = 0
+        if not isinstance(deps, list):
+            deps = []
+        else:
+            # keep only strings
+            cleaned = []
+            for d in deps:
+                if isinstance(d, str) and d != "":
+                    cleaned.append(d)
+            deps = sorted(set(cleaned))
+        if type(max_attempts) is not int or not (1 <= max_attempts <= 100):
+            max_attempts = 3
+        if type(ready_at) is not int or ready_at < 0:
+            ready_at = 0
+        if state not in ("pending","running","succeeded","failed"):
+            state = "pending"
+        if type(attempts) is not int or attempts < 0:
+            attempts = 0
+        if worker is not None and not (isinstance(worker, str) and worker != ""):
+            worker = None
+        if lease_until is not None and not (type(lease_until) is int and lease_until >= 0):
+            lease_until = None
+        spec = {"id": jid, "payload": payload, "priority": priority,
+                "dependencies": deps, "max_attempts": max_attempts, "ready_at": ready_at}
+        spec_json = json.dumps(spec, sort_keys=True, separators=(",", ":"))
+        payload_json = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+        deps_json = json.dumps(deps, separators=(",", ":"))
+        conn.execute(
+            "INSERT OR REPLACE INTO jobs_new (id,spec,payload,priority,dependencies,max_attempts,ready_at,state,attempts,worker,lease_until) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
+            (jid, spec_json, payload_json, priority, deps_json, max_attempts, ready_at, state, attempts, worker, lease_until),
+        )
+    conn.execute("DROP TABLE jobs")
+    conn.execute("ALTER TABLE jobs_new RENAME TO jobs")
+
+def _ensure_schema(conn):
+    row = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='jobs'").fetchone()
+    if row is None:
+        conn.execute(_SCHEMA)
+        return
+    cols = conn.execute("PRAGMA table_info(jobs)").fetchall()
+    names = [c[1] for c in cols]
+    if set(names) == {"id", "data"}:
+        rows = conn.execute("SELECT id, data FROM jobs").fetchall()
+        _migrate_legacy(conn, rows)
+        return
+    if _REQUIRED.issubset(set(names)):
+        return
+    # Unknown/partial schema: add missing columns if possible, else rebuild preserving id/data if present
+    existing = set(names)
+    if "data" in existing and "spec" not in existing:
+        # treat as legacy variant
+        try:
+            rows = conn.execute("SELECT id, data FROM jobs").fetchall()
+        except Exception:
+            rows = []
+        _migrate_legacy(conn, rows)
+        return
+    # Add any missing columns with sensible defaults
+    defaults = {
+        "spec": "''",
+        "payload": "'{}'",
+        "priority": "0",
+        "dependencies": "'[]'",
+        "max_attempts": "3",
+        "ready_at": "0",
+        "state": "'pending'",
+        "attempts": "0",
+        "worker": "NULL",
+        "lease_until": "NULL",
+    }
+    for col in _REQUIRED:
+        if col not in existing:
+            # determine type affinity
+            if col in ("priority","max_attempts","ready_at","attempts","lease_until"):
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col} INTEGER")
+            elif col in ("worker","spec","payload","dependencies","state"):
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col} TEXT")
+            else:
+                conn.execute(f"ALTER TABLE jobs ADD COLUMN {col} TEXT")
+    # backfill spec where empty and possible
+    try:
+        nulls = conn.execute("SELECT id FROM jobs WHERE spec IS NULL OR spec=''").fetchall()
+        for (jid,) in nulls:
+            r = conn.execute("SELECT payload,priority,dependencies,max_attempts,ready_at FROM jobs WHERE id=?", (jid,)).fetchone()
+            if r is None:
+                continue
+            try:
+                p = json.loads(r[0]) if r[0] else {}
+            except Exception:
+                p = {}
+            try:
+                d = json.loads(r[2]) if r[2] else []
+            except Exception:
+                d = []
+            spec = {"id": jid, "payload": p if isinstance(p, dict) else {}, "priority": r[1] if type(r[1]) is int else 0,
+                    "dependencies": d if isinstance(d, list) else [], "max_attempts": r[3] if type(r[3]) is int else 3,
+                    "ready_at": r[4] if type(r[4]) is int else 0}
+            conn.execute("UPDATE jobs SET spec=? WHERE id=?", (json.dumps(spec, sort_keys=True, separators=(",", ":")), jid))
+    except Exception:
+        pass
+
+def connect(path):
+    connection = sqlite3.connect(str(path), timeout=30.0, isolation_level=None, check_same_thread=True)
+    try:
+        connection.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA busy_timeout=30000;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA foreign_keys=ON;")
+    except Exception:
+        pass
+    _ensure_schema(connection)
     return connection
+
+@contextlib.contextmanager
+def transaction(connection):
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        yield connection
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except Exception:
+            pass
+        raise
+    else:
+        connection.execute("COMMIT")
