+import copy
+import json
+import multiprocessing
+import pathlib
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from durable_queue import Queue
+
+
+def _db(tmp, name="q.db"):
+    return str(pathlib.Path(tmp) / name)
+
+
+def _cli(db, req_obj=None, raw=None, tmp=None):
+    # write request file in tmp, run CLI, return CompletedProcess
+    if tmp is None:
+        raise ValueError("tmp required")
+    p = pathlib.Path(tmp) / "req.json"
+    if raw is not None:
+        # raw bytes
+        p.write_bytes(raw)
+    else:
+        p.write_text(json.dumps(req_obj), encoding="utf-8")
+    return subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(p)], capture_output=True, text=True)
+
+
+def _claim_worker(args):
+    db_path, worker, now, lease = args
+    q = Queue(db_path)
+    try:
+        v = q.claim(worker, now, lease)
+    except Exception as e:
+        return ("error", str(e))
+    if v is None:
+        return None
+    return v
+
