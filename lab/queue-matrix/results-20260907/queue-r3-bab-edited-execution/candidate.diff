+    def test_dependency_matrix(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "base"}, {"id": "dep", "dependencies": ["base"]}, {"id": "failer", "max_attempts": 1}, {"id": "blocked", "dependencies": ["failer"]}])
+            # dep not eligible before base succeeded
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "base")
+            # failer also eligible; order by id: base < failer, so base first (already claimed). Next should be failer
+            c2 = q.claim("w", 0, 10)
+            self.assertEqual(c2["id"], "failer")
+            q.fail("failer", "w", c2["attempts"], 1)
+            self.assertEqual(q.get("failer")["state"], "failed")
+            # blocked stays pending/ineligible
+            q.complete("base", "w", c["attempts"], 1)
+            c3 = q.claim("w", 1, 10)
+            self.assertEqual(c3["id"], "dep")
+            q.complete("dep", "w", c3["attempts"], 2)
+            self.assertIsNone(q.claim("w", 2, 10))
+            self.assertEqual(q.get("blocked")["state"], "pending")
+
