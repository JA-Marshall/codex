+                if "payload" in bad and bad["payload"] == {}:
+                    continue
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": True}])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", True, 1)
