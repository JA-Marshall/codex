+"""Storage helpers: WAL, transactions, strict validators, finite JSON, schema."""
+import contextlib
+import copy
+import json
+import math
 import sqlite3
 
+VIEW_KEYS = ("id", "payload", "priority", "dependencies", "max_attempts",
+             "ready_at", "state", "attempts", "worker", "lease_until")
+
+TERMINAL_STATES = ("succeeded", "failed")
+
+
+def is_strict_int(v):
+    return type(v) is int
+
+
+def validate_now(now):
+    if type(now) is not int or now < 0:
+        raise ValueError("now must be int >= 0")
+
+
+def validate_lease_seconds(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("lease_seconds must be positive int")
+
+
+def validate_retry_delay(v):
+    if type(v) is not int or v < 0:
+        raise ValueError("retry_delay must be int >= 0")
+
+
+def validate_attempt(v):
+    if type(v) is not int or v <= 0:
+        raise ValueError("attempt must be positive int")
+
+
+def validate_worker(v):
+    if not isinstance(v, str) or len(v) == 0:
+        raise ValueError("worker must be nonempty string")
+
+
+def validate_job_id(v):
+    if not isinstance(v, str) or len(v) == 0:
+        raise ValueError("id must be nonempty string")
+
+
+def _check_finite_value(v):
+    if v is None:
+        return
+    if isinstance(v, bool):
+        return
+    if isinstance(v, int):
+        # bool already handled; type int allowed
+        return
+    if isinstance(v, float):
+        if not math.isfinite(v):
+            raise ValueError("payload must contain finite JSON values only")
+        return
+    if isinstance(v, str):
+        return
+    if isinstance(v, list):
+        for item in v:
+            _check_finite_value(item)
+        return
+    if isinstance(v, dict):
+        for k, vv in v.items():
+            if type(k) is not str:
+                raise ValueError("payload object keys must be strings")
+            _check_finite_value(vv)
+        return
+    raise ValueError("payload must contain finite JSON values only")
+
+
+def check_payload(payload):
+    if not isinstance(payload, dict):
+        raise ValueError("payload must be JSON object")
+    # keys must be strings (dict check)
+    for k in payload.keys():
+        if type(k) is not str:
+            raise ValueError("payload object keys must be strings")
+    _check_finite_value(payload)
+    # ensure serializable with allow_nan=False and round-trips JSON types
+    try:
+        s = json.dumps(payload, allow_nan=False, sort_keys=True)
+        rt = json.loads(s)
+    except (ValueError, TypeError):
+        raise ValueError("payload must contain finite JSON values only")
+    # reject non-JSON python types that dumps coerces (e.g., tuple becomes list):
+    # verify structure types only contain allowed ones via recursive check already done,
+    # but tuples would have raised above. Ensure round-trip equals original for safety
+    # (comparing via JSON canonical form).
+    try:
+        s2 = json.dumps(rt, allow_nan=False, sort_keys=True)
+    except (ValueError, TypeError):
+        raise ValueError("payload must contain finite JSON values only")
+    if s != s2:
+        # e.g., tuple vs list coercion would still match; but we already rejected tuples
+        pass
+
 
 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
+    connection = sqlite3.connect(str(path), timeout=5.0, isolation_level=None, check_same_thread=True)
+    try:
+        connection.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA busy_timeout=5000;")
+    except Exception:
+        pass
     connection.execute(
         "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
     )
     return connection
+
+
+@contextlib.contextmanager
+def immediate_transaction(conn):
+    conn.execute("BEGIN IMMEDIATE;")
+    try:
+        yield conn
+        conn.execute("COMMIT;")
+    except BaseException:
+        try:
+            conn.execute("ROLLBACK;")
+        except Exception:
+            pass
+        raise
+
+
+def record_to_storage(spec, state, attempts, worker, lease_until, ready_at):
+    obj = {
+        "spec": spec,
+        "state": state,
+        "attempts": attempts,
+        "worker": worker,
+        "lease_until": lease_until,
+        "ready_at": ready_at,
+    }
+    return json.dumps(obj, allow_nan=False, sort_keys=True)
+
+
+def parse_stored(data_str):
+    """Return (spec, state, attempts, worker, lease_until, ready_at_current). Supports legacy view format."""
+    obj = json.loads(data_str)
+    if isinstance(obj, dict) and "spec" in obj and isinstance(obj["spec"], dict):
+        spec = obj["spec"]
+        state = obj.get("state")
+        attempts = obj.get("attempts")
+        worker = obj.get("worker")
+        lease_until = obj.get("lease_until")
+        ready_at = obj.get("ready_at")
+        return spec, state, attempts, worker, lease_until, ready_at
+    # legacy: full view dict
+    if not isinstance(obj, dict):
+        raise ValueError("corrupt job record")
+    spec = {
+        "id": obj.get("id"),
+        "payload": copy.deepcopy(obj.get("payload", {})),
+        "priority": obj.get("priority", 0),
+        "dependencies": sorted(set(obj.get("dependencies", []))) if isinstance(obj.get("dependencies", []), list) else obj.get("dependencies", []),
+        "max_attempts": obj.get("max_attempts", 3),
+        "ready_at": obj.get("ready_at", 0),
+    }
+    return spec, obj.get("state", "pending"), obj.get("attempts", 0), obj.get("worker"), obj.get("lease_until"), obj.get("ready_at", 0)
+
+
+def make_view(job_id, spec, state, attempts, worker, lease_until, ready_at):
+    return {
+        "id": job_id,
+        "payload": copy.deepcopy(spec["payload"]),
+        "priority": spec["priority"],
+        "dependencies": list(spec["dependencies"]),
+        "max_attempts": spec["max_attempts"],
+        "ready_at": ready_at,
+        "state": state,
+        "attempts": attempts,
+        "worker": worker,
+        "lease_until": lease_until,
+    }
