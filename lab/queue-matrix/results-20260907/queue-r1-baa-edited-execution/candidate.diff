+import copy
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _tmp_queue(tmp):
+    path = Path(tmp) / "queue.db"
+    return Queue(str(path)), str(path)
+
+
+class RegressValidationTests(unittest.TestCase):
+    def test_submit_rejects_bool_as_int_and_leaves_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            before = q.list()
+            for bad in [
+                [{"id": "b", "priority": True}],
+                [{"id": "c", "max_attempts": True}],
+                [{"id": "d", "ready_at": True}],
+                [{"id": "e", "ready_at": False}],
+            ]:
+                with self.assertRaises(ValueError):
+                    q.submit(bad)
+            # claim/recover/complete validators with bool
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            self.assertEqual(q.list(), before)
+
+    def test_submit_atomic_no_partial_on_invalid_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([{"id": "ok1"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "new1"}, {"id": "new2", "priority": "bad"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "ok1", "priority": 0}, {"id": "new3", "max_attempts": 0}])
+            self.assertEqual(q.list(), before)
+            self.assertIsNone(q.get("new1"))
+            self.assertIsNone(q.get("new3"))
+
+    def test_submit_dup_unknown_self_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            # unknown dep against DB
+            q.submit([{"id": "x"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "y", "dependencies": ["nope"]}])
+            # self via DB? submit existing with self dep conflict -> reject
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "dependencies": ["x"]}])
+            self.assertEqual(sorted(j["id"] for j in q.list()), ["x"])
+
+    def test_submit_idempotent_same_spec_after_state_change(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([{"id": "a", "payload": {"n": 1}, "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # resubmit same original spec should be no-op, return current view (running)
+            views = q.submit([{"id": "a", "payload": {"n": 1}, "priority": 5}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # conflicting spec rejects whole batch, no writes
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"n": 1}, "priority": 6}])
+            self.assertEqual(q.list(), before)
+            # recover changes ready_at; same original spec still no-op
+            rec = q.recover(10)
+            self.assertEqual(rec, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 10)
+            views2 = q.submit([{"id": "a", "payload": {"n": 1}, "priority": 5}])
+            self.assertEqual(views2[0]["ready_at"], 10)
+            self.assertEqual(views2[0]["state"], "pending")
+
+    def test_views_detached_sorted_unique(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([{"id": "b"}, {"id": "c"}])
+            inp = [{"id": "a", "payload": {"x": [1, 2]}, "dependencies": ["c", "b", "b"]}]
+            orig = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, orig)
+            self.assertEqual(views[0]["dependencies"], ["b", "c"])
+            self.assertEqual(set(views[0].keys()), {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"})
+            v = q.get("a")
+            v["payload"]["x"].append(99)
+            v["dependencies"].append("zzz")
+            v2 = q.get("a")
+            self.assertEqual(v2["payload"], {"x": [1, 2]})
+            self.assertEqual(v2["dependencies"], ["b", "c"])
+            # list sorted by ID
+            ids = [x["id"] for x in q.list()]
+            self.assertEqual(ids, sorted(ids))
+
+    def test_claim_ordering_and_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([
+                {"id": "low", "priority": 1},
+                {"id": "high", "priority": 10},
+                {"id": "mid", "priority": 10},
+                {"id": "future", "priority": 100, "ready_at": 50},
+            ])
+            c = q.claim("w", 0, 10)
+            # high vs mid same priority -> lexicographically smallest
+            self.assertEqual(c["id"], "high")
+            c2 = q.claim("w", 0, 10)
+            self.assertEqual(c2["id"], "mid")
+            c3 = q.claim("w", 0, 10)
+            self.assertEqual(c3["id"], "low")
+            self.assertIsNone(q.claim("w", 0, 10))
+            # future not ready
+            self.assertIsNone(q.claim("w", 10, 10) if False else q.claim("w", 0, 10))
+            c4 = q.claim("w", 50, 10)
+            self.assertEqual(c4["id"], "future")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["attempts"], 1)
+            # not expired
+            self.assertEqual(q.recover(4), [])
+            # expired
+            self.assertEqual(q.recover(5), ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 5)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(v["attempts"], 1)
+            # idempotent
+            self.assertEqual(q.recover(5), [])
+            # exhaust attempts -> failed, ready_at unchanged
+            c2 = q.claim("w", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            q.recover(10)
+            v2 = q.get("a")
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 5)
+            self.assertIsNone(q.claim("w", 10, 5))
+
+    def test_complete_fail_stale_and_terminals(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q, _ = _tmp_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w1", 0, 10)
+            att = c["attempts"]
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", att, 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", att + 1, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", att, 10)
+            before = q.get("a")
+            # state unchanged after failed attempts above
+            self.assertEqual(q.get("a"), before)
+            # fail with retry_delay
+            v = q.fail("a", "w1", att, 1, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 6)
+            # stale after fail: old attempt rejected even same worker reclaims
+            c2 = q.claim("w1", 6, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", att, 7)
+            # complete ok
+            vc = q.complete("a", "w1", c2["attempts"], 7)
+            self.assertEqual(vc["state"], "succeeded")
+            # terminals immutable
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c2["attempts"], 7)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w1", c2["attempts"], 7)
+            self.assertIsNone(q.claim("w1", 7, 10))
+            # failed dep stays pending/ineligible, no propagation
+            q.submit([{"id": "dep"}, {"id": "child", "dependencies": ["dep"]}])
+            cd = q.claim("w1", 7, 5)
+            self.assertEqual(cd["id"], "dep")
+            # exhaust dep: fail until failed? max 3 default; force via recover cycles
+            # fail dep then reclaim until attempts exhausted via claim/fail loop with max_attempts=1 job
+            q2id = "solo1"
+            q.submit([{"id": q2id, "max_attempts": 1}])
+            cs = q.claim("w1", 7, 5)
+            # cs could be child? child ineligible (dep not succeeded), so should be solo1
+            self.assertEqual(cs["id"], q2id)
+            vf = q.fail(q2id, "w1", cs["attempts"], 8)
+            self.assertEqual(vf["state"], "failed")
+            # attempts never exceed
+            self.assertLessEqual(q.get(q2id)["attempts"], 1)
+
+
+class SeparateProcessTests(unittest.TestCase):
+    def test_claim_exclusivity_two_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": "only"}])
+            code = (
+                "import json,sys; from durable_queue import Queue; "
+                "q=Queue(sys.argv[1]); v=q.claim(sys.argv[2], 0, 30); "
+                "print(json.dumps(v, sort_keys=True))"
+            )
+            p1 = subprocess.Popen([sys.executable, "-c", code, db, "w1"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            p2 = subprocess.Popen([sys.executable, "-c", code, db, "w2"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            o1, _ = p1.communicate(timeout=20)
+            o2, _ = p2.communicate(timeout=20)
+            self.assertEqual(p1.returncode, 0)
+            self.assertEqual(p2.returncode, 0)
+            v1 = json.loads(o1.strip())
+            v2 = json.loads(o2.strip())
+            got = [v for v in (v1, v2) if v is not None]
+            nulls = [v for v in (v1, v2) if v is None]
+            self.assertEqual(len(got), 1)
+            self.assertEqual(len(nulls), 1)
+            self.assertEqual(got[0]["id"], "only")
+            # active leases differ: owner is whichever won
+            self.assertIn(got[0]["worker"], ("w1", "w2"))
+
+    def test_durability_survives_close_reopen_in_new_process(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": "a", "payload": {"k": "v"}}, {"id": "b", "priority": 3}])
+            c = q.claim("w", 0, 100)
+            self.assertIsNotNone(c)
+            # reopen in fresh process via CLI-less subprocess
+            code = (
+                "import json,sys; from durable_queue import Queue; "
+                "q=Queue(sys.argv[1]); print(json.dumps(q.list(), sort_keys=True))"
+            )
+            p = subprocess.run([sys.executable, "-c", code, db], capture_output=True, text=True, timeout=20)
+            self.assertEqual(p.returncode, 0)
+            lst = json.loads(p.stdout.strip())
+            by_id = {x["id"]: x for x in lst}
+            self.assertEqual(by_id["a"]["payload"], {"k": "v"} if by_id["a"]["id"] == c["id"] or True else None)
+            # claimed job still running with same worker/attempt
+            claimed = by_id[c["id"]]
+            self.assertEqual(claimed["state"], "running")
+            self.assertEqual(claimed["worker"], "w")
+            self.assertEqual(claimed["attempts"], c["attempts"])
+
+    def test_cli_success_and_exit2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            def run_cli(req):
+                rf = Path(tmp) / "req.json"
+                rf.write_text(json.dumps(req), encoding="utf-8")
+                p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(rf)], capture_output=True, text=True, timeout=20)
+                return p
+            # success submit
+            p = run_cli({"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(json.loads(p.stdout), json.loads(json.dumps(json.loads(p.stdout), sort_keys=True)))
+            # bad op
+            p = run_cli({"op": "nope"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unknown field
+            p = run_cli({"op": "list", "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid UTF-8
+            bad = Path(tmp) / "bad.json"
+            bad.write_bytes(b"\xff\xff")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad)], capture_output=True, text=True, timeout=20)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp)/"missing.json")], capture_output=True, text=True, timeout=20)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
