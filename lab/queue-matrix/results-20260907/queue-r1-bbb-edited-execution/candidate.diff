+"""Focused regression tests: separate-process exclusivity and durability."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def run_cli(db, obj):
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8", dir=str(Path(db).parent)) as f:
+        json.dump(obj, f)
+        req = f.name
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req], capture_output=True, text=True, timeout=20)
+        return p
+    finally:
+        try:
+            Path(req).unlink()
+        except Exception:
+            pass
+
+
+class RegressTests(unittest.TestCase):
+    def test_separate_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            # two processes compete concurrently for the single job
+            req1 = Path(tmp) / "r1.json"
+            req2 = Path(tmp) / "r2.json"
+            req1.write_text(json.dumps({"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 30}), encoding="utf-8")
+            req2.write_text(json.dumps({"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 30}), encoding="utf-8")
+            p1 = subprocess.Popen([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req1)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            p2 = subprocess.Popen([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(req2)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            o1, e1 = p1.communicate(timeout=20)
+            o2, e2 = p2.communicate(timeout=20)
+            self.assertEqual(p1.returncode, 0, e1)
+            self.assertEqual(p2.returncode, 0, e2)
+            v1 = json.loads(o1)
+            v2 = json.loads(o2)
+            got = [v for v in (v1, v2) if v is not None]
+            nulls = [v for v in (v1, v2) if v is None]
+            self.assertEqual(len(got), 1, (v1, v2))
+            self.assertEqual(len(nulls), 1, (v1, v2))
+            self.assertEqual(got[0]["id"], "only")
+            self.assertIsNotNone(got[0]["lease_until"])
+
+    def test_durability_kill_restart(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            q = Queue(db)
+            q.submit([{"id": "a", "payload": {"n": 1}}, {"id": "b", "dependencies": ["a"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # simulate restart: fresh Queue in new process via CLI list
+            p = run_cli(db, {"op": "list"})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            views = json.loads(p.stdout)
+            self.assertEqual(sorted(v["id"] for v in views), ["a", "b"])
+            # committed work survives: a still running with same lease
+            va = [v for v in views if v["id"] == "a"][0]
+            self.assertEqual(va["state"], "running")
+            self.assertEqual(va["lease_until"], 10)
+            # reopen in-process also sees same
+            q2 = Queue(db)
+            self.assertEqual(q2.get("a")["state"], "running")
+
+    def test_atomic_batch_rollback_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(str(Path(tmp) / "q.db"))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # invalid batch must not write and must not recover running lease
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b"}, {"id": ""}])
+            self.assertIsNone(q.get("b"))
+            # a still running, not recovered
+            self.assertEqual(q.get("a")["state"], "running")
+            # expired check: recover at 5 would recover, but submit failure must not have recovered early
+            # now recover explicitly
+            self.assertEqual(q.recover(5), ["a"])
+
+    def test_stale_complete_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(str(Path(tmp) / "q.db"))
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            q.recover(5)
+            c2 = q.claim("w", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            # correct attempt succeeds
+            v = q.complete("a", "w", 2, 6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_cli_matrix(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "a"}])
+            # unknown field
+            p = run_cli(db, {"op": "get", "id": "a", "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # malformed JSON
+            bad = Path(tmp) / "bad.json"
+            bad.write_text("{not json", encoding="utf-8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(bad)], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid UTF-8
+            badb = Path(tmp) / "badb.json"
+            badb.write_bytes(b"\xff\xfe not utf8")
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(badb)], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp) / "nope.json")], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unavailable db (directory)
+            p = run_cli(str(Path(tmp)), {"op": "list"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # success shape sorted keys + newline
+            p = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p.returncode, 0)
+            self.assertTrue(p.stdout.endswith("\n"))
+            self.assertEqual(p.stdout.count("\n"), 1)
+            obj = json.loads(p.stdout)
+            self.assertEqual(list(sorted(obj.keys())), list(obj.keys()))
+
+
+if __name__ == "__main__":
+    unittest.main()
