+"""Storage helpers: WAL, busy timeout, transactions, strict validators."""
+import contextlib
+import json
+import math
 import sqlite3
 
 
+def strict_int(value):
+    """True only for exact int (bool excluded)."""
+    return type(value) is int
+
+
+def validate_now(now):
+    if type(now) is not int or now < 0:
+        raise ValueError("invalid now")
+    return now
+
+
+def validate_lease_seconds(lease_seconds):
+    if type(lease_seconds) is not int or lease_seconds <= 0:
+        raise ValueError("invalid lease_seconds")
+    return lease_seconds
+
+
+def validate_retry_delay(retry_delay):
+    if type(retry_delay) is not int or retry_delay < 0:
+        raise ValueError("invalid retry_delay")
+    return retry_delay
+
+
+def _check_json_value(value):
+    if value is None or value is True or value is False:
+        return
+    if type(value) is int:
+        return
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError("non-finite JSON number")
+        return
+    if type(value) is str:
+        return
+    if type(value) is list:
+        for item in value:
+            _check_json_value(item)
+        return
+    if type(value) is dict:
+        for k, v in value.items():
+            if type(k) is not str:
+                raise ValueError("invalid JSON object key")
+            _check_json_value(v)
+        return
+    raise ValueError("non-JSON value")
+
+
+def check_finite_json(value):
+    _check_json_value(value)
+
+
+def check_payload(payload):
+    if not isinstance(payload, dict):
+        raise ValueError("invalid payload")
+    check_finite_json(payload)
+
+
+@contextlib.contextmanager
+def transaction(connection):
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        yield connection
+        connection.commit()
+    except Exception:
+        try:
+            connection.rollback()
+        except Exception:
+            pass
+        raise
+
+
+def _derive_spec_from_view(view):
+    payload = view.get("payload", {})
+    priority = view.get("priority", 0)
+    deps = view.get("dependencies", [])
+    max_attempts = view.get("max_attempts", 3)
+    ready_at = view.get("ready_at", 0)
+    jid = view.get("id")
+    try:
+        deps_norm = sorted(set(deps)) if isinstance(deps, list) else []
+    except Exception:
+        deps_norm = []
+    spec = {
+        "id": jid,
+        "payload": payload,
+        "priority": priority,
+        "dependencies": deps_norm,
+        "max_attempts": max_attempts,
+        "ready_at": ready_at,
+    }
+    return spec
+
+
