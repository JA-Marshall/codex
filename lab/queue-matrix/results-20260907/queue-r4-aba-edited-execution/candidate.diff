 import argparse
 import json
+import sys
 
 from .queue import Queue
 
+_OPS = {"submit", "get", "list", "claim", "recover", "complete", "fail"}
+# allowed keyword fields per op (excluding 'op')
+_FIELDS = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now", "retry_delay"},
+}
+_REQUIRED = {
+    "submit": {"jobs"},
+    "get": {"id"},
+    "list": set(),
+    "claim": {"worker", "now", "lease_seconds"},
+    "recover": {"now"},
+    "complete": {"id", "worker", "attempt", "now"},
+    "fail": {"id", "worker", "attempt", "now"},
+}
 
-def main():
+
+def main(argv=None):
     parser = argparse.ArgumentParser()
     parser.add_argument("--db", required=True)
     parser.add_argument("--request", required=True)
-    args = parser.parse_args()
-    with open(args.request, encoding="utf-8") as stream:
-        request = json.load(stream)
-    operation = request.pop("op")
-    value = getattr(Queue(args.db), operation)(**request)
-    print(json.dumps(value, sort_keys=True))
-    return 0
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on invalid usage; ensure empty stdout (it uses stderr)
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            request = json.load(stream)
+        if not isinstance(request, dict):
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request.pop("op")
+        if not isinstance(op, str) or op not in _OPS:
+            raise ValueError("unknown op")
+        # no unknown fields
+        keys = set(request.keys())
+        if not keys <= _FIELDS[op]:
+            raise ValueError("unknown field")
+        if not _REQUIRED[op] <= keys:
+            raise ValueError("missing field")
+        # extra strict: fail allows optional retry_delay only; others must have exact fields
+        # (already checked subset + required => for non-fail, exact match required)
+        if op != "fail" and keys != _FIELDS[op]:
+            # for ops where required==allowed, this is same; but keep check
+            if keys != _REQUIRED[op]:
+                raise ValueError("field mismatch")
+        queue = Queue(args.db)
+        method = getattr(queue, op)
+        value = method(**request)
+        sys.stdout.write(json.dumps(value, sort_keys=True, ensure_ascii=False) + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return 2
+    except Exception:
+        return 2
 
 
 if __name__ == "__main__":
