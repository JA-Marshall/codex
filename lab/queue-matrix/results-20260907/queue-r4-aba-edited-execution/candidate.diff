+"""Regression matrix covering validation, rollback, idempotency, ordering, leases, bounded retry, subprocess exclusivity and CLI durability."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def tmp_queue(tmpdir):
+    return Queue(Path(tmpdir) / "q.db")
+
+
+class ValidationTests(unittest.TestCase):
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": True}])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "max_attempts": False}])
+
+    def test_unknown_fields_and_types(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "bogus": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "", }])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": []}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("nan")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": "x"}])
+            with self.assertRaises(ValueError):
+                q.submit("not-a-list")
+            self.assertEqual(q.list(), [])
+
+    def test_no_mutate_and_exact_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            spec = {"id": "a", "dependencies": ["b", "b"], "payload": {"x": 1}}
+            orig = json.loads(json.dumps(spec))
+            # need b to exist first? submit both
+            views = q.submit([{"id": "b"}, spec])
+            self.assertEqual(spec, orig)
+            v = q.get("a")
+            self.assertEqual(set(v.keys()), {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"})
+            self.assertEqual(v["dependencies"], ["b"])
+            # detached
+            v["payload"]["x"] = 999
+            self.assertEqual(q.get("a")["payload"], {"x": 1})
+
+    def test_get_validates(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get(True)
+
+
+class SubmitAtomicityTests(unittest.TestCase):
+    def test_rollback_on_invalid_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "ok"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": "bad", "priority": "x"}])
+            self.assertEqual(q.list(), before)
+            self.assertIsNone(q.get("good"))
+
+    def test_duplicate_unknown_self_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_idempotent_noop_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # same orig spec still no-op even though state changed, returns current view
+            views = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # conflict rejects whole batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            # batch with conflict rolls back other inserts
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "newbie"}, {"id": "a", "priority": 999}])
+            self.assertIsNone(q.get("newbie"))
+
+
+class OrderingLeaseTests(unittest.TestCase):
+    def test_priority_order_and_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "low", "priority": 1}, {"id": "high", "priority": 10}, {"id": "mid", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            q.complete("high", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "mid")
+
+    def test_recover_resets_ready(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["lease_until"], 10)
+            # not expired yet
+            self.assertEqual(q.recover(9), [])
+            ids = q.recover(10)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 10)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # repeated no-op
+            self.assertEqual(q.recover(10), [])
+
+    def test_stale_and_owner_reject(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w1", 0, 10)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c["attempts"] + 1, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c["attempts"], 10)
+            # db unchanged
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
+
+    def test_bounded_retry_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = tmp_queue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c["attempts"], 1, retry_delay=5)
+            self.assertEqual(v["state"], "failed")
+            self.assertIsNone(q.claim("w", 6, 10))
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            # retry path
+            with tempfile.TemporaryDirectory() as tmp2:
+                q2 = tmp_queue(tmp2)
+                q2.submit([{"id": "b", "max_attempts": 2}])
+                c1 = q2.claim("w", 0, 10)
+                v1 = q2.fail("b", "w", c1["attempts"], 1, retry_delay=5)
+                self.assertEqual(v1["state"], "pending")
+                self.assertEqual(v1["ready_at"], 6)
+                self.assertIsNone(q2.claim("w", 5, 10))
+                c2 = q2.claim("w", 6, 10)
+                self.assertEqual(c2["id"], "b")
+
+
+class SubprocessTests(unittest.TestCase):
+    def test_claim_exclusivity_across_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            Queue(db).submit([{"id": "only"}])
+            code = (
+                "import sys; from durable_queue import Queue; "
+                "q=Queue(sys.argv[1]); v=q.claim(sys.argv[2], 0, 10); "
+                "print('CLAIMED' if v else 'NONE')"
+            )
+            p1 = subprocess.run([sys.executable, "-c", code, db, "w1"], capture_output=True, text=True)
+            p2 = subprocess.run([sys.executable, "-c", code, db, "w2"], capture_output=True, text=True)
+            outs = sorted([p1.stdout.strip(), p2.stdout.strip()])
+            self.assertEqual(outs, ["CLAIMED", "NONE"])
+
+    def test_cli_durability(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            req = str(Path(tmp) / "req.json")
+            Path(req).write_text(json.dumps({"op": "submit", "jobs": [{"id": "a"}]}), encoding="utf-8")
+            r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", req], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0)
+            self.assertTrue(r.stdout.endswith("\n"))
+            # bad request exits 2 empty stdout
+            bad = str(Path(tmp) / "bad.json")
+            Path(bad).write_text(json.dumps({"op": "submit", "jobs": [{"id": ""}]}), encoding="utf-8")
+            r2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", bad], capture_output=True, text=True)
+            self.assertEqual(r2.returncode, 2)
+            self.assertEqual(r2.stdout, "")
+            # prior work survives
+            self.assertEqual(Queue(db).get("a")["id"], "a")
+
+
+if __name__ == "__main__":
+    unittest.main()
