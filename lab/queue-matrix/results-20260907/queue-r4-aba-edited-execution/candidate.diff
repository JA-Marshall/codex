+def _has_cycle(graph):
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {n: WHITE for n in graph}
+
+    def dfs(n, stack):
+        color[n] = GRAY
+        for m in graph.get(n, []):
+            if m not in color:
+                continue
+            if color[m] == GRAY:
+                return True
+            if color[m] == WHITE:
+                if dfs(m, stack):
+                    return True
+        color[n] = BLACK
+        return False
+
+    for n in graph:
+        if color[n] == WHITE:
+            if dfs(n, []):
+                return True
+    return False
