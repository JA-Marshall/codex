+            pass
+        # backfill orig from data where possible
+        try:
+            rows = conn.execute("SELECT id, data, orig FROM jobs").fetchall()
+            for jid, data, orig in rows:
+                if orig is not None:
+                    continue
+                try:
+                    view = json.loads(data)
+                    o = {
+                        "id": view.get("id", jid),
+                        "payload": view.get("payload", {}),
+                        "priority": view.get("priority", 0),
+                        "dependencies": sorted(set(view.get("dependencies", []))) if isinstance(view.get("dependencies", []), list) else [],
+                        "max_attempts": view.get("max_attempts", 3),
+                        "ready_at": view.get("ready_at", 0),
+                    }
+                    conn.execute("UPDATE jobs SET orig=? WHERE id=?", (json.dumps(o, sort_keys=True, ensure_ascii=False), jid))
+                except Exception:
+                    # remove corrupt row? keep as-is with empty orig to avoid NOT NULL issues
+                    try:
+                        conn.execute("UPDATE jobs SET orig=? WHERE id=?", ("{}", jid))
+                    except Exception:
+                        pass
+        except Exception:
+            pass
+    return conn
