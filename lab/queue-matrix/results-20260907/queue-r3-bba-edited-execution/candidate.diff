+"""Regression tests for durable_queue contract (TDD red->green).
+
+Covers: atomic submit/views, claims/transitions, persistence, leases,
+dependencies, bounded retries, rollback, stale rejection, subprocess
+durability and claim exclusivity. All DBs in temporary directories.
+"""
+import copy
+import json
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from durable_queue import Queue
+
+
+def _run_cli(db, payload, raw_bytes=None):
+    with tempfile.NamedTemporaryFile(mode="wb", suffix=".json", delete=False, dir=str(Path(db).parent)) as f:
+        if raw_bytes is not None:
+            f.write(raw_bytes)
+            req_path = f.name
+        else:
+            f.write(json.dumps(payload).encode("utf-8"))
+            req_path = f.name
+    try:
+        p = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req_path],
+            capture_output=True, text=True,
+        )
+        return p
+    finally:
+        try:
+            Path(req_path).unlink()
+        except Exception:
+            pass
+
+
+class SubmitViewsTests(unittest.TestCase):
+    def test_bool_is_not_int_and_invalid_batch_rolls_back(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "priority": True}, {"id": "c"}])
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+
+    def test_finite_json_and_unknown_fields(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            for bad in [{"v": float("nan")}, {"v": float("inf")}, {"v": float("-inf")}]:
+                with self.assertRaises(ValueError):
+                    q.submit([{"id": "a", "payload": bad}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"t": (1, 2)}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "extra": 1}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "", }])
+            self.assertEqual(q.list(), [])
+            q.submit([{"id": "ok", "payload": {"b": True, "i": 1, "f": 1.5}}])
+            self.assertEqual(q.get("ok")["payload"], {"b": True, "i": 1, "f": 1.5})
+
+    def test_deps_normalized_cycle_unknown_self_dup(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}, {"id": "b"}])
+            v = q.submit([{"id": "x", "dependencies": ["b", "a", "b"]}])
+            self.assertEqual(v[0]["dependencies"], ["a", "b"])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "s", "dependencies": ["s"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "u", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "p"}, {"id": "p"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "c1", "dependencies": ["c2"]}, {"id": "c2", "dependencies": ["c1"]}])
+            # DB unchanged except prior valid jobs
+            self.assertEqual(sorted(vv["id"] for vv in q.list()), ["a", "b", "x"])
+
+    def test_idempotent_exact_match_and_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            v = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(v[0]["state"], "running")
+            self.assertEqual(v[0]["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            # ready_at original match survives recovery change
+            q2 = Queue(Path(tmp) / "q2.db")
+            q2.submit([{"id": "k", "ready_at": 0}])
+            qc = q2.claim("w", 0, 5)
+            q2.recover(5)
+            self.assertEqual(q2.get("k")["ready_at"], 5)
+            vv = q2.submit([{"id": "k", "ready_at": 0}])
+            self.assertEqual(vv[0]["ready_at"], 5)
+            with self.assertRaises(ValueError):
+                q2.submit([{"id": "k", "ready_at": 5}])
+
+    def test_views_detached_no_mutation_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            inp = [{"id": "b"}, {"id": "a", "payload": {"x": 1}}]
+            orig = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, orig)
+            self.assertEqual([v["id"] for v in views], ["b", "a"])
+            self.assertEqual([v["id"] for v in q.list()], ["a", "b"])
+            v = q.get("a")
+            self.assertEqual(set(v.keys()), {"id", "payload", "priority", "dependencies", "max_attempts", "ready_at", "state", "attempts", "worker", "lease_until"})
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["attempts"], 0)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            views[0]["payload"] = {"evil": 1}
+            self.assertEqual(q.get("b")["payload"], {})
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+
+    def test_empty_submit(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            self.assertEqual(q.submit([]), [])
+            self.assertEqual(q.list(), [])
+
