+    try:
+        try:
+            with open(args.request, "r", encoding="utf-8") as stream:
+                content = stream.read()
+        except Exception as e:
+            print(f"error: {e}", file=sys.stderr)
+            return 2
+        try:
+            request = json.loads(content)
+        except Exception as e:
+            print(f"error: invalid json: {e}", file=sys.stderr)
+            return 2
+        if not isinstance(request, dict):
+            print("error: request must be object", file=sys.stderr)
+            return 2
+        if "op" not in request:
+            print("error: missing op", file=sys.stderr)
+            return 2
+        op = request["op"]
+        if not isinstance(op, str) or op not in _OPS:
+            print("error: unknown op", file=sys.stderr)
+            return 2
+        # No unknown fields (excluding op)
+        keys = set(request.keys()) - {"op"}
+        allowed = _ALLOWED_FIELDS[op]
+        required = _REQUIRED_FIELDS[op]
+        for k in keys:
+            if k not in allowed:
+                print(f"error: unknown field {k}", file=sys.stderr)
+                return 2
+        for k in required:
+            if k not in request:
+                print(f"error: missing field {k}", file=sys.stderr)
+                return 2
+        kwargs = {k: request[k] for k in keys}
+        # Open queue (unavailable database -> exit 2)
+        try:
+            queue = Queue(args.db)
+        except Exception as e:
+            print(f"error: unavailable database: {e}", file=sys.stderr)
+            return 2
+        try:
+            method = getattr(queue, op)
+            value = method(**kwargs)
+        except ValueError as e:
+            print(f"error: {e}", file=sys.stderr)
+            return 2
+        except TypeError as e:
+            # invalid usage (e.g., wrong arg types/count that isn't ValueError)
+            print(f"error: invalid usage: {e}", file=sys.stderr)
+            return 2
+        except Exception as e:
+            print(f"error: {e}", file=sys.stderr)
+            return 2
+        sys.stdout.write(json.dumps(value, sort_keys=True) + "\n")
+        return 0
+    except BrokenPipeError:
+        return 2
 
 
