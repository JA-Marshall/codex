+class ClaimTransitionTests(unittest.TestCase):
+    def test_priority_and_dep_gating(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 5}])
+            self.assertEqual(q.claim("w", 0, 10)["id"], "c")
+            q.complete("c", "w", 1, 1)
+            self.assertEqual(q.claim("w", 1, 10)["id"], "a")
+
+    def test_failed_dep_stays_pending(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "child", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "dep")
+            v = q.fail("dep", "w", c["attempts"], 1)
+            self.assertEqual(v["state"], "failed")
+            self.assertIsNone(q.claim("w", 1, 10))
+            self.assertEqual(q.get("child")["state"], "pending")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["lease_until"], 10)
+            self.assertEqual(q.recover(10), ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 10)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            self.assertEqual(q.recover(10), [])
+
+    def test_recover_failed_leaves_ready(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 1, "ready_at": 2}])
+            q.claim("w", 2, 5)
+            self.assertEqual(q.recover(7), ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "failed")
+            self.assertEqual(v["ready_at"], 2)
+
+    def test_bounded_retries_and_stale(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c1["attempts"], 5, retry_delay=3)
+            self.assertEqual(v["ready_at"], 8)
+            self.assertEqual(v["state"], "pending")
+            c2 = q.claim("w", 8, 10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a", "w", c2["attempts"], 9)
+            self.assertEqual(v2["state"], "failed")
+            # stale same-worker reclaim rejected
+            q2 = Queue(Path(tmp) / "q2.db")
+            q2.submit([{"id": "k"}])
+            a1 = q2.claim("w", 0, 5)["attempts"]
+            q2.recover(5)
+            q2.claim("w", 5, 10)
+            with self.assertRaises(ValueError):
+                q2.complete("k", "w", a1, 6)
+            self.assertEqual(q2.get("k")["attempts"], 2)
+
+    def test_invalid_leaves_db_unchanged_no_implicit_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            with self.assertRaises(ValueError):
+                q.claim("w", 10, 0)
+            self.assertEqual(q.get("a")["state"], "running")
+            with self.assertRaises(ValueError):
+                q.complete("a", "wrong", c["attempts"], 1)
+            self.assertEqual(q.get("a")["state"], "running")
+            # get/list do not recover
+            self.assertEqual(q.get("a")["state"], "running")
+            self.assertEqual(q.list()[0]["state"], "running")
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 5)
+            self.assertEqual(q.get("a")["state"], "running")
+
+    def test_terminal_rejection(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            q.complete("a", "w", c["attempts"], 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", c["attempts"], 2)
+            self.assertIsNone(q.claim("w", 2, 10))
