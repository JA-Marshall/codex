+"""S1 focused regression: strict submit validation, atomicity, idempotency, detached views."""
+import copy
+import tempfile
+import unittest
+from pathlib import Path
+from durable_queue import Queue
+
+def mkqueue(tmp):
+    return Queue(Path(tmp) / "q.db")
+
+class S1SubmitTests(unittest.TestCase):
+    def test_bool_int_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "ready_at": True}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "priority": False}])
+            self.assertEqual(q.list(), [])
+
+    def test_unknown_field_and_atomic_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "ok"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": "bad", "unknown": 1}])
+            self.assertEqual([v["id"] for v in q.list()], ["ok"])
+
+    def test_idempotent_same_spec(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            v1 = q.submit([{"id": "a", "payload": {"x": 1}}])
+            v2 = q.submit([{"id": "a", "payload": {"x": 1}}])
+            self.assertEqual(v1, v2)
+            self.assertEqual(len(q.list()), 1)
+
+    def test_conflict_rejects_batch(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "payload": {"x": 1}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": 2}}, {"id": "b"}])
+            self.assertEqual([v["id"] for v in q.list()], ["a"])
+
+    def test_no_mutate_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            # caller input not mutated; deps normalized sorted-unique
+            q = Queue(Path(tmp) / "q.db")
+            orig2 = {"id": "x", "payload": {"y": 1}}
+            snap2 = copy.deepcopy(orig2)
+            q.submit([orig2])
+            self.assertEqual(orig2, snap2)
+            v = q.get("x")
+            v["payload"]["y"] = 999
+            self.assertEqual(q.get("x")["payload"], {"y": 1})
+            # deps normalization
+            q2 = Queue(Path(tmp) / "q2.db")
+            views = q2.submit([{"id": "a", "dependencies": ["b", "b", "c"]}, {"id": "b"}, {"id": "c"}])
+            # input order preserved, deps sorted unique
+            self.assertEqual(views[0]["dependencies"], ["b", "c"])
+
+if __name__ == "__main__":
+    unittest.main()
+
+class S2ClaimRecoverTests(unittest.TestCase):
+    def test_claim_priority_order(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 10}, {"id": "mid", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")
+            self.assertEqual(c["state"], "running")
+            self.assertEqual(c["attempts"], 1)
+
+    def test_claim_recovers_expired_first(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c1 = q.claim("w1", 0, 5)
+            self.assertEqual(c1["id"], "a")
+            # advance past lease; next claim should recover a then claim b? a becomes pending with ready_at=5, now=5 eligible too; priority tie -> smallest id a again
+            c2 = q.claim("w2", 5, 5)
+            # a recovered (ready_at=5) and both eligible; a smallest id wins
+            self.assertEqual(c2["id"], "a")
+            self.assertEqual(c2["worker"], "w2")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 5)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "failed")
+            # repeated recovery no-op
+            self.assertEqual(q.recover(5), [])
+
+class S3CompleteFailTests(unittest.TestCase):
+    def test_complete_success(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            v = q.complete("a", "w", c["attempts"], 5)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+
+    def test_stale_attempt_rejected_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            # expire and reclaim by other worker
+            c2 = q.claim("w2", 5, 10)
+            self.assertEqual(c2["worker"], "w2")
+            # old attempt must be rejected even with same worker? here different worker
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c1["attempts"], 6)
+            # state still running owned by w2
+            cur = q.get("a")
+            self.assertEqual(cur["worker"], "w2")
+            self.assertEqual(cur["state"], "running")
+
+    def test_fail_retry_and_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c1 = q.claim("w", 0, 10)
+            v = q.fail("a", "w", c1["attempts"], 5, retry_delay=3)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 8)
+            c2 = q.claim("w", 8, 10)
+            self.assertIsNotNone(c2)
+            v2 = q.fail("a", "w", c2["attempts"], 9)
+            self.assertEqual(v2["state"], "failed")
+            # terminal cannot be claimed
+            self.assertIsNone(q.claim("w", 9, 10))
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", v2["attempts"], 9)
+
+    def test_expired_complete_no_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}, {"id": "b"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "a")
+            # now=5 lease expired; complete should fail without recovering
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", c["attempts"], 5)
+            # still running with expired lease (not auto-recovered)
+            cur = q.get("a")
+            self.assertEqual(cur["state"], "running")
+
