+    # path may be Path-like; sqlite3 accepts str or path-like
+    connection = sqlite3.connect(str(path), timeout=30.0, isolation_level=None)
+    # Durability / concurrency settings
+    try:
+        connection.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA synchronous=NORMAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA busy_timeout=30000;")
+    except Exception:
+        pass
+    _ensure_schema(connection)
+    return connection
+
+def _ensure_schema(connection):
+    # Detect existing schema
+    rows = list(connection.execute("PRAGMA table_info(jobs)").fetchall())
+    if not rows:
+        connection.execute(
+            "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, spec TEXT NOT NULL, data TEXT NOT NULL)"
+        )
+        return
+    cols = {r[1] for r in rows}
+    if cols == {"id", "data"}:
+        # Migrate legacy single-blob table: data holds view JSON
+        import json
+        old = list(connection.execute("SELECT id, data FROM jobs").fetchall())
+        connection.execute("DROP TABLE jobs")
+        connection.execute(
+            "CREATE TABLE jobs (id TEXT PRIMARY KEY, spec TEXT NOT NULL, data TEXT NOT NULL)"
+        )
+        for oid, odata in old:
+            try:
+                view = json.loads(odata)
+            except Exception:
+                continue
+            try:
+                spec = {
+                    "id": view.get("id", oid),
+                    "payload": view.get("payload", {}),
+                    "priority": view.get("priority", 0),
+                    "dependencies": sorted(set(view.get("dependencies", []))),
+                    "max_attempts": view.get("max_attempts", 3),
+                    "ready_at": view.get("ready_at", 0),
+                }
+                spec_json = json.dumps(spec, sort_keys=True, separators=(",", ":"), allow_nan=False, ensure_ascii=False)
+                # ensure view has full keys; keep as-is if plausible
+                data_json = json.dumps(view, sort_keys=True, separators=(",", ":"), allow_nan=False, ensure_ascii=False)
+            except Exception:
+                continue
+            connection.execute("INSERT INTO jobs (id, spec, data) VALUES (?, ?, ?)", (oid, spec_json, data_json))
