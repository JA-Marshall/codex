+def _has_cycle(nodes, edges):
+    # nodes: set of ids, edges: dict id -> list of deps (within nodes)
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {n: WHITE for n in nodes}
+
+    def visit(start):
+        stack = [(start, 0)]
+        while stack:
+            node, idx = stack[-1]
+            if color[node] == WHITE:
+                color[node] = GRAY
+            deps = edges.get(node, [])
+            advanced = False
+            for i in range(idx, len(deps)):
+                dep = deps[i]
+                if dep not in nodes:
+                    continue
+                if color.get(dep) == GRAY:
+                    return True
+                if color.get(dep) == WHITE:
+                    stack[-1] = (node, i + 1)
+                    stack.append((dep, 0))
+                    advanced = True
+                    break
+            if not advanced:
+                color[node] = BLACK
+                stack.pop()
+        return False
+
+    for n in nodes:
+        if color[n] == WHITE:
+            if visit(n):
+                return True
+    return False
+
