+"""Durable SQLite storage with WAL and explicit transactions."""
+import json
 import sqlite3
 
 
 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
+    connection = sqlite3.connect(str(path), timeout=5.0, isolation_level=None)
+    # Durability / concurrency settings.
+    try:
+        connection.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA busy_timeout=5000;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA synchronous=NORMAL;")
+    except Exception:
+        pass
     connection.execute(
-        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
+        "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL, orig TEXT)"
     )
+    # Migrate legacy table without orig column.
+    cols = [row[1] for row in connection.execute("PRAGMA table_info(jobs)").fetchall()]
+    if "orig" not in cols:
+        connection.execute("ALTER TABLE jobs ADD COLUMN orig TEXT")
+    # Backfill missing orig from stored views (legacy pending jobs).
+    rows = connection.execute("SELECT id, data FROM jobs WHERE orig IS NULL").fetchall()
+    for job_id, data in rows:
+        try:
+            view = json.loads(data)
+        except Exception:
+            continue
+        spec = {
+            "id": view.get("id", job_id),
+            "payload": view.get("payload", {}),
+            "priority": view.get("priority", 0),
+            "dependencies": sorted(set(view.get("dependencies", []))),
+            "max_attempts": view.get("max_attempts", 3),
+            "ready_at": view.get("ready_at", 0),
+        }
+        connection.execute(
+            "UPDATE jobs SET orig=? WHERE id=?",
+            (json.dumps(spec, sort_keys=True, allow_nan=False), job_id),
+        )
     return connection
