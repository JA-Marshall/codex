+                try:
+                    conn.execute("ROLLBACK")
+                except Exception:
+                    pass
+                raise
+            except Exception as exc:
+                try:
+                    conn.execute("ROLLBACK")
+                except Exception:
+                    pass
+                if isinstance(exc, ValueError):
+                    raise
+                raise ValueError(str(exc)) from exc
+        finally:
+            try:
+                conn.close()
+            except Exception:
+                pass
