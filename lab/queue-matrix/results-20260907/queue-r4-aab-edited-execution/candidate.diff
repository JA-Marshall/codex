+            _fail("unavailable db")
+        try:
+            method = getattr(queue, op)
+        except Exception:
+            _fail("unknown op")
+        try:
+            value = method(**kwargs)
+        except TypeError as exc:
+            _fail("invalid args")
+        except ValueError as exc:
+            _fail("invalid request")
+        except Exception as exc:
+            _fail("operation failed")
+        try:
+            out = json.dumps(value, sort_keys=True, allow_nan=False)
