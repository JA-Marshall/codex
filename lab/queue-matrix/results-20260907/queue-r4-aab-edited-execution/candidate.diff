+        with open(args.request, "rb") as stream:
+            raw = stream.read()
+        try:
+            text = raw.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            _fail("invalid utf-8")
+        try:
+            request = json.loads(text)
