+class SubmitValidationTests(unittest.TestCase):
+    def test_invalid_batch_leaves_zero_writes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "b", "priority": True}])
+            self.assertEqual(q.list(), [])
+            # no implicit recovery side effect check: single valid job still pending
+            q.submit([{"id": "ok"}])
+            self.assertEqual(len(q.list()), 1)
+
+    def test_unknown_field_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "bogus": 1}])
+            self.assertEqual(q.list(), [])
+
+    def test_bool_is_not_int(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            for bad in [{"id": "a", "priority": True}, {"id": "a", "max_attempts": False},
+                        {"id": "a", "ready_at": True}, {"id": "a", "payload": {"x": float("nan")}}]:
+                with self.assertRaises(ValueError, msg=str(bad)):
+                    q.submit([bad])
+            self.assertEqual(q.list(), [])
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            with self.assertRaises(ValueError):
+                q.recover(True)
+            with self.assertRaises(ValueError):
+                q.fail("x", "w", 1, 0, retry_delay=True)
+
+    def test_duplicate_unknown_self_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a"}, {"id": "a"}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["missing"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["c"]}, {"id": "c", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_non_finite_payload_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": {"x": float("inf")}}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": [float("nan")]}])
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "payload": "not-dict"}])
+            self.assertEqual(q.list(), [])
+
+    def test_do_not_mutate_caller(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            inp = [{"id": "a", "dependencies": ["b", "b", "c"], "payload": {"x": [1, 2]}} , {"id": "b"}, {"id": "c"}]
+            orig = copy.deepcopy(inp)
+            q.submit(inp)
+            self.assertEqual(inp, orig)
+
+    def test_sorted_unique_deps_and_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            views = q.submit([{"id": "b"}, {"id": "a", "dependencies": ["b", "b"]}])
+            self.assertEqual(views[1]["dependencies"], ["b"])
+            v = q.get("a")
+            v["payload"]["x"] = 1
+            v["dependencies"].append("evil")
+            v2 = q.get("a")
+            self.assertNotIn("x", v2["payload"])
+            self.assertEqual(v2["dependencies"], ["b"])
+
+    def test_idempotent_spec_match_even_after_state_change(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a", "priority": 5}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "a")
+            # resubmit same original spec should be no-op returning current view
+            views = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(views[0]["state"], "running")
+            self.assertEqual(views[0]["attempts"], 1)
+            # conflicting spec rejects
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            # fail to change ready_at, then idempotent still ok
+            q.fail("a", "w", 1, 1, retry_delay=5)
+            self.assertEqual(q.get("a")["ready_at"], 6)
+            views2 = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(views2[0]["ready_at"], 6)
+
+    def test_submit_returns_input_order_list_sorted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            views = q.submit([{"id": "z"}, {"id": "a"}])
+            self.assertEqual([v["id"] for v in views], ["z", "a"])
+            self.assertEqual([v["id"] for v in q.list()], ["a", "z"])
+
+    def test_get_validates(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            with self.assertRaises(ValueError):
+                q.get("")
+            with self.assertRaises(ValueError):
+                q.get(123)
+            with self.assertRaises(ValueError):
+                q.get(None)
