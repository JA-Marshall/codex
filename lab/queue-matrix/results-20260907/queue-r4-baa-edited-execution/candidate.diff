+class CliTests(unittest.TestCase):
+    def _run_cli(self, db, req_obj=None, raw=None, request_file=None):
+        with tempfile.TemporaryDirectory() as tmp2:
+            if request_file is None:
+                req_path = Path(tmp2) / "req.json"
+                if raw is not None:
+                    req_path.write_bytes(raw)
+                else:
+                    req_path.write_text(json.dumps(req_obj), encoding="utf-8")
+            else:
+                req_path = request_file
+            proc = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(req_path)],
+                                  capture_output=True, cwd=Path(__file__).resolve().parent.parent)
+            return proc
+
+    def test_cli_success_sorted_keys(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            proc = self._run_cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(proc.returncode, 0)
+            self.assertTrue(proc.stdout.endswith(b"\n"))
+            val = json.loads(proc.stdout.decode())
+            self.assertEqual(val[0]["id"], "a")
+            # sorted keys: check raw output has sorted keys
+            raw = proc.stdout.decode().strip()
+            # json dumps sorted keys -> first key alphabetically should appear first
+            self.assertIn('"attempts"', raw)
+
+    def test_cli_failures_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = _db(tmp)
+            # unknown op
+            p = self._run_cli(db, {"op": "bogus"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # unknown field
+            p = self._run_cli(db, {"op": "list", "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(Path(tmp)/"nope.json")], capture_output=True, cwd=Path(__file__).resolve().parent.parent)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # malformed json
+            p = self._run_cli(db, raw=b"{not json")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # non-object
+            p = self._run_cli(db, raw=b"[]")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # invalid utf-8
+            p = self._run_cli(db, raw=b"\xff\xfe")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+            # api ValueError -> exit 2
+            p = self._run_cli(db, {"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, b"")
+
+    def test_cli_missing_required(self):
