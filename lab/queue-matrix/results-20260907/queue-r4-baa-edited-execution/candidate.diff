+class ProcessTests(unittest.TestCase):
+    def test_separate_process_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            Queue(str(db)).submit([{"id": "a"}, {"id": "b"}])
+            repo = Path(__file__).resolve().parent.parent
+            def claim_req(worker):
+                d = tempfile.mkdtemp()
+                p = Path(d) / "req.json"
+                p.write_text(json.dumps({"op": "claim", "worker": worker, "now": 0, "lease_seconds": 30}), encoding="utf-8")
+                return str(p)
+            r1 = claim_req("w1")
+            r2 = claim_req("w2")
+            p1 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", r1], capture_output=True, cwd=repo)
+            p2 = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", r2], capture_output=True, cwd=repo)
+            self.assertEqual(p1.returncode, 0)
+            self.assertEqual(p2.returncode, 0)
+            v1 = json.loads(p1.stdout.decode())
+            v2 = json.loads(p2.stdout.decode())
+            self.assertIsNotNone(v1)
+            self.assertIsNotNone(v2)
+            self.assertNotEqual(v1["id"], v2["id"])
+
+    def test_durability_across_restart(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = Path(tmp) / "q.db"
+            Queue(str(db)).submit([{"id": "a", "payload": {"x": 1}}])
+            # simulate kill-restart: new process via CLI list
+            repo = Path(__file__).resolve().parent.parent
+            with tempfile.TemporaryDirectory() as t2:
+                rp = Path(t2) / "req.json"
+                rp.write_text(json.dumps({"op": "list"}), encoding="utf-8")
+                proc = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(rp)], capture_output=True, cwd=repo)
+                self.assertEqual(proc.returncode, 0)
+                val = json.loads(proc.stdout.decode())
+                self.assertEqual(len(val), 1)
+                self.assertEqual(val[0]["payload"], {"x": 1})
+            # API reopen
+            self.assertEqual(Queue(str(db)).get("a")["payload"], {"x": 1})
+
+
+if __name__ == "__main__":
+    unittest.main()
