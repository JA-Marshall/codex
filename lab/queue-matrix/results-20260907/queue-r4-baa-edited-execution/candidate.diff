+class ClaimRecoverTests(unittest.TestCase):
+    def test_ordering_priority_then_id(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 9}])
+            self.assertEqual(q.claim("w", 0, 10)["id"], "c")
+            q.complete("c", "w", 1, 1)
+            self.assertEqual(q.claim("w", 1, 10)["id"], "a")
+
+    def test_ready_and_attempts_eligibility(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "future", "ready_at": 10}])
+            self.assertIsNone(q.claim("w", 0, 10))
+            self.assertEqual(q.claim("w", 10, 10)["id"], "future")
+
+    def test_dependency_failed_stays_pending(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "main", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "dep")
+            q.fail("dep", "w", 1, 1)
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertIsNone(q.claim("w", 1, 10))
+            self.assertEqual(q.get("main")["state"], "pending")
+
+    def test_recover_semantics(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["lease_until"], 10)
+            # not expired yet
+            self.assertEqual(q.recover(9), [])
+            # expired
+            self.assertEqual(q.recover(10), ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 10)
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            # repeated no-op
+            self.assertEqual(q.recover(10), [])
+            # attempts not incremented
+            self.assertEqual(v["attempts"], 1)
+
+    def test_recover_failed_when_exhausted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a", "max_attempts": 1}])
+            q.claim("w", 0, 5)
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual(v["state"], "failed")
+            # ready_at unchanged (was 0)
+            self.assertEqual(v["ready_at"], 0)
+
+    def test_claim_recovers_implicitly(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a"}, {"id": "b"}])
+            q.claim("w1", 0, 5)
+            # a claimed (lexicographically smallest among equal priority? a first)
+            # expire at 5, claim at 5 should recover then claim
+            c = q.claim("w2", 5, 10)
+            # recovered a becomes pending with ready_at=5, eligible; b pending ready 0
+            # priority equal, smallest id first: a
+            self.assertEqual(c["id"], "a")
+            self.assertEqual(c["worker"], "w2")
+            self.assertEqual(c["attempts"], 2)
+
+    def test_invalid_claim_leaves_no_recovery(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a"}])
+            q.claim("w", 0, 5)
+            with self.assertRaises(ValueError):
+                q.claim("", 5, 10)
+            # recovery should not have happened
+            v = q.get("a")
+            self.assertEqual(v["state"], "running")
+            self.assertEqual(v["worker"], "w")
+
