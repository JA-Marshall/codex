+class CompleteFailTests(unittest.TestCase):
+    def test_stale_wrong_expired_terminal(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 10)
+            # wrong worker
+            with self.assertRaises(ValueError):
+                q.complete("a", "other", 1, 1)
+            # stale attempt
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 999, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 10)
+            # unknown
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            # no writes on failure
+            self.assertEqual(q.get("a")["state"], "running")
+            # success
+            v = q.complete("a", "w", 1, 1)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            # terminal cannot complete again
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 2)
+
+    def test_old_attempt_rejected_after_reclaim(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w", 0, 5)
+            self.assertEqual(c1["attempts"], 1)
+            # expire and reclaim with same worker
+            q.recover(5)
+            c2 = q.claim("w", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            v = q.complete("a", "w", 2, 6)
+            self.assertEqual(v["state"], "succeeded")
+
+    def test_fail_retry_and_exhaust(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", 1, 2, retry_delay=5)
+            self.assertEqual(v["state"], "pending")
+            self.assertEqual(v["ready_at"], 7)
+            self.assertIsNone(v["worker"])
+            c2 = q.claim("w", 7, 10)
+            self.assertEqual(c2["attempts"], 2)
+            v2 = q.fail("a", "w", 2, 8)
+            self.assertEqual(v2["state"], "failed")
+            self.assertEqual(v2["ready_at"], 7)
+
+    def test_complete_leaves_ready_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(_db(tmp))
+            q.submit([{"id": "a", "ready_at": 3}])
+            c = q.claim("w", 3, 10)
+            v = q.complete("a", "w", 1, 4)
+            self.assertEqual(v["ready_at"], 3)
