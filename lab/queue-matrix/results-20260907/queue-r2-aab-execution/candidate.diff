+"""Separate-process durability and exclusivity via subprocess + CLI."""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+def run_cli(db, req_obj=None, raw_text=None, raw_bytes=None):
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+        req_path = f.name
+        if raw_bytes is not None:
+            pass
+        elif raw_text is not None:
+            f.write(raw_text)
+        else:
+            json.dump(req_obj, f)
+    # if raw_bytes, overwrite
+    if raw_bytes is not None:
+        with open(req_path, "wb") as bf:
+            bf.write(raw_bytes)
+    try:
+        p = subprocess.run(
+            [sys.executable, "-m", "durable_queue", "--db", str(db), "--request", req_path],
+            capture_output=True,
+        )
+        return p
+    finally:
+        try:
+            os.unlink(req_path)
+        except Exception:
+            pass
+
+
+def write_req(path, obj):
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(obj, f)
+    return path
+
+
+def cli(db, obj):
+    # helper using temp request file
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False, encoding="utf-8") as f:
+        json.dump(obj, f)
+        rp = f.name
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", rp], capture_output=True, text=True)
+        return p
+    finally:
+        os.unlink(rp)
+
+
+class ProcessDurabilityTests(unittest.TestCase):
+    def test_reopen_durability_via_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = cli(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"x": 1}}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            self.assertTrue(p.stdout.endswith("\n"))
+            # fresh process get
+            p2 = cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p2.returncode, 0)
+            val = json.loads(p2.stdout)
+            self.assertEqual(val["payload"], {"x": 1})
+            # fresh process list survives
+            p3 = cli(db, {"op": "list"})
+            self.assertEqual(p3.returncode, 0)
+            vals = json.loads(p3.stdout)
+            self.assertEqual(len(vals), 1)
+
+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = cli(db, {"op": "submit", "jobs": [{"id": "only"}]})
+            self.assertEqual(p.returncode, 0)
+            c1 = cli(db, {"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 10})
+            self.assertEqual(c1.returncode, 0)
+            v1 = json.loads(c1.stdout)
+            self.assertEqual(v1["id"], "only")
+            # second separate process must not get same lease
+            c2 = cli(db, {"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 10})
+            self.assertEqual(c2.returncode, 0)
+            v2 = json.loads(c2.stdout)
+            self.assertIsNone(v2)
+
+    def test_cli_success_sorted_keys_newline(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p.returncode, 0)
+            out = p.stdout
+            self.assertTrue(out.endswith("\n"))
+            self.assertEqual(out.count("\n"), 1)
+            # sorted keys: json dumps sort_keys, verify by loading and re-dumping
+            val = json.loads(out)
+            self.assertEqual(out, json.dumps(val, sort_keys=True) + "\n")
+
+    def test_cli_errors_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # unknown op
+            p = cli(db, {"op": "nope"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unknown field
+            p = cli(db, {"op": "list", "extra": 1})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # malformed JSON
+            p = run_cli(db, raw_text="{not json")
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout.decode() if isinstance(p.stdout, bytes) else p.stdout, "")
+            # non-object
+            p = cli(db, ["list"])
+            # cli helper dumps list; server should exit 2
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # invalid UTF-8
+            p = run_cli(db, raw_bytes=b"\xff\xfe")
+            self.assertEqual(p.returncode, 2)
+            out = p.stdout.decode() if isinstance(p.stdout, bytes) else p.stdout
+            self.assertEqual(out, "")
+            # missing file
+            p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(Path(tmp)/"missing.json")], capture_output=True, text=True)
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # API ValueError -> exit 2 empty stdout
+            p = cli(db, {"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+            # unavailable database (directory as db)
+            p = cli(str(Path(tmp)), {"op": "list"})
+            self.assertEqual(p.returncode, 2)
+            self.assertEqual(p.stdout, "")
+
+    def test_prior_work_survives_failures(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = cli(db, {"op": "submit", "jobs": [{"id": "keep"}]})
+            self.assertEqual(p.returncode, 0)
+            # failing request
+            p2 = cli(db, {"op": "submit", "jobs": [{"id": ""}]})
+            self.assertEqual(p2.returncode, 2)
+            # prior work still there in fresh process
+            p3 = cli(db, {"op": "get", "id": "keep"})
+            self.assertEqual(p3.returncode, 0)
+            self.assertEqual(json.loads(p3.stdout)["id"], "keep")
+
+
+if __name__ == "__main__":
+    unittest.main()
