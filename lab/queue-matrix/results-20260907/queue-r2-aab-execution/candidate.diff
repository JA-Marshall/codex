+            # ready_at unchanged
+        conn.execute("UPDATE jobs SET data=? WHERE id=?",
+                     (json.dumps(view, sort_keys=True, separators=(",", ":")), jid))
+        recovered.append(jid)
+    recovered.sort()
+    return recovered
