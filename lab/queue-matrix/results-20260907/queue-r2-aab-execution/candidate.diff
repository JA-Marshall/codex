+def _has_cycle(graph):
+    # graph: id -> list of deps (all deps are nodes in graph if valid)
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {n: WHITE for n in graph}
+
+    def visit(u, stack):
+        color[u] = GRAY
+        for w in graph.get(u, []):
+            if w not in color:
+                continue
+            if color[w] == GRAY:
+                return True
+            if color[w] == WHITE:
+                if visit(w, stack):
+                    return True
+        color[u] = BLACK
+        return False
+
+    for n in graph:
+        if color[n] == WHITE:
+            if visit(n, []):
+                return True
+    return False
