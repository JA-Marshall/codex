+    def test_stale_and_owner_and_expiry(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c1 = q.claim("w1", 0, 5)
+            # wrong owner
+            with self.assertRaises(ValueError):
+                q.complete("a", "w2", c1["attempts"], 1)
+            # stale attempt number
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 999, 1)
+            # expired
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", c1["attempts"], 5)
+            # state unchanged
+            self.assertEqual(q.get("a")["state"], "running")
+            # recover then reclaim with same worker, old attempt rejected
+            q.recover(5)
+            c2 = q.claim("w1", 5, 5)
+            self.assertEqual(c2["attempts"], 2)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w1", 1, 6)
+            # correct new attempt works
+            q.complete("a", "w1", 2, 6)
+            self.assertEqual(q.get("a")["state"], "succeeded")
+
+    def test_no_write_on_error(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = mkqueue(tmp)
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.complete("missing", "w", 1, 1)
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, True)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 1, retry_delay=-1)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 1, retry_delay=True)
+            self.assertEqual(q.list(), before)
+
