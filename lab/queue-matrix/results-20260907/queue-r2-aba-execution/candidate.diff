+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as e:
+        # argparse exits 2 on invalid usage; ensure stdout empty (it uses stderr)
+        raise
+    try:
+        with open(args.request, encoding="utf-8") as stream:
+            request = json.load(stream)
+        if not isinstance(request, dict):
+            raise ValueError("request must be object")
+        if "op" not in request:
+            raise ValueError("missing op")
+        op = request["op"]
+        if not isinstance(op, str) or op not in _ALLOWED_OPS:
+            raise ValueError("unknown op")
+        allowed = _ALLOWED_FIELDS[op]
+        required = _REQUIRED_FIELDS[op]
+        keys = set(request.keys()) - {"op"}
+        if not keys <= set(allowed):
+            raise ValueError("unknown field")
+        if not required <= keys:
+            raise ValueError("missing field")
+        # extra check: no duplicate? dict keys unique anyway
+        kwargs = {k: request[k] for k in keys}
+        try:
+            queue = Queue(args.db)
+        except Exception as e:
+            raise ValueError("unavailable database") from e
+        try:
+            method = getattr(queue, op)
+        except AttributeError as e:
+            raise ValueError("unknown op") from e
+        try:
+            value = method(**kwargs)
+        except ValueError:
+            raise
+        except TypeError as e:
+            raise ValueError("invalid args") from e
+        except Exception as e:
+            # sqlite errors / unavailable db -> exit 2
+            import sqlite3
+            if isinstance(e, sqlite3.Error) or isinstance(e, OSError):
+                raise ValueError("unavailable database") from e
+            raise ValueError(str(e)) from e
+        sys.stdout.write(json.dumps(value, sort_keys=True) + "\n")
+        return 0
+    except SystemExit:
+        raise
+    except ValueError as e:
+        # exit 2 with empty stdout; optionally stderr
+        try:
+            sys.stderr.write(f"error: {e}\n")
+        except Exception:
+            pass
+        return 2
+    except Exception as e:
+        try:
+            sys.stderr.write(f"error: {e}\n")
+        except Exception:
+            pass
+        return 2
 
 
