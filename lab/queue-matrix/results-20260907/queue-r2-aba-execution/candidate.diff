+"""SQLite storage with WAL and timeout for cross-process durability."""
 import sqlite3
 
 
 def connect(path):
-    connection = sqlite3.connect(path, timeout=5)
+    connection = sqlite3.connect(str(path), timeout=30.0, isolation_level=None)
+    try:
+        connection.execute("PRAGMA journal_mode=WAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA synchronous=NORMAL;")
+    except Exception:
+        pass
+    try:
+        connection.execute("PRAGMA busy_timeout=30000;")
+    except Exception:
+        pass
     connection.execute(
         "CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, data TEXT NOT NULL)"
     )
+    connection.execute(
+        "CREATE TABLE IF NOT EXISTS job_specs (id TEXT PRIMARY KEY, spec TEXT NOT NULL)"
+    )
     return connection
