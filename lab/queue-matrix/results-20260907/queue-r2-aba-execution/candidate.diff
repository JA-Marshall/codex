@@ -0,0 +1,69 @@
+"""Separate-process durability and claim exclusivity via CLI (TDD red for S4)."""
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+def cli(db, req):
+    req_file = Path(req["_tmp"]) / "req.json" if "_tmp" in req else None
+    # helper not used; direct calls below
+    pass
+
+def run_cli(db_path, payload):
+    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as f:
+        json.dump(payload, f)
+        fname = f.name
+    try:
+        p = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db_path), "--request", fname],
+                           capture_output=True, text=True, timeout=20)
+        return p
+    finally:
+        try:
+            Path(fname).unlink()
+        except Exception:
+            pass
+
+class ProcessTests(unittest.TestCase):
+    def test_reopen_durability_via_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a", "payload": {"x": 1}}]})
+            self.assertEqual(p.returncode, 0, p.stderr)
+            out = json.loads(p.stdout)
+            self.assertEqual(out[0]["id"], "a")
+            # fresh process get
+            p2 = run_cli(db, {"op": "get", "id": "a"})
+            self.assertEqual(p2.returncode, 0, p2.stderr)
+            self.assertEqual(json.loads(p2.stdout)["payload"], {"x": 1})
+
+    def test_two_process_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "only"}]})
+            self.assertEqual(p.returncode, 0)
+            c1 = run_cli(db, {"op": "claim", "worker": "w1", "now": 0, "lease_seconds": 30})
+            c2 = run_cli(db, {"op": "claim", "worker": "w2", "now": 0, "lease_seconds": 30})
+            self.assertEqual(c1.returncode, 0)
+            self.assertEqual(c2.returncode, 0)
+            v1 = json.loads(c1.stdout)
+            v2 = json.loads(c2.stdout)
+            # exactly one gets the job
+            got = [v for v in (v1, v2) if v is not None]
+            self.assertEqual(len(got), 1)
+
+    def test_cli_error_exit2_empty_stdout(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            p = run_cli(db, {"op": "submit", "jobs": [{"id": "a"}]})
+            self.assertEqual(p.returncode, 0)
+            bad = run_cli(db, {"op": "nope"})
+            self.assertEqual(bad.returncode, 2)
+            self.assertEqual(bad.stdout, "")
+            bad2 = run_cli(db, {"op": "claim", "worker": "", "now": 0, "lease_seconds": 10})
+            self.assertEqual(bad2.returncode, 2)
+            self.assertEqual(bad2.stdout, "")
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_regression.py b/tests/test_regression.py
