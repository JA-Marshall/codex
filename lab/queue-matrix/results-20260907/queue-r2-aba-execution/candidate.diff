@@ -0,0 +1,170 @@
+"""Regression tests for S1: storage and atomic submit/views (TDD red)."""
+import copy
+import tempfile
+import unittest
+from pathlib import Path
+from durable_queue import Queue
+
+class SubmitValidationTests(unittest.TestCase):
+    def _q(self, tmp):
+        return Queue(Path(tmp) / "queue.db")
+
+    def test_reject_bool_as_int_and_leave_unchanged(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "b", "priority": True}])
+            self.assertEqual(q.list(), before)
+
+    def test_atomic_batch_rollback_on_invalid(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "keep"}])
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": "bad", "priority": "high"}])
+            self.assertEqual(q.list(), before)
+            self.assertIsNone(q.get("good"))
+
+    def test_no_input_mutation_and_normalized_deps(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            inp = [{"id": "a", "dependencies": ["c", "b", "b"]}, {"id": "b"}, {"id": "c"}]
+            snapshot = copy.deepcopy(inp)
+            views = q.submit(inp)
+            self.assertEqual(inp, snapshot)
+            self.assertEqual(views[0]["dependencies"], ["b", "c"])
+
+    def test_cycle_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "dependencies": ["b"]}, {"id": "b", "dependencies": ["a"]}])
+            self.assertEqual(q.list(), [])
+
+    def test_idempotent_same_spec_vs_conflict(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            q.submit([{"id": "a", "priority": 5}])
+            # same spec idempotent
+            v = q.submit([{"id": "a", "priority": 5}])
+            self.assertEqual(v[0]["priority"], 5)
+            self.assertEqual(len(q.list()), 1)
+            # conflict rejects batch
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "a", "priority": 6}])
+            self.assertEqual(q.get("a")["priority"], 5)
+
+    def test_finite_json_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "x", "payload": {"v": float("nan")}}])
+            self.assertEqual(q.list(), [])
+
+    def test_view_exact_keys_detached(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = self._q(tmp)
+            v = q.submit([{"id": "a"}])[0]
+            self.assertEqual(set(v.keys()), {"id","payload","priority","dependencies","max_attempts","ready_at","state","attempts","worker","lease_until"})
+            v["payload"]["x"] = 1
+            self.assertEqual(q.get("a")["payload"], {})
+
+if __name__ == "__main__":
+    unittest.main()
+
+class ClaimRecoverTests(unittest.TestCase):
+    def test_claim_priority_lex_and_validation_no_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "queue.db")
+            q.submit([{"id": "b", "priority": 1}, {"id": "a", "priority": 1}, {"id": "c", "priority": 5, "ready_at": 10}])
+            # invalid claim leaves DB unchanged
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.claim("", 0, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", True, 10)
+            with self.assertRaises(ValueError):
+                q.claim("w", 0, True)
+            self.assertEqual(q.list(), before)
+            c = q.claim("w1", 0, 10)
+            self.assertEqual(c["id"], "a")
+            self.assertEqual((c["state"], c["attempts"], c["worker"], c["lease_until"]), ("running", 1, "w1", 10))
+
+    def test_recover_expired_sets_ready_at(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "queue.db")
+            q.submit([{"id": "a"}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(q.recover(4), [])
+            ids = q.recover(5)
+            self.assertEqual(ids, ["a"])
+            v = q.get("a")
+            self.assertEqual((v["state"], v["ready_at"], v["worker"], v["lease_until"]), ("pending", 5, None, None))
+            self.assertEqual(v["attempts"], 1)
+            self.assertEqual(q.recover(5), [])
+
+    def test_failed_dependency_ineligible(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "queue.db")
+            q.submit([{"id": "dep", "max_attempts": 1}, {"id": "main", "dependencies": ["dep"]}])
+            c = q.claim("w", 0, 5)
+            self.assertEqual(c["id"], "dep")
+            # expire: attempts(1) >= max(1) -> failed
+            self.assertEqual(q.recover(5), ["dep"])
+            self.assertEqual(q.get("dep")["state"], "failed")
+            self.assertIsNone(q.claim("w", 5, 10))
+            self.assertEqual(q.get("main")["state"], "pending")
+
+class CompleteFailTests(unittest.TestCase):
+    def test_complete_and_fail_retry(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "queue.db")
+            q.submit([{"id": "a", "max_attempts": 2}])
+            c = q.claim("w", 0, 10)
+            v = q.complete("a", "w", c["attempts"], 1)
+            self.assertEqual(v["state"], "succeeded")
+            self.assertIsNone(v["worker"])
+            self.assertIsNone(v["lease_until"])
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 2)
+
+    def test_stale_attempt_rejected_and_retry_delay(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "queue.db")
+            q.submit([{"id": "a", "max_attempts": 3}])
+            c1 = q.claim("w", 0, 5)
+            self.assertEqual(c1["attempts"], 1)
+            # expire and reclaim
+            q.recover(5)
+            c2 = q.claim("w", 5, 10)
+            self.assertEqual(c2["attempts"], 2)
+            before = q.get("a")
+            with self.assertRaises(ValueError):
+                q.complete("a", "w", 1, 6)
+            self.assertEqual(q.get("a"), before)
+            # fail with retry_delay
+            v = q.fail("a", "w", 2, 6, 4)
+            self.assertEqual((v["state"], v["ready_at"]), ("pending", 10))
+            self.assertIsNone(q.claim("w", 9, 10))
+            c3 = q.claim("w", 10, 10)
+            self.assertEqual(c3["id"], "a")
+
+    def test_fail_exhaustion_and_no_write_on_error(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "queue.db")
+            q.submit([{"id": "a", "max_attempts": 1}])
+            c = q.claim("w", 0, 10)
+            v = q.fail("a", "w", 1, 1, 5)
+            self.assertEqual(v["state"], "failed")
+            self.assertEqual(v["ready_at"], 0)
+            before = q.list()
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 2, 0)
+            with self.assertRaises(ValueError):
+                q.complete("nope", "w", 1, 2)
+            with self.assertRaises(ValueError):
+                q.fail("a", "w", 1, 2, True)
+            self.assertEqual(q.list(), before)
