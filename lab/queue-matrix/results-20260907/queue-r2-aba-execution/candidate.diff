+def _strict_json_equal(a, b):
+    # bool/int/float are distinct types
+    if isinstance(a, bool) or isinstance(b, bool):
+        return type(a) is type(b) and a == b
+    if isinstance(a, int) or isinstance(b, int):
+        return type(a) is type(b) and a == b
+    if isinstance(a, float) or isinstance(b, float):
+        if type(a) is not type(b):
+            return False
+        # finite only so direct compare; NaN never equal but invalid anyway
+        return a == b
+    if a is None or b is None:
+        return a is b
+    if isinstance(a, str) or isinstance(b, str):
+        return type(a) is type(b) and a == b
+    if isinstance(a, list) or isinstance(b, list):
+        if type(a) is not list or type(b) is not list:
+            return False
+        if len(a) != len(b):
+            return False
+        return all(_strict_json_equal(x, y) for x, y in zip(a, b))
+    if isinstance(a, dict) or isinstance(b, dict):
+        if type(a) is not dict or type(b) is not dict:
+            return False
+        if set(a.keys()) != set(b.keys()):
+            return False
+        return all(_strict_json_equal(a[k], b[k]) for k in a)
+    return False
+
