+    def test_subprocess_durability_and_claim_exclusivity(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            db = str(Path(tmp) / "q.db")
+            # submit via subprocess, kill-restart durability
+            r = cli(db, {"op": "submit", "jobs": [{"id": "a"}, {"id": "b", "priority": 5}]}, tmp)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            out = json.loads(r.stdout)
+            self.assertEqual(len(out), 2)
+            # concurrent claim exclusivity across processes
+            procs = []
+            for i in range(6):
+                p = Path(tmp) / f"c{i}.json"
+                p.write_text(json.dumps({"op": "claim", "worker": f"w{i}", "now": 0, "lease_seconds": 30}), encoding="utf-8")
+                procs.append(subprocess.Popen([sys.executable, "-m", "durable_queue", "--db", db, "--request", str(p)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True))
+            results = [p.communicate(timeout=15) for p in procs]
+            # collect non-null claims
+            claimed = []
+            for (o, e), p in zip(results, procs):
+                self.assertEqual(p.returncode, 0, e)
+                v = json.loads(o)
+                if v is not None:
+                    claimed.append(v["id"])
+            # only 2 jobs, at most 2 distinct claims, no duplicate active lease
+            self.assertLessEqual(len(claimed), 2)
+            self.assertEqual(len(set(claimed)), len(claimed))
+            # durability: reopen sees same
+            q = Queue(db)
+            self.assertEqual(len(q.list()), 2)
