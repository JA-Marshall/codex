+    def test_claim_priority_dep_retry_and_recover(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "low", "priority": 0}, {"id": "high", "priority": 10}, {"id": "mid", "priority": 10}])
+            c = q.claim("w", 0, 10)
+            self.assertEqual(c["id"], "high")  # highest priority, smallest id among ties
+            q.complete("high", "w", c["attempts"], 1)
+            c2 = q.claim("w", 1, 10)
+            self.assertEqual(c2["id"], "mid")
+            # dep matrix: failed dep stays pending
+            q2 = Queue(Path(tmp) / "q2.db")
