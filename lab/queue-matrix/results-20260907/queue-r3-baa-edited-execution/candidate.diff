+import contextlib
+import json
 import sqlite3
 
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS jobs (
+  id TEXT PRIMARY KEY,
+  spec_json TEXT NOT NULL,
+  payload_json TEXT NOT NULL,
+  priority INTEGER NOT NULL,
+  dependencies_json TEXT NOT NULL,
+  max_attempts INTEGER NOT NULL,
+  ready_at INTEGER NOT NULL,
+  state TEXT NOT NULL,
+  attempts INTEGER NOT NULL,
+  worker TEXT,
+  lease_until INTEGER
+)
+"""
+
+def _ensure_schema(conn):
+    cur = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='jobs'")
+    exists = cur.fetchone() is not None
+    if not exists:
+        conn.execute(_SCHEMA)
+        conn.execute("COMMIT") if False else None
+        return
+    cols = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
+    if set(cols) == {"id", "data"}:
+        # migrate legacy jobs(id,data)
+        rows = conn.execute("SELECT id, data FROM jobs").fetchall()
+        conn.execute("CREATE TABLE IF NOT EXISTS jobs_new (id TEXT PRIMARY KEY, spec_json TEXT NOT NULL, payload_json TEXT NOT NULL, priority INTEGER NOT NULL, dependencies_json TEXT NOT NULL, max_attempts INTEGER NOT NULL, ready_at INTEGER NOT NULL, state TEXT NOT NULL, attempts INTEGER NOT NULL, worker TEXT, lease_until INTEGER)")
+        for rid, data in rows:
+            try:
+                v = json.loads(data)
+            except Exception:
+                continue
+            try:
+                jid = v.get("id", rid)
+                payload = v.get("payload", {})
+                if not isinstance(payload, dict):
+                    payload = {}
+                priority = v.get("priority", 0)
+                if type(priority) is not int:
+                    priority = 0
+                deps = v.get("dependencies", [])
+                if not isinstance(deps, list):
+                    deps = []
+                deps = sorted({d for d in deps if isinstance(d, str) and len(d) > 0})
+                max_attempts = v.get("max_attempts", 3)
+                if type(max_attempts) is not int or not (1 <= max_attempts <= 100):
+                    max_attempts = 3
+                ready_at = v.get("ready_at", 0)
+                if type(ready_at) is not int or ready_at < 0:
+                    ready_at = 0
+                state = v.get("state", "pending")
+                if state not in ("pending", "running", "succeeded", "failed"):
+                    state = "pending"
+                attempts = v.get("attempts", 0)
+                if type(attempts) is not int or attempts < 0:
+                    attempts = 0
+                worker = v.get("worker", None)
+                if worker is not None and not (isinstance(worker, str) and len(worker) > 0):
