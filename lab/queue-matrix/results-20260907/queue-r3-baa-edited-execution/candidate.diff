+def cli(db, req, tmp):
+    p = Path(tmp) / "req.json"
+    # write request preserving types (caller ensures finite)
+    p.write_text(json.dumps(req), encoding="utf-8")
+    r = subprocess.run([sys.executable, "-m", "durable_queue", "--db", str(db), "--request", str(p)], capture_output=True, text=True, timeout=15)
+    return r
+
+
+class RegressionTests(unittest.TestCase):
+    def test_submit_validation_and_rollback(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            q = Queue(Path(tmp) / "q.db")
+            q.submit([{"id": "a"}])
+            before = q.list()
+            # bool is not int
+            for bad in [
+                [{"id": "b", "priority": True}],
+                [{"id": "c", "max_attempts": True}],
+                [{"id": "d", "ready_at": False}],
+                [{"id": ""}],
+                [{"id": "e", "payload": []}],
+                [{"id": "f", "payload": {"x": float("nan")}}],
+                [{"id": "g", "payload": {"x": float("inf")}}],
+                [{"id": "h", "unknown": 1}],
+                [{"id": "a", "payload": {"other": 1}}],  # conflict
+                [{"id": "x"}, {"id": "x"}],  # dup in batch
+                [{"id": "y", "dependencies": ["missing"]}],
+                [{"id": "z", "dependencies": ["z"]}],
+                [{"id": "c1", "dependencies": ["c2"]}, {"id": "c2", "dependencies": ["c1"]}],
+                "notalist",
+                [{"id": "t", "dependencies": "setup"}],
+                [{"id": "u", "priority": 1.0}],
+            ]:
+                with self.assertRaises(ValueError, msg=str(bad)):
+                    q.submit(bad)
+            self.assertEqual(q.list(), before)
+            # invalid batch leaves DB unchanged (mixed valid+invalid)
+            with self.assertRaises(ValueError):
+                q.submit([{"id": "good"}, {"id": ""}])
+            self.assertIsNone(q.get("good"))
+            self.assertEqual(q.list(), before)
+
+    def test_no_caller_mutation_and_detached_views(self):
