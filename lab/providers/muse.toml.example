# Direct Contributor routing verified against Meta's portal and model API.
# Live function/command compatibility tested; workflow limitations are in
# MUSE_VALIDATION.md. Copy muse-contributor.models.json into the dedicated home.
model = "muse-spark-1.3-contributor"
model_provider = "muse-lab"
model_catalog_json = "<absolute-path-to-muse-contributor.models.json>"
model_reasoning_effort = "high"
model_reasoning_summary = "auto"
model_context_window = 1048576
model_auto_compact_token_limit = 900000

[model_providers.muse-lab]
name = "Muse lab provider"
base_url = "https://api.meta.ai/v1"
env_key = "MODEL_API_KEY"
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false

# Context/reasoning/compaction settings follow Meta's Codex setup guide.
# This upstream revision represents reasoning-summary support in the model
# catalog; it rejects the old model_supports_reasoning_summaries config key.
# The tested catalog disables unsupported custom/freeform apply_patch tools.
# Keep its instruction/context policies fixed when comparing workflows. Output
# limits and compaction under pressure remain unverified. Do not use unknown-model
# fallback. Keep API keys in the environment, never here.
