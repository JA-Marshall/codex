[
  {
    "id": "unicode-casefold",
    "files": {},
    "steps": [
      {
        "argv": [
          "8"
        ],
        "stdin": "Straße STRASSE café CAFÉ 42",
        "expect": {
          "exit": 0,
          "stdout_json": {
            "total": 5,
            "unique": 3,
            "top": [
              {
                "word": "café",
                "count": 2
              },
              {
                "word": "strasse",
                "count": 2
              },
              {
                "word": "42",
                "count": 1
              }
            ]
          }
        }
      }
    ]
  },
