[
  {
    "id": "chained-transfer",
    "files": {
      "l.json": "{\"balances\":{\"a\":10},\"receipts\":{}}\n"
    },
    "steps": [
      {
        "argv": [
          "batch",
          "l.json"
        ],
        "stdin": "{\"id\": \"x\", \"transfers\": [{\"from\": \"a\", \"to\": \"b\", \"amount\": 4}, {\"from\": \"b\", \"to\": \"c\", \"amount\": 3}]}",
        "expect": {
          "exit": 0,
          "stdout_json": {
            "a": 6,
            "b": 1,
            "c": 3
          }
        }
      },
      {
        "argv": [
          "balances",
          "l.json"
        ],
        "stdin": "",
        "expect": {
          "exit": 0,
          "stdout_json": {
            "a": 6,
            "b": 1,
            "c": 3
          }
        }
      }
    ]
  },
