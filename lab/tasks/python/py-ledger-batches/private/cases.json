  {
    "id": "rollback-after-successful-prefix",
    "files": {
      "l.json": "{\n \"balances\": {\n  \"a\": 10\n },\n \"receipts\": {}\n}"
    },
    "steps": [
      {
        "argv": [
          "batch",
          "l.json"
        ],
        "stdin": "{\"id\": \"bad\", \"transfers\": [{\"from\": \"a\", \"to\": \"b\", \"amount\": 4}, {\"from\": \"b\", \"to\": \"c\", \"amount\": 5}]}",
        "expect": {
          "exit": 2,
          "stdout_json": {
            "error": "insufficient funds"
          },
          "files": {
            "l.json": "{\n \"balances\": {\n  \"a\": 10\n },\n \"receipts\": {}\n}"
          }
        }
      },
      {
        "argv": [
          "balances",
          "l.json"
        ],
        "stdin": "",
        "expect": {
          "exit": 0,
          "stdout_json": {
            "a": 10
          }
        }
      }
    ]
  },
