  {
    "id": "repeated-boolean-amount",
    "files": {
      "l.json": "{\"balances\":{\"a\":2},\"receipts\":{}}\n"
    },
    "steps": [
      {
        "argv": [
          "batch",
          "l.json"
        ],
        "stdin": "{\"id\": \"retry\", \"transfers\": [{\"from\": \"a\", \"to\": \"b\", \"amount\": 1}]}",
        "expect": {
          "exit": 0,
          "stdout_json": {
            "a": 1,
            "b": 1
          },
          "files": {
            "l.json": "{\"balances\":{\"a\":1,\"b\":1},\"receipts\":{\"retry\":{\"balances\":{\"a\":1,\"b\":1},\"transfers\":[{\"amount\":1,\"from\":\"a\",\"to\":\"b\"}]}}}\n"
          }
        }
      },
      {
        "argv": [
          "batch",
          "l.json"
        ],
        "stdin": "{\"id\": \"retry\", \"transfers\": [{\"from\": \"a\", \"to\": \"b\", \"amount\": true}]}",
        "expect": {
          "exit": 2,
          "stdout_json": {
            "error": "invalid transfer"
          },
          "files": {
            "l.json": "{\"balances\":{\"a\":1,\"b\":1},\"receipts\":{\"retry\":{\"balances\":{\"a\":1,\"b\":1},\"transfers\":[{\"amount\":1,\"from\":\"a\",\"to\":\"b\"}]}}}\n"
          }
        }
      },
      {
        "argv": [
          "batch",
          "l.json"
        ],
        "stdin": "{\"id\": \"retry\", \"transfers\": [{\"from\": \"a\", \"to\": \"b\", \"amount\": 1}]}",
        "expect": {
          "exit": 0,
          "stdout_json": {
            "a": 1,
            "b": 1
          },
          "files": {
            "l.json": "{\"balances\":{\"a\":1,\"b\":1},\"receipts\":{\"retry\":{\"balances\":{\"a\":1,\"b\":1},\"transfers\":[{\"amount\":1,\"from\":\"a\",\"to\":\"b\"}]}}}\n"
          }
        }
      }
    ]
  },
