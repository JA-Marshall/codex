{
  "schema_version": 1,
  "id": "py-csv-rollup",
  "family": "extension",
  "language": "python",
  "size": "small",
  "split": "study",
  "project_id": "py-csv-rollup",
  "capabilities": [
    "cli",
    "csv",
    "aggregation",
    "backward-compatibility"
  ],
  "write_paths": [
    "src",
    "tests"
  ],
