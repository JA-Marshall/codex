    "{repository}/src/main.py"
  ],
  "build": [],
  "public_command": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests"
  ],
  "mutants": [
    "overwrite-groups",
    "drop-empty-groups"
  ],
  "structural_checks": []
}
