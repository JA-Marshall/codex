{
  "schema_version": 1,
  "id": "py-snapshot-format",
  "family": "maintenance",
  "language": "python",
  "size": "small",
  "split": "study",
  "project_id": "py-snapshot-format",
  "capabilities": [
    "cli",
    "migration",
    "serialization",
    "backward-compatibility"
  ],
  "write_paths": [
    "src",
    "tests"
  ],
  "command": [
    "{python}",
    "{repository}/src/main.py"
  ],
  "build": [],
  "public_command": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests"
  ],
  "mutants": [
    "drop-falsy",
    "first-duplicate-wins"
  ],
  "structural_checks": []
}
