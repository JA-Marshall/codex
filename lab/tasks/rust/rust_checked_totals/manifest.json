{
  "schema_version": 1,
  "id": "rust_checked_totals",
  "family": "maintenance",
  "language": "rust",
  "size": "small",
  "split": "study",
  "project_id": "rust_checked_totals",
  "capabilities": [
    "arithmetic_hardening",
    "compatibility",
    "error_contracts"
  ],
  "write_paths": [
    "src",
    "tests"
  ],
  "build": [
    "{cargo}",
    "build",
    "--offline",
    "--locked",
    "--manifest-path",
    "{repository}/Cargo.toml",
    "--target-dir",
    "{scratch}/target"
  ],
  "command": [
    "{scratch}/target/debug/rust-checked-totals"
  ],
  "public_command": [
    "{cargo}",
    "test",
    "--offline",
    "--locked",
    "--manifest-path",
    "{repository}/Cargo.toml",
    "--target-dir",
    "{scratch}/target"
  ],
  "mutants": [
    "product_only",
    "missing_grand_check"
  ],
  "structural_checks": []
}
